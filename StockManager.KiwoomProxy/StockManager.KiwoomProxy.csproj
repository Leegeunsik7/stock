<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      COM axKHOpenAPI+는 32비트 전용. 이 프로세스는 반드시 x86으로 실행.
      메인 터미널(64비트 AnyCPU)과 격리되어 COM 크래시가 터미널에 전파되지 않음.
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockManager.KiwoomProxy</RootNamespace>
    <AssemblyName>MS2E.KiwoomProxyHost</AssemblyName>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <!-- v4.0.0 — The Gold Master: x86 COM 격리 에이전트, 스위트 버전 정합 -->
    <Product>MS2-E KiwoomProxy</Product>
    <Company>Angtec</Company>

    <!-- v4.0.0 골드 마스터 빌드 가드레일: 단 하나의 경고도 빌드를 차단 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    BridgeProtocol 공유 타입: 프로젝트 참조 없이 소스 파일 직접 링크.
    메인 프로젝트의 Blazor/QuestPDF 의존성을 끌어오지 않는다.
  -->
  <ItemGroup>
    <Compile Include="..\src\02_Infrastructure\Engine\BridgeProtocol.cs" />
    <Compile Include="..\src\02_Infrastructure\Engine\BridgeOrderStatus.cs" />
    <Compile Include="..\src\02_Infrastructure\Engine\KiwoomComBridgeCore.cs" />
    <!-- [헬스 · 방향 B] 호스트 하트비트 MMF 판독 → 주문 송신 직전 게이트 -->
    <Compile Include="..\src\02_Infrastructure\Engine\HostHealthHeartbeat.cs" />
  </ItemGroup>

</Project>
