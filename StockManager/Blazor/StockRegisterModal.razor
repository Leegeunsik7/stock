    .reg-pw-meter { height: 6px; border-radius: 4px; background: rgba(255,255,255,.08); overflow: hidden; margin: 8px 0 5px; }
    .reg-pw-bar { height: 100%; border-radius: 4px; transition: width .3s ease, background .3s ease; }
    .reg-pw-bar.weak { background: #f87171; } .reg-pw-bar.mid { background: #fbbf24; } .reg-pw-bar.strong { background: #818cf5; }
    .reg-pw-lbl { font-size: .74rem; font-weight: 800; }
    .reg-pw-lbl.weak { color: #f87171; } .reg-pw-lbl.mid { color: #fcd34d; } .reg-pw-lbl.strong { color: #a5b0ff; }
    .reg-pw-reqs { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 8px; }
    .reg-pw-reqs span { font-size: .72rem; font-weight: 700; transition: color .2s ease; }
    .reg-pw-reqs .ok { color: #34d399; }
    .reg-pw-reqs .no { color: #8f9bc9; }
    .reg-done { text-align: center; padding: 14px 6px; }
    .reg-done-ico { font-size: 3.2rem; animation: regBurst .6s cubic-bezier(.2,.9,.3,1.5); }
    @@keyframes regBurst { 0% { transform: scale(.2) rotate(-20deg); opacity: 0; } 60% { transform: scale(1.15) rotate(6deg); } 100% { transform: scale(1) rotate(0); opacity: 1; } }
    .reg-done-t { font-size: 1.2rem; font-weight: 800; color: #a5b0ff; margin: 8px 0 5px; }
    .reg-done-s { font-size: .84rem; color: #aab2d4; } .reg-done-s b { color: #eef0fb; }
    .reg-member { margin: 16px auto; max-width: 320px; padding: 13px; background: rgba(124,138,255,.12); border: 1px solid rgba(124,138,255,.38); border-radius: 12px; }
    .reg-member-l { font-size: .66rem; font-weight: 800; color: #9aa6ff; letter-spacing: .04em; }
    .reg-member-id { font-family: 'Roboto Mono', Consolas, monospace; font-size: 1.15rem; font-weight: 800; color: #a5b0ff; margin-top: 4px; letter-spacing: .03em; }
    .reg-summary { max-width: 340px; margin: 0 auto; display: flex; flex-direction: column; gap: 5px; text-align: left; }
    .reg-summary > div { display: flex; justify-content: space-between; font-size: .8rem; padding: 5px 0; border-bottom: 1px dashed rgba(255,255,255,.08); }
    .reg-summary span { color: #8f9bc9; } .reg-summary b { color: #eef0fb; max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .reg-foot { display: flex; align-items: center; gap: 8px; padding: 14px 22px 18px; border-top: 1px solid rgba(255,255,255,.06); }
    .reg-foot-sp { flex: 1; }
    .reg-nav { border: none; border-radius: 11px; padding: 11px 20px; font-weight: 800; font-size: .88rem; cursor: pointer; transition: filter .15s ease, transform .1s ease; }
    .reg-nav.prev { background: rgba(255,255,255,.06); color: #c3c9e2; border: 1px solid rgba(255,255,255,.14); }
    .reg-nav.next, .reg-nav.go { color: #0b0f1a; background: linear-gradient(135deg, #818cf5, #4f5bd5); box-shadow: 0 6px 18px rgba(79,91,213,.34); }
    .reg-nav.next:hover:not(:disabled), .reg-nav.go:hover { filter: brightness(1.06); }
    .reg-nav:active:not(:disabled) { transform: scale(.98); }
    .reg-nav:disabled { opacity: .4; cursor: not-allowed; }
    .reg-modal, .reg-body { contain: layout; }
    .reg-body .reg-in, .reg-body .reg-sel { box-sizing: border-box; max-width: 100%; }
    .reg-countdown { flex: 0 0 auto; font-variant-numeric: tabular-nums; font-weight: 800; font-size: .82rem; color: #a5b0ff; min-width: 48px; text-align: center; }
    .reg-countdown.danger { color: #f87171; }
    .reg-lockbadge { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; padding: 7px 12px; border-radius: 9px; font-size: .8rem; font-weight: 800; color: #6ee7b7; background: rgba(52,211,153,.12); border: 1px solid rgba(52,211,153,.42); }
    .reg-lock-ic { font-size: .82rem; }
    .reg-toast { position: fixed; top: 22px; left: 50%; transform: translateX(-50%); z-index: 6400; max-width: min(520px, 92vw);
        background: linear-gradient(135deg, #2b3170, #3a3f8f); color: #eef0ff; border: 1px solid rgba(124,138,255,.5); border-radius: 12px;
        padding: 13px 18px; font-size: .86rem; font-weight: 700; box-shadow: 0 16px 44px rgba(0,0,0,.55), 0 0 0 3px rgba(124,138,255,.16);
        animation: regToast .3s cubic-bezier(.2,.9,.3,1.3); }
    @@keyframes regToast { from { opacity: 0; transform: translate(-50%, -14px); } to { opacity: 1; transform: translate(-50%, 0); } }
    .reg-done-note { margin-top: 14px; font-size: .76rem; color: #9aa6ff; background: rgba(124,138,255,.1); border: 1px solid rgba(124,138,255,.24); border-radius: 10px; padding: 9px 12px; }
    .reg-confirm-scrim { position: fixed; inset: 0; z-index: 6500; background: rgba(6,9,16,.64); display: flex; align-items: center; justify-content: center; padding: 20px; animation: regFade .15s ease; }
    .reg-confirm { width: min(360px, 92vw); background: linear-gradient(168deg, #141b2e, #0b0f1a); border: 1px solid rgba(251,191,36,.4); border-radius: 16px; padding: 22px; box-shadow: 0 26px 60px rgba(0,0,0,.6); text-align: center; }
    .reg-confirm-t { font-size: 1.02rem; font-weight: 900; color: #fcd34d; }
    .reg-confirm-s { font-size: .82rem; color: #aab2d4; margin: 8px 0 18px; }
    .reg-confirm-actions { display: flex; gap: 9px; }
    .reg-confirm-no, .reg-confirm-yes { flex: 1; padding: 11px; border-radius: 10px; font-weight: 800; font-size: .86rem; cursor: pointer; border: none; }
    .reg-confirm-no { color: #c3c9e2; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); }
    .reg-confirm-yes { color: #2a1206; background: linear-gradient(135deg, #fcd34d, #f59e0b); }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<RegisterResult> OnComplete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    public sealed record RegisterResult(string UserId, string Password, string MemberId);

    private static readonly string[] EmailDomains = { "naver.com", "gmail.com", "daum.net", "kakao.com", "hanmail.net", "nate.com" };
    private static readonly string[] Crops = { "국내주식", "해외주식", "암호화폐", "선물·옵션", "ETF·ETN", "전체 자산" };
    private static readonly string[] Facilities = { "단기 트레이딩", "스윙 트레이딩", "중장기 가치투자", "퀀트 자동매매" };
    private static readonly string[] TakenIds = { "admin", "operator", "viewer", "test", "root", "manager", "gslee", "stock", "trader", "ms2e" };

    private int _step = 1;

    private bool _agreeAll, _agreeTos, _agreePrivacy, _agreeLocation;
    private string _regLicKey = "";
    private StockManager.Common.Account.LicenseInfo? _regLicInfo;
    private void OnLicInput(ChangeEventArgs e)
    {
        _regLicKey = e.Value?.ToString() ?? string.Empty;
        _regLicInfo = string.IsNullOrWhiteSpace(_regLicKey) ? null : License.VerifyKey(_regLicKey);
    }
    private static string YmdDash(string? s) => (s is not null && s.Length == 8) ? $"{s[..4]}-{s.Substring(4, 2)}-{s.Substring(6, 2)}" : (s ?? "");

    private string _name = "", _birth = "", _gender = "", _phone = "";
    private bool _emailCodeSent, _emailVerified, _verifyError, _emailSending, _demoMode;
    private string? _emailSendError;
    private string _emailCode = "", _emailCodeInput = "";
    private string PhoneDigits => new string(_phone.Where(char.IsDigit).ToArray());
    private bool BirthValid => System.Text.RegularExpressions.Regex.IsMatch(
        _birth, @"^(19|20)\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$");
    private int _remain;
    private System.Threading.Timer? _otpTimer;
    private string? _toast;
    private System.Threading.Timer? _toastTimer;
    private bool _confirmClose;
    private string _email = "", _emailDomain = "naver.com";
    private const string CustomDomainKey = "__custom__";
    private string _customDomain = "";
    private string _userId = "", _pw = "", _pwConfirm = "";
    private string? _idState;
    private string _zip = "", _addr = "", _addrDetail = "", _farmName = "", _crop = "국내주식", _facility = "단기 트레이딩";
    private string _cropCustom = "", _facilityCustom = "";
    private string EffectiveCrop => _crop == CustomDomainKey ? _cropCustom.Trim() : _crop;
    private string EffectiveFacility => _facility == CustomDomainKey ? _facilityCustom.Trim() : _facility;
    private bool _postcodeOpen;
    private ElementReference _detailRef;
    private string _memberId = "";

    private static string StepLabel(int s) => s switch { 1 => "약관", 2 => "정보", 3 => "계정", 4 => "프로필", _ => "완료" };

    private void ToggleAll(ChangeEventArgs e)
    {
        _agreeAll = (bool)(e.Value ?? false);
        _agreeTos = _agreePrivacy = _agreeLocation = _agreeAll;
    }
    private void SyncAll() => _agreeAll = _agreeTos && _agreePrivacy && _agreeLocation;

    private bool IsCustomDomain => _emailDomain == CustomDomainKey;
    private string EffectiveDomain => (IsCustomDomain ? _customDomain : _emailDomain).Trim();
    private string FullEmail => $"{_email.Trim()}@{EffectiveDomain}";
    private bool IsEmailValid => _email.Trim().Length > 0 && !_email.Contains(' ')
                              && EffectiveDomain.Length > 0 && EffectiveDomain.Contains('.') && !EffectiveDomain.Contains(' ');
    private string CountdownText => $"{_remain / 60:D2}:{_remain % 60:D2}";

    private void ResetSendState()
    {
        if (!_emailVerified) { _emailCodeSent = false; _demoMode = false; _emailSendError = null; StopOtpTimer(); _remain = 0; }
    }
    private void OnEmailInput(ChangeEventArgs e) { _email = e.Value?.ToString() ?? string.Empty; ResetSendState(); }
    private void OnDomainChange(ChangeEventArgs e) { _emailDomain = e.Value?.ToString() ?? "naver.com"; ResetSendState(); }
    private void OnCustomDomainInput(ChangeEventArgs e) { _customDomain = e.Value?.ToString() ?? string.Empty; ResetSendState(); }
    private void OnPhoneInput(ChangeEventArgs e)
    {
        var d = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(11).ToArray());
        _phone = FormatPhone(d);
    }
    private static string FormatPhone(string d)
    {
        if (d.Length < 4) return d;
        if (d.Length < 8) return $"{d[..3]}-{d[3..]}";
        if (d.Length <= 10) return $"{d[..3]}-{d[3..6]}-{d[6..]}";
        return $"{d[..3]}-{d[3..7]}-{d[7..11]}";
    }
    private void OnCodeInput(ChangeEventArgs e)
    {
        _emailCodeInput = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(6).ToArray());
        _verifyError = false;
    }

    private async Task SendEmailCode()
    {
        if (!IsEmailValid || _emailVerified || _emailSending) return;
        _emailSendError = null;
        _emailCode = Random.Shared.Next(100000, 1000000).ToString(CultureInfo.InvariantCulture);
        _emailCodeInput = ""; _verifyError = false; _emailCodeSent = false; _demoMode = false;
        _emailSending = true;
        await InvokeAsync(StateHasChanged);
        var to = FullEmail;
        var res = await Otp.SendOtpAsync(to, _emailCode);
        _emailSending = false;
        if (res.Sent)
        {
            _emailCodeSent = true; _demoMode = false; _remain = 180; StartOtpTimer();
            ShowToast($"📧 인증번호를 {to} 로 발송했습니다. 메일함(스팸함 포함)을 확인해 주세요.", 8000);
        }
        else if (res.Demo)
        {
            _emailCodeSent = true; _demoMode = true; _remain = 180; StartOtpTimer();
            ShowToast($"📮 데모 모드 — 화면의 인증번호를 입력해 주세요. (이메일 미구성)", 6000);
        }
        else
        {
            _emailSendError = "인증 메일 발송에 실패했습니다. 이메일 주소를 확인하거나 관리자에게 문의하세요." + (string.IsNullOrWhiteSpace(res.Error) ? "" : $" ({res.Error})");
        }
        await InvokeAsync(StateHasChanged);
    }
    private void StartOtpTimer()
    {
        _otpTimer?.Dispose();
        _otpTimer = new System.Threading.Timer(_ =>
        {
            if (_remain > 0) _remain--;
            if (_remain <= 0) StopOtpTimer();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }
    private void StopOtpTimer() { _otpTimer?.Dispose(); _otpTimer = null; }

    private void VerifyEmail()
    {
        if (_remain <= 0) { _verifyError = true; return; }
        if (_emailCodeInput.Trim() == _emailCode)
        {
            _emailVerified = true; _verifyError = false;
            StopOtpTimer();
            ShowToast($"✅ {FullEmail} 이메일 본인인증이 완료되었습니다.", 3500);
        }
        else _verifyError = true;
    }

    private void ShowToast(string msg, int ms)
    {
        _toast = msg;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ => { _toast = null; InvokeAsync(StateHasChanged); }, null, ms, System.Threading.Timeout.Infinite);
    }

    private void CheckId()
    {
        var id = _userId.Trim();
        if (id.Length < 4) return;
        bool taken = TakenIds.Contains(id, StringComparer.OrdinalIgnoreCase) || Members.Exists(id);
        _idState = taken ? "taken" : "ok";
    }
    private bool PwLen => _pw.Length >= 8;
    private bool PwLetter => _pw.Any(char.IsLetter);
    private bool PwDigit => _pw.Any(char.IsDigit);
    private bool PwSpecial => _pw.Any(c => !char.IsLetterOrDigit(c));
    private bool PwOk => PwLen && PwLetter && PwDigit && PwSpecial;
    private string PwClass => !PwOk ? "weak" : (_pw.Length >= 12 ? "strong" : "mid");
    private string PwLabel => !PwOk ? "요건 미충족" : (_pw.Length >= 12 ? "안전" : "보통");
    private int PwPct => !PwOk ? Math.Clamp(_pw.Length * 6, 8, 45) : (_pw.Length >= 12 ? 100 : 72);

    private async Task OnAddressPicked(PostcodeSearchModal.PostcodeResult a)
    {
        _zip = a.Zip; _addr = a.Road; _postcodeOpen = false;
        await InvokeAsync(StateHasChanged);
        try { await _detailRef.FocusAsync(); } catch { /* 포커스 실패 무시 */ }
    }

    private bool CanNext => _step switch
    {
        1 => _agreeTos && _agreePrivacy,
        2 => _name.Trim().Length > 0 && BirthValid && !string.IsNullOrEmpty(_gender)
             && _emailVerified && PhoneDigits.Length >= 10
             && (!License.EnforcementOn || (_regLicInfo?.Valid ?? false)),
        3 => _idState == "ok" && PwOk && _pw == _pwConfirm,
        4 => !string.IsNullOrEmpty(_zip),
        _ => true,
    };

    private void Next() { if (CanNext && _step < 4) _step++; }
    private void Prev() { if (_step > 1) _step--; }

    private void Submit()
    {
        if (!CanNext) return;
        _memberId = $"MS2E-USER-{DateTime.Now:yyyy}-{DateTime.Now:MMdd}";
        var req = new StockManager.Common.Account.MemberRegisterRequest(
            _userId, _pw, _name, _birth,
            _gender == "M" ? "남성" : _gender == "F" ? "여성" : "-",
            FullEmail, _phone, _regLicKey.Trim(), _memberId,
            _farmName, _zip, _addr, _addrDetail, EffectiveCrop, EffectiveFacility);
        try { Members.RegisterFull(req); } catch { /* 저장 실패해도 완료 화면 표시(원장 재시도 가능) */ }
        _step = 5;
    }

    private async Task Finish()
    {
        if (OnComplete.HasDelegate) await OnComplete.InvokeAsync(new RegisterResult(_userId, _pw, _memberId));
    }

    private async Task Close() { if (OnClose.HasDelegate) await OnClose.InvokeAsync(); }

    private Task RequestClose()
    {
        if (_step == 5) return Close();
        _confirmClose = true;
        return Task.CompletedTask;
    }
    private async Task ConfirmClose()
    {
        _confirmClose = false;
        ResetForm();
        await Close();
    }
    private void ResetForm()
    {
        StopOtpTimer(); _toastTimer?.Dispose(); _toast = null;
        _step = 1;
        _agreeAll = _agreeTos = _agreePrivacy = _agreeLocation = false;
        _regLicKey = ""; _regLicInfo = null;
        _name = _birth = _gender = _phone = "";
        _emailCodeSent = _emailVerified = _verifyError = _emailSending = _demoMode = false;
        _emailCode = _emailCodeInput = ""; _remain = 0; _emailSendError = null;
        _email = ""; _emailDomain = "naver.com"; _customDomain = "";
        _userId = _pw = _pwConfirm = ""; _idState = null;
        _zip = _addr = _addrDetail = _farmName = ""; _crop = "국내주식"; _facility = "단기 트레이딩"; _cropCustom = _facilityCustom = "";
        _memberId = "";
    }

    public void Dispose() { _otpTimer?.Dispose(); _toastTimer?.Dispose(); }
}
