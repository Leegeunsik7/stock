@using System.Globalization
@inject StockManager.Common.Account.LicenseService License
@inject StockManager.Common.Account.MemberRegistryService Members
@inject StockManager.Common.Account.StockEmailOtpService Otp
@implements IDisposable

@* [MS2E StockSuite] 정밀 5단계 회원가입 Wizard — 약관·인적정보·계정보안·투자 프로필/주소·완료 (Pure Blazor/CSS).
   모니터링/스마트팜/PLAI/UAV와 동일 구조 · StockSuite 전용(인디고 핀테크 · 오프라인 주소 · 데모 OTP 폴백). *@
@if (Visible)
{
    <div class="reg-scrim">
        <div class="reg-modal" @onclick:stopPropagation="true">
            <div class="reg-head">
                <div class="reg-brand"><span class="reg-leaf">📈</span><b>MS2E StockSuite</b> 신규 회원가입</div>
                <button class="reg-x" @onclick="RequestClose" aria-label="닫기">✕</button>
            </div>

            <div class="reg-steps">
                @for (int i = 1; i <= 5; i++)
                {
                    var s = i;
                    <div class="reg-step @(s == _step ? "cur" : s < _step ? "done" : null)">
                        <span class="reg-step-n">@(s < _step ? "✓" : s.ToString())</span>
                        <span class="reg-step-l">@StepLabel(s)</span>
                    </div>
                    if (i < 5) { <div class="reg-step-bar @(i < _step ? "done" : null)"></div> }
                }
            </div>

            <div class="reg-body">
                @if (_step == 1)
                {
                    <div class="reg-sec-t">📜 약관 동의</div>
                    <label class="reg-agree-all">
                        <input type="checkbox" checked="@_agreeAll" @onchange="ToggleAll" />
                        <span><b>전체 동의하기</b> — 필수 및 선택 항목에 모두 동의합니다.</span>
                    </label>
                    <div class="reg-agree-list">
                        <label class="reg-agree"><input type="checkbox" checked="@_agreeTos" @onchange="e => { _agreeTos = (bool)e.Value!; SyncAll(); }" /><span><em class="req">[필수]</em> MS2E StockSuite 서비스 이용약관</span></label>
                        <label class="reg-agree"><input type="checkbox" checked="@_agreePrivacy" @onchange="e => { _agreePrivacy = (bool)e.Value!; SyncAll(); }" /><span><em class="req">[필수]</em> 개인정보 수집 및 이용 동의</span></label>
                        <label class="reg-agree"><input type="checkbox" checked="@_agreeLocation" @onchange="e => { _agreeLocation = (bool)e.Value!; SyncAll(); }" /><span><em class="opt">[선택]</em> 실시간 시세·시그널 알림 수신 동의</span></label>
                    </div>
                }
                else if (_step == 2)
                {
                    <div class="reg-sec-t">👤 기본 인적 정보</div>
                    @if (License.EnforcementOn)
                    {
                        <div class="reg-field"><label>라이선스 키 <span class="reg-req">*</span> <span class="reg-req-tag">필수</span></label>
                            <input class="reg-in" placeholder="배포자에게 발급받은 라이선스 키 붙여넣기" value="@_regLicKey" @oninput="OnLicInput" spellcheck="false" />
                            @if (_regLicInfo is not null)
                            {
                                @if (_regLicInfo.Valid) { <div class="reg-mailsent">✅ 유효한 라이선스 — @_regLicInfo.Licensee · 만료 @(string.IsNullOrEmpty(_regLicInfo.Expiry) ? "무기한" : YmdDash(_regLicInfo.Expiry))</div> }
                                else { <div class="reg-bad">❌ @_regLicInfo.Reason</div> }
                            }
                            else { <div class="reg-hint">배포자에게 발급받은 라이선스 키를 입력해야 다음 단계로 진행할 수 있습니다.</div> }
                        </div>
                    }
                    <div class="reg-field"><label>이름 <span class="reg-req">*</span></label><input class="reg-in" placeholder="예: 홍길동" @bind="_name" @bind:event="onchange" /></div>
                    <div class="reg-field"><label>생년월일 <span class="reg-req">*</span></label>
                        <input class="reg-in" type="date" min="1900-01-01" max="2099-12-31" value="@_birth" @onchange="e => _birth = e.Value?.ToString() ?? string.Empty" />
                        @if (_birth.Length > 0 && !BirthValid) { <div class="reg-bad" style="margin-top:6px">생년월일 조건 — 연도 1900~2099(19XX·20XX) · 월 01~12 · 일 01~31 범위여야 합니다.</div> }
                    </div>
                    <div class="reg-field"><label>성별 <span class="reg-req">*</span></label>
                        <div class="reg-radio">
                            <button class="reg-radio-btn @(_gender == "M" ? "on" : null)" @onclick='() => _gender = "M"'>남성</button>
                            <button class="reg-radio-btn @(_gender == "F" ? "on" : null)" @onclick='() => _gender = "F"'>여성</button>
                        </div>
                    </div>
                    <div class="reg-field"><label>이메일 <span class="reg-req">*</span> <span class="reg-req-tag">본인인증 필수</span></label>
                        <div class="reg-inline">
                            <input class="reg-in" placeholder="아이디" value="@_email" @oninput="OnEmailInput" disabled="@_emailVerified" />
                            <span class="reg-at">@@</span>
                            <select class="reg-sel" value="@_emailDomain" @onchange="OnDomainChange" disabled="@_emailVerified">
                                @foreach (var d in EmailDomains) { <option value="@d">@d</option> }
                                <option value="@CustomDomainKey">직접 입력</option>
                            </select>
                            <button class="reg-sub-btn" @onclick="SendEmailCode" disabled="@(_emailVerified || _emailSending || !IsEmailValid)">@(_emailSending ? "발송 중…" : _emailCodeSent ? "재발송" : "인증메일 발송")</button>
                        </div>
                        @if (IsCustomDomain)
                        {
                            <input class="reg-in" style="margin-top:7px" placeholder="회사 도메인 직접 입력 (예: angtec.com)" value="@_customDomain" @oninput="OnCustomDomainInput" disabled="@_emailVerified" spellcheck="false" inputmode="url" />
                        }
                        @if (_emailSendError is not null) { <div class="reg-bad">❌ @_emailSendError</div> }
                        @if (_emailCodeSent && !_emailVerified)
                        {
                            <div class="reg-inline" style="margin-top:7px">
                                <input class="reg-in code-in" placeholder="6자리 인증번호" value="@_emailCodeInput" @oninput="OnCodeInput" maxlength="6" inputmode="numeric" />
                                <span class="reg-countdown @(_remain <= 30 ? "danger" : null)">@CountdownText</span>
                                <button class="reg-sub-btn ok" @onclick="VerifyEmail" disabled="@(_remain <= 0 || _emailCodeInput.Length < 6)">인증 확인</button>
                            </div>
                            @if (_demoMode)
                            {
                                <div class="reg-testcode">📮 데모 모드(이메일 미구성) — 아래 인증번호를 입력하세요: <b>@_emailCode</b>
                                    <span class="reg-tc-sub">설정 > 이메일 구성 시 실제 메일로 발송됩니다.</span>
                                </div>
                            }
                            else if (_remain <= 0) { <div class="reg-bad">⏱️ 인증 시간이 만료되었습니다. [재발송] 후 다시 시도해 주세요.</div> }
                            else if (_verifyError) { <div class="reg-bad">❌ 인증번호가 일치하지 않습니다. 다시 확인해 주세요.</div> }
                            else { <div class="reg-mailsent">📧 <b>@FullEmail</b> 로 인증번호를 발송했습니다. 메일함(스팸함 포함)을 확인해 주세요.</div> }
                        }
                        @if (_emailVerified) { <div class="reg-lockbadge">✅ @FullEmail 이메일 인증 완료 <span class="reg-lock-ic">🔒</span></div> }
                    </div>
                    <div class="reg-field"><label>휴대전화번호 <span class="reg-req">*</span></label>
                        <input class="reg-in" placeholder="010-1234-5678" value="@_phone" @oninput="OnPhoneInput" maxlength="13" inputmode="numeric" />
                    </div>
                }
                else if (_step == 3)
                {
                    <div class="reg-sec-t">🔐 계정 보안 설정</div>
                    <div class="reg-field"><label>사용자 ID <span class="reg-req">*</span></label>
                        <div class="reg-inline">
                            <input class="reg-in" placeholder="영문/숫자 4자 이상" value="@_userId" @oninput="e => { _userId = e.Value?.ToString() ?? string.Empty; _idState = null; }" />
                            <button class="reg-sub-btn" @onclick="CheckId" disabled="@(_userId.Length < 4)">중복 확인</button>
                        </div>
                        @if (_idState == "ok") { <div class="reg-ok">✅ 사용 가능한 아이디입니다.</div> }
                        else if (_idState == "taken") { <div class="reg-bad">❌ 이미 가입된 아이디입니다. 다른 아이디를 입력하세요.</div> }
                    </div>
                    <div class="reg-field"><label>비밀번호 <span class="reg-req">*</span></label>
                        <input class="reg-in" type="password" placeholder="영문·숫자·특수문자 조합 8자 이상" value="@_pw" @oninput="e => _pw = e.Value?.ToString() ?? string.Empty" />
                        @if (_pw.Length > 0)
                        {
                            <div class="reg-pw-meter"><div class="reg-pw-bar @PwClass" style="width:@PwPct%"></div></div>
                            <div class="reg-pw-lbl @PwClass">비밀번호 강도: @PwLabel</div>
                            <div class="reg-pw-reqs">
                                <span class="@(PwLen ? "ok" : "no")">@(PwLen ? "✓" : "○") 8자 이상</span>
                                <span class="@(PwLetter ? "ok" : "no")">@(PwLetter ? "✓" : "○") 영문</span>
                                <span class="@(PwDigit ? "ok" : "no")">@(PwDigit ? "✓" : "○") 숫자</span>
                                <span class="@(PwSpecial ? "ok" : "no")">@(PwSpecial ? "✓" : "○") 특수문자</span>
                            </div>
                        }
                    </div>
                    <div class="reg-field"><label>비밀번호 확인 <span class="reg-req">*</span></label>
                        <input class="reg-in" type="password" placeholder="비밀번호 재입력" value="@_pwConfirm" @oninput="e => _pwConfirm = e.Value?.ToString() ?? string.Empty" />
                        @if (_pwConfirm.Length > 0)
                        {
                            @if (_pw == _pwConfirm) { <div class="reg-ok">✅ 비밀번호가 일치합니다.</div> }
                            else { <div class="reg-bad">❌ 비밀번호가 일치하지 않습니다.</div> }
                        }
                    </div>
                }
                else if (_step == 4)
                {
                    <div class="reg-sec-t">🏢 투자 프로필 & 주소</div>
                    <div class="reg-field"><label>주소 <span class="reg-req">*</span></label>
                        <div class="reg-inline">
                            <input class="reg-in" style="max-width:120px" placeholder="우편번호" value="@_zip" readonly />
                            <button class="reg-sub-btn" @onclick="() => _postcodeOpen = true">🔍 주소 검색</button>
                        </div>
                        <input class="reg-in" style="margin-top:7px" placeholder="기본 주소 (주소 검색 시 자동 입력)" value="@_addr" readonly />
                        <input class="reg-in" @ref="_detailRef" style="margin-top:7px" placeholder="상세주소 (동/층/호 등)" @bind="_addrDetail" @bind:event="onchange" />
                    </div>
                    <div class="reg-field"><label>소속/회사 <span class="reg-opt-tag">(선택)</span></label><input class="reg-in" placeholder='예: (주)에이앤지테크 · 개인투자자' @bind="_farmName" @bind:event="onchange" /></div>
                    <div class="reg-field"><label>주 관심 시장 <span class="reg-opt-tag">(선택)</span></label>
                        <select class="reg-sel wide" value="@_crop" @onchange="e => _crop = e.Value?.ToString() ?? string.Empty">
                            @foreach (var c in Crops) { <option value="@c">@c</option> }
                            <option value="@CustomDomainKey">직접 입력</option>
                        </select>
                        @if (_crop == CustomDomainKey) { <input class="reg-in" style="margin-top:7px" placeholder="관심 시장 직접 입력" @bind="_cropCustom" @bind:event="onchange" spellcheck="false" /> }
                    </div>
                    <div class="reg-field"><label>투자 스타일 <span class="reg-opt-tag">(선택)</span></label>
                        <select class="reg-sel wide" value="@_facility" @onchange="e => _facility = e.Value?.ToString() ?? string.Empty">
                            @foreach (var f in Facilities) { <option value="@f">@f</option> }
                            <option value="@CustomDomainKey">직접 입력</option>
                        </select>
                        @if (_facility == CustomDomainKey) { <input class="reg-in" style="margin-top:7px" placeholder="투자 스타일 직접 입력" @bind="_facilityCustom" @bind:event="onchange" spellcheck="false" /> }
                    </div>
                }
                else
                {
                    <div class="reg-done">
                        <div class="reg-done-ico">🎉</div>
                        <div class="reg-done-t">회원가입이 완료되었습니다!</div>
                        <div class="reg-done-s">가입이 완료되었습니다, <b>@_name</b>님. 발급된 아이디로 <b>로그인</b>하여 MS2E StockSuite 트레이딩을 시작하세요.</div>
                        <div class="reg-member">
                            <div class="reg-member-l">회원 고유 식별 번호</div>
                            <div class="reg-member-id">@_memberId</div>
                        </div>
                        <div class="reg-summary">
                            <div><span>사용자 ID</span><b>@_userId</b></div>
                            <div><span>소속/회사</span><b>@(_farmName.Length > 0 ? _farmName : "-")</b></div>
                            <div><span>주소</span><b>@(_addr.Length > 0 ? _addr : "-")</b></div>
                        </div>
                        <div class="reg-done-note">🔐 로그인 화면에서 아이디가 자동 입력됩니다. 비밀번호만 입력하면 로그인됩니다.</div>
                    </div>
                }
            </div>

            <div class="reg-foot">
                @if (_step is > 1 and < 5)
                {
                    <button class="reg-nav prev" @onclick="Prev">← 이전</button>
                }
                <span class="reg-foot-sp"></span>
                @if (_step < 4)
                {
                    <button class="reg-nav next" @onclick="Next" disabled="@(!CanNext)">다음 →</button>
                }
                else if (_step == 4)
                {
                    <button class="reg-nav next" @onclick="Submit" disabled="@(!CanNext)">✅ 가입 완료</button>
                }
                else
                {
                    <button class="reg-nav go" @onclick="Finish">로그인 화면으로 →</button>
                }
            </div>
        </div>
    </div>

    <PostcodeSearchModal Visible="_postcodeOpen" OnSelect="OnAddressPicked" OnClose="() => _postcodeOpen = false" />

    @if (_toast is not null) { <div class="reg-toast">@_toast</div> }

    @if (_confirmClose)
    {
        <div class="reg-confirm-scrim">
            <div class="reg-confirm">
                <div class="reg-confirm-t">⚠️ 회원가입을 취소하시겠습니까?</div>
                <div class="reg-confirm-s">작성 중인 내용이 모두 삭제됩니다.</div>
                <div class="reg-confirm-actions">
                    <button class="reg-confirm-no" @onclick="() => _confirmClose = false">계속 작성</button>
                    <button class="reg-confirm-yes" @onclick="ConfirmClose">나가기</button>
                </div>
            </div>
        </div>
    }
}

<style>
    .reg-scrim { position: fixed; inset: 0; z-index: 6100; background: rgba(6,9,16,.76); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: flex; align-items: flex-start; justify-content: center; padding: 5vh 18px; overflow-y: auto; animation: regFade .18s ease; }
    @@keyframes regFade { from { opacity: 0; } to { opacity: 1; } }
    .reg-modal { width: min(560px, 96vw); background: linear-gradient(168deg, #141b2e, #0b0f1a); border: 1px solid rgba(124,138,255,.32); border-radius: 18px; box-shadow: 0 30px 84px rgba(0,0,0,.66), 0 0 34px rgba(79,91,213,.14); color: #d7dbec; overflow: hidden; animation: regPop .24s cubic-bezier(.2,.9,.3,1.2); }
    @@keyframes regPop { from { opacity: 0; transform: translateY(-12px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .reg-head { display: flex; align-items: center; justify-content: space-between; padding: 15px 20px; border-bottom: 1px solid rgba(255,255,255,.06); background: linear-gradient(90deg, rgba(124,138,255,.16), transparent); }
    .reg-brand { font-size: .98rem; color: #d7dbec; } .reg-brand b { color: #9aa6ff; } .reg-leaf { margin-right: 5px; }
    .reg-x { background: rgba(255,255,255,.08); color: #fff; border: none; border-radius: 8px; width: 28px; height: 28px; font-weight: 800; cursor: pointer; }
    .reg-steps { display: flex; align-items: center; padding: 14px 18px 4px; }
    .reg-step { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 0 0 auto; }
    .reg-step-n { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: .72rem; font-weight: 800; color: #8f9bc9; background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.14); }
    .reg-step.cur .reg-step-n { color: #0b0f1a; background: #818cf5; border-color: #818cf5; box-shadow: 0 0 0 3px rgba(124,138,255,.28); }
    .reg-step.done .reg-step-n { color: #a5b0ff; background: rgba(124,138,255,.14); border-color: rgba(124,138,255,.5); }
    .reg-step-l { font-size: .56rem; font-weight: 700; color: #8f9bc9; white-space: nowrap; }
    .reg-step.cur .reg-step-l { color: #a5b0ff; }
    .reg-step-bar { flex: 1; height: 2px; background: rgba(255,255,255,.1); margin: -14px 4px 0; }
    .reg-step-bar.done { background: rgba(124,138,255,.5); }
    .reg-body { padding: 8px 22px 6px; min-height: 240px; }
    .reg-sec-t { font-size: 1rem; font-weight: 800; margin: 8px 0 14px; color: #eef0fb; }
    .reg-agree-all { display: flex; align-items: center; gap: 9px; padding: 12px 14px; background: rgba(124,138,255,.1); border: 1px solid rgba(124,138,255,.34); border-radius: 11px; cursor: pointer; font-size: .86rem; }
    .reg-agree-list { display: flex; flex-direction: column; gap: 4px; margin-top: 10px; }
    .reg-agree { display: flex; align-items: center; gap: 9px; padding: 9px 12px; border-radius: 9px; cursor: pointer; font-size: .82rem; color: #c3c9e2; }
    .reg-agree:hover { background: rgba(255,255,255,.03); }
    .reg-agree .req { color: #fbbf24; font-style: normal; font-weight: 800; margin-right: 4px; }
    .reg-agree .opt { color: #9aa6ff; font-style: normal; font-weight: 800; margin-right: 4px; }
    .reg-agree input[type=checkbox], .reg-agree-all input[type=checkbox] { accent-color: #818cf5; width: 16px; height: 16px; cursor: pointer; flex: 0 0 auto; }
    .reg-field { margin-bottom: 13px; } .reg-field > label { display: block; font-size: .72rem; font-weight: 800; color: #9aa6ff; margin-bottom: 6px; }
    .reg-hint { font-size: .72rem; color: #8f9bc9; margin-top: 6px; }
    .reg-in { width: 100%; box-sizing: border-box; background: rgba(10,14,24,.6); border: 1px solid rgba(124,138,255,.26); border-radius: 10px; padding: 10px 12px; color: #e8eaf6; font-size: .88rem; outline: none; font-variant-numeric: tabular-nums; }
    .reg-in:focus { border-color: #818cf5; box-shadow: 0 0 0 3px rgba(124,138,255,.2); }
    .reg-in[readonly] { opacity: .8; }
    .reg-inline { display: flex; align-items: center; gap: 7px; min-width: 0; }
    .reg-inline > .reg-in { min-width: 0; flex: 1 1 auto; }
    .reg-at { color: #8f9bc9; font-weight: 800; }
    .reg-sel { background: rgba(10,14,24,.6); border: 1px solid rgba(124,138,255,.26); border-radius: 10px; padding: 10px 12px; color: #e8eaf6; font-size: .86rem; cursor: pointer; color-scheme: dark; }
    .reg-sel.wide { width: 100%; }
    .reg-sel option { background: #141b2e; color: #e8eaf6; }
    .reg-radio { display: flex; gap: 8px; }
    .reg-radio-btn { flex: 1; padding: 10px; border-radius: 10px; font-weight: 700; font-size: .85rem; color: #aab2d4; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); cursor: pointer; }
    .reg-radio-btn.on { color: #0b0f1a; background: #818cf5; border-color: #818cf5; }
    .reg-sub-btn { flex: 0 0 auto; padding: 10px 13px; border-radius: 10px; font-weight: 800; font-size: .78rem; color: #a5b0ff; background: rgba(124,138,255,.14); border: 1px solid rgba(124,138,255,.42); cursor: pointer; white-space: nowrap; }
    .reg-sub-btn.ok { color: #0b0f1a; background: #818cf5; border-color: #818cf5; }
    .reg-sub-btn:disabled { opacity: .4; cursor: not-allowed; }
    .reg-ok { font-size: .76rem; color: #34d399; margin-top: 6px; font-weight: 700; }
    .reg-bad { font-size: .76rem; color: #f87171; margin-top: 6px; font-weight: 700; }
    .reg-testcode { margin-top: 8px; padding: 9px 13px; border-radius: 10px; background: rgba(251,191,36,.16); border: 1px solid rgba(251,191,36,.55); display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: .84rem; font-weight: 800; color: #fde68a; }
    .reg-testcode b { font-family: 'Roboto Mono', Consolas, monospace; font-size: 1.12rem; color: #fcd34d; letter-spacing: .14em; }
    .reg-testcode .reg-tc-sub { font-size: .66rem; font-weight: 700; color: #cbb488; }
    .reg-mailsent { margin-top: 8px; padding: 9px 13px; border-radius: 10px; background: rgba(52,211,153,.12); border: 1px solid rgba(52,211,153,.42); font-size: .8rem; font-weight: 700; color: #6ee7b7; }
    .reg-mailsent b { color: #a7f3d0; font-family: 'Roboto Mono', Consolas, monospace; }
    .reg-req-tag { font-weight: 800; color: #fbbf24; font-size: .62rem; margin-left: 4px; }
