@inject DashboardService Svc
@inject IJSRuntime JS
@inject ToastService Toasts
@inject NavigationManager Nav
@implements IDisposable

@if (_open)
{
    <div class="cmdk-mask" @onclick="Close">
        <div class="cmdk" @onclick:stopPropagation="true">
            <input @ref="_input" placeholder="명령 검색… (모듈 이동 · 테마 · BTC 100만 매수)"
                   value="@_query" @oninput="OnInput" @onkeydown="OnKey" />
            <div class="cmdk-list">
                @if (Filtered.Count == 0)
                {
                    <div class="cmdk-empty">결과 없음</div>
                }
                @for (int i = 0; i < Filtered.Count; i++)
                {
                    var idx = i; var c = Filtered[i];
                    <div class="cmdk-item @(idx == _sel ? "sel" : "")" @onclick="() => Run(c)">
                        <span class="ic">@c.Icon</span><span>@c.Label</span><span class="cat">@c.Cat</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private record Cmd(string Icon, string Label, string Cat, Func<Task> Action);

    private bool _open;
    private string _query = "";
    private int _sel;
    private ElementReference _input;
    private DotNetObjectReference<CommandPalette>? _ref;
    private bool _focusQueued;

    private readonly List<Cmd> _all = new();

    protected override void OnInitialized()
    {
        void Mod(string icon, string label, string key) =>
            _all.Add(new Cmd(icon, label, "이동", () => { ModuleBridge.Open(key); return Task.CompletedTask; }));
        Mod("📈", "실시간 시세", "Realtime"); Mod("💼", "포트폴리오", "Portfolio");
        Mod("🧠", "AI 분석", "AI"); Mod("📰", "뉴스 레이더", "News");
        Mod("⚡", "시그널 엔진", "Signal"); Mod("🔔", "알림 센터", "Alert");
        Mod("🪙", "코인 실시간", "Crypto"); Mod("🧮", "총자산", "TotalAsset");
        Mod("🧪", "모의투자", "Paper"); Mod("🧠", "복합 알림", "Composite");
        Mod("⚙️", "거래 설정", "BrokerSettings"); Mod("⚙️", "설정", "Settings");
        _all.Add(new Cmd("🌗", "테마 전환 (라이트/다크)", "보기", ToggleTheme));
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dashboard.initHotkeys", _ref);
        }
        if (_focusQueued)
        {
            _focusQueued = false;
            try { await JS.InvokeVoidAsync("dashboard.focusEl", _input); } catch { }
        }
    }

    [JSInvokable] public void OpenPalette() { _open = true; _query = ""; _sel = 0; _focusQueued = true; StateHasChanged(); }
    [JSInvokable] public void ClosePalette() { if (_open) { _open = false; StateHasChanged(); } }
    private void Close() => ClosePalette();

    private void OnInput(ChangeEventArgs e) { _query = e.Value?.ToString() ?? ""; _sel = 0; }

    private async Task OnKey(KeyboardEventArgs e)
    {
        var list = Filtered;
        if (e.Key == "ArrowDown") _sel = Math.Min(_sel + 1, Math.Max(0, list.Count - 1));
        else if (e.Key == "ArrowUp") _sel = Math.Max(_sel - 1, 0);
        else if (e.Key == "Enter") { if (_sel < list.Count) await Run(list[_sel]); }
        else if (e.Key == "Escape") ClosePalette();
    }

    private List<Cmd> Filtered
    {
        get
        {
            // 퀵 액션(매크로)은 항상 맨 위 — 원본 Launcher.ParseQuickAction 순서 유지
            var quick = new List<Cmd>();
            if (TryParseAlertsOff(_query) is { } off) quick.Add(off);
            if (TryParseCoinAlert(_query) is { } ca) quick.Add(ca);
            if (TryParsePaper(_query) is { } paper) quick.Add(paper);

            var list = new List<Cmd>(quick);
            list.AddRange(_all);
            if (string.IsNullOrWhiteSpace(_query)) return list;
            var q = _query.Trim();
            return list.Where(c => quick.Contains(c)
                                || c.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
                                || c.Cat.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    // "BTC 100만 매수" / "ETH 50만 매도" 파싱 → 모의 주문
    private Cmd? TryParsePaper(string q)
    {
        if (string.IsNullOrWhiteSpace(q)) return null;
        var parts = q.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3) return null;
        if (!(parts[2].Contains("매수") || parts[2].Contains("매도"))) return null;
        var amt = ParseAmt(parts[1]); if (amt == null) return null;
        var market = "KRW-" + parts[0].ToUpperInvariant();
        var side = parts[2].Contains("매도") ? PaperSide.Sell : PaperSide.Buy;
        return new Cmd("⚡", $"모의 {(side == PaperSide.Buy ? "매수" : "매도")}: {market} {amt:N0}원", "주문",
            () =>
            {
                var (ok, msg) = Svc.QuickPaper(market, amt.Value, side);
                if (ok)
                    Toasts.Success("모의 주문 체결", msg + "\n(모의투자 — 실제 주문 아님)", new()
                    {
                        new ToastButton("모의투자 보기", () => { Nav.NavigateTo("/paper"); return Task.CompletedTask; }, Primary: true)
                    });
                else
                    Toasts.Warning("주문 실패", msg);
                return Task.CompletedTask;
            });
    }

    // "BTC 알림 1억" 파싱 → 지정가 이상 알림 등록 (원본 룰: Above 고정 · 감시목록 자동 추가)
    private Cmd? TryParseCoinAlert(string q)
    {
        if (string.IsNullOrWhiteSpace(q)) return null;
        var parts = q.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3 || !parts[1].Contains("알림")) return null;
        var amt = ParseAmt(parts[2]); if (amt == null) return null;
        var market = "KRW-" + parts[0].ToUpperInvariant();
        return new Cmd("🔔", $"코인 알림 등록: {market} {amt:N0}원 이상", "액션",
            () =>
            {
                Svc.AddCoinAlert(market, amt.Value);
                Toasts.Success("알림 등록", $"{market} {amt:N0}원 이상", new()
                {
                    new ToastButton("코인 화면", () => { Nav.NavigateTo("/coins"); return Task.CompletedTask; })
                });
                return Task.CompletedTask;
            });
    }

    // "알림 끄기/해제/off" → 텔레그램 OFF + 코인 지정가 알림 전체 제거 (원본의 원자적 동작 유지)
    private Cmd? TryParseAlertsOff(string q)
    {
        if (string.IsNullOrWhiteSpace(q)) return null;
        var t = q.Trim(); var low = t.ToLowerInvariant();
        if (!t.Contains("알림") || !(t.Contains("끄") || t.Contains("해제") || low.Contains("off"))) return null;
        return new Cmd("🔕", "모든 코인 알림 + 텔레그램 자동전송 끄기", "액션",
            () =>
            {
                Svc.SetTelegramEnabled(false);
                Svc.DisableAllCoinAlerts();
                Toasts.Info("알림 끄기 완료", "텔레그램 자동 전송 OFF · 코인 지정가 알림 모두 제거");
                return Task.CompletedTask;
            });
    }

    private static decimal? ParseAmt(string s)
    {
        s = s.Replace(",", "").Replace("원", "").Trim();   // "원" 접미사 — 원본 ParseAmount 룰
        decimal mul = 1m;
        if (s.EndsWith("억")) { mul = 100_000_000m; s = s[..^1]; }
        else if (s.EndsWith("만")) { mul = 10_000m; s = s[..^1]; }
        return decimal.TryParse(s, out var v) ? v * mul : (decimal?)null;
    }

    private async Task Run(Cmd c) { ClosePalette(); await c.Action(); }

    private async Task ToggleTheme()
    {
        var mode = Svc.Theme == "dark" ? "light" : "dark";
        Svc.Theme = mode;
        await JS.InvokeVoidAsync("dashboard.setTheme", mode);
    }

    public void Dispose() => _ref?.Dispose();
}
