@* 🌪 시나리오 스튜디오 — RiskHub의 탭(자식). 보유·수익률은 허브에서 캐스케이딩(자체 수집 X). *@

<div class="hubbar">
    <div class="hubbar-t">🌪 시나리오 스튜디오 <span class="sub">시장/환율 충격을 종목별 베타로 전파 (스트레스 테스트)</span></div>
</div>

<div style="padding:0 28px 40px;max-width:920px">
    <div style="background:color-mix(in srgb,var(--accent) 9%,transparent);border:1px solid var(--accent);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--sub);margin:14px 0 16px">
        ℹ️ 시장 팩터 = 보유 종목 가중 합성. 각 종목의 <b>베타</b>(시장 1% 변동당 민감도)로 충격을 전파합니다.
        환율 충격은 USD 표시 종목에 직접 가산. <b>단일팩터 선형 근사·과거 베타 기반이며 보장이 아닙니다(투자 권유 아님).</b>
    </div>

    @if (_msg.Length > 0) { <div style="color:var(--sub);padding:20px">@_msg</div> }
    else if (_base is { IsValid: true })
    {
        <!-- 충격 입력 -->
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:16px">
            <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-bottom:10px">
                <label style="display:flex;align-items:center;gap:8px;font-size:13px">시장 충격
                    <input type="range" min="-30" max="30" step="1" @bind="_mkt" @bind:event="oninput" style="width:200px" />
                    <b class="@(_mkt>=0?"up":"down")" style="width:52px;text-align:right">@_mkt.ToString("+0;-0")%</b>
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px">환율(USD/KRW) 충격
                    <input type="range" min="-15" max="15" step="1" @bind="_fx" @bind:event="oninput" style="width:160px" />
                    <b class="@(_fx>=0?"up":"down")" style="width:52px;text-align:right">@_fx.ToString("+0;-0")%</b>
                </label>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button class="ghost" @onclick="@(() => Preset(-20, 0))">🐻 폭락 −20%</button>
                <button class="ghost" @onclick="@(() => Preset(-10, 0))">조정 −10%</button>
                <button class="ghost" @onclick="@(() => Preset(10, 0))">📈 랠리 +10%</button>
                <button class="ghost" @onclick="@(() => Preset(0, 5))">💱 원화약세 +5%</button>
                <button class="ghost" @onclick="@(() => Preset(-15, 8))">🌩 복합충격</button>
                <button class="ghost" @onclick="@(() => Preset(0, 0))">초기화</button>
            </div>
        </div>

        <div class="kpis" style="margin:0 0 16px;grid-template-columns:repeat(3,1fr)">
            <div class="kpi @(Total>=0?"u":"d")"><div class="k-lab">포트폴리오 예상 변동</div><div class="k-val">@Total.ToString("+0.0;-0.0")%</div></div>
            <div class="kpi k"><div class="k-lab">시장 영향</div><div class="k-val">@MktImpact.ToString("+0.0;-0.0")%</div></div>
            <div class="kpi k"><div class="k-lab">환율 영향 (USD @( (_usdW*100).ToString("0"))%)</div><div class="k-val">@FxImpact.ToString("+0.0;-0.0")%</div></div>
        </div>

        <div class="panel"><div class="panel-h">종목별 베타 전파 <span class="tag">SCENARIO</span></div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden">
            <table class="ctbl" style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                    <th style="text-align:left;padding:8px 12px">종목</th>
                    <th style="text-align:right;padding:8px 12px">비중</th>
                    <th style="text-align:right;padding:8px 12px">베타</th>
                    <th style="text-align:right;padding:8px 12px">R²</th>
                    <th style="text-align:right;padding:8px 12px">예측 이동(시장)</th>
                </tr></thead>
                <tbody>
                @foreach (var a in _base.Assets.OrderByDescending(x => Math.Abs(x.Beta)))
                {
                    var pred = a.Beta * _mkt;
                    <tr style="border-top:1px solid var(--line)">
                        <td style="padding:7px 12px">@a.Name</td>
                        <td style="text-align:right;padding:7px 12px">@(( a.Weight*100).ToString("0.0"))%</td>
                        <td style="text-align:right;padding:7px 12px;font-weight:700">@a.Beta.ToString("0.00")</td>
                        <td style="text-align:right;padding:7px 12px;color:var(--sub)">@a.R2.ToString("0.00")</td>
                        <td style="text-align:right;padding:7px 12px" class="@(pred>=0?"up":"down")">@pred.ToString("+0.0;-0.0")%</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        </div>
        <div class="sub" style="font-size:11.5px;margin-top:8px">@_base.Note · 베타 1회 추정 후 충격은 선형 스케일. R²가 낮은 종목은 시장과 동조성이 약해 예측 신뢰도가 낮습니다.</div>
    }
</div>

@code {
    [CascadingParameter] public PortfolioData? Data { get; set; }

    private string _msg = "";
    private ScenarioResult? _base;     // 시장충격 1% 기준(베타 보존) — UI에서 선형 스케일
    private double _mkt = -10, _fx = 0, _usdW;

    private double MktImpact => _base is { IsValid: true } ? _base.PortfolioMovePct * _mkt : 0;
    private double FxImpact => _usdW * _fx;
    private double Total => MktImpact + FxImpact;

    private void Preset(double mkt, double fx) { _mkt = mkt; _fx = fx; }

    // 캐스케이드된 보유·수익률로 베타 1회 추정(동기). 충격은 UI에서 선형 스케일.
    protected override void OnParametersSet()
    {
        if (Data is null) { _msg = "리스크 시뮬 허브에서 열어 주세요."; _base = null; return; }
        if (!Data.Loaded) { _msg = Data.Error.Length > 0 ? Data.Error : "데이터 수집 중…"; _base = null; return; }

        // USD 비중 합 (환율 충격 대상)
        _usdW = 0;
        for (int i = 0; i < Data.Used.Count && i < Data.Weights.Length; i++)
            if (Data.Used[i].Currency == Currency.USD) _usdW += Data.Weights[i];

        _base = ScenarioStudio.ApplyShock(Data.R, Data.Names, Data.Weights, 1.0);
        _msg = _base.IsValid ? "" : _base.Note;
        if (!_base.IsValid) _base = null;
    }
}
