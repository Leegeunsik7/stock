@page "/broker"
@inject LocalDatabase Db
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ToastService Toasts

@* 레거시 WinForms BrokerSettingsForm의 Blazor 네이티브 이식 (검증된 ApiKeyVault/BrokerHub 재사용).
   실거래 안전장치(무장 확인·경고)는 원본과 동일하게 보존. 실주문 실행 로직은 LiveBrokers에 그대로. *@

<div class="top">
    <div class="hello"><h1>⚙️ 거래 설정</h1><p>모의/실전 · 무장 · API 키 (DPAPI 암호화)</p></div>
    <button class="addbtn" style="background:var(--card);color:var(--ink);border:1px solid var(--line);margin-right:16px"
            @onclick='() => Nav.NavigateTo("/settings")'>← 설정으로</button>
</div>

<div style="padding:0 28px 40px;max-width:620px">

    @* 거래 모드 *@
    <div class="card-sec">
        <div class="sec-h">거래 모드</div>
        <div style="display:flex;gap:14px;margin-bottom:10px">
            <span class="pill @(!_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick="() => _live = false">🧪 모의투자 (안전)</span>
            <span class="pill @(_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick="() => _live = true">💸 실거래</span>
        </div>
        <div style="background:color-mix(in srgb,var(--up) 10%,transparent);border:1px solid var(--up);border-radius:10px;padding:12px;font-size:12.5px;color:var(--up);line-height:1.6">
            ⚠️ 실거래는 실제 자금이 집행됩니다. 이 빌드의 실주문 코드는 검증되지 않았으니
            반드시 KIS 모의도메인 / 업비트 소액으로 먼저 확인하세요. <b>'무장'</b>을 켜야 실주문이 나갑니다.
        </div>
        <label class="ck" style="margin-top:12px;color:var(--up)">
            <input type="checkbox" @bind="_armed" /> 실거래 주문 최종 활성화 (무장)
        </label>
        <label class="ck">
            <input type="checkbox" @bind="_kisReal" /> KIS 실전 도메인 (기본: 모의 VTS)
        </label>
        <div style="margin-top:12px;display:flex;align-items:center;gap:10px">
            <label class="flbl" style="margin:0">주문 금액 상한(원)</label>
            <input class="fin" style="width:200px" type="number" min="0" step="10000" @bind="_maxKrw" />
        </div>
    </div>

    @* KIS *@
    <div class="card-sec">
        <div class="sec-h">KIS (한국투자증권)</div>
        <label class="flbl">App Key</label>
        <input class="fin" type="password" @bind="_kisKey" />
        <label class="flbl" style="margin-top:10px">App Secret</label>
        <input class="fin" type="password" @bind="_kisSecret" />
        <label class="flbl" style="margin-top:10px">계좌번호 (예: 12345678-01)</label>
        <input class="fin" @bind="_kisAcct" placeholder="12345678-01" />
    </div>

    @* 업비트 *@
    <div class="card-sec">
        <div class="sec-h">업비트</div>
        <label class="flbl">Access Key</label>
        <input class="fin" type="password" @bind="_upAccess" />
        <label class="flbl" style="margin-top:10px">Secret Key</label>
        <input class="fin" type="password" @bind="_upSecret" />
    </div>

    <div style="display:flex;gap:10px;align-items:center">
        <button class="addbtn" @onclick="Save">💾 저장</button>
        <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick='() => Nav.NavigateTo("/settings")'>취소</button>
        <span style="color:var(--sub);font-size:12.5px">현재: <b>@CurrentModeText</b></span>
    </div>
</div>

<style>
    .card-sec{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px}
    .sec-h{font-weight:700;margin-bottom:14px}
    .ck{display:flex;align-items:center;gap:8px;font-size:13px;margin-top:8px;cursor:pointer}
</style>

@code {
    private bool _live, _armed, _kisReal;
    private decimal _maxKrw = 100_000m;
    private string _kisKey = "", _kisSecret = "", _kisAcct = "", _upAccess = "", _upSecret = "";

    private string CurrentModeText => !_live ? "모의투자"
        : (_armed ? "실거래(무장)" : "실거래(미무장 — 주문 거부)");

    protected override void OnInitialized()
    {
        _live = BrokerHub.IsLive(Db);
        _armed = BrokerHub.IsArmed(Db);
        _kisReal = Db.GetSetting("Kis.UseRealDomain") == "1";
        _maxKrw = BrokerHub.MaxOrderKrw(Db);
        (_kisKey, _kisSecret, _kisAcct) = ApiKeyVault.GetKis(Db);
        (_upAccess, _upSecret) = ApiKeyVault.GetUpbit(Db);
    }

    private async Task Save()
    {
        // 실거래 + 무장 동시 저장 시 원본과 동일하게 한 번 더 확인
        if (_live && _armed)
        {
            var dom = _kisReal ? "KIS 실전 도메인" : "KIS 모의(VTS)";
            var msg = $"실거래가 '무장' 상태로 저장됩니다.\n· 모드: 실전  · {dom}  · 금액 상한 {_maxKrw:N0}원\n\n"
                    + "실제 주문이 집행될 수 있습니다. 계속할까요?\n(이 빌드의 실주문 코드는 검증되지 않았습니다 — 소액으로 먼저 확인하세요)";
            bool ok = false;
            try { ok = await JS.InvokeAsync<bool>("confirm", msg); } catch { ok = false; }
            if (!ok) return;
        }

        BrokerHub.SetLive(Db, _live);
        BrokerHub.SetArmed(Db, _armed);
        BrokerHub.SetMaxOrderKrw(Db, _maxKrw);
        Db.SetSetting("Kis.UseRealDomain", _kisReal ? "1" : "0");
        ApiKeyVault.SaveKis(Db, _kisKey.Trim(), _kisSecret.Trim(), _kisAcct.Trim());   // DPAPI 암호화 저장
        ApiKeyVault.SaveUpbit(Db, _upAccess.Trim(), _upSecret.Trim());

        Toasts.Success("거래 설정 저장됨", $"현재 모드: {CurrentModeText}");
    }
}
