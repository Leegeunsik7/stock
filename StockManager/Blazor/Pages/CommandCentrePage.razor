@page "/command"
@implements IDisposable
@inject SystemStatusAggregator Agg
@inject PromotionGateway Gw
@inject ShadowMetricsBridge Shadow
@inject IgnitionLock Ignition
@inject ConfigAuditReport ConfigAudit
@inject GreenhouseService Greenhouse
@inject ForensicTelemetryChannel Telemetry
@using System.Threading
@using StockManager.Common

@* ═══════════════════════════════════════════════════════════════════════════
   CommandCentrePage — S18 #2: 전체 관제 탑 (v3.96.0)
   4대 핵심 센서(원장 정합성·메모리 릭·어댑티브 튜너·파이프 연결)를 사분면 매트릭스로
   통합 관제. 하나라도 동결/누수면 중앙 인디케이터가 최고 심각도 색으로 전역 동기화.
   ═══════════════════════════════════════════════════════════════════════════ *@

<div class="top">
    <div class="hello">
        <h1>🗺️ 전체 관제 탑 <span class="tag">GRAND COMMAND CENTRE</span></h1>
        <p>시스템 5대 비탈 통합 관제 · @_snap.CapturedUtc.ToLocalTime().ToString("HH:mm:ss") 기준 · 3초 자동 갱신</p>
    </div>
    <div>
        <button class="addbtn" @onclick="RefreshNow">🔄 새로고침</button>
    </div>
</div>

@* ── 중앙 전역 인디케이터 ─────────────────────────────────────────────────── *@
<div class="cc-master @SystemStatusAggregator.SeverityCssClass(_snap.Overall)">
    <div class="cc-master-icon">@OverallIcon(_snap.Overall)</div>
    <div class="cc-master-body">
        <div class="cc-master-state">시스템 @SystemStatusAggregator.SeverityLabel(_snap.Overall)</div>
        <div class="cc-master-sub">@OverallMessage(_snap)</div>
    </div>
    <div class="cc-master-quad">
        <span class="cc-pip @SystemStatusAggregator.SeverityCssClass(_snap.AttestationSeverity)" title="원장 정합성"></span>
        <span class="cc-pip @SystemStatusAggregator.SeverityCssClass(_snap.MemorySeverity)" title="메모리 릭 프로브"></span>
        <span class="cc-pip @SystemStatusAggregator.SeverityCssClass(_snap.TunerSeverity)" title="어댑티브 튜너"></span>
        <span class="cc-pip @SystemStatusAggregator.SeverityCssClass(_snap.BridgeSeverity)" title="파이프 연결"></span>
        <span class="cc-pip @SystemStatusAggregator.SeverityCssClass(_snap.GreenhouseSeverity)" title="유전자 온실"></span>
    </div>
</div>

@* ── S26-c 포렌식 텔레메트리 스트립 (락-프리 채널 · UI 무할당 독출) ─────────────── *@
<div class="cc-tele">
    <div class="cc-tele-hd">🛰 포렌식 텔레메트리 <span class="cc-tele-tag">LOCK-FREE</span>
        <span class="cc-tele-note">@(_teleEver ? "복합 저널 펌프 발행 중" : "발행 대기 — 펌프 가동 + 챔피언 승격 후 표시")</span>
    </div>
    <div class="cc-tele-grid">
        <div class="cc-tele-cell"><span>영속화 주기</span><b>@_tele.PersistSeq.ToString("N0")</b></div>
        <div class="cc-tele-cell"><span>포렌식 레코드</span><b>@_tele.ForensicCount.ToString("N0")</b></div>
        <div class="cc-tele-cell"><span>무결성 점수</span><b class="@(_tele.IntegrityScore >= 100 ? "ok" : _teleEver ? "warn" : "")">@_tele.IntegrityScore / 100</b></div>
        <div class="cc-tele-cell"><span>신선도 Lag</span><b>@_tele.FreshnessLagMs.ToString("N1") ms</b></div>
        <div class="cc-tele-cell"><span>Seqlock 커서</span><b>v@_tele.ForensicSeqlockVersion.ToString("N0")</b></div>
        <div class="cc-tele-cell"><span>게놈 지문</span><b>@_tele.GenomeFp.ToString("X8")</b></div>
        <div class="cc-tele-cell"><span>포렌식 지문</span><b>@_tele.ForensicFp.ToString("X8")</b></div>
    </div>
</div>

@* ── 4대 사분면 매트릭스 ──────────────────────────────────────────────────── *@
<div class="cc-matrix">

    @* ① 원장 정합성 *@
    <div class="cc-quad @SystemStatusAggregator.SeverityCssClass(_snap.AttestationSeverity)">
        <div class="cc-quad-hd">
            <span class="cc-quad-no">①</span> 원장 정합성
            <span class="cc-quad-badge">@SystemStatusAggregator.SeverityLabel(_snap.AttestationSeverity)</span>
        </div>
        <div class="cc-quad-big">
            @(!_snap.AttestationPresent ? "미배선"
              : _snap.GatingMode == GatingMode.EmergencyFreeze ? "🔒 비상 동결" : "✅ 정상 게이트")
        </div>
        <div class="cc-quad-rows">
            <div><span>게이팅 모드</span><b>@(_snap.AttestationPresent ? _snap.GatingMode.ToString() : "—")</b></div>
            <div><span>거래 허용</span><b>@(_snap.AttestationPresent && _snap.GatingMode == GatingMode.Normal ? "예" : "차단")</b></div>
        </div>
        @if (_snap.GatingMode == GatingMode.EmergencyFreeze)
        {
            <a class="cc-quad-link" href="/broker/gating">→ 정합 서명 해제</a>
        }
    </div>

    @* ② 메모리 릭 프로브 *@
    <div class="cc-quad @SystemStatusAggregator.SeverityCssClass(_snap.MemorySeverity)">
        <div class="cc-quad-hd">
            <span class="cc-quad-no">②</span> 메모리 릭 프로브
            <span class="cc-quad-badge">@SystemStatusAggregator.SeverityLabel(_snap.MemorySeverity)</span>
        </div>
        <div class="cc-quad-big">
            @(!_snap.MemoryPresent ? "미배선" : _snap.LeakSuspected ? "⚠ 누수 의심" : "✅ 정상")
        </div>
        <div class="cc-quad-rows">
            <div><span>활성 리스(핸들러)</span><b>@_snap.LiveLeases</b></div>
            <div><span>워킹셋</span><b>@(_snap.WorkingSetBytes / 1048576) MB</b></div>
            <div><span>관리 힙</span><b>@(_snap.ManagedHeapBytes / 1048576) MB</b></div>
            <div><span>Gen2 GC</span><b>@_snap.Gen2Collections</b></div>
        </div>
    </div>

    @* ③ 어댑티브 튜너 *@
    <div class="cc-quad @SystemStatusAggregator.SeverityCssClass(_snap.TunerSeverity)">
        <div class="cc-quad-hd">
            <span class="cc-quad-no">③</span> 어댑티브 튜너
            <span class="cc-quad-badge">@SystemStatusAggregator.SeverityLabel(_snap.TunerSeverity)</span>
        </div>
        <div class="cc-quad-big">
            @(!_snap.TunerPresent ? "미배선" : _snap.TunerFrozen ? "🔒 안전 동결" : "✅ 가동")
        </div>
        <div class="cc-quad-rows">
            <div><span>집행 슬라이스</span><b>@(_snap.TunerPresent ? _snap.TunerSlices.ToString() : "—")</b></div>
            <div><span>집행 시간</span><b>@(_snap.TunerPresent ? _snap.TunerDurationSec + "초" : "—")</b></div>
            <div><span>동결 여부</span><b>@(_snap.TunerFrozen ? "동결" : "정상")</b></div>
        </div>
    </div>

    @* ④ 파이프 연결 *@
    <div class="cc-quad @SystemStatusAggregator.SeverityCssClass(_snap.BridgeSeverity)">
        <div class="cc-quad-hd">
            <span class="cc-quad-no">④</span> 파이프 연결
            <span class="cc-quad-badge">@SystemStatusAggregator.SeverityLabel(_snap.BridgeSeverity)</span>
        </div>
        <div class="cc-quad-big">
            @(!_snap.BridgePresent ? "미배선" : _snap.BridgeAlive ? "🟢 연결됨" : "⚪ 대기")
        </div>
        <div class="cc-quad-rows">
            <div><span>키움 브리지</span><b>@(_snap.BridgePresent ? (_snap.BridgeAlive ? "프록시 연결" : "프록시 미연결") : "—")</b></div>
            <div><span>하트비트</span><b>@(_snap.BridgeAlive ? "수신 중" : "없음")</b></div>
        </div>
    </div>

</div>

@* ── 🧬 유전자 온실: 승인 대기 변이체 + 인간 서명 패널 ─────────────────────── *@
<div class="cc-greenhouse @(_snap.Promotion == PromotionState.PendingApproval ? "cc-gh-pending" : "")">
    <div class="cc-gh-hd">
        <span class="cc-gh-icon">🧬</span> 유전자 온실
        <span class="cc-gh-state">@GreenhouseLabel(_snap.Promotion)</span>
    </div>

    @{ var ghp = Greenhouse.Probe(); }
    <div class="cc-gh-live @(ghp.Running ? "cc-gh-live-on" : "")">
        <span class="cc-gh-dot"></span>
        @(ghp.Running ? "자율 배양 LIVE" : "휴면")
        · @ghp.Cycles.ToString("N0") 사이클 · 변이 @ghp.Mutations.ToString("N0")
        · 최고 F @ghp.BestFitness.ToString("F3") · 레짐 @ghp.Regime
        @if (ghp.Errors > 0)
        {
            <span class="cc-gh-err"> · 격리흡수 @ghp.Errors</span>
        }
        @if (Greenhouse.FeedStale)
        {
            <span class="cc-gh-err"> · ⚠️ 데이터 피드 단절(fail-closed)</span>
        }
        else if (Greenhouse.StalePauses > 0)
        {
            <span class="cc-gh-err"> · staleness 정지 @Greenhouse.StalePauses</span>
        }
    </div>

    @if (!_snap.GreenhousePresent)
    {
        <div class="cc-gh-idle">온실 미배선 — 배양 엔진 가동 대기</div>
    }
    else if (_snap.Promotion == PromotionState.PendingApproval)
    {
        <div class="cc-gh-candidate">
            <div class="cc-gh-badge">⚡ 승인 대기 변이체 출현</div>
            <div class="cc-gh-rows">
                <div><span>후보 전략 ID</span><b>@ShortId(_snap.CandidateSpecId)</b></div>
                <div><span>적응도 F</span><b>@_snap.CandidateFitness.ToString("F4")</b></div>
            </div>
            <div class="cc-gh-signoff">
                <input class="cc-gh-input" @bind="_signature" placeholder="지휘관 서명 입력" />
                <button class="addbtn" @onclick="ApproveCandidate">✍ 승인</button>
                <button class="addbtn cc-gh-reject" @onclick="RejectCandidate">✖ 거부</button>
            </div>
            @if (!string.IsNullOrEmpty(_signMsg))
            {
                <div class="cc-gh-msg">@_signMsg</div>
            }
        </div>
    }
    else
    {
        <div class="cc-gh-idle">현재 상태: @GreenhouseLabel(_snap.Promotion) — 승인 대기 변이체 없음</div>
    }

    @* S23-c — 비가역 거부 포렌식: 올바른 서명에도 1ms 단위 타이밍 만료로 튕긴 찰나를 정직하게 분별 *@
    @if (Agg.TryGetLatestRejection(out var _rej) && _rej.HasValue)
    {
        <div class="cc-gh-forensic">
            ❌ 스왑 거부 #@_rej.Seq (@RejectionStageLabel(_rej.Stage)) —
            승인 시점 대비 마켓 As-Of <b>@(_rej.LagMs.ToString("N0"))ms</b> 지연 감지
            (신선도 한도 @(_rej.WindowMs.ToString("N0"))ms 초과).
            <span class="cc-gh-forensic-note">시스템 오작동 아님 — 하드웨어 타이밍 만료(fail-closed). 게놈 @ShortId(_rej.SpecId)</span>
        </div>
    }
</div>

@* ── 👁️ 그림자 파이프라인: 실시간 연동 (눈 뜨고 손 묶임) ─────────────────────── *@
<div class="cc-shadow @(Shadow.Connected ? "cc-shadow-live" : "")">
    <div class="cc-shadow-hd">
        <span class="cc-shadow-icon">👁️</span> 그림자 파이프라인
        <span class="cc-shadow-state">@(Shadow.Connected ? "실시간 연동 중" : "프록시 대기")</span>
    </div>
    <div class="cc-shadow-rows">
        <div><span>실 틱 유입</span><b>@Shadow.TicksReceived.ToString("N0") 틱 · @Shadow.TicksPerSecond.ToString("F1")/s</b></div>
        <div><span>실측 마찰 Z</span><b>@Shadow.LastZ.ToString("F4")</b></div>
        <div><span>발주 차단 / 실위임</span><b>@Shadow.BlockedOrders.ToString("N0") 차단 · @Shadow.Delegated.ToString("N0") 위임</b></div>
        <div><span>마스터 플래그</span><b>@(Shadow.LiveArmed ? "ARMED ⚠️" : "OFF (실거래 0)")</b></div>
    </div>
    <div class="cc-shadow-note">🔒 2중 게이트(마스터 플래그 + 점화 허용) — 마스터 OFF 인 한 와이어 송신 0%</div>
</div>

@* ── 🔑 점화 제어반 (조종석 — 방아쇠 잠김) ──────────────────────────────────── *@
<div class="cc-ign @IgnitionLock.StageCss(Ignition.Stage)">
    <div class="cc-ign-hd">
        <span class="cc-ign-icon">🔑</span> 점화 제어반
        <span class="cc-ign-stage">@IgnitionLock.StageLabel(Ignition.Stage)</span>
    </div>
    <div class="cc-ign-banner">🔒 발주 밸브 미결속(-c) — 점화 단계와 무관하게 실거래 0%. 제어반 조종석(드라이런 박제).</div>
    <div class="cc-ign-rows">
        <div><span>현재 단계</span><b>@IgnitionLock.StageLabel(Ignition.Stage)</b></div>
        <div><span>1주 프로브 잔여</span><b>@Ignition.ProbeRemaining</b></div>
        <div><span>물리 발주 허용</span><b>@(Ignition.AllowPhysical() ? "허용(밸브 미결속)" : "차단")</b></div>
        <div><span>시스템 동결</span><b>@(Ignition.SystemFrozen ? "동결" : "정상")</b></div>
    </div>
    <div class="cc-ign-panel">
        <input class="cc-ign-input" @bind="_ignSignature" placeholder="지휘관 점화 서명" />
        <button class="addbtn" @onclick="ArmProbe">① 1주 프로브</button>
        <button class="addbtn" @onclick="ArmTimeBox">② 시간상자</button>
        <button class="addbtn" @onclick="ArmMaster">③ 마스터</button>
        <button class="addbtn cc-ign-retreat" @onclick="Retreat">⏹ 후퇴(Lock)</button>
    </div>
    @if (!string.IsNullOrEmpty(_ignMsg))
    {
        <div class="cc-ign-msg">@_ignMsg</div>
    }
</div>

@* ── 🛡️ 설정 무결성 (S22 #2 — 부팅 감사 스냅샷) ─────────────────────────────── *@
<div class="cc-cfg @(ConfigAudit.HasAnomaly ? "cc-cfg-warn" : "")">
    <div class="cc-cfg-hd">
        <span class="cc-cfg-icon">🛡️</span> 설정 무결성
        <span class="cc-cfg-badge">
            @(ConfigAudit.HasAnomaly ? $"⚠️ 설정 복구 {ConfigAudit.CoercedCount}건" : "✓ 정상")
        </span>
    </div>
    @if (ConfigAudit.HasAnomaly)
    {
        <div class="cc-cfg-banner">
            ⚠️ 잘못된 설정이 안전 값으로 클램프됐습니다 — 의도한 값이 무시됐을 수 있습니다.
        </div>
        @foreach (var c in ConfigAudit.Coerced)
        {
            <div class="cc-cfg-anomaly">· <b>@c.Label</b> (@c.Key) — @c.Detail → 안전값 <b>@c.Display</b></div>
        }
    }
    <div class="cc-cfg-snap">
        @foreach (var e in ConfigAudit.Entries)
        {
            <span class="cc-cfg-chip cc-cfg-@(e.Status.ToString().ToLowerInvariant())" title="@e.Detail">
                @e.Label: <b>@e.Display</b>
            </span>
        }
    </div>
    <div class="cc-cfg-note">env → DB → 폴백 검증 경로 · 로그 비밀 차폐 @(LogRedactor.Shared.Count)건 활성 · liveArmed 미노출(코드 게이트 전용)</div>
</div>

<style>
    .cc-tele { margin:0 0 16px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:14px 18px; }
    .cc-tele-hd { font-weight:700; display:flex; align-items:center; gap:10px; margin-bottom:10px; }
    .cc-tele-tag { font-size:9px; font-weight:800; letter-spacing:.1em; color:#fff; background:#3b82f6; border-radius:4px; padding:2px 6px; }
    .cc-tele-note { margin-left:auto; font-size:11px; color:var(--sub); font-weight:500; }
    .cc-tele-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:10px; }
    .cc-tele-cell { background:var(--card-2,#181f31); border-radius:8px; padding:9px 11px; display:flex; flex-direction:column; gap:4px; }
    .cc-tele-cell span { font-size:10.5px; color:var(--sub); }
    .cc-tele-cell b { font-size:15px; font-family:ui-monospace,monospace; color:var(--ink); }
    .cc-tele-cell b.ok { color:var(--up,#22c55e); }
    .cc-tele-cell b.warn { color:var(--down,#ef4444); }
    @@media (max-width:1100px){ .cc-tele-grid { grid-template-columns:repeat(3,1fr); } }
</style>

@code {
    private SystemHealthSnapshot _snap;

    private Timer?        _timer;
    private volatile bool _disposed;
    private int           _refreshPending;
    private ResourceLease? _lease;   // S18 #1 가드 — 타이머 리소스를 추적

    private string  _signature = "";  // 지휘관 서명 입력
    private string? _signMsg;          // 서명 처리 결과 메시지

    protected override void OnInitialized()
    {
        // 렌더 스로틀 타이머를 추적 리소스로 등록 — Dispose 시 반납해 누수 0 보장
        _lease = MemoryLeakGuard.Shared.Acquire("command-centre-timer");
        Refresh();
        _timer = new Timer(OnTimer, null, 3_000, 3_000);
    }

    private void OnTimer(object? _)
    {
        if (_disposed) return;
        if (Interlocked.CompareExchange(ref _refreshPending, 1, 0) != 0) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                Interlocked.Exchange(ref _refreshPending, 0);
                if (_disposed) return;
                Refresh();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch { }
    }

    private void RefreshNow() { Refresh(); StateHasChanged(); }

    private ForensicTelemetry _tele;   // S26-c — 락-프리 텔레메트리(경합 시 직전 프레임 유지 → 코어 무블록)
    private bool _teleEver;

    private void Refresh()
    {
        if (_disposed) return;
        try { _snap = Agg.Capture(); } catch { }
        // 코어를 절대 기다리지 않음 — TryRead 가 경합으로 false 면 _tele 를 갱신하지 않고 직전 프레임 유지.
        if (Telemetry.TryRead(out var t)) { _tele = t; if (t.HasValue) _teleEver = true; }
    }

    private static string OverallIcon(SystemSeverity s) => s switch
    {
        SystemSeverity.Critical => "🛑",
        SystemSeverity.Warning  => "⚠️",
        SystemSeverity.Notice   => "🔎",
        _                       => "🟢",
    };

    private static string OverallMessage(SystemHealthSnapshot s) => s.Overall switch
    {
        SystemSeverity.Critical => "하부 시스템이 동결 상태입니다 — 즉시 개입이 필요합니다.",
        SystemSeverity.Warning  => "리소스 경고가 감지되었습니다 — 점검을 권장합니다.",
        SystemSeverity.Notice   => "일부 센서가 대기/미배선 상태입니다.",
        _                       => "모든 핵심 비탈이 정상 범위입니다.",
    };

    // ── 인간 서명 패널 (PromotionGateway 직접 호출 — 검증된 로직 위임) ──────────
    private void ApproveCandidate()
    {
        bool ok = Gw.Approve(_signature ?? "");
        _signMsg = ok
            ? "✅ 승인 완료 — 활성화 대기 (실거래 결속은 S19 #5)"
            : "⛔ 서명 거부 — 컴플라이언스 원장에 즉시 박제됨";
        _signature = "";
        Refresh(); StateHasChanged();
    }

    private void RejectCandidate()
    {
        Gw.Reject("관제탑 수동 거부");
        _signMsg   = "후보 거부됨";
        _signature = "";
        Refresh(); StateHasChanged();
    }

    private static string GreenhouseLabel(PromotionState s) => s switch
    {
        PromotionState.PendingApproval => "승인 대기",
        PromotionState.Approved        => "승인됨",
        PromotionState.Active          => "가동 중",
        PromotionState.Candidate       => "배양 중",
        PromotionState.Rejected        => "거부됨",
        PromotionState.Sunsetted       => "일몰",
        _                              => "대기",
    };

    private static string ShortId(string? id) =>
        string.IsNullOrEmpty(id) ? "—" : (id.Length > 12 ? id[..12] : id);

    private static string RejectionStageLabel(RejectionStage s) => s switch
    {
        RejectionStage.Approve  => "승인 관문",
        RejectionStage.Activate => "활성 관문(비가역 직전)",
        _                       => "—",
    };

    // ── 점화 제어반 (IgnitionLock 직접 호출 — 검증된 FSM 위임. 밸브 미결속 = 실거래 0) ──
    private string  _ignSignature = "";
    private string? _ignMsg;

    private void ArmProbe()   => DoArm(IgnitionStage.ProbeReady, null);
    private void ArmTimeBox() => DoArm(IgnitionStage.TimeBoxOpen, System.TimeSpan.FromMinutes(30));
    private void ArmMaster()  => DoArm(IgnitionStage.MasterIgnited, null);

    private void DoArm(IgnitionStage stage, System.TimeSpan? window)
    {
        bool ok = Ignition.Arm(stage, _ignSignature ?? "", window);
        _ignMsg = ok
            ? $"✅ {IgnitionLock.StageLabel(stage)} 점화 — 단, 밸브 미결속(-c)이라 실거래 0"
            : "⛔ 점화 거부 — Locked 상태 아님 · 미인가 서명 · 비상 동결 중";
        _ignSignature = "";
        StateHasChanged();
    }

    private void Retreat()
    {
        Ignition.Lock("관제반 수동 후퇴");
        _ignMsg = "⏹ 후퇴 — 즉시 Locked 다운그레이드";
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Change(Timeout.Infinite, Timeout.Infinite);
        _timer?.Dispose();
        _lease?.Dispose();   // 리스 반납 — MemoryLeakGuard LiveCount 가 0으로 수렴
    }
}

