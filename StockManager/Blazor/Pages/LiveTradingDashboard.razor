@page "/trading/live"
@implements IDisposable
@inject OrderAttestationService Attestation
@inject KiwoomBridgeClient Bridge
@inject ExecutionBridgeBroker Broker
@inject ToastService Toasts
@using System.Threading
@using MS2E.Core
@using MS2E.Infrastructure

@* ════════════════════════════════════════════════════════════════════════
   비상 게이트웨이 오버레이 — EmergencyFreeze 시 전면 활성화
   ════════════════════════════════════════════════════════════════════════ *@
@if (Attestation.Mode == GatingMode.EmergencyFreeze)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(160,15,15,0.95);z-index:9500;display:flex;align-items:center;justify-content:center;overflow-y:auto">
        <div style="background:#0e0505;border:2px solid #e34d4d;border-radius:14px;padding:36px 44px;max-width:820px;width:92%;box-shadow:0 0 80px rgba(220,50,50,0.6);margin:24px auto">
            <div style="font-size:28px;font-weight:800;color:#ff3333;margin-bottom:8px">
                🚨 비상 게이트웨이 — EMERGENCY FREEZE
            </div>
            <div style="font-size:13px;color:#ffaaaa;margin-bottom:22px;line-height:1.7">
                실거래 체결 엔진이 이상 징후를 감지하여 <b>하드 동결</b> 상태입니다.<br/>
                <b>ExecutionBridgeBroker.Place()</b> 및 모든 자동화 주문이 전면 차단됩니다.<br/>
                브로커 잔고와 로컬 원장을 비교한 뒤 서명을 입력하여 게이트를 해제하세요.
            </div>
            <OrderReconcilePanel />
        </div>
    </div>
}

@* ════════════════════════════════════════════════════════════════════════
   페이지 헤더
   ════════════════════════════════════════════════════════════════════════ *@
<div class="top">
    <div class="hello">
        <h1>🎯 실거래 계기판 <span class="tag">LIVE TRADING DASHBOARD</span></h1>
        <p>KiwoomProxyHost와 실시간으로 연동되는 체결 모니터링 및 긴급 개입 터미널.</p>
    </div>
</div>

@* ════════════════════════════════════════════════════════════════════════
   연결 상태 바
   ════════════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 16px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
    @if (!_started)
    {
        <div style="display:flex;align-items:center;gap:8px;background:#1a1a1a;border:1.5px solid var(--line);border-radius:8px;padding:9px 16px">
            <span style="color:#888;font-size:14px">⬤</span>
            <div>
                <div style="font-size:12.5px;font-weight:700;color:var(--sub)">연결 없음</div>
                <div style="font-size:10.5px;color:var(--sub)">KiwoomProxyHost 대기 중</div>
            </div>
        </div>
        <button class="addbtn" disabled="@_connecting" @onclick="ConnectBridgeAsync">
            @(_connecting ? "연결 중…" : "키움 프록시 연결")
        </button>
    }
    else if (Bridge.IsProxyAlive)
    {
        <div style="display:flex;align-items:center;gap:8px;background:#0a1f0a;border:1.5px solid #2a7a2a;border-radius:8px;padding:9px 16px">
            <span style="color:#44cc44;font-size:14px;animation:blink 1.4s step-end infinite">⬤</span>
            <div>
                <div style="font-size:12.5px;font-weight:700;color:#44cc44">연결됨</div>
                <div style="font-size:10.5px;color:var(--sub)">KiwoomProxyHost 정상 동작 중</div>
            </div>
        </div>
        <span style="font-size:11px;color:var(--sub)">갱신 10fps · 하트비트 500ms</span>
    }
    else
    {
        <div style="display:flex;align-items:center;gap:8px;background:#1f0a0a;border:1.5px solid #e34d4d;border-radius:8px;padding:9px 16px">
            <span style="color:#ff4444;font-size:14px">⬤</span>
            <div>
                <div style="font-size:12.5px;font-weight:700;color:#ff4444">연결 끊김</div>
                <div style="font-size:10.5px;color:#cc7777">하트비트 타임아웃 — 앱을 재시작하세요</div>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(_connectError))
    {
        <span class="down" style="font-size:12px">@(_connectError)</span>
    }

    @* 정합성 배지 *@
    <div style="margin-left:auto">
        @if (Attestation.Mode == GatingMode.Normal)
        {
            <div style="display:flex;align-items:center;gap:6px;background:#0a1f0a;border:1.5px solid #2a7a2a;border-radius:6px;padding:7px 14px">
                <span style="font-size:15px">✅</span>
                <div style="font-size:11.5px;font-weight:700;color:#44cc44">정합성 NORMAL</div>
            </div>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:6px;background:#1f0a0a;border:1.5px solid #e34d4d;border-radius:6px;padding:7px 14px;cursor:pointer"
                 title="클릭 → 동결 해제 패널">
                <span style="font-size:15px;animation:blink .8s step-end infinite">🚨</span>
                <div style="font-size:11.5px;font-weight:700;color:#ff4444">FROZEN — 주문 차단 중</div>
            </div>
        }
    </div>
</div>

@* ════════════════════════════════════════════════════════════════════════
   계좌 모니터
   ════════════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 20px">
    <div style="font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--sub);margin-bottom:10px">
        계좌 모니터 <span style="background:var(--line);border-radius:3px;padding:2px 7px;margin-left:6px">ACCOUNT MONITOR</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
        @{
            var acct = _account;
        }
        <div class="panel" style="padding:14px 18px">
            <div style="font-size:10px;color:var(--sub);margin-bottom:6px;font-weight:700;letter-spacing:.05em">예수금</div>
            <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:var(--fg)">
                @(acct.Deposit > 0 ? $"₩{acct.Deposit:N0}" : "—")
            </div>
            <div style="font-size:10.5px;color:var(--sub);margin-top:4px">KRW 잔고</div>
        </div>
        <div class="panel" style="padding:14px 18px">
            <div style="font-size:10px;color:var(--sub);margin-bottom:6px;font-weight:700;letter-spacing:.05em">평가자산</div>
            <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:var(--fg)">
                @(acct.Equity > 0 ? $"₩{acct.Equity:N0}" : "—")
            </div>
            <div style="font-size:10.5px;color:var(--sub);margin-top:4px">포트폴리오 합계</div>
        </div>
        <div class="panel" style="padding:14px 18px">
            <div style="font-size:10px;color:var(--sub);margin-bottom:6px;font-weight:700;letter-spacing:.05em">미체결 주문</div>
            <div style="font-size:22px;font-weight:700;font-family:var(--mono);color:@(acct.UnfilledCount > 0 ? "var(--up,#2aae6a)" : "var(--fg)")">
                @(acct.UnfilledCount)건
            </div>
            <div style="font-size:10.5px;color:var(--sub);margin-top:4px">API 보고값</div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════════════════
   실거래 주문장
   ════════════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 20px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--sub)">
            실거래 주문장 <span style="background:var(--line);border-radius:3px;padding:2px 7px;margin-left:6px">LIVE ORDER BOOK</span>
        </div>
        @{
            int active = Broker.Audit.ActiveCount;
        }
        @if (active > 0)
        {
            <span style="background:#1a3a1a;border:1px solid #2a7a2a;border-radius:10px;padding:3px 10px;font-size:11px;color:#44cc44;font-weight:700">
                @(active)건 활성
            </span>
        }
    </div>
    @{
        var orders = Broker.Audit.GetAllOrders()
            .OrderByDescending(o => o.SubmittedAt)
            .ToList();
    }
    @if (orders.Count == 0)
    {
        <div class="panel" style="padding:20px;text-align:center;font-size:13px;color:var(--sub)">
            대기 주문 없음
        </div>
    }
    else
    {
        <div class="panel" style="padding:0;overflow:hidden">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead>
                    <tr style="color:var(--sub);font-size:10.5px;border-bottom:1px solid var(--line)">
                        <th style="text-align:left;padding:8px 14px">주문 ID</th>
                        <th style="text-align:left;padding:8px 10px">종목</th>
                        <th style="text-align:center;padding:8px 10px">방향</th>
                        <th style="text-align:right;padding:8px 10px">체결/주문</th>
                        <th style="text-align:right;padding:8px 10px">예상가</th>
                        <th style="text-align:center;padding:8px 10px">상태</th>
                        <th style="text-align:left;padding:8px 10px">제출 시각</th>
                        <th style="text-align:left;padding:8px 14px">게놈 ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr style="border-top:1px solid var(--line);background:@OrderRowBg(o.State)">
                            <td style="padding:7px 14px;font-family:var(--mono);font-size:11.5px;color:var(--sub)">
                                @(o.OrderId)
                            </td>
                            <td style="padding:7px 10px;font-family:var(--mono);font-weight:600">
                                @(o.Symbol)
                            </td>
                            <td style="padding:7px 10px;text-align:center">
                                @if (o.Side == PaperSide.Buy)
                                {
                                    <span class="up" style="font-size:12px;font-weight:700">매수 ▲</span>
                                }
                                else
                                {
                                    <span class="down" style="font-size:12px;font-weight:700">매도 ▼</span>
                                }
                            </td>
                            <td style="padding:7px 10px;text-align:right;font-family:var(--mono)">
                                <span style="color:@(o.FilledQty >= o.Quantity ? "var(--up,#2aae6a)" : "var(--sub)")">
                                    @(o.FilledQty)
                                </span>/@(o.Quantity)주
                            </td>
                            <td style="padding:7px 10px;text-align:right;font-family:var(--mono)">
                                @(o.ExpectedPrice == 0.0 ? "시장가" : o.ExpectedPrice.ToString("N0"))
                            </td>
                            <td style="padding:7px 10px;text-align:center">
                                <span style="font-size:11px;font-weight:700;padding:3px 8px;border-radius:4px;@StateBadgeStyle(o.State)">
                                    @(StateLabel(o.State))
                                </span>
                            </td>
                            <td style="padding:7px 10px;font-family:var(--mono);font-size:11px;color:var(--sub)">
                                @(o.SubmittedAt.ToLocalTime().ToString("HH:mm:ss.fff"))
                            </td>
                            <td style="padding:7px 14px;font-family:var(--mono);font-size:11.5px;color:var(--sub)">
                                @(o.GenomeId == 0 ? "—" : $"G-{o.GenomeId}")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ════════════════════════════════════════════════════════════════════════
   최근 체결 이력
   ════════════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 40px">
    <div style="font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--sub);margin-bottom:10px">
        최근 체결 이력 <span style="background:var(--line);border-radius:3px;padding:2px 7px;margin-left:6px">FILL HISTORY</span>
    </div>
    @{
        List<FillPayload> fills;
        lock (_fillLock) fills = _recentFills.ToList();
    }
    @if (fills.Count == 0)
    {
        <div class="panel" style="padding:20px;text-align:center;font-size:13px;color:var(--sub)">
            체결 이력 없음
        </div>
    }
    else
    {
        <div class="panel" style="padding:0;overflow:hidden">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead>
                    <tr style="color:var(--sub);font-size:10.5px;border-bottom:1px solid var(--line)">
                        <th style="text-align:left;padding:8px 14px">주문 ID</th>
                        <th style="text-align:left;padding:8px 10px">종목</th>
                        <th style="text-align:center;padding:8px 10px">방향</th>
                        <th style="text-align:right;padding:8px 10px">체결가</th>
                        <th style="text-align:right;padding:8px 10px">수량</th>
                        <th style="text-align:left;padding:8px 14px">시각 (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in fills)
                    {
                        <tr style="border-top:1px solid var(--line)">
                            <td style="padding:6px 14px;font-family:var(--mono);font-size:11.5px;color:var(--sub)">@(f.OrderId)</td>
                            <td style="padding:6px 10px;font-family:var(--mono);font-weight:600">
                                @(BridgeSerializer.FormatSymbol(f.SymbolCode))
                            </td>
                            <td style="padding:6px 10px;text-align:center">
                                @if (f.Side == 1)
                                { <span class="up" style="font-size:12px;font-weight:700">매수 ▲</span> }
                                else
                                { <span class="down" style="font-size:12px;font-weight:700">매도 ▼</span> }
                            </td>
                            <td style="padding:6px 10px;text-align:right;font-family:var(--mono)">
                                @(f.FillPrice.ToString("N0"))
                            </td>
                            <td style="padding:6px 10px;text-align:right;font-family:var(--mono)">
                                @(f.FillQty)주
                            </td>
                            <td style="padding:6px 14px;font-family:var(--mono);font-size:11px;color:var(--sub)">
                                @(new DateTime(f.TimestampTicks > 0 ? f.TimestampTicks : DateTime.UtcNow.Ticks, DateTimeKind.Utc).ToString("HH:mm:ss.fff"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    // ── 상태 ──────────────────────────────────────────────────────────────
    private bool        _connecting;
    private bool        _started;
    private string?     _connectError;
    private AccountPayload _account;

    // 체결 이력 (최근 20건, 링 버퍼)
    private readonly List<FillPayload> _recentFills = new();
    private readonly object            _fillLock    = new();
    private const    int               MaxFills     = 20;

    // 10fps 리프레시 타이머 (렌더링 부하 제어)
    private Timer? _renderTimer;
    private int    _dirty; // 0=clean, 1=dirty  (Interlocked로 원자적 조작)

    // ── 생명주기 ──────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        Bridge.FillReceived    += OnFill;
        Bridge.AccountReceived += OnAccount;
        Bridge.ProxyLost       += OnProxyLost;

        // 10fps 주기로 dirty 플래그 확인 → StateHasChanged 호출
        _renderTimer = new Timer(_ =>
        {
            if (Interlocked.Exchange(ref _dirty, 0) == 1)
                _ = InvokeAsync(StateHasChanged);
        }, null, 0, 100);
    }

    public void Dispose()
    {
        _renderTimer?.Dispose();
        Bridge.FillReceived    -= OnFill;
        Bridge.AccountReceived -= OnAccount;
        Bridge.ProxyLost       -= OnProxyLost;
    }

    // ── 이벤트 핸들러 ─────────────────────────────────────────────────────

    private void OnFill(FillPayload fill)
    {
        lock (_fillLock)
        {
            _recentFills.Insert(0, fill);
            if (_recentFills.Count > MaxFills)
                _recentFills.RemoveAt(_recentFills.Count - 1);
        }
        Interlocked.Exchange(ref _dirty, 1);
    }

    private void OnAccount(AccountPayload acct)
    {
        _account = acct;
        Interlocked.Exchange(ref _dirty, 1);
    }

    // ProxyLost는 즉시 렌더 (연결 상태 표시 즉각 반영)
    private void OnProxyLost() => _ = InvokeAsync(StateHasChanged);

    // ── 브릿지 연결 ───────────────────────────────────────────────────────

    private async Task ConnectBridgeAsync()
    {
        _connecting = true;
        _connectError = null;
        StateHasChanged();
        try
        {
            await Bridge.ConnectAsync();
            _started = true;
            // StartAsync: 3개 루프(ReadLoop/DispatchLoop/HeartbeatWatch) 병렬 실행 — fire-and-forget
            _ = Bridge.StartAsync();
            Toasts.Success("브릿지 연결", "KiwoomProxyHost에 연결되었습니다.");
        }
        catch (Exception ex)
        {
            _connectError = ex.Message;
            Toasts.Warning("연결 실패", ex.Message);
        }
        finally
        {
            _connecting = false;
            StateHasChanged();
        }
    }

    // ── 주문 상태 표시 헬퍼 ───────────────────────────────────────────────

    private static string OrderRowBg(PendingOrderState s) => s switch
    {
        PendingOrderState.Pending     => "rgba(255,200,50,0.05)",
        PendingOrderState.PartialFill => "rgba(50,150,255,0.06)",
        PendingOrderState.Filled      => "rgba(42,174,106,0.07)",
        PendingOrderState.Rejected    => "rgba(227,77,77,0.08)",
        PendingOrderState.Cancelled   => "transparent",
        _                             => "transparent",
    };

    private static string StateBadgeStyle(PendingOrderState s) => s switch
    {
        PendingOrderState.Pending     => "background:#2a2200;color:#d4a017;border:1px solid #665500;",
        PendingOrderState.PartialFill => "background:#001a3a;color:#6699ff;border:1px solid #003388;",
        PendingOrderState.Filled      => "background:#0a1f0a;color:#44cc44;border:1px solid #2a7a2a;",
        PendingOrderState.Rejected    => "background:#1f0a0a;color:#ff6666;border:1px solid #7a2020;",
        PendingOrderState.Cancelled   => "background:transparent;color:var(--sub);border:1px solid var(--line);",
        _                             => "",
    };

    private static string StateLabel(PendingOrderState s) => s switch
    {
        PendingOrderState.Pending     => "대기",
        PendingOrderState.PartialFill => "부분체결",
        PendingOrderState.Filled      => "체결완료",
        PendingOrderState.Rejected    => "거부",
        PendingOrderState.Cancelled   => "취소",
        _                             => s.ToString(),
    };
}

<style>
    @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
</style>
