@* ============================================================================
   BrokerConnectionPage.razor — v11.3.0: 증권사별 연결 화면 (사이드바 '증권사 연결' 그룹)
     증권사(토스/한국투자/LS)별 전용 연결 화면. Open API 자격증명을 DPAPI 암호화 저장 → 연결 테스트
     (UniversalBrokerGatewayMesh 조회 전용 경유) → 포트폴리오 열기. 라우트 파라미터로 증권사 전환.
     ★평문 디스크/JSON 미기록·입력 즉시 소거. ★연결 테스트는 실 토큰/엔드포인트·물리 무장 전엔 정직하게
       fail-closed(미동기화)만 표시하며 가짜 잔고를 생성하지 않는다(liveArmed:false). 기존 DI 서비스 재사용.
   ============================================================================ *@
@page "/brokers"
@page "/brokers/{Broker}"
@using StockManager.Common
@inject SecurityAssetVault Vault
@inject UniversalBrokerGatewayMesh Mesh
@inject NavigationManager Nav

<div class="bc-wrap">
    <div class="bc-head">
        <div class="bc-title">🔗 증권사 연결</div>
        <div class="bc-sub">증권사 Open API 자격증명을 안전하게 연결(DPAPI 암호화·평문 미기록)하고 연결 상태를 확인합니다.
            ★물리 이중 키 무장 전에는 조회 전용으로만 동작하며 실물 발주는 100% Veto 됩니다(liveArmed:false).</div>
    </div>

    @* ── 증권사 선택 탭 ── *@
    <div class="bc-tabs" role="tablist">
        @foreach (var t in _brokers)
        {
            <a class="bc-tab @(t.Key == _active.Key ? "active" : "")" href="/brokers/@t.Key"
               style="@(t.Key == _active.Key ? $"--accent:{t.Accent}" : "")">
                <span class="bc-tic">@t.Icon</span>
                <span class="bc-tnm">@t.Name</span>
                <span class="bc-dot @DotClass(t)" title="@DotTitle(t)"></span>
            </a>
        }
    </div>

    @* ── 활성 증권사 연결 카드 ── *@
    <div class="bc-card" style="--accent:@_active.Accent">
        <div class="bc-bhead">
            <span class="bc-bic">@_active.Icon</span>
            <span class="bc-bnm">@_active.Name</span>
            <span class="bc-state @StateClass()">@StateLabel()</span>
        </div>
        <div class="bc-hint">ℹ️ @_active.Hint</div>

        <div class="bc-statrow">
            <span class="bc-stat">자격증명 <b class="@(_stored ? "on" : "off")">@(_stored ? "저장됨 🔒" : "미저장")</b></span>
            <span class="bc-stat">조회 어댑터 <b class="@(_registered ? "on" : "off")">@(_registered ? "등록됨" : "미등록")</b></span>
            <span class="bc-stat">동기화 <b class="@(_connected ? "on" : "off")">@(_connected ? "연결됨" : "미연결")</b></span>
        </div>

        <div class="bc-grid">
            <label class="bc-field">
                <span class="bc-lab">@_active.LabelApiKey</span>
                <input class="bc-in" @bind="_active.ApiKey" placeholder="@(_active.LabelApiKey) 입력" type="password" autocomplete="off" />
            </label>
            <label class="bc-field">
                <span class="bc-lab">@_active.LabelSecret</span>
                <input class="bc-in" @bind="_active.Secret" placeholder="@(_active.LabelSecret) 입력" type="password" autocomplete="off" />
            </label>
            <label class="bc-field">
                <span class="bc-lab">금융기관 / 은행</span>
                <select class="bc-in bc-sel" @bind="_active.BankCode">
                    @foreach (var bk in _banks)
                    {
                        <option value="@bk.Code">@bk.Name (@bk.Code)</option>
                    }
                </select>
            </label>
            <label class="bc-field">
                <span class="bc-lab">@_active.LabelAccount</span>
                <input class="bc-in" @bind="_active.Account" placeholder="@(_active.LabelAccount) 입력" autocomplete="off" />
            </label>
        </div>

        <div class="bc-actions">
            <button class="bc-btn primary" @onclick="Save">🔐 저장 및 연결</button>
            <button class="bc-btn" disabled="@_testing" @onclick="Test">@(_testing ? "테스트 중…" : "⚡ 연결 테스트")</button>
            <button class="bc-btn ghost" @onclick="OpenPortfolio">📂 포트폴리오 열기</button>
        </div>

        @if (!string.IsNullOrEmpty(_saveMsg))
        {
            <div class="bc-toast @(_saveOk ? "ok" : "bad")" @key="_saveTick">@_saveMsg</div>
        }
        @if (!string.IsNullOrEmpty(_testMsg))
        {
            <div class="bc-badge @(_testOk ? "ok" : "warn")" @key="_testTick">@_testMsg</div>
        }
    </div>

    <div class="bc-note">🔒 자격증명은 <code>SecurityAssetVault</code>(DPAPI CurrentUser at-rest)에 암호화 저장되며, 복호화는 물리 무장 상태에서만 허용됩니다.
        조회는 <code>UniversalBrokerGatewayMesh</code>(발주 메서드 없음), 실물 발주는 <code>GenesisLiveIgnitionGateway</code>(이중 물리 키 인터락)을 반드시 경유합니다.</div>
</div>

@code {
    [Parameter] public string? Broker { get; set; }

    private sealed class BrokerMeta
    {
        public string Key = "";
        public BrokerId Id;
        public string Name = "", Icon = "", Accent = "";
        public string LabelApiKey = "API Key", LabelSecret = "App Secret", LabelAccount = "계좌번호", Hint = "";
        public string ApiKey = "", Secret = "", Account = "", BankCode = "";
    }

    private static readonly (string Code, string Name)[] _banks =
    {
        ("029", "토스증권"), ("007", "한국투자증권"), ("078", "LS증권"),
        ("230", "미래에셋증권"), ("264", "키움증권"), ("240", "삼성증권"),
        ("092", "토스뱅크"), ("004", "KB국민은행"), ("088", "신한은행"),
        ("011", "NH농협은행"), ("020", "우리은행"), ("081", "하나은행"),
        ("003", "IBK기업은행"), ("090", "카카오뱅크"),
    };

    private readonly BrokerMeta[] _brokers =
    {
        new() { Key = "toss", Id = BrokerId.Toss, Name = "토스증권", Icon = "🔷", Accent = "#3182f6",
                LabelApiKey = "API Key (Client ID)", LabelSecret = "App Secret (Client Secret)", LabelAccount = "사용자 ID 또는 계좌 ID",
                Hint = "토스증권 Open API 센터에서 발급받은 Client ID/Secret을 입력하세요.", BankCode = "029" },
        new() { Key = "kis", Id = BrokerId.Kis, Name = "한국투자증권 (KIS)", Icon = "🔶", Accent = "#f5a623",
                LabelApiKey = "App Key", LabelSecret = "App Secret", LabelAccount = "종합계좌번호 (8자리)",
                Hint = "한국투자증권 KIS Developers 포털에서 발급한 App Key/App Secret과 종합계좌번호(앞 8자리)를 입력하세요.", BankCode = "007" },
        new() { Key = "ls", Id = BrokerId.Ls, Name = "LS증권", Icon = "🟢", Accent = "#22a06b",
                LabelApiKey = "App Key", LabelSecret = "App Secret", LabelAccount = "계좌번호",
                Hint = "LS증권 Open API 포털에서 발급한 App Key/App Secret과 계좌번호를 입력하세요.", BankCode = "078" },
    };

    private BrokerMeta _active = default!;
    private bool _stored, _registered, _connected;
    private bool _saveOk, _testOk, _testing;
    private string _saveMsg = "", _testMsg = "";
    private int _saveTick, _testTick;

    protected override void OnParametersSet()
    {
        string key = (Broker ?? "toss").Trim().ToLowerInvariant();
        _active = Array.Find(_brokers, x => x.Key == key) ?? _brokers[0];
        _saveMsg = ""; _testMsg = "";   // 증권사 전환 시 이전 알림 정리
        RefreshStatus();
    }

    private void RefreshStatus()
    {
        _stored = Vault.Has($"{_active.Key}.apiKey");
        var port = Mesh.Get(_active.Id);
        _registered = port is not null;
        _connected = port?.Connected ?? false;
    }

    private void Save()
    {
        try
        {
            int stored = 0;
            if (!string.IsNullOrEmpty(_active.ApiKey)) { Vault.Store($"{_active.Key}.apiKey", _active.ApiKey.AsSpan()); stored++; }
            if (!string.IsNullOrEmpty(_active.Secret)) { Vault.Store($"{_active.Key}.secret", _active.Secret.AsSpan()); stored++; }
            if (!string.IsNullOrEmpty(_active.Account))
            {
                Vault.Store($"{_active.Key}.account", _active.Account.AsSpan()); stored++;
                Vault.Store($"{_active.Key}.bankCode", _active.BankCode.AsSpan());   // 계좌와 함께 봉인
            }
            _active.ApiKey = ""; _active.Secret = ""; _active.Account = "";   // 입력 즉시 소거(평문 잔류 최소화)
            _saveOk = stored > 0;
            _saveMsg = stored > 0
                ? $"✅ {_active.Name} 자격증명 {stored}건이 DPAPI 암호화·저장되었습니다(입력 소거 완료)."
                : "⚠ 입력값이 비어 있습니다 — API Key·App Secret·계좌번호 중 하나 이상을 입력하세요.";
        }
        catch (Exception ex) { _saveOk = false; _saveMsg = $"❌ 저장 실패: {ex.Message}"; }
        finally { _saveTick++; RefreshStatus(); }
    }

    private void Test()
    {
        _testing = true;
        try
        {
            var port = Mesh.Get(_active.Id);
            if (port is null)
            {
                _testOk = false;
                _testMsg = $"⚠ {_active.Name} 조회 어댑터가 메쉬에 미등록 — 연결 테스트 불가(현재 토스·KIS 조회 어댑터만 등록됨).";
            }
            else if (port.SyncNow())
            {
                _testOk = true;
                _testMsg = "✅ 연결 성공 (자산 동기화 완료)";
            }
            else
            {
                _testOk = false;
                _testMsg = Vault.Has($"{_active.Key}.apiKey")
                    ? "⛔ 연결 미완료 — 자격증명은 저장됨. 실 토큰·조회 엔드포인트 배선 및 물리 이중 키 무장 후 동기화됩니다(liveArmed:false fail-closed)."
                    : "⛔ 연결 미완료 — 먼저 [저장 및 연결]로 자격증명을 저장하세요. 이후 실 트랜스포트·무장 시 동기화(fail-closed).";
            }
        }
        catch (Exception ex) { _testOk = false; _testMsg = $"❌ 연결 테스트 오류: {ex.Message}"; }
        finally { _testing = false; _testTick++; RefreshStatus(); }
    }

    private void OpenPortfolio() => Nav.NavigateTo("/portfolio");

    private string DotClass(BrokerMeta t)
    {
        var port = Mesh.Get(t.Id);
        if (port?.Connected == true) return "on";
        return Vault.Has($"{t.Key}.apiKey") ? "stored" : "off";
    }
    private string DotTitle(BrokerMeta t) => DotClass(t) switch { "on" => "연결됨", "stored" => "자격증명 저장됨", _ => "미연결" };

    private string StateClass() => _connected ? "on" : _stored ? "stored" : "off";
    private string StateLabel() => _connected ? "🟢 연결됨" : _stored ? "🔒 자격증명 저장됨 (미연결)" : "⚪ 미연결";
}

<style>
    .bc-wrap{padding:20px 26px;max-width:960px}
    .bc-head{margin-bottom:14px}
    .bc-title{font-weight:800;font-size:19px}
    .bc-sub{color:#8b97ad;font-size:12.5px;line-height:1.6;margin-top:3px}

    .bc-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
    .bc-tab{display:flex;align-items:center;gap:8px;text-decoration:none;background:rgba(30,40,64,.35);border:1px solid #2a3550;border-radius:10px;padding:10px 15px;color:#8b97ad;font-size:13px;font-weight:600;transition:all .15s}
    .bc-tab:hover{color:#cdd9ef;border-color:#3a4869}
    .bc-tab.active{color:#fff;border-color:var(--accent,#3182f6);border-left:3px solid var(--accent,#3182f6);background:rgba(255,255,255,.04)}
    .bc-tic{font-size:15px}
    .bc-dot{width:8px;height:8px;border-radius:50%;background:#6b7688}
    .bc-dot.on{background:#22a06b;box-shadow:0 0 6px rgba(34,160,107,.7)}
    .bc-dot.stored{background:#f5a623}
    .bc-dot.off{background:#6b7688}

    .bc-card{background:rgba(30,40,64,.35);border:1px solid #2a3550;border-left:3px solid var(--accent,#3182f6);border-radius:10px;padding:18px}
    .bc-bhead{display:flex;align-items:center;gap:9px;margin-bottom:6px}
    .bc-bic{font-size:17px}
    .bc-bnm{font-weight:800;font-size:15px;color:#cdd9ef}
    .bc-state{margin-left:auto;font-size:12px;font-weight:700;padding:4px 10px;border-radius:20px}
    .bc-state.on{background:rgba(34,160,107,.18);color:#8fdca4}
    .bc-state.stored{background:rgba(245,166,35,.15);color:#f0c088}
    .bc-state.off{background:rgba(120,140,170,.12);color:#aeb9cf}
    .bc-hint{font-size:12px;color:#8b97ad;margin-bottom:12px;line-height:1.5}

    .bc-statrow{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px;font-size:12px;color:#8b97ad}
    .bc-stat b{margin-left:5px}
    .bc-stat b.on{color:#8fdca4}
    .bc-stat b.off{color:#8b97ad}

    .bc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
    .bc-field{display:flex;flex-direction:column;gap:5px}
    .bc-lab{font-size:11px;font-weight:700;color:#8b97ad}
    .bc-in{background:#0f1626;border:1px solid #2a3550;color:#dfe7f5;border-radius:6px;padding:9px 11px;font-family:monospace;font-size:12.5px;width:100%;box-sizing:border-box}
    .bc-in:focus{outline:none;border-color:var(--accent,#3182f6)}
    .bc-sel{font-family:inherit;cursor:pointer}

    .bc-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .bc-btn{background:transparent;color:#cdd9ef;border:1px solid #3a4869;border-radius:8px;padding:10px 16px;font-weight:600;font-size:13px;cursor:pointer;white-space:nowrap}
    .bc-btn:hover:not(:disabled){background:rgba(255,255,255,.05);border-color:var(--accent,#3182f6)}
    .bc-btn:disabled{opacity:.55;cursor:default}
    .bc-btn.primary{background:linear-gradient(180deg,#2d6be0,#1f52bb);color:#fff;border:0;font-weight:700}
    .bc-btn.primary:hover{filter:brightness(1.08)}
    .bc-btn.ghost{color:#8fb4ff}

    .bc-toast{margin-top:14px;padding:11px 14px;border-radius:8px;font-size:13px;font-weight:600}
    .bc-toast.ok{background:rgba(34,160,107,.16);border:1px solid rgba(34,160,107,.5);color:#a5e8bd}
    .bc-toast.bad{background:rgba(231,154,90,.14);border:1px solid rgba(231,154,90,.45);color:#f0c088}
    .bc-badge{margin-top:10px;padding:10px 14px;border-radius:8px;font-size:12.5px;font-weight:600}
    .bc-badge.ok{background:rgba(34,160,107,.2);border:1px solid rgba(34,160,107,.6);color:#a5e8bd;box-shadow:0 0 14px rgba(34,160,107,.25)}
    .bc-badge.warn{background:rgba(120,140,170,.12);border:1px solid #3a4869;color:#aeb9cf}

    .bc-note{margin-top:16px;color:#7b8aa4;font-size:12px;line-height:1.6}
    .bc-note code{background:#0f1626;padding:1px 6px;border-radius:4px;font-family:monospace;color:#cdd9ef}
</style>
