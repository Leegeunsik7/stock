@* ============================================================================
   PortfolioHub - 💼 포트폴리오 허브 (IA 개편 1단계, v3.29.0)
    가이드라인:
     ① 딥링크   : @page "/portfolio/{Tab?}" — /portfolio/risk 식 직접 진입
     ② 1회 로드 : 보유·환율·수익률을 허브에서 한 번만 수집(상태 호이스팅).
                  소비 탭(리밸런싱/리스크) 첫 진입 시 지연 로드, 이후 탭 전환은 재수집 0
     ③ Cascade  : 로드한 PortfolioData를 <CascadingValue>로 자식에 내려 중복 쿼리 제거
     ④ 부드러운 전환: URL만 바꾸고(NavigationManager) switch로 자식만 교체(전체 새로고침 X)
    기존 /portfolio·/assets·/rebalance·/risk 페이지는 @page를 떼고 이 허브의 탭(자식)으로 강등.
   ============================================================================ *@
@page "/portfolio"
@page "/portfolio/{Tab?}"
@inject IQuoteProvider Provider
@inject LocalDatabase Db
@inject FxConverter Fx
@inject NavigationManager Nav
@inject UniversalBrokerGatewayMesh Mesh
@inject IBrokerAccountPort Account

<div class="hubhead">
    <div class="hubtitle">💼 포트폴리오 허브</div>
    <span class="hubsub">한 번 수집한 보유·수익률을 모든 탭이 공유</span>
    @if (Cur is "rebalance" or "risk")
    {
        <label class="hubwin">분석 창
            <select class="srch" style="width:84px" @bind="_days" @bind:after="ReloadAsync">
                <option value="90">90일</option><option value="180">180일</option><option value="365">1년</option>
            </select>
        </label>
        <button class="ghost" disabled="@_busy" @onclick="ReloadAsync">@(_busy ? "수집 중…" : "🔄 새로고침")</button>
    }
</div>

@* ── 증권사 포트폴리오 불러오기(명세 4) — 조회 전용 메쉬 경유·liveArmed:false·fail-closed ── *@
<div class="brokerbar">
    <button class="brokerload" disabled="@_brokerBusy" @onclick="LoadBrokerPortfolio">
        @(_brokerBusy ? "동기화 중…" : "🔄 증권사 포트폴리오 불러오기")
    </button>
    @if (_brokerLoaded)
    {
        <span class="brokerbadge @(_brokerOk ? "ok" : "warn")">@_brokerMsg</span>
    }
    else
    {
        <span class="brokerhint">퀀텀 금고에 봉인된 자격증명으로 실시간 잔고·보유 종목을 불러옵니다(조회 전용·liveArmed:false).</span>
    }
</div>
@if (_brokerLoaded && _brokerOk)
{
    <div class="brokerpanel">
        <div class="bp-kpis">
            <div class="bp-kpi"><span class="bp-k">총평가</span><span class="bp-v">@Won(_snap.TotalEvalRaw)</span></div>
            <div class="bp-kpi"><span class="bp-k">총손익</span><span class="bp-v @(_snap.TotalPnlRaw >= 0 ? "up" : "down")">@Won(_snap.TotalPnlRaw)</span></div>
            <div class="bp-kpi"><span class="bp-k">예수금</span><span class="bp-v">@Won(_snap.DepositRaw)</span></div>
            <div class="bp-kpi"><span class="bp-k">매수가능</span><span class="bp-v">@Won(_snap.BuyingPowerRaw)</span></div>
            <div class="bp-kpi"><span class="bp-k">보유종목</span><span class="bp-v">@_snap.HoldingCount</span></div>
        </div>
        @if (_brokerHoldings.Count > 0)
        {
            <table class="bp-table">
                <thead><tr><th>종목(해시)</th><th>수량</th><th>평균단가</th><th>현재가</th><th>평가손익</th></tr></thead>
                <tbody>
                    @foreach (var h in _brokerHoldings)
                    {
                        <tr>
                            <td class="mono">x@(h.SymbolHash.ToString("X8"))@(h.IsOverseas ? " 🌐" : "")</td>
                            <td>@h.Quantity</td>
                            <td>@Won(h.AvgPriceRaw)</td>
                            <td>@Won(h.CurPriceRaw)</td>
                            <td class="@(h.UnrealizedPnlRaw >= 0 ? "up" : "down")">@Won(h.UnrealizedPnlRaw)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="bp-foot">※ 종목코드는 δ=0 FNV 해시로 보관됩니다(문자열 무할당). 실 종목명 해석은 운영자 심볼 맵 배선 시 표기됩니다.</div>
        }
    </div>
}

@* v4.64.0 — 실시간 지수·선물 스트립(코스피·코스닥·나스닥·나스닥선물·다우·S&P). GlobalIndexService 구독 재사용. *@
<IndexTickerBar />

<HubTabs Items="_tabs" Active="@Cur" OnSelect="Sel" />

@if (_busy && Cur is "rebalance" or "risk")
{
    <div style="color:var(--sub);padding:22px 28px">📡 보유 종목 시세·수익률 수집 중… (1회 로드 후 모든 탭이 공유합니다)</div>
}
else
{
    <CascadingValue Value="_data">
        @switch (Cur)
        {
            case "rebalance":
                <RebalancePage />
                break;
            case "risk":
                <RiskPage />
                break;
            case "assets":
                <TotalAssetPage />
                break;
            default:
                <PortfolioPage />
                break;
        }
    </CascadingValue>
}

@code {
    [Parameter] public string? Tab { get; set; }
    private string Cur => string.IsNullOrWhiteSpace(Tab) ? "holdings" : Tab!.ToLowerInvariant();

    private readonly (string, string)[] _tabs =
    {
        ("holdings", "보유·배분"), ("rebalance", "리밸런싱(MPT)"), ("risk", "리스크 분해"), ("assets", "총자산")
    };

    private PortfolioData _data = new();
    private bool _busy;
    private int _days = 180;

    private void Sel(string k) => Nav.NavigateTo(k == "holdings" ? "/portfolio" : $"/portfolio/{k}");

    // ② 지연 1회 로드: 수익률을 쓰는 탭(리밸런싱/리스크)에 처음 들어올 때만 수집, 이후 캐시 공유.
    //   (보유·총자산 탭은 자체 DB 로드 — 수익률 불필요)
    protected override async Task OnParametersSetAsync()
    {
        if ((Cur is "rebalance" or "risk") && !_data.Loaded && !_busy)
            await ReloadAsync();
    }

    // 상태 호이스팅 — 공용 로더 1회 호출, 새 인스턴스 할당으로 CascadingValue가 자식에 전파.
    private async Task ReloadAsync()
    {
        _busy = true; StateHasChanged();
        _data = await PortfolioData.LoadAsync(Provider, Db, Fx, _days);
        _busy = false; StateHasChanged();
    }

    // ── 증권사 포트폴리오 불러오기(명세 4) ─────────────────────────────
    private bool _brokerBusy, _brokerLoaded, _brokerOk;
    private string _brokerMsg = "";
    private TossAccountSnapshot _snap;
    private readonly List<TossHolding> _brokerHoldings = new();

    // ★조회 전용 메쉬 경유 1회 동기화 → 계좌/보유 스냅샷 렌더. 어댑터가 스텁(미인증)이면 fail-closed —
    //   실 토큰/엔드포인트 배선·물리 무장 전엔 '미동기화'만 표시하고 가짜 잔고를 절대 생성하지 않는다(liveArmed:false).
    private void LoadBrokerPortfolio()
    {
        _brokerBusy = true;
        try
        {
            int ok = Mesh.SyncAll();   // 전 브로커 1회 동기화(조회 전용·브로커 격리·발주 메서드 없음)
            if (Account.TryGetAccount(out _snap))
            {
                Span<TossHolding> buf = stackalloc TossHolding[256];
                int n = Account.GetHoldings(buf);
                _brokerHoldings.Clear();
                for (int i = 0; i < n; i++) _brokerHoldings.Add(buf[i]);
                _brokerOk = true;
                _brokerMsg = $"✅ 동기화 완료 — {ok}개 증권사 · 보유 {_snap.HoldingCount}종목";
            }
            else
            {
                _brokerOk = false;
                _brokerHoldings.Clear();
                _brokerMsg = "⛔ 동기화된 잔고 없음 — 증권사 자격증명 저장·실 조회 엔드포인트 배선·물리 무장 후 실시간 잔고가 로드됩니다(liveArmed:false fail-closed·가짜 데이터 미표시).";
            }
        }
        catch (Exception ex) { _brokerOk = false; _brokerMsg = $"❌ 불러오기 오류: {ex.Message}"; }
        finally { _brokerBusy = false; _brokerLoaded = true; }
    }

    private static string Won(long raw) => QMath.ToDecimal(raw).ToString("#,##0");
}

<style>
    .hubhead{display:flex;align-items:center;gap:12px;padding:18px 28px 2px;flex-wrap:wrap}
    .hubhead .hubtitle{font-weight:800;font-size:18px}
    .hubhead .hubsub{color:var(--sub);font-size:12px}
    .hubhead .hubwin{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--sub)}

    /* 명세 4 — 증권사 포트폴리오 불러오기 바/패널 */
    .brokerbar{display:flex;align-items:center;gap:12px;padding:6px 28px 4px;flex-wrap:wrap}
    .brokerload{background:linear-gradient(180deg,#2d6be0,#1f52bb);color:#fff;border:0;border-radius:8px;padding:8px 15px;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap}
    .brokerload:disabled{opacity:.55;cursor:default}
    .brokerhint{color:var(--sub);font-size:12px}
    .brokerbadge{font-size:12px;font-weight:600;padding:6px 11px;border-radius:7px}
    .brokerbadge.ok{background:rgba(34,160,107,.18);border:1px solid rgba(34,160,107,.55);color:#a5e8bd}
    .brokerbadge.warn{background:rgba(120,140,170,.12);border:1px solid #3a4869;color:#aeb9cf}
    .brokerpanel{margin:4px 28px 8px;border:1px solid var(--line,#2a3550);border-radius:10px;padding:14px 16px;background:rgba(30,40,64,.25)}
    .bp-kpis{display:flex;gap:22px;flex-wrap:wrap;margin-bottom:12px}
    .bp-kpi{display:flex;flex-direction:column;gap:2px}
    .bp-k{font-size:11px;color:var(--sub)}
    .bp-v{font-size:15px;font-weight:800}
    .bp-v.up,.bp-table td.up{color:var(--up)}
    .bp-v.down,.bp-table td.down{color:var(--down)}
    .bp-table{width:100%;border-collapse:collapse;font-size:12.5px}
    .bp-table th{text-align:right;color:var(--sub);font-weight:600;padding:6px 10px;border-bottom:1px solid var(--line,#2a3550)}
    .bp-table th:first-child{text-align:left}
    .bp-table td{text-align:right;padding:6px 10px;border-bottom:1px solid rgba(42,53,80,.5)}
    .bp-table td:first-child{text-align:left;font-family:monospace}
    .bp-foot{margin-top:8px;color:var(--sub);font-size:11px}
</style>
