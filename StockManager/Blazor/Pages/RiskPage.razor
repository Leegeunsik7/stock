@* 🧯 리스크 기여도 분해 — PortfolioHub의 탭(자식). 데이터는 허브에서 캐스케이딩(자체 수집 X). *@

<div class="hubbar">
    <div class="hubbar-t">🧯 리스크 기여도 분해 <span class="sub">변동성이 실제로 어디서 나오는가 + 리스크 패리티 (정보 제공용)</span></div>
</div>

<div style="padding:0 28px 40px;max-width:920px">
    <div style="background:color-mix(in srgb,var(--accent) 9%,transparent);border:1px solid var(--accent);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--sub);margin:14px 0 16px">
        ℹ️ 위험 비중(합 100%)은 공분산 기반 Euler 분해입니다. <b>비중 ≠ 위험 비중</b> — 비중보다 위험 비중이 큰 종목이 숨은 집중원.
        리스크 패리티는 각 종목이 <b>동일한 위험</b>을 지도록 한 대안 비중입니다(투자 권유 아님).
    </div>

    @if (_msg.Length > 0) { <div style="color:var(--sub);padding:20px">@_msg</div> }
    else if (_rep is { IsValid: true })
    {
        <div style="background:color-mix(in srgb,var(--accent) 7%,transparent);border-left:3px solid var(--accent);border-radius:8px;padding:11px 14px;margin-bottom:14px;font-size:13.5px;font-weight:600">@_rep.Insight</div>

        <div class="kpis" style="grid-template-columns:repeat(3,1fr);margin:0 0 16px">
            <div class="kpi"><div class="k-lab">포트폴리오 변동성(연)</div><div class="k-val">@_rep.PortfolioVolPct.ToString("0.0")%</div></div>
            <div class="kpi"><div class="k-lab">최대 위험 집중</div><div class="k-val @(_rep.TopConcentrationPct>=40?"down":"")">@_rep.TopConcentrationPct.ToString("0")%</div></div>
            <div class="kpi"><div class="k-lab">집중 종목</div><div class="k-val" style="font-size:17px">@_rep.TopName</div></div>
        </div>

        <div class="panel" style="margin-bottom:16px">
            <div class="panel-h">⚖️ 비중 vs 위험 비중 <span class="tag">EULER</span></div>
            <table class="ctbl dense">
                <thead><tr>
                    <th>종목</th><th style="text-align:right">비중</th><th style="text-align:right">위험 비중</th>
                    <th style="width:42%">위험 비중 막대</th><th style="text-align:right">배율</th>
                </tr></thead>
                <tbody>
                @foreach (var c in _rep.Contributions)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td class="num" style="text-align:right;color:var(--sub)">@c.WeightPct.ToString("0.0")%</td>
                        <td class="num" style="text-align:right;font-weight:700">@c.RiskContribPct.ToString("0.0")%</td>
                        <td>
                            <div style="background:var(--line);border-radius:5px;height:9px;overflow:hidden">
                                <div style="height:100%;width:@(Math.Min(100,c.RiskContribPct).ToString("0.0"))%;background:@(c.Ratio>1.2?"var(--down)":"var(--accent)")"></div>
                            </div>
                        </td>
                        <td class="num @(c.Ratio>1.2?"down":(c.Ratio<0.85?"up":""))" style="text-align:right">@c.Ratio.ToString("0.00")×</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="panel-h">🎯 리스크 패리티 제안 (동일 위험 분담) <span class="tag">RISK PARITY</span></div>
            <table class="ctbl dense">
                <thead><tr>
                    <th>종목</th><th style="text-align:right">현재 비중</th><th style="text-align:right">패리티 비중</th><th style="text-align:right">차이</th>
                </tr></thead>
                <tbody>
                @for (int i = 0; i < _rep.Names.Length; i++)
                {
                    var cur = i < _rep.CurrentWeights.Length ? _rep.CurrentWeights[i] : 0;
                    var rp = i < _rep.RiskParityWeights.Length ? _rep.RiskParityWeights[i] : 0;
                    var diff = rp - cur;
                    <tr>
                        <td>@_rep.Names[i]</td>
                        <td class="num" style="text-align:right;color:var(--sub)">@((cur*100).ToString("0.0"))%</td>
                        <td class="num" style="text-align:right;font-weight:700">@((rp*100).ToString("0.0"))%</td>
                        <td class="num @(diff>=0?"up":"down")" style="text-align:right">@((diff*100).ToString("+0.0;-0.0"))%p</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="sub" style="font-size:11.5px;margin-top:8px">@_rep.Note · 배율 = 위험비중/비중 (1.2× 초과면 비중 대비 위험이 큼)</div>
    }
</div>

@code {
    [CascadingParameter] public PortfolioData? Data { get; set; }

    private string _msg = "";
    private RiskReport? _rep;

    // 캐스케이드된 데이터가 갱신될 때 동기 재계산(순수 모듈). 자체 수집 없음.
    protected override void OnParametersSet()
    {
        if (Data is null) { _msg = "포트폴리오 허브에서 열어 주세요."; _rep = null; return; }
        if (!Data.Loaded) { _msg = Data.Error.Length > 0 ? Data.Error : "데이터 수집 중…"; _rep = null; return; }

        _rep = RiskAttribution.Analyze(Data.R, Data.Names, Data.Weights);
        if (!_rep.IsValid) { _msg = _rep.Note; _rep = null; return; }
        _msg = "";
    }
}

<style>
    .hubbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 28px 0}
    .hubbar-t{font-weight:800;font-size:16px;margin-right:auto}
    .hubbar-t .sub{font-weight:400;font-size:12px;color:var(--sub);margin-left:8px}
</style>
