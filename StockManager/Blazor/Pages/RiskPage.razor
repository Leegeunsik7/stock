@page "/risk"
@inject IQuoteProvider Provider
@inject LocalDatabase Db
@inject FxConverter Fx

<div class="top">
    <div class="hello"><h1>🧯 리스크 기여도 분해</h1><p>비중이 아니라 "변동성이 실제로 어디서 나오는가"를 분해 + 리스크 패리티 대안 (정보 제공용)</p></div>
    <select class="srch" style="width:90px" @bind="_days"><option value="90">90일</option><option value="180">180일</option><option value="365">1년</option></select>
    <button class="addbtn" style="margin:0 16px 0 8px" disabled="@_busy" @onclick="RunAsync">@(_busy?"분해 중…":"🔄 분석")</button>
</div>

<div style="padding:0 28px 40px;max-width:920px">
    <div style="background:color-mix(in srgb,var(--accent) 9%,transparent);border:1px solid var(--accent);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--sub);margin-bottom:16px">
        ℹ️ 위험 비중(합 100%)은 공분산 기반 Euler 분해입니다. <b>비중 ≠ 위험 비중</b> — 비중보다 위험 비중이 큰 종목이 숨은 집중원.
        리스크 패리티는 각 종목이 <b>동일한 위험</b>을 지도록 한 대안 비중입니다(투자 권유 아님).
    </div>

    @if (_busy) { <div style="color:var(--sub);padding:20px">시세 수집 + 리스크 분해 중…</div> }
    else if (_msg.Length > 0) { <div style="color:var(--sub);padding:20px">@_msg</div> }
    else if (_rep is { IsValid: true })
    {
        <div style="background:color-mix(in srgb,var(--accent) 7%,transparent);border-left:3px solid var(--accent);border-radius:8px;padding:11px 14px;margin-bottom:14px;font-size:13.5px;font-weight:600">@_rep.Insight</div>

        <div class="tiles" style="padding:0 0 16px;grid-template-columns:repeat(3,1fr)">
            <div class="tile k"><div class="lab">포트폴리오 변동성(연)</div><div class="val num">@_rep.PortfolioVolPct.ToString("0.0")%</div></div>
            <div class="tile d"><div class="lab">최대 위험 집중</div><div class="val num">@_rep.TopConcentrationPct.ToString("0")%</div></div>
            <div class="tile k"><div class="lab">집중 종목</div><div class="val num" style="font-size:15px">@_rep.TopName</div></div>
        </div>

        <div style="font-weight:700;margin:6px 0 8px">비중 vs 위험 비중</div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:16px">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                    <th style="text-align:left;padding:8px 12px">종목</th>
                    <th style="text-align:right;padding:8px 12px">비중</th>
                    <th style="text-align:right;padding:8px 12px">위험 비중</th>
                    <th style="text-align:left;padding:8px 12px;width:42%">위험 비중 막대</th>
                    <th style="text-align:right;padding:8px 12px">배율</th>
                </tr></thead>
                <tbody>
                @foreach (var c in _rep.Contributions)
                {
                    <tr style="border-top:1px solid var(--line)">
                        <td style="padding:7px 12px">@c.Name</td>
                        <td style="text-align:right;padding:7px 12px;color:var(--sub)">@c.WeightPct.ToString("0.0")%</td>
                        <td style="text-align:right;padding:7px 12px;font-weight:700">@c.RiskContribPct.ToString("0.0")%</td>
                        <td style="padding:7px 12px">
                            <div style="background:var(--line);border-radius:5px;height:10px;position:relative;overflow:hidden">
                                <div style="position:absolute;left:0;top:0;height:100%;width:@(Math.Min(100,c.RiskContribPct).ToString("0.0"))%;background:@(c.Ratio>1.2?"var(--down)":"var(--accent)")"></div>
                            </div>
                        </td>
                        <td style="text-align:right;padding:7px 12px" class="@(c.Ratio>1.2?"down":(c.Ratio<0.85?"up":""))">@c.Ratio.ToString("0.00")×</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div style="font-weight:700;margin:6px 0 8px">리스크 패리티 제안 (동일 위험 분담)</div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                    <th style="text-align:left;padding:8px 12px">종목</th>
                    <th style="text-align:right;padding:8px 12px">현재 비중</th>
                    <th style="text-align:right;padding:8px 12px">패리티 비중</th>
                    <th style="text-align:right;padding:8px 12px">차이</th>
                </tr></thead>
                <tbody>
                @for (int i = 0; i < _rep.Names.Length; i++)
                {
                    var cur = i < _rep.CurrentWeights.Length ? _rep.CurrentWeights[i] : 0;
                    var rp = i < _rep.RiskParityWeights.Length ? _rep.RiskParityWeights[i] : 0;
                    var diff = rp - cur;
                    <tr style="border-top:1px solid var(--line)">
                        <td style="padding:7px 12px">@_rep.Names[i]</td>
                        <td style="text-align:right;padding:7px 12px;color:var(--sub)">@(( cur*100).ToString("0.0"))%</td>
                        <td style="text-align:right;padding:7px 12px;font-weight:700">@(( rp*100).ToString("0.0"))%</td>
                        <td style="text-align:right;padding:7px 12px" class="@(diff>=0?"up":"down")">@(( diff*100).ToString("+0.0;-0.0"))%p</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="sub" style="font-size:11.5px;margin-top:8px">@_rep.Note · 배율 = 위험비중/비중 (1.2× 초과면 비중 대비 위험이 큼)</div>
    }
</div>

@code {
    private int _days = 180;
    private bool _busy;
    private string _msg = "";
    private RiskReport? _rep;

    protected override async Task OnInitializedAsync() => await RunAsync();

    private async Task RunAsync()
    {
        _busy = true; _msg = ""; _rep = null; StateHasChanged();
        try
        {
            var holdings = Db.GetAllHoldings();
            if (holdings.Count == 0) { _msg = "보유 종목이 없습니다. 포트폴리오에 종목을 추가하세요."; return; }

            decimal usd = 1380m; try { usd = await Fx.GetUsdKrwAsync(); } catch { }
            var returns = await CorrelationAnalyzer.CollectReturnsAsync(
                Provider, holdings.Select(h => (h.Symbol, h.Market)), Math.Max(30, _days));

            var used = holdings.Where(h => returns.ContainsKey(h.Symbol) && returns[h.Symbol].Count >= 2).ToList();
            if (used.Count == 0) { _msg = "수익률 히스토리를 수집하지 못했습니다(시세 제공자 확인)."; return; }

            var R = used.Select(h => returns[h.Symbol].Select(d => (double)d).ToArray()).ToArray();
            var names = used.Select(h => string.IsNullOrWhiteSpace(h.Name) ? h.Symbol : h.Name).ToArray();
            var rawW = used.Select(h => (double)(h.CurrentPrice * h.Quantity * (h.Currency == Currency.USD ? usd : 1m))).ToArray();
            var sumW = rawW.Sum();
            var weights = sumW > 0 ? rawW.Select(w => w / sumW).ToArray() : rawW.Select(_ => 1.0 / rawW.Length).ToArray();

            _rep = RiskAttribution.Analyze(R, names, weights);
            if (!_rep.IsValid) { _msg = _rep.Note; _rep = null; }
        }
        catch (Exception ex) { _msg = "오류: " + ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }
}
