@page "/mirror"
@inject LocalDatabase Db
@inject IQuoteProvider Provider
@inject FxConverter Fx
@implements IDisposable
@using StockManager.Common
@using System.Data

<div class="top">
    <div class="hello">
        <h1>🪟 결정 품질 미러 <span class="tag">DECISION MIRROR</span></h1>
        <p>현재 보유 포지션 컨텍스트를 과거 행동편향 이력과 교차분석 — <b>지금 이 순간</b>의 의사결정 위험을 정량화합니다. 매매 지시가 아니라 판단 보조 정보입니다.</p>
    </div>
</div>

<div style="padding:0 28px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <button class="addbtn" disabled="@_busy" @onclick="Run">@(_busy ? "분석 중…" : "🪟 결정 미러 분석")</button>
    @if (_result != null)
    {
        <span class="sub" style="font-size:11.5px">@_result.Note</span>
    }
</div>

@if (!string.IsNullOrEmpty(_msg)) { <div style="padding:0 28px 14px;color:var(--sub)">@_msg</div> }

@if (_result != null)
{
    @* 포트폴리오 레벨 경고 *@
    @foreach (var pa in _result.PortfolioAlerts)
    {
        <div style="margin:0 28px 12px;padding:10px 14px;border-radius:8px;background:rgba(224,173,0,.12);border:1px solid rgba(224,173,0,.25)">
            <b style="color:var(--warn)">⚠️ @pa.Label</b>
            <span class="sub" style="font-size:12px;margin-left:8px">@pa.Evidence</span>
        </div>
    }

    @* 포트폴리오 평균 리스크 점수 *@
    <div style="padding:0 28px 20px;display:flex;align-items:center;gap:18px">
    @{
        var avgScore = _result.Signals.Count > 0
            ? (int)_result.Signals.Average(s => s.RiskScore) : 0;
        var (gColor, gLabel) = avgScore >= 61 ? ("var(--down)", "⚠️ 주의 필요") :
                               avgScore >= 26 ? ("var(--warn)", "💛 관찰 중") :
                               ("var(--up)", "✅ 양호");
    }
        <div style="width:72px;height:72px;border-radius:50%;border:4px solid @gColor;display:flex;flex-direction:column;align-items:center;justify-content:center">
            <b style="font-size:20px;color:@gColor">@avgScore</b>
            <span style="font-size:9px;color:var(--sub)">포트폴리오</span>
        </div>
        <div>
            <div style="font-size:14px;font-weight:600;color:@gColor">@gLabel</div>
            <div class="sub" style="font-size:12px">@(_result.Signals.Count)개 보유종목 분석 · 위험도 0=양호, 100=경고</div>
        </div>
    </div>

    @* 종목별 카드 *@
    <div style="padding:0 28px 40px;display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px">
        @foreach (var sig in _result.Signals)
        {
            var (sc, sl) = sig.RiskScore >= 61 ? ("var(--down)", "경고") :
                           sig.RiskScore >= 26 ? ("var(--warn)", "주의") : ("var(--up)", "양호");
            <div class="panel" style="border-left:3px solid @sc">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
                    <div style="width:42px;height:42px;border-radius:50%;border:3px solid @sc;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0">
                        <b style="font-size:13px;color:@sc">@sig.RiskScore</b>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700">@sig.Symbol <span class="sub" style="font-size:11.5px">@sig.Name</span></div>
                        <div style="font-size:11.5px">
                            <span class="@(sig.PnlPct >= 0 ? "up" : "down")">@sig.PnlPct.ToString("+0.00;-0.00;0.00")%</span>
                            <span class="sub" style="margin-left:8px">보유 @(sig.HoldDays)일</span>
                        </div>
                    </div>
                    <span style="margin-left:auto;font-size:11px;font-weight:700;color:@sc">@sl</span>
                </div>

                @if (sig.Alerts.Count == 0)
                {
                    <div class="sub" style="font-size:12px;padding:4px 0">이 포지션에서 감지된 행동 편향 패턴이 없습니다.</div>
                }
                @foreach (var a in sig.Alerts)
                {
                    var (ac, ai) = a.Severity switch
                    {
                        AlertSeverity.High    => ("rgba(224,82,77,.15)", "🔴"),
                        AlertSeverity.Warning => ("rgba(224,173,0,.12)", "🟡"),
                        _                    => ("rgba(120,120,120,.1)", "🔵")
                    };
                    <div style="margin-top:6px;padding:7px 10px;border-radius:6px;background:@ac;font-size:12px">
                        <b>@ai @a.Label</b>
                        <div class="sub" style="font-size:11.5px;margin-top:2px">@a.Evidence</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="sub" style="padding:0 28px 28px;font-size:11.5px">
        ℹ️ 결정 품질 미러는 과거 행동 패턴을 기반으로 한 참고 정보이며, <b>매수·매도 지시나 자동 주문이 아닙니다.</b>
        추격/패닉 편향은 과거 거래에 가격 맥락(회고 코치 실행)이 있어야 활성화됩니다.
    </div>
}

@code {
    private bool _busy, _disposed;
    private string _msg = "";
    private MirrorResult? _result;
    private System.Threading.CancellationTokenSource? _cts;

    public void Dispose() { _disposed = true; try { _cts?.Cancel(); _cts?.Dispose(); } catch { } }

    private async Task Run()
    {
        if (_busy) return;
        _busy = true; _msg = "보유 종목 및 거래 이력 분석 중…"; _result = null;
        _cts?.Dispose(); _cts = new();
        try
        {
            var (result, msg) = await Task.Run(() => RunCore(_cts.Token), _cts.Token);
            if (_disposed) return;
            _result = result; _msg = msg;
        }
        catch (OperationCanceledException) { _msg = "취소되었습니다."; }
        catch (Exception ex) { if (!_disposed) _msg = "분석 실패: " + ex.Message; }
        finally { _busy = false; }
    }

    private (MirrorResult? result, string msg) RunCore(System.Threading.CancellationToken ct)
    {
        // ── 보유 종목 로드 ──
        var holdings = Db.GetAllHoldings().Where(h => h.Quantity > 0).ToList();
        if (holdings.Count == 0)
            return (null, "보유 종목이 없습니다. 포트폴리오에 종목을 추가해 주세요.");

        // ── 거래 이력 로드 (PriorRet 없이 — 구조적 편향 4종 활성) ──
        var rows = Db.Query("SELECT Symbol,Type,Quantity,Price,Commission,Tax,ExecutedAt FROM Transactions ORDER BY ExecutedAt").Rows;
        var txs = rows.Cast<DataRow>().Select(r => new CoachTx(
            Safe.Str(r["Symbol"]),
            (TransactionType)Safe.Int(r["Type"]),
            Safe.Int(r["Quantity"]),
            Safe.Dec(r["Price"]),
            Safe.Dec(r["Commission"]) + Safe.Dec(r["Tax"]),
            Safe.DT(r["ExecutedAt"], DateTime.MinValue),
            null)) // PriorRet — 캔들 없이 실행; 추격/패닉 편향은 회고 코치에서 활성화
            .Where(t => t.ExecutedAt > DateTime.MinValue)
            .ToList();

        var report = RetroCoach.Compute(txs);
        var result = DecisionMirror.Analyze(holdings, report, DateTime.Now);
        return (result, "");
    }
}
