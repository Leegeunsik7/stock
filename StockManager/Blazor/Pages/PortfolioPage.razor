    // ===== 세금 시뮬 — runningRealized가 행 간 전파 (평가이익 내림차순 · USD만 누적, 원본 룰) =====
    private List<(Holding h, TaxScenario sim)> TaxRows()
    {
        var rows = new List<(Holding, TaxScenario)>();
        decimal runningRealized = 0;
        foreach (var h in _holdings.OrderByDescending(x => x.UnrealizedPnL))
        {
            var sim = TaxSimulator.SimulateSell(h, _usdKrw, runningRealized);
            rows.Add((h, sim));
            if (h.Currency == Currency.USD) runningRealized += sim.UnrealizedGain * _usdKrw;
        }
        return rows;
    }

    // ===== 상관관계 (원본: 2종목 미만 거부 · 90일 일수익률 Pearson) =====
    private async Task CalcCorrAsync()
    {
        if (_holdings.Count < 2) { _corrMsg = "최소 2종목 이상 보유해야 합니다."; return; }
        _corrBusy = true; _corrMsg = ""; StateHasChanged();
        try
        {
            _corrSyms = _holdings.Select(h => h.Symbol).ToList();
            var returns = await CorrelationAnalyzer.CollectReturnsAsync(Provider,
                _holdings.Select(h => (h.Symbol, h.Market)), 90);
            _corr = CorrelationAnalyzer.BuildMatrix(_corrSyms, returns);
        }
        catch (Exception ex) { _corrMsg = "계산 실패: " + ex.Message; }
        _corrBusy = false;
    }

    // 원본 색 버킷: ≥0.7 빨강 / ≥0.3 주황 / ≥−0.3 회색 / ≥−0.7 하늘 / 그 외 파랑
    private static string CorrColor(decimal v) =>
        v >= 0.7m ? "#dc3232" : v >= 0.3m ? "#c88250" : v >= -0.3m ? "#646464" : v >= -0.7m ? "#5082c8" : "#325adc";

    // ===== 통합 기록 폼 열기/전환 =====
    // 통합 폼 열기 — 매수/매도는 항상 새로, 직접보정(Correct)은 토글.
    private void Open(FormMode m)
    {
        if (m == FormMode.Correct && _showForm && _mode == FormMode.Correct) { CloseForm(); return; }
        _showForm = true; _mode = m; _flash = "";
        if (m == FormMode.Correct) { ResetForm(); }
        else
        {
            _txType = m == FormMode.Buy ? TransactionType.Buy : TransactionType.Sell;
            _editId = 0; _tf = new(); _feesDirty = false; _lastBroker = ""; _txMsg = "";
        }
    }
    private void CloseForm() { _showForm = false; _editId = 0; _flash = ""; }

    // 모드 전환 — 종목/시장/통화/증권사 컨텍스트 이월(수정 중 '추가매수' 전환 시 종목 유지). 거래 모드로 가면 _editId 해제.
    private void SwitchMode(FormMode m)
    {
        if (m == _mode) return;
        string sym, name, broker; Market mk; Currency cur; bool picked;
        if (_mode == FormMode.Correct)
        { sym = _f.Symbol; name = _f.Name; mk = _f.Market; cur = _f.Currency; broker = _f.Broker; picked = _f.Picked; }
        else
        { sym = _tf.Symbol; name = _tf.Name; mk = _tf.Market; cur = _tf.Currency; broker = _tf.Broker; picked = _tf.Picked; }

        _mode = m; _flash = "";
        if (m == FormMode.Correct)
        {
            _editId = 0;   // 거래→직접보정 전환은 특정 보유행 편집이 아닌 신규 보정
            _f = new() { Symbol = sym, Name = name, Market = mk, Currency = cur, Broker = broker };
            _fLastBroker = (broker ?? "").Trim();
            _formMsg = "직접보정 — 보유 합계(수량·평단)를 직접 입력/덮어씁니다.";
        }
        else
        {
            _txType = m == FormMode.Buy ? TransactionType.Buy : TransactionType.Sell;
            _editId = 0;
            _tf = new() { Symbol = sym, Name = name, Market = mk, Currency = cur, Broker = broker, Picked = picked, ExecutedAt = DateTime.Now };
            _feesDirty = false; _lastBroker = (broker ?? "").Trim(); _txMsg = "";
        }
    }

    // SymbolPicker 결과 → 현재 모드의 모델에 채움(공유 어댑터).
    private void ApplyPick(SymbolEntry e)
    {
        if (_mode == FormMode.Correct) ApplyPickToForm(e);
        else ApplyPickToTx(e);
    }

    private async Task SaveTx()
    {
        // 원본 TransactionDialog 검증 룰: 종목코드 필수 · 수량/단가 0 거부 (종목명은 선택)
        if (string.IsNullOrWhiteSpace(_tf.Symbol)) { _txMsg = "종목코드를 입력하세요."; return; }
        if (_tf.Qty == 0 || _tf.Price == 0) { _txMsg = "수량과 단가를 입력하세요."; return; }

        var tx = new Transaction
        {
            Symbol = _tf.Symbol.Trim(),
            Type = _txType,
            Quantity = _tf.Qty,
            Price = _tf.Price,
            Commission = _tf.Commission,
            Tax = _tf.Tax,
            ExecutedAt = _tf.ExecutedAt,
            BrokerAccount = _tf.Broker,
            Memo = _tf.Memo
        };
        // 1) 저장(DB) — 이 단계 실패만 '저장 실패'로 보고한다.
        try
        {
            Db.AddTransaction(tx);
            // 평단 재계산 연쇄(원본 룰). 픽커로 고른 종목이면 시장/통화를 권위값으로 넘겨 코인(KRW-BTC)이
            //   미국주식으로 오분류되지 않게 함. 직접 타이핑이면 null → 심볼 기반 추론(코인 접두 포함).
            PortfolioService.RecomputeAverage(Db, tx.Symbol, _tf.Name,
                _tf.Picked ? _tf.Market : (Market?)null, _tf.Picked ? _tf.Currency : (Currency?)null);
        }
        catch (Exception ex) { _txMsg = "저장 실패: " + ex.Message; return; }   // 저장 자체 실패 → 폼 유지

        // 2) 저장 성공 — 저장 직후 DB 실제 상태를 조회해 배너에 반영(정상이면 보유수량 확인, 비정상이면 진단 노출).
        //    '저장됐다는데 데이터가 없다'는 신고의 원인을 사용자 환경에서 확정하기 위함. (읽기 쿼리라 락 불필요)
        string nm = string.IsNullOrWhiteSpace(_tf.Name) ? tx.Symbol : _tf.Name;
        int txCnt = 0; decimal hQty = 0; bool hExists = false; string storedQ = "?";
        try
        {
            var tc = Db.Query("SELECT COUNT(*) AS c FROM Transactions WHERE Symbol=@s", new() { ["@s"] = tx.Symbol });
            txCnt = tc.Rows.Count > 0 ? Safe.Int(tc.Rows[0]["c"]) : 0;
            // 방금 저장한 거래의 '실제 저장값 + storage class(typeof)' — 0.13이 0/integer로 강제변환됐는지 확정.
            var sd = Db.Query("SELECT Quantity AS q, typeof(Quantity) AS t FROM Transactions WHERE Symbol=@s ORDER BY Id DESC LIMIT 1", new() { ["@s"] = tx.Symbol });
            if (sd.Rows.Count > 0) storedQ = $"{Safe.Str(sd.Rows[0]["q"])}/{Safe.Str(sd.Rows[0]["t"])}";
            var hd = Db.Query("SELECT Quantity FROM Holdings WHERE Symbol=@s", new() { ["@s"] = tx.Symbol });
            hExists = hd.Rows.Count > 0;
            if (hExists) hQty = Safe.Dec(hd.Rows[0]["Quantity"]);
        }
        catch { }
        if (!hExists || hQty <= 0)
            _flash = $"⚠️ '{nm}' 거래 저장됐으나 보유 미생성 — 코드 [{tx.Symbol}] · 입력 {tx.Quantity} · DB저장값 {storedQ} · 거래 {txCnt}건 · 보유행 {(hExists ? $"있음(수량 {hQty})" : "없음")}. 이 문구를 캡처해 주세요.";
        else
            _flash = $"✅ '{nm}' {(_txType == TransactionType.Buy ? "매수" : "매도")} 저장됨 — 보유수량 {hQty} ({tx.Symbol}).";
        _showForm = false; _tf = new(); _feesDirty = false; _lastBroker = ""; _txMsg = "";
        try { await LoadAsync(); LoadTransactions(); } catch { /* 시세 갱신 실패는 저장과 무관 — 다음 새로고침에 반영 */ }
    }

    // ===== 직접보정 (기존 직접 등록) =====
    // 통합 폼 '직접보정' 모드 신규 초기화. (편집 상태 _editId 잔류 시 새 종목이 엉뚱한 보유를 덮어쓰는 치명 버그 방지)
    private void ResetForm() { _f = new(); _editId = 0; _formMsg = ""; _fLastBroker = ""; }

    // 보유행 '수정' → 통합 폼을 직접보정 모드로 열고 그 종목을 채운다(기존 수정 의미 유지 = 합계 보정).
    //   추가매수로 평단을 병합하려면 폼에서 '📈 매수' 모드로 전환(SwitchMode가 종목 이월).
    private void Edit(Holding h)
    {
        _editId = h.Id; _mode = FormMode.Correct;
        _f = new() { Symbol = h.Symbol, Name = h.Name, Market = h.Market, Currency = h.Currency,
                     Quantity = h.Quantity, AvgPrice = h.AvgPrice,
                     Broker = h.BrokerAccount, Commission = h.Commission, Tax = h.Tax };
        _fLastBroker = (h.BrokerAccount ?? "").Trim();   // 진입 시 자동추정이 기존 수수료를 덮지 않도록 기준 맞춤
        _showForm = true; _formMsg = ""; _flash = ""; _tab = "hold";
    }

    // 수정 폼에서 증권사가 '실제로' 바뀐 경우에만 수수료를 재추정(매수 기준 — 보유는 순매수 포지션, 거래세 없음).
    //   같은 증권사 재편집이면 손대지 않아 사용자가 직접 입력한 수수료를 보존한다. 시장은 폼의 권위값(_f.Market) 사용.
    //   Edit()에서 _fLastBroker를 기존 증권사로 맞춰두므로 수정 화면을 '열 때' 불려와도 즉시 덮어쓰지 않는다.
    private string _fLastBroker = "";
    private void OnFormBrokerChanged()
    {
        var b = (_f.Broker ?? "").Trim();
        if (b == _fLastBroker) return;
        _fLastBroker = b;
        if (string.IsNullOrWhiteSpace(b)) return;
        var (c, _) = BrokerFeeSchedule.Estimate(b, _f.Market, TransactionType.Buy, _f.Quantity, _f.AvgPrice);
        _f.Commission = c;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_f.Symbol) || _f.Quantity <= 0) { _formMsg = "종목코드와 수량을 입력하세요."; return; }
        var h = new Holding
        {
            Id = _editId,
            Symbol = _f.Symbol.Trim(), Name = string.IsNullOrWhiteSpace(_f.Name) ? _f.Symbol.Trim() : _f.Name.Trim(),
            Market = _f.Market, Currency = _f.Currency, Quantity = _f.Quantity, AvgPrice = _f.AvgPrice,
            CurrentPrice = _f.AvgPrice, FirstBuyDate = DateTime.Now,
            BrokerAccount = (_f.Broker ?? "").Trim(), Commission = _f.Commission, Tax = _f.Tax
        };
        // 1) 저장(DB) — 실패 시 폼 유지하고 메시지만. 수정(Id>0)은 행 단위 UPDATE(중복행 방지), 신규는 upsert.
        bool edited = _editId > 0;
        try { if (edited) Db.UpdateHoldingById(h); else Db.SaveHolding(h); }
        catch (Exception ex) { _formMsg = "저장 실패: " + ex.Message; return; }

        // 2) 저장 성공 — 확인 배너 후 폼 닫기. 시세 갱신 실패는 저장과 무관(별도 try).
        _flash = $"✅ '{h.Name}' {(edited ? "수정" : "등록")}되었습니다.";
        ResetForm(); _showForm = false;
        try { await LoadAsync(); } catch { /* 시세 갱신 실패는 저장과 무관 */ }
    }

    private async Task Delete(Holding h)
    {
        _flash = "";   // 삭제도 새 작업 → 이전 확인배너 정리
        try { Db.DeleteHolding(h.Symbol, h.BrokerAccount); await LoadAsync(); } catch { }
    }

    public void Dispose() { AsOfCtx.OnChange -= OnAsOf; _cts?.Cancel(); _cts?.Dispose(); }
}
