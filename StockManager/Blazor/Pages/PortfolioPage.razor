    // 거래일시 — datetime-local 견고 바인딩(value+onchange 수동 파싱). @bind 직결은 datetime-local을 DateTime/TimeOnly로
    //   특수 처리하고 @bind:format 조합 시 편집 파싱이 깨져 ExecutedAt가 default(0001-01-01)로 떨어졌다 →
    //   ValidateTransaction '거래일시 없음' → 모든 거래(코인 포함) 저장 거부되던 버그. 아래 방식은 표시값을 항상
    //   현재시각으로 보정(default 표시 불가)하고, 파싱 실패 시 기존 값을 유지하므로 default 저장이 구조적으로 불가능.
    private string ExecAtText =>
        (_tf.ExecutedAt == default ? DateTime.Now : _tf.ExecutedAt).ToString("yyyy-MM-ddTHH:mm");

    private void OnExecAtChanged(ChangeEventArgs e)
    {
