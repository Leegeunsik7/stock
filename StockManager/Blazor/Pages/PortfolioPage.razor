    //   재무 기록 영구 삭제이므로 확인창으로 오삭제 방지.
    private async Task DeleteTx(TxRow t)
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("confirm", $"이 거래를 삭제할까요?\n{t.Sym} · {t.Type} · {FmtQty(t.Qty)} @ {t.Price:N0}\n→ 해당 종목 평단·수량이 재계산됩니다."); }
        catch { ok = true; }   // JS 미가용 환경 폴백
        if (!ok) return;
        try
        {
            Db.DeleteTransaction(t.Id);
            PortfolioService.RecomputeAverage(Db, t.Sym);   // 남은 거래로 재계산(0건이면 수량 0 → 목록에서 사라짐)
            _flash = $"🗑 거래 삭제됨 — '{t.Sym}' {t.Type} {FmtQty(t.Qty)} @ {t.Price:N0}. 평단·수량 재계산 완료.";
        }
        catch (Exception ex) { _flash = "거래 삭제 실패: " + ex.Message; }
