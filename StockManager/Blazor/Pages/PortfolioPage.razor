    // ===== 전역 시점(As-Of) — 거래내역으로 그 시점 보유 재구성 (순수 엔진) =====
    private List<AsOfHolding> _asof = new();
    private void LoadAsOf()
    {
        if (AsOfCtx.IsLive) { _asof = new(); return; }
        try
        {
            var txs = Db.Query("SELECT * FROM Transactions").Rows.Cast<DataRow>()
                .Select(r => new AsOfTx(Safe.Str(r["Symbol"]), (TransactionType)Safe.Int(r["Type"]),
                    Safe.Dec(r["Quantity"]), Safe.Dec(r["Price"]), Safe.DT(r["ExecutedAt"]))).ToList();
            _asof = AsOfPortfolio.Reconstruct(txs, AsOfCtx.AsOf!.Value);
        }
        catch { _asof = new(); }
    }
    private void OnAsOf() { if (!AsOfCtx.IsLive) _tab = "hold"; LoadAsOf(); InvokeAsync(StateHasChanged); }   // AS-OF 진입 시 보유탭 고정(다른 탭의 현재가 누수 차단)

    // 자동 새로고침 폴링. 주기는 _pollSec(초). 끄기(0)·과거시점(AS-OF)·보유 탭 아님·폼 입력 중이면 건너뛴다.
    //   ★폼 입력 중(_showTxForm/_showForm) 폴링 금지 — 폴링의 StateHasChanged 재렌더가 입력 중인 컨트롤드 입력
    //     (수량·단가·거래일시)을 리셋해 '0.13 입력이 0으로 저장'되던 치명 버그를 막는다.
    //   자동 폴링은 persist:false 로 'DB 저장 없이' 메모리 시세만 갱신(저장은 초기·수동 때만). 시세 fetch는 병렬.
    private async Task Loop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            int sec = _pollSec > 0 ? _pollSec : 15;   // 끄기 상태에선 15초마다 깨어 재확인만(부하 0)
            try { await Task.Delay(sec * 1000, ct); } catch { return; }
            if (ct.IsCancellationRequested) return;
            // 폴링 조건 미충족(끄기·과거시점·보유탭 아님·폼 입력 중) → 재렌더 건너뜀
            if (_pollSec <= 0 || !AsOfCtx.IsLive || _tab != "hold" || _showForm) continue;
            await LoadAsync(persist: false);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SwitchTab(string key)
    {
        _tab = key; _flash = "";   // 탭 전환 → 이전 확인배너 정리
        if (key == "tx") LoadTransactions();
        else if (key == "div") LoadDividends();
    }

