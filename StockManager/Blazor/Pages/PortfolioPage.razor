@* /portfolio 라우트는 PortfolioHub가 소유 — 이 페이지는 허브의 '보유·배분' 탭(자식)으로 강등 *@
@inject LocalDatabase Db
@inject IQuoteProvider Provider
@inject UpbitProvider Upbit
@inject FxConverter Fx
@inject AsOfContext AsOfCtx
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable
@using System.Threading
@using System.Data

<div class="top"><div class="hello"><h1>💼 포트폴리오</h1><p>보유 종목 손익 · 갱신 @_ts @if (_pollSec > 0 && AsOfCtx.IsLive) { <span class="livepulse">● LIVE @(_pollSec)초</span> }</p></div>
<button class="addbtn" style="background:var(--up);margin:0 4px" @onclick="() => Open(FormMode.Buy)">➕ 매수 기록</button>
<button class="addbtn" style="background:var(--down)" @onclick="() => Open(FormMode.Sell)">➖ 매도 기록</button>
<button class="addbtn" style="background:var(--card);color:var(--ink);border:1px solid var(--line);margin:0 4px" @onclick="() => Open(FormMode.Correct)">@((_showForm && _mode==FormMode.Correct)?"✕ 닫기":"✎ 직접 등록")</button>
<label class="addbtn" style="background:var(--card);color:var(--ink);border:1px solid var(--line);margin:0 4px;display:inline-flex;align-items:center;gap:6px;cursor:default" title="실시간 자동 새로고침 주기">⚡ 자동
    <select class="srch" style="width:72px" @bind="_pollSec" @bind:after="OnPollChanged">
        <option value="0">끄기</option><option value="3">3초</option><option value="5">5초</option><option value="10">10초</option><option value="30">30초</option>
    </select>
</label>
<button class="addbtn" style="background:var(--card);color:var(--ink);border:1px solid var(--line);margin-right:16px" @onclick="LoadAllAsync">🔄 새로고침</button></div>

@* ===== 통합 기록 폼 — 매수/매도(거래 이력 append→평단 자동 병합) · 직접보정(보유 합계 덮어쓰기)을 한 폼에서 모드 전환 =====
   매수/매도는 _tf(거래 모델)·SaveTx(AddTransaction+RecomputeAverage), 직접보정은 _f(보유 모델)·Save(UpdateHoldingById/SaveHolding).
   두 모델·입력 헬퍼는 그대로 유지(컨트롤드 입력·datetime·픽커 권위·수수료 dirty 불변식 보존) — 껍데기만 하나로 통일. *@
@if (_showForm)
{
    <div style="margin:0 28px 18px;background:var(--card);border:1.5px solid @(_mode==FormMode.Buy?"var(--up)":_mode==FormMode.Sell?"var(--down)":"var(--line)");border-radius:var(--radius);padding:18px">
        @* 모드 전환 탭 — 매수(빨강)/매도(파랑)/직접보정(중립). 전환 시 종목·시장·통화·증권사 컨텍스트 이월. *@
        <div style="display:flex;gap:6px;margin-bottom:14px;align-items:center;flex-wrap:wrap">
            <button class="pill @(_mode==FormMode.Buy?"r":"b")" style="border:0;cursor:pointer;padding:6px 14px;font-size:12.5px" @onclick="() => SwitchMode(FormMode.Buy)">📈 매수</button>
            <button class="pill @(_mode==FormMode.Sell?"r":"b")" style="border:0;cursor:pointer;padding:6px 14px;font-size:12.5px" @onclick="() => SwitchMode(FormMode.Sell)">📉 매도</button>
            <button class="pill @(_mode==FormMode.Correct?"r":"b")" style="border:0;cursor:pointer;padding:6px 14px;font-size:12.5px" @onclick="() => SwitchMode(FormMode.Correct)">✎ 직접보정</button>
            @if (_editId > 0 && _mode == FormMode.Correct) { <span class="tag">보유 수정 중</span> }
            <span style="margin-left:auto;color:var(--sub);font-size:12px">@(_mode==FormMode.Correct ? "보유 합계를 직접 보정" : "거래 기록 → 평단 자동 병합(가중평균)")</span>
        </div>
        <div style="margin-bottom:12px">
            <label class="flbl">🔎 종목·코인 검색 (이름으로 찾기 — 주식·비트코인 모두)</label>
            <SymbolPicker OnPick="ApplyPick" Placeholder="삼성전자, 비트코인, 005930, AAPL …" />
        </div>
        @if (_mode != FormMode.Correct)
        {
            @* --- 매수/매도 모드 (거래 이벤트 → RecomputeAverage 병합) --- *@
            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;align-items:end">
                <div><label class="flbl">종목코드 *</label><input class="fin" @bind="_tf.Symbol" @bind:after="OnSymbolEdited" placeholder="005930 / AAPL" /></div>
                <div><label class="flbl">종목명(선택)</label><input class="fin" @bind="_tf.Name" /></div>
                <div><label class="flbl">거래일시</label><input class="fin" type="datetime-local" value="@ExecAtText" @onchange="OnExecAtChanged" /></div>
                <div><label class="flbl">수량 *</label><input class="fin" inputmode="decimal" value="@TxQtyText" @onchange="OnTxQtyChanged" placeholder="2.555 (코인 소수점)" /></div>
                <div><label class="flbl">단가 *</label><input class="fin" inputmode="decimal" value="@TxPriceText" @onchange="OnTxPriceChanged" placeholder="97,299,615" /></div>
                <div><label class="flbl">수수료</label><input class="fin" type="number" step="any" @bind="_tf.Commission" @bind:after="MarkFeesDirty" /></div>
                <div><label class="flbl">세금</label><input class="fin" type="number" step="any" @bind="_tf.Tax" @bind:after="MarkFeesDirty" /></div>
                <div><label class="flbl">증권사</label><input class="fin" list="brokerList" @bind="_tf.Broker" @bind:after="OnBrokerChanged" />
                    <datalist id="brokerList">@foreach (var b in _brokers) { <option value="@b" /> }</datalist></div>
                <div style="grid-column:span 2"><label class="flbl">메모</label><input class="fin" @bind="_tf.Memo" /></div>
            </div>
            <div style="margin-top:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <b style="color:@(_txType==TransactionType.Buy?"var(--up)":"var(--down)")">총 금액: @TxTotal.ToString("N0")원</b>
                <button class="addbtn" @onclick="SaveTx">✅ 저장</button>
                <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="CloseForm">취소</button>
                @if (!string.IsNullOrEmpty(_txMsg)) { <span style="color:var(--sub)">@_txMsg</span> }
            </div>
            <div style="margin-top:8px;color:var(--sub);font-size:12px">저장 시 전체 거래 이력으로 평균단가·수량이 자동 재계산됩니다 (이동평균법 · 전량 매도 시 평단 0). <b>같은 종목을 추가 매수하면 평단이 가중평균으로 자동 병합</b>됩니다.</div>
            <div style="margin-top:4px;color:var(--sub);font-size:12px">💡 증권사를 고르면 수수료·세금이 자동 추정 입력됩니다 (직접 수정 가능 · 약정·이벤트·환율로 실제와 다를 수 있는 추정치). 코인은 거래세 없음.</div>
        }
        else
        {
            @* --- 직접보정 모드 (보유 합계 직접 덮어쓰기 — 기존 직접 등록/수정) --- *@
            <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;align-items:end">
                <div><label class="flbl">종목코드</label><input class="fin" @bind="_f.Symbol" @bind:after="OnFormSymbolEdited" placeholder="005930" /></div>
                <div><label class="flbl">종목명</label><input class="fin" @bind="_f.Name" placeholder="삼성전자" /></div>
                <div><label class="flbl">시장</label>
                    <select class="fin" @bind="_f.Market">
                        @foreach (var m in Enum.GetValues<Market>()) { <option value="@m">@m</option> }
                    </select></div>
                <div><label class="flbl">통화</label>
                    <select class="fin" @bind="_f.Currency">
                        <option value="@Currency.KRW">KRW</option><option value="@Currency.USD">USD</option>
                    </select></div>
                <div><label class="flbl">수량</label><input class="fin" inputmode="decimal" value="@FormQtyText" @onchange="OnFormQtyChanged" placeholder="2.555 (코인 소수점 가능)" /></div>
                <div><label class="flbl">평균단가</label><input class="fin" inputmode="decimal" value="@FormAvgText" @onchange="OnFormAvgChanged" placeholder="20,000,000" /></div>
                <div><label class="flbl">증권사</label><input class="fin" list="brokerListF" @bind="_f.Broker" @bind:after="OnFormBrokerChanged" />
                    <datalist id="brokerListF">@foreach (var b in _brokers) { <option value="@b" /> }</datalist></div>
                <div><label class="flbl">수수료(누적)</label><input class="fin" type="number" step="any" @bind="_f.Commission" /></div>
                <div><label class="flbl">세금(누적)</label><input class="fin" type="number" step="any" @bind="_f.Tax" /></div>
            </div>
            @if (_f.AvgPrice > 0 || _f.Quantity > 0)
            {
                <div style="margin-top:10px;color:var(--sub);font-size:13px">
                    평균단가 <b style="color:var(--ink)">@_f.AvgPrice.ToString("N0")원</b>
                    · 수량 <b style="color:var(--ink)">@FmtQty(_f.Quantity)</b>
                    · 매입금액 <b style="color:var(--ink)">@((_f.AvgPrice * _f.Quantity).ToString("N0"))원</b>
                </div>
            }
            <div style="margin-top:14px;display:flex;gap:10px">
                <button class="addbtn" @onclick="Save">@(_editId>0?"수정 저장":"등록")</button>
                <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="ResetForm">초기화</button>
                <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="CloseForm">닫기</button>
                @if (!string.IsNullOrEmpty(_formMsg)) { <span style="align-self:center;color:var(--sub)">@_formMsg</span> }
            </div>
            <div style="margin-top:8px;color:var(--sub);font-size:12px">ℹ️ '직접보정'은 보유 <b>합계</b>(수량·평단·증권사·누적 수수료/세금)를 직접 덮어씁니다. 개별 거래로 남기고 평단을 자동 병합하려면 위 <b>📈 매수 / 📉 매도</b> 모드를 쓰세요(거래일시·건별 수수료는 <b>📝 거래 이력</b>에서 확인).</div>
        }
    </div>
}

@* KPI·자산군 카드는 현재가 기반(LIVE 전용) — 과거시점(AS-OF)에선 숨겨 과거 화면에 현재 수치가 섞이지 않게 한다.
   (AS-OF는 그 시점 '보유 포지션'만 의미 있고 현재 평가액·비중은 적용 불가) *@
@if (AsOfCtx.IsLive)
{
<div class="kpis">
    <div class="kpi">
        <div class="k-lab">총 평가 (KRW)</div>
        <div class="k-val">₩@_totalValue.ToString("N0")</div>
        <div class="k-row"><span class="delta @(_totalRet>=0?"pos":"neg")">@_totalRet.ToString("+0.0;-0.0")%</span><span class="sub" style="font-size:11px">실시간 환산</span></div>
    </div>
    <div class="kpi">
        <div class="k-lab">평가손익</div>
        <div class="k-val @(_totalPnl>=0?"up":"down")">@_totalPnl.ToString("+#,##0;-#,##0;0")</div>
        <div class="k-row"><span class="sub" style="font-size:11px">미실현 손익</span></div>
    </div>
    <div class="kpi">
        <div class="k-lab">수익률</div>
        <div class="k-val @(_totalRet>=0?"up":"down")">@_totalRet.ToString("+0.0;-0.0")%</div>
        <div class="k-row"><span class="sub" style="font-size:11px">원가 대비</span></div>
    </div>
    <div class="kpi">
        <div class="k-lab">보유 종목</div>
        <div class="k-val">@_holdings.Count</div>
        <div class="k-row"><span class="sub" style="font-size:11px">종목수</span></div>
    </div>
</div>

@* ===== 자산군 3분류 집계 (국내주식 · 해외주식 · 비트코인) — 총평가의 구성 ===== *@
<div style="padding:0 28px 16px">
    <div style="font-size:12.5px;color:var(--sub);margin-bottom:8px">📊 자산군 구성 — 국내주식 · 해외주식 · 코인 (KRW 환산)</div>
    <div class="catgrid">
        @foreach (var c in _cats)
        {
            <div class="catcard @CatClass(c.Class)">
                <div class="cat-h">
                    <span class="cat-ic">@CatIcon(c.Class)</span>
                    <span class="cat-lab">@c.Label</span>
                    <span class="cat-cnt">@c.Count 종목</span>
                </div>
                <div class="cat-val">₩@c.ValueKrw.ToString("N0")</div>
                <div class="cat-row">
                    <span class="@(c.PnlKrw>=0?"up":"down")">@c.PnlKrw.ToString("+#,##0;-#,##0;0") (@c.ReturnPct.ToString("+0.0;-0.0")%)</span>
                    <span class="cat-wt">비중 @c.WeightPct(_totalValue).ToString("0.0")%</span>
                </div>
                <div class="cat-bar"><div class="cat-bar-fill" style="width:@WeightWidth(c)"></div></div>
            </div>
        }
    </div>
</div>
}

@if (!string.IsNullOrEmpty(_flash))
{
    <div style="margin:0 28px 14px;padding:10px 14px;border-radius:10px;background:color-mix(in srgb,var(--up) 14%,transparent);border:1px solid var(--up);font-size:13px;display:flex;align-items:center;gap:8px">
        <span>@_flash</span>
        <button class="addbtn" style="margin-left:auto;background:var(--card);color:var(--ink);border:1px solid var(--line);padding:3px 10px" @onclick="() => _flash = string.Empty">확인</button>
    </div>
}

@* 탭(보유/거래/세금/배당/상관)은 모두 현재가 기반 — AS-OF에선 숨기고 그 시점 보유표만 보인다(현재가 누수 차단). *@
@if (AsOfCtx.IsLive)
{
<div style="display:flex;gap:8px;padding:0 28px 14px;flex-wrap:wrap">
    @foreach (var (key, label) in _tabDefs)
    {
        <button class="pill @(key==_tab?"r":"b")" style="padding:6px 14px;cursor:pointer;border:0;font-size:12.5px" @onclick="() => SwitchTab(key)">@label</button>
    }
</div>
}

@if (_tab == "hold")
{
@if (!AsOfCtx.IsLive)
{
<div style="padding:0 28px 40px">
  <div style="background:color-mix(in srgb,var(--warn) 14%,transparent);border:1px solid var(--warn);border-radius:10px;padding:10px 14px;font-size:12.5px;margin-bottom:14px">⏳ <b>AS-OF @AsOfCtx.AsOf!.Value.ToString("yyyy-MM-dd")</b> · 거래내역으로 재구성한 <b>그 시점의 보유 포지션</b>입니다(현재가·평가액 아님). 상단 시점 바에서 LIVE 복귀.</div>
  <div class="panel">
    <div class="panel-h">📦 그 시점 보유 <span class="tag">AS-OF</span></div>
    <div style="overflow:auto;max-height:calc(100vh - 380px)">
    <table class="ctbl dense">
        <thead><tr><th>종목</th><th style="text-align:right">수량</th><th style="text-align:right">평균단가(당시)</th><th style="text-align:right">매입원가</th></tr></thead>
        <tbody>
            @foreach (var a in _asof)
            {
                <tr>
                    <td><b>@a.Symbol</b></td>
                    <td class="num" style="text-align:right">@FmtQty(a.Quantity)</td>
                    <td class="num" style="text-align:right">@a.AvgCost.ToString("N0")</td>
                    <td class="num" style="text-align:right">@a.CostBasis.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (_asof.Count == 0) { <div style="padding:34px;color:var(--sub);text-align:center">해당 시점에 보유 포지션이 없습니다.</div> }
  </div>
</div>
}
else
{
<div style="padding:0 28px 40px">
  <div class="panel">
    <div class="panel-h">📊 보유 종목 <span class="sub" style="font-weight:400">· @FilteredHoldings().Count()/@_holdings.Count 종목</span><span class="tag">HOLDINGS</span></div>
    @* 자산군 분류 필터 — 전체 / 국내 / 해외 / 코인 (요청: 분류별·전체 보기) *@
    <div style="display:flex;gap:6px;padding:8px 14px 4px;flex-wrap:wrap">
        @foreach (var (k, lbl) in _holdFilters)
        {
            <button class="pill @(k==_holdFilter?"r":"b")" style="border:0;cursor:pointer;padding:5px 12px;font-size:12px" @onclick="() => _holdFilter = k">@lbl <span style="opacity:.7">@FilterCount(k)</span></button>
        }
    </div>
    @* 정렬 — 전체/국내/해외/코인 모든 분류에 공통 적용. 일간 수익률은 시세 갱신 시 포착된 전일대비 등락. *@
    <div style="display:flex;gap:8px;padding:2px 14px 8px;flex-wrap:wrap;align-items:center">
        <span style="font-size:12px;color:var(--sub)">↕ 정렬</span>
        <select class="srch" style="width:auto;min-width:118px" @bind="_sortKey" @bind:after="OnSortChanged">
            <option value="val">평가금</option>
            <option value="ret">총수익률</option>
            <option value="day">일간 수익률</option>
            <option value="name">가나다순</option>
            <option value="custom">직접설정</option>
        </select>
        @if (_sortKey == "custom")
        {
            <span style="font-size:11.5px;color:var(--sub)">관리 열의 ▲▼ 로 순서를 지정하세요 (저장됨)</span>
        }
        else
        {
            <button class="pill b" style="border:0;cursor:pointer;padding:5px 11px;font-size:12px" @onclick="() => { _sortDesc = !_sortDesc; }">
                @(_sortKey == "name" ? (_sortDesc ? "역순 ᐯ" : "가나다 ᐱ") : (_sortDesc ? "높은순 ᐯ" : "낮은순 ᐱ"))
            </button>
        }
    </div>
    <div style="overflow:auto;max-height:calc(100vh - 392px)">
    <table class="ctbl dense">
        <thead><tr>
            <th>종목</th><th>시장</th><th style="text-align:right">수량</th>
            <th style="text-align:right">평균단가</th><th style="text-align:right">현재가</th>
            <th style="text-align:right">평가액(₩)</th><th style="text-align:right">손익(₩)</th><th style="text-align:right">수익률</th><th style="text-align:right">일간</th>
            <th style="text-align:center;width:108px">추세 30D</th><th style="text-align:center;width:118px">관리</th>
        </tr></thead>
        <tbody>
            @foreach (var h in FilteredHoldings())
            {
                var fxr = h.Currency == Currency.USD ? _usdKrw : 1m;          // 평가액·손익은 KRW 환산 (원본 KrwValue 룰)
                var pnl = (h.CurrentPrice - h.AvgPrice) * h.Quantity * fxr;
                var ret = h.AvgPrice > 0 ? (h.CurrentPrice - h.AvgPrice) / h.AvgPrice * 100m : 0m;
                var hasDay = _dayPct.TryGetValue(h.Symbol, out var day);      // 일간(전일대비) 등락% — 시세 갱신 시 포착
                var sess = _session.TryGetValue(h.Symbol, out var sv) ? sv : "";   // 시간외/프리/애프터 세션
                <tr>
                    <td><b>@h.Name</b><br/><small class="sub">@h.Symbol</small></td>
                    <td><small class="sub">@h.Market@(h.Currency == Currency.USD ? " · USD" : "")</small></td>
                    <td class="num" style="text-align:right">@FmtQty(h.Quantity)</td>
                    <td class="num" style="text-align:right">@Formatter.Money(h.AvgPrice, h.Currency)</td>
