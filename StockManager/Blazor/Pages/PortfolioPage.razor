@code {
    private List<Holding> _holdings = new();
    private bool _showForm;                       // 통합 기록 폼(매수/매도/직접보정) 단일 토글
    private FormMode _mode = FormMode.Buy;         // 통합 폼 현재 모드
    private enum FormMode { Buy, Sell, Correct }
    private int _editId;
    private string _ts = "", _formMsg = "", _txMsg = "", _flash = "";   // _flash: 저장 성공 확인 배너(폼 닫힌 뒤에도 표시)
    private decimal _totalValue, _totalPnl, _totalRet;
    private decimal _usdKrw = 1380m;   // 환율 실패 시 직전 캐시값 유지 (원본 룰)
    private List<CategoryAgg> _cats = new();   // 자산군 3분류 집계(국내·해외·코인)
    private CancellationTokenSource? _cts;
    private int _pollSec = 5;                  // 자동 새로고침 주기(초). 0=끄기. 기본 5초(토스류 실시간 체감)
    // 직전 폴링가 — 현재가 셀 상승/하락 틱 플래시(라이브 체감)용. 표시 전용이라 정확도 영향 없음.
    private readonly Dictionary<string, decimal> _prevPrice = new(StringComparer.OrdinalIgnoreCase);
    private string TickClass(Holding h) =>
        _prevPrice.TryGetValue(h.Symbol, out var prev) && prev > 0
            ? (h.CurrentPrice > prev ? "tick-up" : h.CurrentPrice < prev ? "tick-down" : "")
            : "";

    // 자동 새로고침 주기 변경 → 폴링 루프 재시작 + 즉시 1회 갱신(LIVE·보유탭 한정).
    private void RestartPoll()
    {
        _cts?.Cancel(); _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }
    private async Task OnPollChanged()
    {
        RestartPoll();
        if (_pollSec > 0 && AsOfCtx.IsLive && _tab == "hold") { await LoadAsync(persist: false); StateHasChanged(); }
    }

    // ----- 보유 목록 자산군 필터(전체/국내/해외/코인) -----
    private string _holdFilter = "all";
    private readonly (string k, string lbl)[] _holdFilters =
        { ("all", "전체"), ("dom", "🇰🇷 국내주식"), ("for", "🇺🇸 해외주식"), ("crypto", "₿ 코인") };
    private static string CatKey(AssetClass c) => c switch
    { AssetClass.DomesticStock => "dom", AssetClass.ForeignStock => "for", AssetClass.Crypto => "crypto", _ => "all" };
    private IEnumerable<Holding> FilteredHoldings()
    {
        var src = _holdFilter == "all" ? _holdings : _holdings.Where(h => CatKey(PortfolioBreakdown.Classify(h.Market)) == _holdFilter);
        return SortHoldings(src);
    }
    private int FilterCount(string key) =>
        key == "all" ? _holdings.Count : _holdings.Count(h => CatKey(PortfolioBreakdown.Classify(h.Market)) == key);

    // ----- 정렬 (전체/국내/해외/코인 모든 분류에 공통 적용) -----
    private string _sortKey = "val";    // val 평가금 · ret 총수익률 · day 일간 · name 가나다 · custom 직접설정
    private bool _sortDesc = true;      // name: false=가나다순, true=역순
    private readonly Dictionary<string, decimal> _dayPct  = new(StringComparer.OrdinalIgnoreCase);  // 종목별 일간(전일대비) 등락%
    private readonly Dictionary<string, string>  _session = new(StringComparer.OrdinalIgnoreCase);  // 종목별 세션(AFTER/PRE/POST)
    private List<string> _customOrder = new();   // 직접설정 순서(심볼 나열) — Db.GetSetting 영속

    // 정렬 기준 변경 시 방향 기본값 보정: 가나다는 오름차순(false), 그 외는 높은순(true).
    private void OnSortChanged() => _sortDesc = _sortKey != "name";

    // 정렬 코어는 순수 헬퍼(HoldingSort)에 위임 — 결정론·단위테스트 대상. 필터 후 현재 시세 컨텍스트를 넘긴다.
    private IEnumerable<Holding> SortHoldings(IEnumerable<Holding> src) =>
        HoldingSort.Sort(src, _sortKey, _sortDesc, _dayPct, _customOrder, _usdKrw);

    private static string SessLabel(string s) => s switch { "AFTER" => "시간외", "PRE" => "프리", "POST" => "애프터", _ => "" };

    // ----- 직접설정 순서 편집·영속 (Db.SetSetting/GetSetting) -----
    private void EnsureCustomSeed()   // 진입/신규 종목 → 현재 목록 순서로 시드(누락 종목 뒤에 추가)
    { foreach (var h in _holdings) if (!_customOrder.Contains(h.Symbol)) _customOrder.Add(h.Symbol); }
    // dir: -1 위로, +1 아래로. ★현재 '표시 순서'(필터 적용된 화면) 기준으로 인접 종목과 스왑한다.
    //   (전역 _customOrder 인접이 아니라 화면 인접 — 분류 필터가 켜져 있어도 화면상 위/아래로 정확히 한 칸 이동하고,
    //    필터로 숨겨진 다른 분류 종목의 상대 순서를 건드리지 않는다.)
    private void MoveCustom(Holding h, int dir)
    {
        EnsureCustomSeed();
        var view = FilteredHoldings().Select(x => x.Symbol).ToList();   // 현재 화면(필터 적용) 순서
        if (HoldingSort.MoveInView(_customOrder, view, h.Symbol, dir)) PersistCustomOrder();
    }
    private void PersistCustomOrder()
    { try { Db.SetSetting("Portfolio.CustomOrder", string.Join(",", _customOrder)); } catch { } }
    private void LoadCustomOrder()
    {
        try
        {
            var s = Db.GetSetting("Portfolio.CustomOrder");
            _customOrder = string.IsNullOrWhiteSpace(s) ? new()
                : s.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        }
        catch { _customOrder = new(); }
    }

    private static string CatIcon(AssetClass c) => c switch
    { AssetClass.DomesticStock => "🇰🇷", AssetClass.ForeignStock => "🇺🇸", AssetClass.Crypto => "₿", _ => "•" };
    private static string CatClass(AssetClass c) => c switch
    { AssetClass.DomesticStock => "c-dom", AssetClass.ForeignStock => "c-for", AssetClass.Crypto => "c-cry", _ => "" };
    // 비중 막대 너비 — CSS용이라 InvariantCulture(소수점 '.')로 고정, 0~100% 클램프.
    private string WeightWidth(CategoryAgg c)
    {
        var w = Math.Max(0m, Math.Min(100m, c.WeightPct(_totalValue)));
        return w.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string _tab = "hold";
    private readonly (string key, string label)[] _tabDefs = {
        ("hold","📊 보유 종목"), ("tx","📝 거래 이력"), ("tax","💰 세금 시뮬"),
        ("div","💸 배당 캘린더"), ("corr","🔗 상관관계") };

    // ----- 직접 등록 폼 -----
    private class Form { public string Symbol=""; public string Name=""; public Market Market=Market.KRX_KOSPI; public Currency Currency=Currency.KRW; public decimal Quantity; public decimal AvgPrice; public string Broker=""; public decimal Commission; public decimal Tax; public bool Picked; }
    private Form _f = new();

    // 검색→자동 채움 — SymbolPicker 가 고른 종목을 폼에 채운다(코드·이름·시장·통화). 수량/단가만 입력하면 됨.
    //   ⚠️ 데이터 손상 차단: 어떤 종목을 '고르는' 행위는 곧 '그 종목을 신규 등록'한다는 뜻이므로 편집 모드(_editId)를
    //   해제한다. (이전엔 종목 수정 화면에서 비트코인을 고르면 _editId가 편집 중이던 주식에 남아, 저장 시 그 주식을
    //   BTC로 덮어써 BTC는 안 보이고 기존 종목이 사라지던 버그.) 같은 종목을 다시 고르면 SaveHolding upsert가
    //   (Symbol,BrokerAccount) 기준으로 기존 행을 갱신하므로 중복도 안 생긴다.
    private void ApplyPickToForm(SymbolEntry e)
    {
        _editId = 0;
        _f.Symbol = e.Code; _f.Name = e.Name; _f.Market = e.Market; _f.Currency = e.Currency; _f.Picked = true;
        _fLastBroker = (_f.Broker ?? "").Trim();   // 자동추정 기준 동기화(기존 수수료 보존)
        _formMsg = $"'{e.Name}' 선택됨 — 신규 등록으로 전환. 수량·평균단가를 입력하세요.";
    }

    // 직접보정 폼에서 종목코드를 손으로 바꾸면 픽커 권위 해제(코인/KOSDAQ 픽 후 다른 코드로 덮어쓸 때 시장 힌트 오적용 차단).
    private void OnFormSymbolEdited() => _f.Picked = false;
    private void ApplyPickToTx(SymbolEntry e)
    {
        _tf.Symbol = e.Code; _tf.Name = e.Name; _tf.Market = e.Market; _tf.Currency = e.Currency; _tf.Picked = true;
        AutoFillFees();   // 종목 선택 즉시(수량·단가 이미 입력됐다면) 수수료/세금 추정
    }

    // 종목코드를 손으로 바꾸면 픽커 권위(Picked)를 해제 — 코인 선택 후 주식코드로 덮어쓸 때 CRYPTO 힌트가
    //   주식에 잘못 적용되는 fail-open 차단. 이후엔 심볼 기반 추론(코인 접두/6자리)으로 폴백한다.
    //   픽커가 채운 종목명도 함께 정리 — 코인 '비트코인'이 잔류해 주식(AAPL)이 잘못된 이름으로 저장되는 leak 방지.
    private void OnSymbolEdited()
    {
        if (_tf.Picked) _tf.Name = "";   // 픽커 출처 이름만 비움(수동 입력 이름은 건드리지 않음)
