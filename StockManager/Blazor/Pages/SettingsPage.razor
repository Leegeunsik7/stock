@page "/settings"
@inject LocalDatabase Db
@inject NavigationManager Nav

<div class="top"><div class="hello"><h1>⚙️ 설정</h1><p>거래 모드 · API 키 · 테마</p></div></div>

<div style="padding:0 28px;max-width:560px">
    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:14px">거래 모드</div>
        <div style="display:flex;gap:14px;margin-bottom:12px">
            <span class="pill @(!_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick='()=>SetMode(false)'>🧪 모의투자</span>
            <span class="pill @(_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick='()=>SetMode(true)'>💸 실거래</span>
        </div>
        <div style="color:var(--sub);font-size:12.5px">@(_live ? "실거래 모드 — 무장(LiveArmed) 설정 후 주문이 실제 집행됩니다." : "모의투자 모드 — 실제 자금이 이동하지 않습니다.")</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:14px">API 키 관리 (DPAPI 암호화 저장)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">키는 로컬에서 암호화 보관됩니다. 자세한 설정은 '거래 설정 창'을 이용하세요.</div>
        <div style="margin-bottom:8px">업비트: <span class="num" style="color:var(--sub)">@MaskKey(_upAk)</span></div>
        <div style="margin-bottom:14px">KIS: <span class="num" style="color:var(--sub)">@MaskKey(_kisAk)</span></div>
        <button class="addbtn" @onclick="OpenBrokerSettings">⚙️ 거래 설정 열기</button>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px">
        <div style="font-weight:700;margin-bottom:14px">빠른 설정</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="OpenSetup">🔧 설정 마법사</button>
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="OpenBrokerSettings">💳 거래 설정</button>
        </div>
    </div>
</div>

@code {
    private bool _live;
    private string _upAk = "", _kisAk = "";

    protected override void OnInitialized()
    {
        _live = BrokerHub.IsLive(Db);
        (_upAk, _) = ApiKeyVault.GetUpbit(Db);
        (_kisAk, _, _) = ApiKeyVault.GetKis(Db);
    }

    private void SetMode(bool live) { BrokerHub.SetLive(Db, live); _live = live; }
    private void OpenBrokerSettings() => Nav.NavigateTo("/broker");   // Blazor 네이티브 페이지 (WinForms 팝업 제거)
    private void OpenSetup() => Nav.NavigateTo("/setup");             // Blazor 네이티브 설정 마법사

    private static string MaskKey(string k) =>
        string.IsNullOrWhiteSpace(k) ? "(미설정)" :
        k.Length > 8 ? k[..4] + "****" + k[^4..] : "****";
}
