@* ============================================================================
   BrokerCredentialVaultManager.razor — v11.0.0: 다중 증권사 API 자격증명 UI 매니저 (도구 하위·Zero-Leak·탭 UI)
     증권사별 맞춤 라벨/발급처 안내 + 금융기관 선택 드롭다운(BankCode) + [⚡ 연결 테스트 & 포트폴리오 동기화].
     ★평문은 디스크/JSON 에 절대 저장 안 됨 — 입력 즉시 SecurityAssetVault.Store(DPAPI CurrentUser at-rest) 후 입력 소거.
     ★연결 테스트는 UniversalBrokerGatewayMesh(조회 전용·발주 메서드 없음) 경유 — 실 토큰/엔드포인트·물리 무장 전엔
       fail-closed(미동기화)만 반환하며 가짜 잔고를 절대 생성하지 않는다(liveArmed:false).
   ============================================================================ *@
@page "/tools/credentials"
@using StockManager.Common
@inject SecurityAssetVault Vault
@inject UniversalBrokerGatewayMesh Mesh
@inject IBrokerAccountPort Account

<div class="cred-wrap">
    <h2>🔑 증권사 API 자격증명 금고</h2>
    <p class="sub">아래 <b>증권사 탭</b>을 선택해 API Key·App Secret·금융기관·계좌번호를 입력하면 <b>즉시 DPAPI(CurrentUser) 암호화</b>되어
        저장됩니다(At-Rest Encryption). 평문은 하드디스크·일반 JSON 설정에 <b>절대 저장되지 않으며</b>, 저장 즉시 입력 필드가 소거됩니다.
        ★자격증명이 등록돼도 물리 이중 키 무장 전에는 실물 발주가 <b>100% Veto</b> 되고, 연결 테스트도 조회 전용으로만 동작합니다(liveArmed:false).</p>

    @* ── 증권사 탭 바(진입 시 첫 탭=토스증권 활성) ── *@
    <div class="cred-tabs" role="tablist">
        @for (int i = 0; i < _brokers.Length; i++)
        {
            var idx = i;
            var t = _brokers[idx];
            <button type="button" role="tab"
                    class="cred-tab @(idx == _active ? "active" : "")"
                    style="@(idx == _active ? $"--accent:{t.Accent}" : "")"
                    aria-selected="@(idx == _active ? "true" : "false")"
                    @onclick="() => _active = idx">
                <span class="cred-tab-ic">@t.Icon</span>
                <span class="cred-tab-nm">@t.Name</span>
                @if (t.Ok) { <span class="cred-tab-dot" title="봉인됨">✓</span> }
            </button>
        }
    </div>

    @* ── 활성 증권사 입력 카드(맞춤 라벨·발급처 안내·금융기관 드롭다운) ── *@
    @{ var b = _brokers[_active]; }
    <div class="cred-card" style="--accent:@b.Accent">
        <div class="cred-broker"><span class="cred-broker-ic">@b.Icon</span>@b.Name</div>
        <div class="cred-hint">ℹ️ @b.Hint</div>
        <div class="cred-grid">
            <label class="cred-field">
                <span class="cred-lab">@b.LabelApiKey</span>
                <input class="cred-in" @bind="b.ApiKey" placeholder="@(b.LabelApiKey) 입력" type="password" autocomplete="off" />
            </label>
            <label class="cred-field">
                <span class="cred-lab">@b.LabelSecret</span>
                <input class="cred-in" @bind="b.Secret" placeholder="@(b.LabelSecret) 입력" type="password" autocomplete="off" />
            </label>
            <label class="cred-field">
                <span class="cred-lab">금융기관 / 은행</span>
                <select class="cred-in cred-sel" @bind="b.BankCode">
                    @foreach (var bk in _banks)
                    {
                        <option value="@bk.Code">@bk.Name (@bk.Code)</option>
                    }
                </select>
            </label>
            <label class="cred-field">
                <span class="cred-lab">@b.LabelAccount</span>
                <input class="cred-in" @bind="b.Account" placeholder="@(b.LabelAccount) 입력" autocomplete="off" />
            </label>
        </div>

        <div class="cred-actions">
            <button class="cred-save" @onclick="() => Save(b)">🔐 저장 및 퀀텀 금고 봉인</button>
            <button class="cred-test" disabled="@b.Testing" @onclick="() => TestConnection(b)">
                @(b.Testing ? "테스트 중…" : "⚡ API 연결 테스트 & 포트폴리오 동기화")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(b.Status))
        {
            <div class="cred-toast @(b.Ok ? "ok" : "bad")" @key="b.SaveTick">
                <span class="cred-toast-ic">@(b.Ok ? "✅" : "⚠")</span>
                <span>@b.Status</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(b.TestStatus))
        {
            <div class="cred-testbadge @(b.TestOk ? "ok" : "warn")" @key="b.TestTick">@b.TestStatus</div>
        }
    </div>

    <div class="cred-note">🔒 저장된 자격증명은 <code>SecurityAssetVault.Reveal</code>(무장·비봉인·비동결 시에만·SecretLease char 버퍼 wipe-on-dispose)로만 복호화되며, 조회는 <code>UniversalBrokerGatewayMesh</code>(발주 메서드 없음·RejectOrderAttempt 하드 veto), 발주는 <code>UniversalOrderExecutionAdapter</code>→<code>GenesisLiveIgnitionGateway.Emit</code>(이중 물리 키 인터락)을 반드시 경유합니다.</div>
</div>

@code {
    private sealed class BrokerCred
    {
        public BrokerId Id;
        public string Name = "";
        public string Prefix = "";
        public string Icon = "";
        public string Accent = "";
        // ★증권사별 맞춤 라벨·발급처 안내(명세 1)
        public string LabelApiKey = "API Key";
        public string LabelSecret = "App Secret";
        public string LabelAccount = "계좌번호";
        public string Hint = "";
        // 입력값
        public string ApiKey = "";
        public string Secret = "";
        public string Account = "";
        public string BankCode = "";   // ★금융기관 코드(명세 2) — 계좌와 함께 봉인
        // 저장 알림
        public string Status = "";
        public bool Ok;
        public int SaveTick;
        // 연결 테스트 알림(명세 3)
        public string TestStatus = "";
        public bool TestOk;
        public bool Testing;
        public int TestTick;
    }

    // ★주요 금융기관/은행 코드(전자금융공동망·증권사) — 명세 지정 코드 포함.
    private static readonly (string Code, string Name)[] _banks =
    {
        ("029", "토스증권"),   ("007", "한국투자증권"), ("078", "LS증권"),
        ("230", "미래에셋증권"), ("264", "키움증권"),    ("240", "삼성증권"),
        ("092", "토스뱅크"),   ("004", "KB국민은행"),   ("088", "신한은행"),
        ("011", "NH농협은행"), ("020", "우리은행"),     ("081", "하나은행"),
        ("003", "IBK기업은행"), ("090", "카카오뱅크"),
    };

    private readonly BrokerCred[] _brokers =
    {
        new()
        {
            Id = BrokerId.Toss, Name = "토스증권", Prefix = "toss", Icon = "🔷", Accent = "#3182f6",
            LabelApiKey = "API Key (Client ID)", LabelSecret = "App Secret (Client Secret)", LabelAccount = "사용자 ID 또는 계좌 ID",
            Hint = "토스증권 Open API 센터에서 발급받은 Client ID/Secret을 입력하세요.", BankCode = "029",
        },
        new()
        {
            Id = BrokerId.Kis, Name = "한국투자증권 (KIS)", Prefix = "kis", Icon = "🔶", Accent = "#f5a623",
            LabelApiKey = "App Key", LabelSecret = "App Secret", LabelAccount = "종합계좌번호 (8자리)",
            Hint = "한국투자증권 KIS Developers 포털에서 발급한 App Key/App Secret과 종합계좌번호(앞 8자리)를 입력하세요.", BankCode = "007",
        },
        new()
        {
            Id = BrokerId.Ls, Name = "LS증권", Prefix = "ls", Icon = "🟢", Accent = "#22a06b",
            LabelApiKey = "App Key", LabelSecret = "App Secret", LabelAccount = "계좌번호",
            Hint = "LS증권 Open API 포털에서 발급한 App Key/App Secret과 계좌번호를 입력하세요.", BankCode = "078",
        },
    };

    private int _active;   // 진입 시 첫 탭(토스증권) 활성

    private void Save(BrokerCred b)
    {
        try
        {
            int stored = 0;
            // ★입력 span 을 직접 Store(DPAPI 암호화·평문 파일 미기록). Store 내부에서 CryptographicOperations.ZeroMemory 로 임시 버퍼 소거.
            if (!string.IsNullOrEmpty(b.ApiKey)) { Vault.Store($"{b.Prefix}.apiKey", b.ApiKey.AsSpan()); stored++; }
            if (!string.IsNullOrEmpty(b.Secret)) { Vault.Store($"{b.Prefix}.secret", b.Secret.AsSpan()); stored++; }
            if (!string.IsNullOrEmpty(b.Account))
            {
                // ★BankCode 는 계좌번호와 '함께' 봉인(명세 2 DTO 확장) — 둘 다 DPAPI at-rest.
                Vault.Store($"{b.Prefix}.account", b.Account.AsSpan()); stored++;
                Vault.Store($"{b.Prefix}.bankCode", b.BankCode.AsSpan());
            }

            // ★입력 필드 즉시 소거(평문 잔류 최소화). Blazor 는 string 바인딩이라 완전 char-버퍼 소멸은 아니나, 평문 파일
            //   미기록 + 필드 클리어 + at-rest 암호화로 Zero-Leak 계약 충족. BankCode 는 비민감 → 선택 유지.
            b.ApiKey = ""; b.Secret = ""; b.Account = "";
            b.Ok = stored > 0;
            b.Status = stored > 0
                ? $"✅ {b.Name} 자격증명 {stored}건이 퀀텀 금고에 DPAPI 암호화·봉인되었습니다(입력 소거 완료)."
                : "⚠ 입력값이 비어 있습니다 — API Key·App Secret·계좌번호 중 하나 이상을 입력하세요.";
        }
        catch (Exception ex)
        {
            b.Ok = false;
            b.Status = $"❌ 저장 실패: {ex.Message}";
        }
        finally
        {
            b.SaveTick++;   // 버튼 클릭 시마다 토스트 재점등(성공/경고/실패 모두 선명하게 알림)
        }
    }

    // ★연결 테스트 & 포트폴리오 동기화(명세 3) — UniversalBrokerGatewayMesh(조회 전용) 경유.
    //   ⚠️ 실 토큰/조회 엔드포인트·물리 무장 전엔 어댑터가 미인증 fail-closed(false) → 정직하게 '미동기화'만 보고,
    //      가짜 잔고를 절대 생성하지 않는다. 성공(true) 시에만 '연결 성공 (자산 동기화 완료)' 녹색 배지 점등.
    private void TestConnection(BrokerCred b)
    {
        b.Testing = true;
        try
        {
            var port = Mesh.Get(b.Id);   // 미등록(예: LS) → null(fail-closed)
            if (port is null)
            {
                b.TestOk = false;
                b.TestStatus = $"⚠ {b.Name} 조회 어댑터가 메쉬에 미등록 — 연결 테스트 불가(현재 토스·KIS 조회 어댑터만 등록됨).";
            }
            else if (port.SyncNow())        // ★조회 전용 1회 동기화 트리거(δ=0 파싱)
            {
                b.TestOk = true;
                int n = Account.TryGetAccount(out var snap) ? snap.HoldingCount : 0;
                b.TestStatus = $"✅ {b.Name} 실통신 연결 성공 — {n}개 종목 동기화";
            }
            else
            {
                b.TestOk = false;
                bool stored = Vault.Has($"{b.Prefix}.apiKey");
                b.TestStatus = stored
                    ? "⛔ 연결 미완료 — 자격증명은 금고에 저장됨. 실 토큰·조회 엔드포인트 배선 및 물리 이중 키 무장 후 동기화됩니다(liveArmed:false fail-closed)."
                    : "⛔ 연결 미완료 — 먼저 [저장 및 퀀텀 금고 봉인]으로 자격증명을 저장하세요. 이후 실 트랜스포트·무장 시 동기화(fail-closed).";
            }
        }
        catch (Exception ex)
        {
            b.TestOk = false;
            b.TestStatus = $"❌ 연결 테스트 오류: {ex.Message}";
        }
        finally
        {
            b.Testing = false;
            b.TestTick++;
        }
    }
}

<style>
    .cred-wrap{padding:22px 26px;max-width:960px}
    .cred-wrap h2{margin:0 0 6px;font-size:20px}
    .cred-wrap .sub{color:#8b97ad;font-size:13px;line-height:1.6;margin:0 0 18px}

    /* 증권사 탭 바 */
    .cred-tabs{display:flex;gap:6px;border-bottom:1px solid #2a3550;margin-bottom:16px;flex-wrap:wrap}
    .cred-tab{display:flex;align-items:center;gap:8px;background:transparent;border:0;border-bottom:2.5px solid transparent;color:#8b97ad;padding:10px 16px;font-size:13.5px;font-weight:600;cursor:pointer;border-radius:8px 8px 0 0;transition:color .15s,background .15s}
    .cred-tab:hover{color:#cdd9ef;background:rgba(255,255,255,.03)}
    .cred-tab.active{color:#fff;border-bottom-color:var(--accent,#3182f6);background:rgba(255,255,255,.05)}
    .cred-tab-ic{font-size:14px}
    .cred-tab-dot{color:#8fdca4;font-size:12px;font-weight:900;margin-left:2px}

    /* 활성 증권사 카드 */
    .cred-card{background:rgba(30,40,64,.35);border:1px solid #2a3550;border-left:3px solid var(--accent,#3182f6);border-radius:10px;padding:18px}
    .cred-broker{display:flex;align-items:center;gap:8px;font-weight:800;font-size:15px;margin-bottom:6px;color:#cdd9ef}
    .cred-broker-ic{font-size:16px}
    .cred-hint{font-size:12px;color:#8b97ad;margin-bottom:14px;line-height:1.5}
    .cred-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
    .cred-field{display:flex;flex-direction:column;gap:5px}
    .cred-lab{font-size:11px;font-weight:700;letter-spacing:.03em;color:#8b97ad}
    .cred-in{background:#0f1626;border:1px solid #2a3550;color:#dfe7f5;border-radius:6px;padding:9px 11px;font-family:monospace;font-size:12.5px;width:100%;box-sizing:border-box;transition:border-color .15s}
    .cred-in:focus{outline:none;border-color:var(--accent,#3182f6)}
    .cred-sel{font-family:inherit;cursor:pointer}
    .cred-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .cred-save{background:linear-gradient(180deg,#2d6be0,#1f52bb);color:#fff;border:0;border-radius:8px;padding:10px 18px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap}
    .cred-save:hover{filter:brightness(1.08)}
    .cred-test{background:transparent;color:#cdd9ef;border:1px solid #3a4869;border-radius:8px;padding:10px 16px;font-weight:600;font-size:13px;cursor:pointer;white-space:nowrap}
    .cred-test:hover:not(:disabled){background:rgba(255,255,255,.05);border-color:var(--accent,#3182f6)}
    .cred-test:disabled{opacity:.55;cursor:default}

    /* 저장 성공 알림 — 선명하게 점등(글로우 replay) */
    .cred-toast{display:flex;align-items:center;gap:8px;margin-top:14px;padding:11px 14px;border-radius:8px;font-size:13px;font-weight:600;animation:credpulse .55s ease-out}
    .cred-toast-ic{font-size:15px}
    .cred-toast.ok{background:rgba(34,160,107,.16);border:1px solid rgba(34,160,107,.5);color:#a5e8bd}
    .cred-toast.bad{background:rgba(231,154,90,.14);border:1px solid rgba(231,154,90,.45);color:#f0c088}

    /* 연결 테스트 배지 */
    .cred-testbadge{margin-top:10px;padding:10px 14px;border-radius:8px;font-size:12.5px;font-weight:600;animation:credpulse .55s ease-out}
    .cred-testbadge.ok{background:rgba(34,160,107,.2);border:1px solid rgba(34,160,107,.6);color:#a5e8bd;box-shadow:0 0 14px rgba(34,160,107,.25)}
    .cred-testbadge.warn{background:rgba(120,140,170,.12);border:1px solid #3a4869;color:#aeb9cf}
    @@keyframes credpulse{0%{opacity:0;transform:translateY(-6px);box-shadow:0 0 20px 3px rgba(34,160,107,.55)}100%{opacity:1;transform:translateY(0);box-shadow:0 0 0 rgba(34,160,107,0)}}

    .cred-note{margin-top:16px;color:#7b8aa4;font-size:12px;line-height:1.6}
    .cred-note code{background:#0f1626;padding:1px 6px;border-radius:4px;font-family:monospace;color:#cdd9ef}
</style>
