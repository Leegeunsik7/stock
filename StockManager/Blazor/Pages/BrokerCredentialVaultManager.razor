@* ============================================================================
   BrokerCredentialVaultManager.razor — v11.0.0: 다중 증권사 API 자격증명 UI 매니저 (Admin 하위·Zero-Leak)
     각 증권사별 API Key·App Secret·계좌번호를 입력·관리. ★평문은 디스크/JSON 에 절대 저장 안 됨 — 입력 즉시
     SecurityAssetVault.Store(DPAPI CurrentUser at-rest 암호화) 후 입력 필드 소거(SecureAdminViewPresenter 철학 계승).
   ============================================================================ *@
@page "/admin/credentials"
@using StockManager.Common
@inject SecurityAssetVault Vault

<div class="cred-wrap">
    <h2>💳 다중 증권사 API 자격증명 금고</h2>
    <p class="sub">API Key·App Secret·계좌번호를 입력하면 <b>즉시 DPAPI(CurrentUser) 암호화</b>되어 저장됩니다(At-Rest Encryption).
        평문은 하드디스크·일반 JSON 설정에 <b>절대 저장되지 않으며</b>, 저장 즉시 입력 필드가 소거됩니다.
        ★자격증명이 등록돼도 물리 이중 키 무장 전에는 실물 발주가 100% Veto 됩니다(liveArmed:false).</p>

    @foreach (var b in _brokers)
    {
        <div class="cred-card">
            <div class="cred-broker">@b.Name</div>
            <div class="cred-row">
                <input class="cred-in" @bind="b.ApiKey" placeholder="API Key" type="password" autocomplete="off" />
                <input class="cred-in" @bind="b.Secret" placeholder="App Secret" type="password" autocomplete="off" />
                <input class="cred-in" @bind="b.Account" placeholder="계좌번호" autocomplete="off" />
                <button class="cred-save" @onclick="() => Save(b)">🔐 암호화 저장</button>
            </div>
            @if (!string.IsNullOrEmpty(b.Status))
            {
                <div class="cred-status @(b.Ok ? "ok" : "bad")">@b.Status</div>
            }
        </div>
    }
    <div class="cred-note">🔒 저장된 자격증명은 <code>SecurityAssetVault.Reveal</code>(무장·비봉인·비동결 시에만·SecretLease char 버퍼 wipe-on-dispose)로만 복호화되며, 발주 경로는 <code>UniversalOrderExecutionAdapter</code>→<code>GenesisLiveIgnitionGateway.Emit</code>(이중 물리 키 인터락)을 반드시 경유합니다.</div>
</div>

@code {
    private sealed class BrokerCred
    {
        public string Name = "";
        public string Prefix = "";
        public string ApiKey = "";
        public string Secret = "";
        public string Account = "";
        public string Status = "";
        public bool Ok;
    }

    private readonly List<BrokerCred> _brokers = new()
    {
        new() { Name = "토스증권", Prefix = "toss" },
        new() { Name = "한국투자증권 (KIS)", Prefix = "kis" },
        new() { Name = "LS증권", Prefix = "ls" },
    };

    private void Save(BrokerCred b)
    {
        try
        {
            int stored = 0;
            // ★입력 span 을 직접 Store(DPAPI 암호화·평문 파일 미기록). Store 내부에서 CryptographicOperations.ZeroMemory 로 임시 버퍼 소거.
            if (!string.IsNullOrEmpty(b.ApiKey))  { Vault.Store($"{b.Prefix}.apiKey",  b.ApiKey.AsSpan());  stored++; }
            if (!string.IsNullOrEmpty(b.Secret))  { Vault.Store($"{b.Prefix}.secret",  b.Secret.AsSpan());  stored++; }
            if (!string.IsNullOrEmpty(b.Account)) { Vault.Store($"{b.Prefix}.account", b.Account.AsSpan()); stored++; }

            // ★입력 필드 즉시 소거(평문 잔류 최소화). Blazor 는 string 바인딩이라 완전 char-버퍼 소멸은 아니나, 평문 파일
            //   미기록 + 필드 클리어 + at-rest 암호화로 Zero-Leak 계약 충족.
            b.ApiKey = ""; b.Secret = ""; b.Account = "";
            b.Ok = stored > 0;
            b.Status = stored > 0 ? $"✅ {stored}건 DPAPI 암호화 저장됨(입력 소거)." : "⚠ 입력값이 비어 있습니다.";
        }
        catch (Exception ex)
        {
            b.Ok = false;
            b.Status = $"❌ 저장 실패: {ex.Message}";
        }
    }
}

<style>
    .cred-wrap{padding:22px 26px;max-width:960px}
    .cred-wrap h2{margin:0 0 6px;font-size:20px}
    .cred-wrap .sub{color:#8b97ad;font-size:13px;line-height:1.6;margin:0 0 16px}
    .cred-card{background:rgba(30,40,64,.35);border:1px solid #2a3550;border-radius:10px;padding:14px 16px;margin-bottom:12px}
    .cred-broker{font-weight:800;font-size:14px;margin-bottom:8px;color:#cdd9ef}
    .cred-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
    .cred-in{background:#0f1626;border:1px solid #2a3550;color:#dfe7f5;border-radius:6px;padding:7px 10px;font-family:monospace;font-size:12.5px;min-width:180px;flex:1}
    .cred-save{background:linear-gradient(180deg,#2d6be0,#1f52bb);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:700;cursor:pointer;white-space:nowrap}
    .cred-status{margin-top:8px;font-size:12.5px;font-weight:600}
    .cred-status.ok{color:#8fdca4}
    .cred-status.bad{color:#e79a9a}
    .cred-note{margin-top:14px;color:#7b8aa4;font-size:12px;line-height:1.6}
    .cred-note code{background:#0f1626;padding:1px 6px;border-radius:4px;font-family:monospace;color:#cdd9ef}
</style>
