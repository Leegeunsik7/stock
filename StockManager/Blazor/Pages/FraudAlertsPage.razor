@page "/fraud-alerts"
@inject LocalDatabase Db

<div class="top">
    <div class="hello">
        <h1>🚨 부정거래 경고
            @if (_unreviewed > 0)
            {
                <span class="pill r" style="margin-left:10px;font-size:13px;vertical-align:middle">@_unreviewed 미검토</span>
            }
        </h1>
        <p>AddTransaction() 검증 실패 자동 기록 · 총 @(_all.Count)건 / 표시 @(_filtered.Count)건</p>
    </div>
    <div style="display:flex;gap:8px">
        @if (_unreviewed > 0)
        {
            <button class="addbtn" @onclick="MarkAll">✅ 전체 검토완료</button>
        }
        <button class="addbtn" @onclick="Load">🔄 새로고침</button>
    </div>
</div>

<div style="display:flex;gap:8px;padding:0 28px 14px;flex-wrap:wrap;align-items:center">
    <input class="srch" placeholder="🔍 종목·사유 검색…" @bind="_q" @bind:event="oninput" />
    <label style="display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--sub);cursor:pointer">
        <input type="checkbox" @bind="_unreviewedOnly" /> 미검토만
    </label>
</div>

@if (_filtered.Count == 0)
{
    <div style="padding:60px 28px;text-align:center;color:var(--sub);font-size:14px">
        @(_all.Count == 0 ? "🟢 부정거래 감지 이력이 없습니다" : "🔍 필터 조건에 맞는 결과 없음")
    </div>
}
else
{
    <div style="overflow:auto;padding:0 28px 40px">
        <table class="ctbl">
            <thead>
                <tr>
                    <th style="white-space:nowrap">시간(UTC)</th>
                    <th>종목</th>
                    <th>거래유형</th>
                    <th>검증 실패 사유</th>
                    <th style="width:72px;text-align:center">검토</th>
                    <th style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fa in _filtered.Take(500))
                {
                    <tr style="@RowStyle(fa)">
                        <td style="font-size:11.5px;white-space:nowrap;color:var(--sub)">
                            @fa.AttemptedAt.ToString("MM-dd HH:mm:ss")
                        </td>
                        <td style="font-size:13px"><b>@fa.Symbol</b></td>
                        <td style="font-size:12px;color:var(--sub)">@fa.TransactionType</td>
                        <td style="font-size:12px;max-width:380px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                            title="@fa.Reason">
                            @fa.Reason
                        </td>
                        <td style="text-align:center">
                            @if (fa.IsReviewed)
                            {
                                <span style="font-size:11px;color:var(--sub)">완료</span>
                            }
                            else
                            {
                                <span class="pill r" style="font-size:10px">미검토</span>
                            }
                        </td>
                        <td>
                            @if (!fa.IsReviewed)
                            {
                                <button class="addbtn" style="font-size:11px;padding:3px 8px"
                                        @onclick="() => MarkOne(fa.Id)">
                                    검토완료
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<FraudAlert> _all = new();
    private string _q = "";
    private bool _unreviewedOnly;
    private int _unreviewed;

    private List<FraudAlert> _filtered => _all
        .Where(fa =>
            (string.IsNullOrEmpty(_q)
                || fa.Symbol.Contains(_q, StringComparison.OrdinalIgnoreCase)
                || fa.Reason.Contains(_q, StringComparison.OrdinalIgnoreCase))
            && (!_unreviewedOnly || !fa.IsReviewed))
        .ToList();

    protected override void OnInitialized() => Load();

    private void Load()
    {
        try
        {
            _all        = Db.GetFraudAlerts(500);
            _unreviewed = Db.GetUnreviewedFraudCount();
        }
        catch { }
    }

    private void MarkOne(int id)
    {
        try { Db.MarkFraudReviewed(id); Load(); } catch { }
    }

    private void MarkAll()
    {
        try { Db.MarkAllFraudReviewed(); Load(); } catch { }
    }

    private static string RowStyle(FraudAlert fa) =>
        fa.IsReviewed
            ? "color:var(--sub);"
            : "font-weight:700;color:var(--down);";
}
