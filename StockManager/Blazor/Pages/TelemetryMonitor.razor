                    }
                    else if (qArmed)
                    {
                        <span class="prod-badge" style="background:rgba(66,133,244,0.22);color:#5b9bff;box-shadow:0 0 8px rgba(66,133,244,0.55)">[QUANTUM VAULT ACTIVE - WATCHING]</span>
