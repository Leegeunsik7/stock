                <div class="kpi-sub">가속 티어 <b style="color:@(aZmm ? "#b39ddf" : (aFall ? "#ffb74d" : "#9e9e9e"))">@_frame.AvxTierName</b> · op 지연 <b style="font-family:var(--mono)">@_frame.SimdAlphaLatencyNanos.ToString("N0")ns</b></div>
