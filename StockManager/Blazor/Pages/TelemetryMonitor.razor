    <div class="kpi-card @(qBreach ? "kpi-alert" : (qHook ? "kpi-amber" : (qClean ? "kpi-hotswap-ok" : "")))" style="margin-bottom:22px">
        <div class="kpi-label">🔒 Quantum Vault &amp; Phase 83 Infra Liberation (안티-RAM 퀀텀 금고 · 인프라 해방)</div>
        <div style="display:flex;gap:28px;flex-wrap:wrap;margin-top:6px">
            <div style="min-width:360px">
                <div class="kpi-value" style="font-size:15px">
