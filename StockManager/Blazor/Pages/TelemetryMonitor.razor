@* ============================================================================
   TelemetryMonitor — S29 Path Gamma: 파이프라인 디스패치 링 락-프리 관제탑
   PeriodicTimer(150ms) + RingTelemetryChannel.TryRead 세쿼록 단방향 폴링.
   TryRead false → 직전 프레임 유지(StateHasChanged 불호출, 코어 무블록).
   SendErrors > 0 → 비상 경보 오버레이(downstream throw = 비상 동결 신호).
   ============================================================================ *@
@page "/broker/pipeline"
@implements IAsyncDisposable
@using System.Threading
@inject RingTelemetryChannel Channel
@inject OrderAttestationService Attestation
@inject StrategyEvolutionPipeline Pipeline
@inject DeterministicWarmRestartEngine Recovery
@inject DeterministicChaosGrid Chaos
@inject NewsIntelController NewsIntel
@inject IJSRuntime JS

<div class="top">
    <div class="hello">
        <h1>📡 파이프라인 관제 <span class="tag">DISPATCH RING TELEMETRY</span></h1>
        <p>SPMC 주문 디스패치 링의 실시간 지표 — 150ms 락-프리 폴링, 코어 무블록. SendErrors &gt; 0 = 비상 동결 확인.</p>
    </div>
</div>

@* ══ v4.93.0 감성 속도 서킷 브레이커 Amber 오버레이 ═══════════════════════════ *@
@if (_frame.SentimentBreakerActive)
{
    <div style="margin:0 28px 18px;background:rgba(255,152,0,0.18);border:2px solid #ff9800;border-radius:10px;padding:18px 22px;animation:recpulse 1s ease-in-out infinite">
        <div style="font-size:16px;font-weight:700;color:#ff9800;margin-bottom:6px">🟠 [SENTIMENT VELOCITY BREAKER TRIP — SYSTEM DOWNGRADED]</div>
        <div style="font-size:13px;color:#ffcc80">
            최근 5분 창 감성 3σ 하향 드리프트 폭주 감지 — 발주 무장 단계가 자동 강등되었습니다(MasterIgnited→ProbeReady).
            &nbsp;신규 진입 보류 · 뉴스 진위 확인 후 운영자 재무장 필요.
        </div>
    </div>
}

@* ══ SendErrors 비상 경보 오버레이 ═══════════════════════════════════════════ *@
@if (_frame.HasAlert)
{
    <div style="margin:0 28px 18px;background:rgba(180,20,20,0.18);border:2px solid #e34d4d;border-radius:10px;padding:18px 22px">
        <div style="font-size:16px;font-weight:700;color:#ff4444;margin-bottom:6px">🚨 DOWNSTREAM THROW 감지 — 비상 동결 확인 필요</div>
        <div style="font-size:13px;color:#ffaaaa">
            <b>SendErrors = @(_frame.SendErrors)</b> — onSend(브로커 송출)에서 예외 발생, ForceFreeze 호출됨.
            &nbsp;현재 게이팅 모드: <b>@(Attestation.Mode)</b>.
            &nbsp;/broker/gating 에서 원장 확인 후 수동 정합 서명을 완료하세요.
        </div>
    </div>
}

@* ══ v4.88.0 원장 메시 오버플로 대형 레드 오버레이 ═══════════════════════════ *@
@if (_frame.LedgerOverflowAlert)
{
    <div style="margin:0 28px 18px;background:rgba(180,20,20,0.22);border:2px solid #e34d4d;border-radius:10px;padding:18px 22px">
        <div style="font-size:16px;font-weight:700;color:#ff4444;margin-bottom:6px">🚨 LEDGER PROTECTION MESH OVERFLOW — 디스크 쓰기 기아 · 전역 동결</div>
        <div style="font-size:13px;color:#ffaaaa">
            비동기 원장 큐가 <b>@(_frame.LedgerSaturationPct.ToString("F0"))%</b> 포화(임계 90%)되었거나 영속화 실패
            (<b>@(_frame.LedgerWriteFailures.ToString("N0"))</b>건)로 <b>ForceFreeze</b> 격발됨.
            &nbsp;현재 게이팅 모드: <b>@(Attestation.Mode)</b>. &nbsp;디스크 여유·DB 락 점검 후 /broker/gating 에서 수동 정합 서명하세요.
        </div>
    </div>
}

@* ══ 계기판 ════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 28px">

    @* 상단 KPI 카드 열 *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px">
        <div class="kpi-card @(_frame.HasAlert ? "kpi-alert" : "")">
            <div class="kpi-label">Published</div>
            <div class="kpi-value">@(_frame.Published < 0 ? "—" : _frame.Published.ToString("N0"))</div>
            <div class="kpi-sub">링 최고 발행 시퀀스</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Forwarded</div>
            <div class="kpi-value" style="color:var(--green,#4caf50)">@(_frame.Forwarded.ToString("N0"))</div>
            <div class="kpi-sub">무장 실송출 (성공)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">GatedOut</div>
            <div class="kpi-value" style="color:var(--yellow,#ffc107)">@(_frame.GatedOut.ToString("N0"))</div>
            <div class="kpi-sub">미무장 차단 (fail-closed)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Dropped</div>
            <div class="kpi-value" style="color:@(_frame.Dropped > 0 ? "var(--orange,#ff9800)" : "inherit")">@(_frame.Dropped.ToString("N0"))</div>
            <div class="kpi-sub">추월 유실 (소비 지연)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">WriterCollisions</div>
            <div class="kpi-value" style="color:@(_frame.WriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.WriterCollisions.ToString("N0"))</div>
            <div class="kpi-sub">동시 발행 위반 (CAS 낙방)</div>
        </div>
        <div class="kpi-card @(_frame.HasAlert ? "kpi-alert" : "")">
            <div class="kpi-label">SendErrors</div>
            <div class="kpi-value" style="color:@(_frame.SendErrors > 0 ? "#ff4444" : "inherit");font-weight:@(_frame.SendErrors > 0 ? "800" : "400")">@(_frame.SendErrors.ToString("N0"))</div>
            <div class="kpi-sub">downstream throw 누적</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Throughput</div>
            <div class="kpi-value">@(_frame.ThroughputPerSec.ToString("N1"))</div>
            <div class="kpi-sub">건/초 (직전 샘플 델타)</div>
        </div>
    </div>

    @* ══ δ=0 실시간 추세 차트 — Canvas(JS) 직접 드로잉. C# 은 매 틱 스칼라 2개만 push(SVG 문자열 KB 폭발 없음) ══ *@
    <div style="background:var(--card-bg,rgba(255,255,255,0.04));border:1px solid var(--border,rgba(255,255,255,0.08));border-radius:10px;padding:12px 14px;margin-bottom:22px">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
            <span class="kpi-label">최근 @(ChartCapacity)프레임 추세 (~@(ChartCapacity * 150 / 1000)초)</span>
            <span style="font-size:11px;color:var(--muted,#888)"><span style="display:inline-block;width:12px;height:2px;background:#4caf50;vertical-align:middle"></span> Throughput</span>
            <span style="font-size:11px;color:var(--muted,#888)"><span style="display:inline-block;width:12px;height:2px;background:#f44336;vertical-align:middle"></span> WriterCollisions</span>
        </div>
        @* width/height = 픽셀 백버퍼. 문자열·MarkupString 미사용 — 좌표는 전부 JS 측 Float64Array→canvas. *@
        <canvas id="@ChartId" width="900" height="120" style="width:100%;height:120px;display:block"></canvas>
    </div>

    @* ══ 다중 seqlock 교차 관제(주문 파이프라인 ↔ 시나리오 변이) ══════════════════ *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:22px">
        <div class="kpi-card">
            <div class="kpi-label">📡 주문 파이프라인 seqlock</div>
            <div style="display:flex;gap:20px;margin-top:6px">
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.WriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.WriterCollisions.ToString("N0"))</div><div class="kpi-sub">라이터 경합</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(_tornReads.ToString("N0"))</div><div class="kpi-sub">읽기 경합(torn 재시도·UI계수)</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(Channel.Version.ToString("N0"))</div><div class="kpi-sub">채널 버전</div></div>
            </div>
        </div>
        <div class="kpi-card @(_frame.ScenarioFrozen > 0 ? "kpi-alert" : "")">
            <div class="kpi-label">🌀 시나리오 변이 seqlock @(_frame.ScenarioActive ? "" : "(비활성)")</div>
            <div style="display:flex;gap:20px;margin-top:6px">
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.ScenarioWriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.ScenarioWriterCollisions.ToString("N0"))</div><div class="kpi-sub">라이터 경합(슬라이더)</div></div>
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.ScenarioFrozen > 0 ? "#ff4444" : "inherit")">@(_frame.ScenarioFrozen.ToString("N0"))</div><div class="kpi-sub">산출 동결</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(_frame.ScenarioVersion.ToString("N0"))</div><div class="kpi-sub">발행 버전</div></div>
            </div>
            @if (!_frame.ScenarioActive)
            {
                <div class="kpi-sub" style="margin-top:6px">미래가치 시뮬(/future/sim) 열면 슬라이더 경합이 실시간 합류됩니다.</div>
            }
        </div>
    </div>

    @* ══ 자율 알파 공장 카운터 + 자기 제어 밸브(v4.85.0) ══════════════════════════ *@
    <div class="kpi-card @(_frame.AlphaFactoryAmber ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">
            🏭 자율 알파 공장 @(_frame.AlphaFactoryActive ? "" : "(첫 사이클 대기 중)")
            @if (_frame.AlphaFactorySuspended != 0)
            {
                <span style="margin-left:8px;padding:2px 8px;border-radius:6px;background:#ff9800;color:#111;font-weight:700;font-size:10px">⏸ SUSPENDED (밸브 트립)</span>
            }
        </div>
        @if (_frame.AlphaFactoryAmber)
        {
            <div style="margin:8px 0;padding:10px 14px;background:rgba(255,152,0,0.14);border:1px solid #ff9800;border-radius:8px;font-size:12px;color:#ffcc80">
                🟠 AMBER — 최근 롤링 거부율 <b>@((_frame.AlphaFactoryRecentRejRate * 100.0).ToString("F1"))%</b>
                (임계 95%). 전략 고갈/오작동 의심 —
                @(_frame.AlphaFactorySuspended != 0
                    ? "자기 제어 밸브가 공장을 자동 일시정지했습니다(사이클 스킵). 원인 점검 후 Resume."
                    : "임계 도달 시 공장이 자동 일시정지됩니다.")
            </div>
        }
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.AlphaFactoryActive ? _frame.AlphaFactoryCycles.ToString("N0") : "—")</div>
                <div class="kpi-sub">완료 사이클 (24h 주기)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:var(--green,#4caf50)">@(_frame.AlphaFactoryActive ? _frame.AlphaFactorySigned.ToString("N0") : "—")</div>
                <div class="kpi-sub">서명 완료 전략 수</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.AlphaFactoryRejected > 0 ? "var(--orange,#ff9800)" : "inherit")">@(_frame.AlphaFactoryActive ? _frame.AlphaFactoryRejected.ToString("N0") : "—")</div>
                <div class="kpi-sub">가드 거부 수 (수치 검증 실패)</div>
            </div>
            @{
                long denom = _frame.AlphaFactorySigned + _frame.AlphaFactoryRejected;
                string rejRate = (denom > 0) ? ((double)_frame.AlphaFactoryRejected / denom * 100.0).ToString("F1") + "%" : "—";
            }
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.AlphaFactoryActive ? rejRate : "—")</div>
                <div class="kpi-sub">거부율 (누적·가드/전체)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.AlphaFactoryRecentRejRate >= 0.95 ? "#ff9800" : "inherit")">@(_frame.AlphaFactoryActive ? (_frame.AlphaFactoryRecentRejRate * 100.0).ToString("F1") + "%" : "—")</div>
                <div class="kpi-sub">최근 거부율 (롤링·밸브 기준)</div>
            </div>
        </div>
        @if (!_frame.AlphaFactoryActive)
        {
            <div class="kpi-sub" style="margin-top:6px">AutonomousAlphaFactory 배선됨 — 첫 24h 사이클 완료 후 지표 표시. RunCycle() 직접 호출로 즉시 확인 가능.</div>
        }
    </div>

    @* ══ 자율 전략 진화 토너먼트 파이프라인(v4.86.0) ══════════════════════════════ *@
    @{
        // 서명 성공률 표기(시도 없거나 0이면 — 로 정직 표기).
        string signRate = (_frame.AlphaSigningSuccessRate > 0 || _frame.AlphaPromoted > 0)
            ? (_frame.AlphaSigningSuccessRate * 100.0).ToString("F1") + "%" : "—";
    }
    <div class="kpi-card @(_frame.AlphaPipelinePaused ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">
            🧬 자율 전략 진화 파이프라인
            <span style="margin-left:8px;padding:2px 8px;border-radius:6px;background:@(_frame.AlphaPipelinePaused ? "#ff9800" : "rgba(120,140,170,0.35)");color:@(_frame.AlphaPipelinePaused ? "#111" : "#cfe");font-weight:700;font-size:10px">@(_frame.AlphaPipelineModeName)</span>
        </div>
        @if (_frame.AlphaPipelinePaused)
        {
            <div style="margin:8px 0;padding:10px 14px;background:rgba(255,152,0,0.14);border:1px solid #ff9800;border-radius:8px;font-size:12px;color:#ffcc80">
                🟠 PAUSED — 알파 공장 밸브 SUSPENDED 또는 EmergencyFreeze 와 동기화되어 토너먼트가 자율 일시정지되었습니다.
            </div>
        }
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px;font-family:var(--mono)">@(string.IsNullOrEmpty(Pipeline.CurrentGenomeId) ? "—" : Pipeline.CurrentGenomeId)</div>
                <div class="kpi-sub">테스트 중 유전자 ID</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:var(--green,#4caf50)">@(string.IsNullOrEmpty(Pipeline.LastChampion) ? "—" : Pipeline.LastChampion)</div>
                <div class="kpi-sub">최근 승격 챔피언</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.AlphaPromoted.ToString("N0"))</div>
                <div class="kpi-sub">승격 제출 (PendingApproval)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@signRate</div>
                <div class="kpi-sub">서명 성공률</div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:8px">
            🔒 승격 제출은 <b>PendingApproval</b> 까지만 — 지휘관 인간 서명 승인 + 실거래 이중키(ValveWired ∧ LiveArmingWired)
            전까지 어떤 실주문 엔진에도 자동 배선되지 않습니다(liveArmed:false).
        </div>
    </div>

    @* ══ 집행 미시구조 관제(v4.87.0) — IgnitionLock FSM + 슬리피지 3σ ═══════════════ *@
    @{
        double sigDisp  = (double)_frame.SlippageSigmaDecimal;
        double slipAbs  = Math.Abs((double)_frame.SlippageDecimal);
        double band3    = sigDisp * 3.0;
        bool   warmup   = sigDisp <= 0.0;
        double barPct   = (band3 > 1e-12) ? Math.Min(100.0, slipAbs / band3 * 100.0) : 0.0;
        string barColor = barPct >= 100.0 ? "#f44336" : (barPct >= 66.0 ? "#ff9800" : "#4caf50");
        string fsmBg = _frame.IgnitionStageCode switch
        {
            3 => (_frame.ExecDowngrades > 0 ? "#e34d4d" : "#4caf50"),   // MasterIgnited: 녹색(강등 이력 시 적색)
            1 => "#ffc107",                                             // ProbeReady: 황색
            2 => "#42a5f5",                                             // TimeBoxOpen: 청색
            _ => "#888"                                                 // Locked: 회색
        };
    }
    <div class="kpi-card @(_frame.ExecDowngrades > 0 ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">
            ⚡ 집행 미시구조 (Microstructure Execution)
            <span style="margin-left:8px;padding:2px 10px;border-radius:6px;background:@fsmBg;color:#111;font-weight:700;font-size:11px">
                @(_frame.IgnitionStageName)
            </span>
        </div>
        @if (_frame.ExecDowngrades > 0)
        {
            <div style="margin:8px 0;padding:10px 14px;background:rgba(255,152,0,0.16);border:1px solid #ff9800;border-radius:8px;font-size:12px;color:#ffcc80">
                🟠 STEP-DOWN 격발 — 슬리피지 3σ 2연속 또는 체결 레이턴시 100ms 초과로 점화 단계가 강등되었습니다
                (누적 <b>@(_frame.ExecDowngrades.ToString("N0"))</b>회). 추가 대형 발주가 물리적으로 차단됩니다.
            </div>
        }
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px;font-family:var(--mono)">@(_frame.SlippageDecimal.ToString("+0.00000000;-0.00000000;0"))</div>
                <div class="kpi-sub">실시간 슬리피지 (raw·기대−체결)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(warmup ? "워밍업" : "±" + _frame.SlippageSigmaDecimal.ToString("0.00000000"))</div>
                <div class="kpi-sub">롤링 표준편차 (σ)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.ExecDowngrades > 0 ? "#ff9800" : "inherit")">@(_frame.ExecDowngrades.ToString("N0"))</div>
                <div class="kpi-sub">FSM 강등 누적</div>
            </div>
        </div>
        @* 3σ 임계 진척 바(Pure CSS) — |슬리피지| / 3σ. 워밍업(σ 미확립)이면 판정 보류 표기. *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">3σ 임계 근접도 @(warmup ? "(워밍업 — 표본 &lt;10, 판정 보류·fail-closed)" : $"({barPct:F0}%)")</div>
            <div style="height:10px;border-radius:5px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(warmup ? 0 : barPct.ToString("F1"))%;background:@barColor;transition:width .2s"></div>
            </div>
        </div>
    </div>

    @* ══ 원장 보호 메시 관제(v4.88.0) — 비동기 큐 깊이 게이지 + I/O 레이턴시 ═══════════ *@
    @{
        double ledSat  = _frame.LedgerSaturationPct;
        string ledColor = ledSat >= 90.0 ? "#f44336" : (ledSat >= 70.0 ? "#ff9800" : "#4caf50");
    }
    <div class="kpi-card @(_frame.LedgerOverflowAlert ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🗄️ 원장 보호 메시 (Ledger Protection Mesh) — 발주 핫패스 비동기 분리</div>
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.LedgerQueueDepth.ToString("N0")) / @(_frame.LedgerCapacity.ToString("N0"))</div>
                <div class="kpi-sub">큐 깊이 / 용량</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.LedgerAvgPersistMicros.ToString("N1")) µs</div>
                <div class="kpi-sub">평균 디스크 영속화 소요</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.LedgerWriteFailures > 0 ? "#f44336" : "inherit")">@(_frame.LedgerWriteFailures.ToString("N0"))</div>
                <div class="kpi-sub">누적 쓰기 실패</div>
            </div>
        </div>
        @* 큐 깊이 게이지(Pure CSS) — 0~70% 녹색·70~90% 황색·90%+ 적색. *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">큐 포화도 @(ledSat.ToString("F0"))% @(ledSat >= 90.0 ? "🔴 오버플로(전역 동결)" : ledSat >= 70.0 ? "🟠 경계" : "🟢 정상")</div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(Math.Min(100.0, ledSat).ToString("F1"))%;background:@ledColor;transition:width .2s"></div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:8px">
            핫패스는 blittable 페이로드를 무할당·논블로킹으로 큐에 밀어 넣고 즉시 복귀 — 전용 드레인 스레드가 AddTransaction +
            RecomputeAverage 를 순차 격리 실행(장부/평단 디싱크 차단). 90% 포화·영속화 실패 시 ForceFreeze(fail-closed).
        </div>
    </div>

    @* ══ v4.90.0 결정론적 웜 스타트 복구 관제 패널 ═══════════════════════════════ *@
    @{
        var recStages = new[] { RecoveryState.Idle, RecoveryState.Validating, RecoveryState.Draining, RecoveryState.Escalating, RecoveryState.Stable };
        double recBacklogPct = _frame.LedgerCapacity > 0 ? Math.Min(100.0, (double)_frame.RecoveryBacklog / _frame.LedgerCapacity * 100.0) : 0.0;
        bool recRttWarn = _frame.ProbeRttMs > 50;
    }
    <div class="kpi-card @(_frame.RecoveryStage == RecoveryState.Frozen ? "kpi-alert" : (_frame.RecoveryActive ? "kpi-amber" : ""))" style="margin-bottom:22px">
        <div class="kpi-label">🛠️ 웜 스타트 복구 관제 (Deterministic Warm-Restart Control Panel)</div>
        @* 복구 단계 타임라인 배지 — Stable 녹 / Draining·Escalating 황색 점멸 / Idle 회 / Frozen 적. *@
        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;align-items:center">
            @foreach (var st in recStages)
            {
                bool active = _frame.RecoveryStage == st;
                <span class="rec-badge @(active ? RecoveryCss(st) : "rec-idle")" style="@(active ? "" : "opacity:.4")">@st</span>
                @if (st != RecoveryState.Stable) { <span style="color:var(--muted,#888)">→</span> }
            }
            @if (_frame.RecoveryStage == RecoveryState.Frozen)
            { <span class="rec-badge rec-frozen" style="margin-left:8px">⛔ FROZEN</span> }
        </div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.RecoveryStateName)</div>
                <div class="kpi-sub">현재 복구 단계</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.RecoveryBacklog.ToString("N0"))</div>
                <div class="kpi-sub">드레인 잔여 백로그</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(recRttWarn ? "#f44336" : "inherit")">@(_frame.ProbeRttMs.ToString("N0")) ms</div>
                <div class="kpi-sub">프로브 파이프 RTT (≤50ms)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.ProbeSlippageSigmaDecimal.ToString("F2"))σ</div>
                <div class="kpi-sub">프로브 슬리피지 (3σ 게이트)</div>
            </div>
        </div>
        @* 백로그 소진 게이지(Pure CSS) *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">백로그 잔여 @(_frame.RecoveryBacklog.ToString("N0"))건</div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(recBacklogPct.ToString("F1"))%;background:#ff9800;transition:width .2s"></div>
            </div>
        </div>
        @* 🔐 운영자 서명 입력 → 수동 해제 + 웜 스타트 트리거(순수 HTML) *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🔐 운영자 서명 입력 → 수동 해제 + 웜 스타트 (현재 게이팅: <b>@(Attestation.Mode)</b>)</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_sig" @bind:event="oninput" placeholder="운영자 서명(예: OPERATOR-20260710-…)"
                       style="flex:1;min-width:240px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoWarmRestart" disabled="@_frame.RecoveryActive"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#c0392b;color:#fff;font-weight:600;@(_frame.RecoveryActive ? "opacity:.5;cursor:not-allowed" : "")">
                    🛠️ 웜 스타트 실행
                </button>
                @if (!string.IsNullOrEmpty(_recMsg)) { <span class="kpi-sub">@_recMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                서명 확인 → 금고 해제·백로그 순차 드레인(동결창 가격정합성 펜스) → 점화 Locked→ProbeReady→1주 프로브(3σ·지연&lt;50ms 검증)→MasterIgnited.
                복구 중에는 라이브 라우팅이 무조건 차단됩니다(주문 폭주 방지). 실패 시 즉시 재동결 + 금고 재봉인(fail-closed).
            </div>
        </div>
    </div>

    @* ══ v4.91.0 결정론적 카오스 테스팅 그리드 관제 패널 ═══════════════════════════ *@
    @{
        var chaosBadges = new (bool on, string label, string css)[]
        {
            (_frame.ChaosKiwoomProxyDown, "Kiwoom Proxy Down", "chaos-red"),
            (_frame.ChaosTossAuth401,     "Toss 401",          "chaos-amber"),
            (_frame.ChaosFxSpike,         "FX 3σ Spike",       "chaos-red"),
            (_frame.ChaosFxStale,         "FX 1s Stale",       "chaos-amber"),
        };
    }
    <div class="kpi-card @(_frame.ChaosActive ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🕹️ 결정론적 카오스 테스팅 그리드 (Deterministic Chaos Testing Grid) — 가상 시간선 복합 장애 내성</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">1000×</div><div class="kpi-sub">시뮬레이션 속도 배율</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.VirtualSeconds.ToString("N1")s</div><div class="kpi-sub">가상 시간 진행</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.PbtPasses.ToString("N0")</div><div class="kpi-sub">PBT 누적 통과</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.VirtualQueueDepth.ToString("N0")</div><div class="kpi-sub">가상 큐 깊이</div></div>
        </div>
        @* 카오스몽키 폭격 상태 — 레이저 배지(활성 적/황 글로우·비활성 회) *@
        <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;align-items:center">
            <span class="kpi-sub" style="margin-right:4px">카오스몽키 폭격 상태</span>
            @foreach (var b in chaosBadges)
            {
                <span class="chaos-badge @(b.on ? b.css : "chaos-off")">@b.label</span>
            }
        </div>
        @* 🎯 시드 재현 테스트 트리거 — 임의 시드로 특정 카오스 시나리오를 런타임 가상 재현(순수 HTML) *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🎯 시드 재현 테스트 — 임의 시드로 결정론 카오스 시나리오를 가상 시간선에서 재현</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_seed" @bind:event="oninput" placeholder="시드(예: 42)"
                       style="width:160px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoReproduceChaos"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#6b4fbb;color:#fff;font-weight:600">
                    🕹️ 시드 재현 실행
                </button>
                @if (!string.IsNullOrEmpty(_chaosMsg)) { <span class="kpi-sub">@_chaosMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                가상 시간 1000× 압축 · 시드 PRNG 로 [Kiwoom IPC 다운 · Toss 401 · FX 3σ/스테일] 동시 투하 → ForceFreeze 멱등·원장 명목 ≤1raw 정합 검증.
                ★순수 인메모리 시뮬 — 외부 프로덕션 API 로 단 1바이트도 송출되지 않습니다(liveArmed:false 격리).
            </div>
        </div>
    </div>

    @* ══ v4.92.0 프로덕션/샌드박스 자격증명 스왑 관제 패널 ═══════════════════════════ *@
    <div class="kpi-card @(_frame.ProductionLiveDetected ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🔌 프로덕션/샌드박스 자격증명 스왑 (Production/Sandbox Credential Swap)</div>
        @if (_frame.ProductionLiveDetected)
        {
            <div class="prod-live-banner">🔴 [PRODUCTION LIVE ENDPOINT CONNECTED — HIGH SENSITIVITY]</div>
        }
        else
        {
            <div class="prod-safe-banner">🔵 SANDBOX / 모의 엔드포인트 — 안전 상태 (실전 미접속)</div>
        }
        <div style="display:flex;gap:20px;margin-top:10px;flex-wrap:wrap">
            <div>
                <div style="font-size:16px"><span class="prod-badge @LinkCss(_frame.KiwoomLink)">@RingTelemetry.LinkName(_frame.KiwoomLink)</span></div>
                <div class="kpi-sub">키움 x86 프록시</div>
            </div>
            <div>
                <div style="font-size:16px"><span class="prod-badge @LinkCss(_frame.TossLink)">@RingTelemetry.LinkName(_frame.TossLink)</span></div>
                <div class="kpi-sub">토스 프로덕션</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.TossTokenRemainSec > 0 && _frame.TossTokenRemainSec < 60 ? "#ff9800" : "inherit")">@(_frame.TossTokenRemainSec.ToString("N0"))s</div>
                <div class="kpi-sub">인증 토큰 잔여 수명</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.EndpointFirewallClean ? "#66bb6a" : "#ff6b6b")">@(_frame.EndpointFirewallClean ? "PASS" : $"BLOCK ×{_frame.EndpointFirewallBlocks}")</div>
                <div class="kpi-sub">엔드포인트 변이 방화벽</div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            소스 하드코딩 화이트리스트(sandbox/real 도메인) vs 주입 URL 교차검증 — 1글자 불일치·플레이스홀더(.example)·모드 분열(KIS 시세↔주문) 시
            즉시 ForceFreeze 로 소켓 오픈 무력화. 송신 직전 주문 OpCode 스캔(영지식 절연) — 미무장 주문 패킷은 소켓 강제 파괴 + 영구 동결.
            ★실전 엔드포인트라도 이중 키(ValveWired∧LiveArmingWired)∧MasterIgnited 없이는 실주문 확률 0(liveArmed:false).
        </div>
    </div>

    @* ══ v4.93.0 실시간 뉴스 레이더 & AI 포트폴리오 멘토 패널 ═══════════════════════ *@
    @{
        decimal ms = _frame.MarketSentiment;
        string msColor = _frame.MarketBullish ? "#ff5252" : _frame.MarketBearish ? "#5082c8" : "var(--muted,#888)";   // 한국색상: 호재 빨강·악재 파랑
        string msLabel = _frame.MarketBullish ? "호재 우위" : _frame.MarketBearish ? "악재 우위" : "중립";
        string mentorAdvice = PortfolioMentorAdvisor.Advise(new MentorInput(
            0m, 0m, 0m, AssetClass.DomesticStock, 0m, ms, _frame.SemanticShockEngaged, _frame.SentimentBreakerActive));
    }
    <div class="kpi-card @(_frame.SentimentBreakerActive ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🧠 실시간 뉴스 레이더 & AI 포트폴리오 멘토 (Realtime News Radar & AI Portfolio Mentor)</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@(_frame.NewsRatePerMin.ToString("N0"))</div><div class="kpi-sub">뉴스 인입 (개/분)</div></div>
            <div><div class="kpi-value" style="font-size:18px;color:@msColor">@ms.ToString("+0.00;-0.00")</div><div class="kpi-sub">시장 감성 · @msLabel</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.NewsUnanalyzedCount.ToString("N0"))</div><div class="kpi-sub">미분석 격리</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.SemanticShockEngaged ? "chaos-red" : "prod-idle")">@(_frame.SemanticShockEngaged ? "SHOCK" : "안정")</span></div><div class="kpi-sub">세맨틱 쇼크</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.SentimentBreakerActive ? "chaos-amber" : "prod-auth")">@_frame.MentorFsmName</span></div><div class="kpi-sub">멘토 FSM</div></div>
        </div>
        @* SVG 마이크로차트 데모(호재 빨강·악재 파랑 뉴스 닷) — 포트폴리오 각 행에도 동일 NewsRadarSvg 로 결속. *@
        <div style="margin-top:10px;display:flex;align-items:center;gap:10px">
            @((MarkupString)NewsRadarSvg.Build(_demoSeries, _demoDots, 180, 34))
            <span class="kpi-sub">시계열 선 위 뉴스 포획 시점 — 🔴 호재 / 🔵 악재 닷 인과 마킹</span>
        </div>
        @* AI 멘토 실시간 조언 카드(한국어·결정론 룰기반). ★조언은 텍스트일 뿐 — 실주문 무접촉. *@
        <div style="margin-top:12px;padding:12px 14px;border-radius:8px;background:var(--card-bg,rgba(255,255,255,0.04));border:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:4px">💬 AI 멘토 조언</div>
            <div style="font-size:13px;line-height:1.55">@mentorAdvice</div>
        </div>
    </div>

    @* 데이터 없음 안내 *@
    @if (!_frame.HasActivity)
    {
        <div style="text-align:center;padding:40px;color:var(--muted,#888);font-size:14px">
            <div style="font-size:28px;margin-bottom:12px">📭</div>
            <div>링 활동 없음 — OrderDispatchRing 에 제안이 발행되지 않았거나 샘플러가 미시작입니다.</div>
            <div style="margin-top:8px;font-size:12px;font-family:var(--mono)">RingTelemetryPublisher.Sample() 주기 호출 여부를 확인하세요.</div>
        </div>
    }

    @* 세쿼록 채널 진단 *@
    <div style="margin-top:10px;padding:12px 16px;background:var(--card-bg,rgba(255,255,255,0.04));border-radius:8px;font-size:12px;color:var(--muted,#888);font-family:var(--mono)">
        채널 버전: @(Channel.Version)
        &nbsp;|&nbsp; 폴링 주기: 150ms (PeriodicTimer, 무할당)
        &nbsp;|&nbsp; seqlock 8회 재시도 후 직전 프레임 유지
        &nbsp;|&nbsp; 게이팅 모드: @(Attestation.Mode)
    </div>
</div>

<style>
    .kpi-card {
        background: var(--card-bg, rgba(255,255,255,0.05));
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 10px;
        padding: 14px 16px;
        display: flex; flex-direction: column; gap: 4px;
    }
    .kpi-card.kpi-alert {
        border-color: rgba(220, 50, 50, 0.5);
        background: rgba(180, 20, 20, 0.10);
    }
    .kpi-card.kpi-amber {
        border-color: rgba(255, 152, 0, 0.6);
        background: rgba(255, 152, 0, 0.08);
    }
    .kpi-label { font-size: 11px; color: var(--muted, #888); text-transform: uppercase; letter-spacing: 0.05em; }
    .kpi-value { font-size: 22px; font-weight: 600; font-family: var(--mono); }
    .kpi-sub   { font-size: 11px; color: var(--muted, #888); }
    /* v4.90.0 — 웜 스타트 복구 단계 배지: Stable 녹 / Draining·Escalating 황색 점멸 / Idle 회 / Frozen 적. */
    .rec-badge      { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 6px; font-family: var(--mono); }
    .rec-idle       { background: rgba(255,255,255,0.08); color: var(--muted, #888); }
    .rec-validating { background: rgba(255,152,0,0.18);   color: #ffb74d; }
    .rec-busy       { background: rgba(255,152,0,0.22);   color: #ffb74d; animation: recpulse 1s ease-in-out infinite; }
    .rec-stable     { background: rgba(76,175,80,0.20);   color: #66bb6a; }
    .rec-frozen     { background: rgba(220,50,50,0.22);   color: #ff6b6b; }
    @@keyframes recpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    /* v4.91.0 — 카오스몽키 레이저 배지: 활성=적/황 글로우, 비활성=회. */
    .chaos-badge { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 6px; font-family: var(--mono); }
