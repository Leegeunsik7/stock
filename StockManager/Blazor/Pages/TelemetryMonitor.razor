    @* ══ 집행 미시구조 관제(v4.87.0) — IgnitionLock FSM + 슬리피지 3σ ═══════════════ *@
    @{
        double sigDisp  = (double)_frame.SlippageSigmaDecimal;
        double slipAbs  = Math.Abs((double)_frame.SlippageDecimal);
        double band3    = sigDisp * 3.0;
        bool   warmup   = sigDisp <= 0.0;
        double barPct   = (band3 > 1e-12) ? Math.Min(100.0, slipAbs / band3 * 100.0) : 0.0;
        string barColor = barPct >= 100.0 ? "#f44336" : (barPct >= 66.0 ? "#ff9800" : "#4caf50");
        string fsmBg = _frame.IgnitionStageCode switch
        {
            3 => (_frame.ExecDowngrades > 0 ? "#e34d4d" : "#4caf50"),   // MasterIgnited: 녹색(강등 이력 시 적색)
            1 => "#ffc107",                                             // ProbeReady: 황색
            2 => "#42a5f5",                                             // TimeBoxOpen: 청색
            _ => "#888"                                                 // Locked: 회색
        };
    }
    <div class="kpi-card @(_frame.ExecDowngrades > 0 ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">
            ⚡ 집행 미시구조 (Microstructure Execution)
            <span style="margin-left:8px;padding:2px 10px;border-radius:6px;background:@fsmBg;color:#111;font-weight:700;font-size:11px">
                @(_frame.IgnitionStageName)
            </span>
        </div>
        @if (_frame.ExecDowngrades > 0)
        {
            <div style="margin:8px 0;padding:10px 14px;background:rgba(255,152,0,0.16);border:1px solid #ff9800;border-radius:8px;font-size:12px;color:#ffcc80">
                🟠 STEP-DOWN 격발 — 슬리피지 3σ 2연속 또는 체결 레이턴시 100ms 초과로 점화 단계가 강등되었습니다
                (누적 <b>@(_frame.ExecDowngrades.ToString("N0"))</b>회). 추가 대형 발주가 물리적으로 차단됩니다.
            </div>
        }
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px;font-family:var(--mono)">@(_frame.SlippageDecimal.ToString("+0.00000000;-0.00000000;0"))</div>
                <div class="kpi-sub">실시간 슬리피지 (raw·기대−체결)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(warmup ? "워밍업" : "±" + _frame.SlippageSigmaDecimal.ToString("0.00000000"))</div>
                <div class="kpi-sub">롤링 표준편차 (σ)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.ExecDowngrades > 0 ? "#ff9800" : "inherit")">@(_frame.ExecDowngrades.ToString("N0"))</div>
                <div class="kpi-sub">FSM 강등 누적</div>
            </div>
        </div>
        @* 3σ 임계 진척 바(Pure CSS) — |슬리피지| / 3σ. 워밍업(σ 미확립)이면 판정 보류 표기. *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">3σ 임계 근접도 @(warmup ? "(워밍업 — 표본 &lt;10, 판정 보류·fail-closed)" : $"({barPct:F0}%)")</div>
            <div style="height:10px;border-radius:5px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(warmup ? "0" : barPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:@barColor;transition:width .2s"></div>
            </div>
        </div>
    </div>

    @* ══ 원장 보호 메시 관제(v4.88.0) — 비동기 큐 깊이 게이지 + I/O 레이턴시 ═══════════ *@
    @{
        double ledSat  = _frame.LedgerSaturationPct;
        string ledColor = ledSat >= 90.0 ? "#f44336" : (ledSat >= 70.0 ? "#ff9800" : "#4caf50");
    }
    <div class="kpi-card @(_frame.LedgerOverflowAlert ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🗄️ 원장 보호 메시 (Ledger Protection Mesh) — 발주 핫패스 비동기 분리</div>
        <div style="display:flex;gap:20px;margin-top:6px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.LedgerQueueDepth.ToString("N0")) / @(_frame.LedgerCapacity.ToString("N0"))</div>
                <div class="kpi-sub">큐 깊이 / 용량</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.LedgerAvgPersistMicros.ToString("N1")) µs</div>
                <div class="kpi-sub">평균 디스크 영속화 소요</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.LedgerWriteFailures > 0 ? "#f44336" : "inherit")">@(_frame.LedgerWriteFailures.ToString("N0"))</div>
                <div class="kpi-sub">누적 쓰기 실패</div>
            </div>
        </div>
        @* 큐 깊이 게이지(Pure CSS) — 0~70% 녹색·70~90% 황색·90%+ 적색. *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">큐 포화도 @(ledSat.ToString("F0"))% @(ledSat >= 90.0 ? "🔴 오버플로(전역 동결)" : ledSat >= 70.0 ? "🟠 경계" : "🟢 정상")</div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(Math.Min(100.0, ledSat).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:@ledColor;transition:width .2s"></div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:8px">
            핫패스는 blittable 페이로드를 무할당·논블로킹으로 큐에 밀어 넣고 즉시 복귀 — 전용 드레인 스레드가 AddTransaction +
            RecomputeAverage 를 순차 격리 실행(장부/평단 디싱크 차단). 90% 포화·영속화 실패 시 ForceFreeze(fail-closed).
        </div>
    </div>

    @* ══ v4.90.0 결정론적 웜 스타트 복구 관제 패널 ═══════════════════════════════ *@
    @{
        var recStages = new[] { RecoveryState.Idle, RecoveryState.Validating, RecoveryState.Draining, RecoveryState.Escalating, RecoveryState.Stable };
        double recBacklogPct = _frame.LedgerCapacity > 0 ? Math.Min(100.0, (double)_frame.RecoveryBacklog / _frame.LedgerCapacity * 100.0) : 0.0;
        bool recRttWarn = _frame.ProbeRttMs > 50;
    }
    <div class="kpi-card @(_frame.RecoveryStage == RecoveryState.Frozen ? "kpi-alert" : (_frame.RecoveryActive ? "kpi-amber" : ""))" style="margin-bottom:22px">
        <div class="kpi-label">🛠️ 웜 스타트 복구 관제 (Deterministic Warm-Restart Control Panel)</div>
        @* 복구 단계 타임라인 배지 — Stable 녹 / Draining·Escalating 황색 점멸 / Idle 회 / Frozen 적. *@
        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;align-items:center">
            @foreach (var st in recStages)
            {
                bool active = _frame.RecoveryStage == st;
                <span class="rec-badge @(active ? RecoveryCss(st) : "rec-idle")" style="@(active ? "" : "opacity:.4")">@st</span>
                @if (st != RecoveryState.Stable) { <span style="color:var(--muted,#888)">→</span> }
            }
            @if (_frame.RecoveryStage == RecoveryState.Frozen)
            { <span class="rec-badge rec-frozen" style="margin-left:8px">⛔ FROZEN</span> }
        </div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.RecoveryStateName)</div>
                <div class="kpi-sub">현재 복구 단계</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.RecoveryBacklog.ToString("N0"))</div>
                <div class="kpi-sub">드레인 잔여 백로그</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(recRttWarn ? "#f44336" : "inherit")">@(_frame.ProbeRttMs.ToString("N0")) ms</div>
                <div class="kpi-sub">프로브 파이프 RTT (≤50ms)</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px">@(_frame.ProbeSlippageSigmaDecimal.ToString("F2"))σ</div>
                <div class="kpi-sub">프로브 슬리피지 (3σ 게이트)</div>
            </div>
        </div>
        @* 백로그 소진 게이지(Pure CSS) *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">백로그 잔여 @(_frame.RecoveryBacklog.ToString("N0"))건</div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(recBacklogPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:#ff9800;transition:width .2s"></div>
            </div>
        </div>
        @* 🔐 운영자 서명 입력 → 수동 해제 + 웜 스타트 트리거(순수 HTML) *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🔐 운영자 서명 입력 → 수동 해제 + 웜 스타트 (현재 게이팅: <b>@(Attestation.Mode)</b>)</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_sig" @bind:event="oninput" placeholder="운영자 서명(예: OPERATOR-20260710-…)"
                       style="flex:1;min-width:240px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoWarmRestart" disabled="@_frame.RecoveryActive"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#c0392b;color:#fff;font-weight:600;@(_frame.RecoveryActive ? "opacity:.5;cursor:not-allowed" : "")">
                    🛠️ 웜 스타트 실행
                </button>
                @if (!string.IsNullOrEmpty(_recMsg)) { <span class="kpi-sub">@_recMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                서명 확인 → 금고 해제·백로그 순차 드레인(동결창 가격정합성 펜스) → 점화 Locked→ProbeReady→1주 프로브(3σ·지연&lt;50ms 검증)→MasterIgnited.
                복구 중에는 라이브 라우팅이 무조건 차단됩니다(주문 폭주 방지). 실패 시 즉시 재동결 + 금고 재봉인(fail-closed).
            </div>
        </div>
    </div>

    @* ══ v4.91.0 결정론적 카오스 테스팅 그리드 관제 패널 ═══════════════════════════ *@
    @{
        var chaosBadges = new (bool on, string label, string css)[]
        {
            (_frame.ChaosKiwoomProxyDown, "Kiwoom Proxy Down", "chaos-red"),
            (_frame.ChaosTossAuth401,     "Toss 401",          "chaos-amber"),
            (_frame.ChaosFxSpike,         "FX 3σ Spike",       "chaos-red"),
            (_frame.ChaosFxStale,         "FX 1s Stale",       "chaos-amber"),
        };
    }
    <div class="kpi-card @(_frame.ChaosActive ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🕹️ 결정론적 카오스 테스팅 그리드 (Deterministic Chaos Testing Grid) — 가상 시간선 복합 장애 내성</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">1000×</div><div class="kpi-sub">시뮬레이션 속도 배율</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.VirtualSeconds.ToString("N1")s</div><div class="kpi-sub">가상 시간 진행</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.PbtPasses.ToString("N0")</div><div class="kpi-sub">PBT 누적 통과</div></div>
            <div><div class="kpi-value" style="font-size:18px">@_frame.VirtualQueueDepth.ToString("N0")</div><div class="kpi-sub">가상 큐 깊이</div></div>
        </div>
        @* 카오스몽키 폭격 상태 — 레이저 배지(활성 적/황 글로우·비활성 회) *@
        <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;align-items:center">
            <span class="kpi-sub" style="margin-right:4px">카오스몽키 폭격 상태</span>
            @foreach (var b in chaosBadges)
            {
                <span class="chaos-badge @(b.on ? b.css : "chaos-off")">@b.label</span>
            }
        </div>
        @* 🎯 시드 재현 테스트 트리거 — 임의 시드로 특정 카오스 시나리오를 런타임 가상 재현(순수 HTML) *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🎯 시드 재현 테스트 — 임의 시드로 결정론 카오스 시나리오를 가상 시간선에서 재현</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_seed" @bind:event="oninput" placeholder="시드(예: 42)"
                       style="width:160px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoReproduceChaos"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#6b4fbb;color:#fff;font-weight:600">
                    🕹️ 시드 재현 실행
                </button>
                @if (!string.IsNullOrEmpty(_chaosMsg)) { <span class="kpi-sub">@_chaosMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                가상 시간 1000× 압축 · 시드 PRNG 로 [Kiwoom IPC 다운 · Toss 401 · FX 3σ/스테일] 동시 투하 → ForceFreeze 멱등·원장 명목 ≤1raw 정합 검증.
                ★순수 인메모리 시뮬 — 외부 프로덕션 API 로 단 1바이트도 송출되지 않습니다(liveArmed:false 격리).
            </div>
        </div>
    </div>

    @* ══ v4.92.0 프로덕션/샌드박스 자격증명 스왑 관제 패널 ═══════════════════════════ *@
    <div class="kpi-card @(_frame.ProductionLiveDetected ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🔌 프로덕션/샌드박스 자격증명 스왑 (Production/Sandbox Credential Swap)</div>
        @if (_frame.ProductionLiveDetected)
        {
            <div class="prod-live-banner">🔴 [PRODUCTION LIVE ENDPOINT CONNECTED — HIGH SENSITIVITY]</div>
        }
        else
        {
            <div class="prod-safe-banner">🔵 SANDBOX / 모의 엔드포인트 — 안전 상태 (실전 미접속)</div>
        }
        <div style="display:flex;gap:20px;margin-top:10px;flex-wrap:wrap">
            <div>
                <div style="font-size:16px"><span class="prod-badge @LinkCss(_frame.KiwoomLink)">@RingTelemetry.LinkName(_frame.KiwoomLink)</span></div>
                <div class="kpi-sub">키움 x86 프록시</div>
            </div>
            <div>
                <div style="font-size:16px"><span class="prod-badge @LinkCss(_frame.TossLink)">@RingTelemetry.LinkName(_frame.TossLink)</span></div>
                <div class="kpi-sub">토스 프로덕션</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.TossTokenRemainSec > 0 && _frame.TossTokenRemainSec < 60 ? "#ff9800" : "inherit")">@(_frame.TossTokenRemainSec.ToString("N0"))s</div>
                <div class="kpi-sub">인증 토큰 잔여 수명</div>
            </div>
            <div>
                <div class="kpi-value" style="font-size:18px;color:@(_frame.EndpointFirewallClean ? "#66bb6a" : "#ff6b6b")">@(_frame.EndpointFirewallClean ? "PASS" : $"BLOCK ×{_frame.EndpointFirewallBlocks}")</div>
                <div class="kpi-sub">엔드포인트 변이 방화벽</div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            소스 하드코딩 화이트리스트(sandbox/real 도메인) vs 주입 URL 교차검증 — 1글자 불일치·플레이스홀더(.example)·모드 분열(KIS 시세↔주문) 시
            즉시 ForceFreeze 로 소켓 오픈 무력화. 송신 직전 주문 OpCode 스캔(영지식 절연) — 미무장 주문 패킷은 소켓 강제 파괴 + 영구 동결.
            ★실전 엔드포인트라도 이중 키(ValveWired∧LiveArmingWired)∧MasterIgnited 없이는 실주문 확률 0(liveArmed:false).
        </div>
    </div>

    @* ══ v4.93.0 실시간 뉴스 레이더 & AI 포트폴리오 멘토 패널 ═══════════════════════ *@
    @{
        decimal ms = _frame.MarketSentiment;
        string msColor = _frame.MarketBullish ? "#ff5252" : _frame.MarketBearish ? "#5082c8" : "var(--muted,#888)";   // 한국색상: 호재 빨강·악재 파랑
        string msLabel = _frame.MarketBullish ? "호재 우위" : _frame.MarketBearish ? "악재 우위" : "중립";
        string mentorAdvice = PortfolioMentorAdvisor.Advise(new MentorInput(
            0m, 0m, 0m, AssetClass.DomesticStock, 0m, ms, _frame.SemanticShockEngaged, _frame.SentimentBreakerActive));
    }
    <div class="kpi-card @(_frame.SentimentBreakerActive ? "kpi-amber" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🧠 실시간 뉴스 레이더 & AI 포트폴리오 멘토 (Realtime News Radar & AI Portfolio Mentor)</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@(_frame.NewsRatePerMin.ToString("N0"))</div><div class="kpi-sub">뉴스 인입 (개/분)</div></div>
            <div><div class="kpi-value" style="font-size:18px;color:@msColor">@ms.ToString("+0.00;-0.00")</div><div class="kpi-sub">시장 감성 · @msLabel</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.NewsUnanalyzedCount.ToString("N0"))</div><div class="kpi-sub">미분석 격리</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.SemanticShockEngaged ? "chaos-red" : "prod-idle")">@(_frame.SemanticShockEngaged ? "SHOCK" : "안정")</span></div><div class="kpi-sub">세맨틱 쇼크</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.SentimentBreakerActive ? "chaos-amber" : "prod-auth")">@_frame.MentorFsmName</span></div><div class="kpi-sub">멘토 FSM</div></div>
        </div>
        @* SVG 마이크로차트 데모(호재 빨강·악재 파랑 뉴스 닷) — 포트폴리오 각 행에도 동일 NewsRadarSvg 로 결속. *@
        <div style="margin-top:10px;display:flex;align-items:center;gap:10px">
            @((MarkupString)NewsRadarSvg.Build(_demoSeries, _demoDots, 180, 34))
            <span class="kpi-sub">시계열 선 위 뉴스 포획 시점 — 🔴 호재 / 🔵 악재 닷 인과 마킹</span>
        </div>
        @* AI 멘토 실시간 조언 카드(한국어·결정론 룰기반). ★조언은 텍스트일 뿐 — 실주문 무접촉. *@
        <div style="margin-top:12px;padding:12px 14px;border-radius:8px;background:var(--card-bg,rgba(255,255,255,0.04));border:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:4px">💬 AI 멘토 조언</div>
            <div style="font-size:13px;line-height:1.55">@mentorAdvice</div>
        </div>
    </div>

    @* ══ v4.94.0 발주 전 리스크 실드 & MMF 패브릭 코어 패널 ═══════════════════════════ *@
    @{
        double marginPct       = _frame.MarginUtilizationPct;
        string marginBar       = marginPct >= 90 ? "#e34d4d" : marginPct >= 70 ? "#ffb74d" : "#66bb6a";
        string marginWidthCss  = marginPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        string marginPctStr    = marginPct.ToString("0.0");
        string marginRemainStr = _frame.MarginRemainingPct.ToString("0.0");
        string riskGuardCls    = _frame.FabricGuardTripped ? "kpi-alert" : "";
    }
    <div class="kpi-card @riskGuardCls" style="margin-bottom:22px">
        <div class="kpi-label">⚡ 발주 전 리스크 실드 & MMF 패브릭 코어 (Pre-Trade Risk Shield &amp; MMF Fabric Core)</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@(_frame.MmfLatencyMicros.ToString("N0")) <span style="font-size:12px">µs</span></div><div class="kpi-sub">MMF IPC 레이턴시</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.ReservationRejects.ToString("N0"))</div><div class="kpi-sub">락-프리 예약 거부</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.ShadowRingNodeCount)</div><div class="kpi-sub">다중 브로커 링 노드</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.RiskShieldFrozen ? "chaos-red" : "prod-auth")">@(_frame.RiskShieldFrozen ? "LOCKED" : "정상")</span></div><div class="kpi-sub">리스크 실드</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.MmfFabricCorrupted ? "chaos-red" : (_frame.MmfFabricActive ? "prod-auth" : "prod-idle"))">@(_frame.MmfFabricCorrupted ? "CORRUPT" : (_frame.MmfFabricActive ? "가동" : "idle"))</span></div><div class="kpi-sub">MMF 패브릭</div></div>
        </div>
        @* 증거금 포화도 Pure CSS 바(잔여 증거금 비율 시각화) — 3단 색(녹<70/황<90/적≥90). *@
        <div style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted,#888);margin-bottom:4px">
                <span>증거금 포화도 @marginPctStr% (잔여 @marginRemainStr%)</span>
                <span>@(_frame.MarginSaturated ? "⚠️ 포화 근접" : "")</span>
            </div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(marginWidthCss)%;background:@marginBar;transition:width .2s"></div>
            </div>
        </div>
        @* MMF 레이턴시 타임라인 텍스트 — 마이크로초 단위 물리 왕복. *@
        <div class="kpi-sub" style="margin-top:10px">
            MMF 물리 왕복 레이턴시: <b style="font-family:var(--mono)">@(_frame.MmfLatencyMicros.ToString("N0")) µs</b>
            &nbsp;|&nbsp; 다중 브로커 링 노드 마스크: <b style="font-family:var(--mono)">0x@(_frame.ShadowRingNodeMask.ToString("X"))</b>
            &nbsp;|&nbsp; 증거금 예약 포화 @marginPctStr%
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            발주 전 다요소 리스크 검문(증거금·당일 누적 한도·무차입 공매도) — 락-프리 원자 예약(TOCTOU-free CAS)으로 순간 한도 초과 오발주를 봉쇄.
            연속 한도 3회 위반 시 계좌 전체 ForceFreeze. MMF 공유메모리 링은 하트비트 20ms 단절·경계(bound-check) 파손 시 즉시 격리 동결.
            ★모든 한도 계산·MMF 개통이 진행돼도 이중 키(ValveWired∧LiveArmingWired)∧MasterIgnited 없이는 실주문 확률 0(liveArmed:false).
        </div>
    </div>

    @* ══ v4.95.0 무할당 순환 블랙박스 & 감사 오디트 매그넷 패널 ═══════════════════ *@
    @{
        bool   bbFrozen   = _frame.BlackboxSealed || Attestation.Mode == GatingMode.EmergencyFreeze;
        double bbSat       = _frame.BlackboxSaturationPct;
        string bbSatWidth  = bbSat.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        string bbSatStr    = bbSat.ToString("0.0");
        if (!bbFrozen) { _hexCache = null; }                          // 해제 시 캐시 무효화(재동결 시 신규 스냅샷)
        else if (_hexCache is null) { _hexCache = BuildHexDump(); }   // ★동결 시 1회만 정적 투사(매 폴링 재생성 금지=GC 폭탄 방지)
    }
    <div class="kpi-card @(bbFrozen ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🗃️ 무할당 순환 블랙박스 & 감사 오디트 매그넷 (Zero-Alloc Flight Recorder &amp; Audit Magnet)</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@(_frame.BlackboxRatePerSec.ToString("N0"))</div><div class="kpi-sub">이산 사건 (개/초)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@bbSatStr%</div><div class="kpi-sub">순환 버퍼 포화도</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.BlackboxDroppedSealed.ToString("N0"))</div><div class="kpi-sub">봉인 후 유실</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.BlackboxDumpFailed ? "chaos-red" : _frame.BlackboxSealed ? "chaos-amber" : "prod-auth")">@_frame.BlackboxDumpStateName</span></div><div class="kpi-sub">덤프 상태</div></div>
        </div>
        @* 순환 버퍼 포화도 Pure CSS 바(정상 가동 시각화). *@
        <div style="margin-top:12px">
            <div style="font-size:11px;color:var(--muted,#888);margin-bottom:4px">순환 버퍼 포화도 @bbSatStr% (@Blackbox.Capacity 슬롯 · 64B/레코드)</div>
            <div style="height:12px;border-radius:6px;background:rgba(255,255,255,0.08);overflow:hidden">
                <div style="height:100%;width:@(bbSatWidth)%;background:#5082c8;transition:width .2s"></div>
            </div>
        </div>
        @* ★동결 시에만 100 레코드 정적 헥스덤프 투사(암흑 적색 감사 모드) — 무할당 글리프 렌더·1회 생성 캐시. *@
        @if (bbFrozen)
        {
            <div style="margin-top:14px;padding:14px;border-radius:8px;background:rgba(90,10,10,0.35);border:1px solid #7a1010">
                <div style="font-weight:700;color:#ff6b6b;font-size:14px;margin-bottom:8px">🩸 AUDIT MAGNET — 동결 스냅샷 헥스 덤프 (최근 @HexRecordCount 레코드 · 무할당 정적 투사)</div>
                <pre style="font-family:var(--mono);font-size:10.5px;line-height:1.35;color:#ffb0b0;background:rgba(0,0,0,0.4);padding:10px;border-radius:6px;overflow:auto;max-height:340px;white-space:pre;margin:0">@_hexCache</pre>
                <div class="kpi-sub" style="margin-top:6px;color:#ffb0b0">사유: <b>@(_frame.FabricGuardReason)</b> · 게이팅: <b>@(Attestation.Mode)</b> · 덤프: <b>@(_frame.BlackboxDumpStateName)</b> · 봉인: SHA256 변조탐지 + XOR 난독 + CRC32 → .ms2dump</div>
            </div>
        }
        <div class="kpi-sub" style="margin-top:10px">
            핫패스 엔진(MMF IPC·리스크 실드·발주·뉴스) 통과 시마다 δ=0 락-프리 push — 50ms 드레인·IPC 동기 마진 무간섭(자체 링·자체 카운터).
            ForceFreeze 격발 시 순환 인덱스 물리 봉인 + 격리 BelowNormal 스레드가 .ms2dump 원자 영속화(temp→flush→rename·디스크 예외 시 OS 핸들 abort+무응답 격리).
            ★블랙박스 가동·덤프가 진행돼도 이중 키∧MasterIgnited 없이는 실주문 확률 0(liveArmed:false·IBroker/소켓 참조 0).
        </div>
    </div>

    @* ══ v4.96.0 실시간 청산 메쉬 & 자본 영점 조절 패널 ═══════════════════════════ *@
    <div class="kpi-card @(_frame.AccFrozen ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">📊 실시간 청산 메쉬 & 자본 영점 조절 (Live Accounting &amp; Clearing Mesh)</div>
        <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@(_frame.AccFeeKrw.ToString("N2")) <span style="font-size:12px">원</span></div><div class="kpi-sub">누적 제비용(원화)</div></div>
            <div><div class="kpi-value" style="font-size:18px">$@(_frame.AccFeeUsd.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</div><div class="kpi-sub">누적 제비용(달러)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@(_frame.AccLatchDepth.ToString("N0"))</div><div class="kpi-sub">청산 래치 큐</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(_frame.AccZeroSynced ? "prod-auth" : _frame.AccFrozen ? "chaos-red" : "prod-idle")">@(_frame.AccZeroSynced ? "🟢 ZERO-SYNC" : _frame.AccStateName)</span></div><div class="kpi-sub">예수금 영점 조절</div></div>
        </div>
        @* 거래세/농특세 분리 투명 표출(소수점) — 주입 메쉬 직독. *@
        <div class="kpi-sub" style="margin-top:10px">
            누적 거래세: <b>@(Accounting.CumStampTax.ToString("N2")) 원</b> · 누적 농어촌특별세: <b>@(Accounting.CumFarmTax.ToString("N2")) 원</b>
            &nbsp;|&nbsp; 가용 예수금: <b>@(Accounting.AvailableDeposit.ToString("N2")) 원</b>
            &nbsp;|&nbsp; 정밀 잔여 캐리 오차: <b style="font-family:var(--mono)">@(_frame.AccCarryError.ToString("0.00000000", System.Globalization.CultureInfo.InvariantCulture)) raw</b> (&lt;1.0 정상)
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            체결 즉시 실전 제비용(위탁수수료·거래세·농특세·해외 혼합수수료) 고정소수점 δ=0 정산 → 예수금·장부 1raw 오차 없이 실시간 영점 조절.
            ★정밀 잔여 캐리 가드로 절사 잔차를 이월해 장기 누적오차 0 수렴. 스펙큘러티브 2단계 청산 래치(핫 CAS 델타 + 회계 스레드 exact 확정)로 dirty-read/double-spend 봉쇄.
            ★실전 정산이 나노초 단위로 진행돼도 이중 키(ValveWired∧LiveArmingWired)∧MasterIgnited 없이는 외부 증권사로 허위 체결 동기화·주문 0바이트(liveArmed:false·IBroker/소켓 참조 0).
        </div>
    </div>

    @* ══ v4.97.0 원자적 컷오버 & 섀도우 플라이트 대시보드 ═══════════════════════════ *@
    <div class="kpi-card @(Cutover.State == CutoverState.Frozen ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🕹️ 원자적 컷오버 & 섀도우 플라이트 대시보드 (Atomic Cutover &amp; Shadow Flight Dashboard)</div>
        @if (Cutover.IsLive)
        {
            <div class="prod-live-banner">🔴 [PRODUCTION LIVE OPERATION IN PROGRESS — MAXIMUM ATTENTION]</div>
        }
        else
        {
            <div class="prod-safe-banner">🔵 [SHADOW FLIGHT ACTIVE — CAPITAL IS 100% SAFE]</div>
        }
        <div style="display:flex;gap:20px;margin-top:10px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @CutoverBadgeCss(Cutover.State)">@Cutover.State.ToString()</span></div><div class="kpi-sub">컷오버 상태</div></div>
            <div><div class="kpi-value" style="font-size:18px">@((Gateway.LastFillRttMicros / 1000.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))<span style="font-size:12px">ms</span></div><div class="kpi-sub">가상 체결 RTT (≤50ms)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Gateway.VirtualFillCount.ToString("N0")</div><div class="kpi-sub">가상 체결 누적</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Gateway.BypassedCount.ToString("N0")</div><div class="kpi-sub">실 송출 바이패스(0바이트)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Cutover.CanaryTripCount.ToString("N0") / @Cutover.RollbackCount.ToString("N0")</div><div class="kpi-sub">카나리 트립 / 되감기</div></div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            카나리 표본: <b>@Cutover.CanarySampleCount.ToString("N0")</b> · 편차: <b style="font-family:var(--mono)">@Cutover.LastCanaryDeviationRaw.ToString("N0") raw</b> (단측 3σ 상향=위험)
            &nbsp;|&nbsp; 듀얼트랙 드리프트: <b style="font-family:var(--mono)">@Cutover.LastDualTrackDriftRaw.ToString("N0") raw</b> (&gt;1raw=동결 @Cutover.DualTrackFreezeCount.ToString("N0")회)
            &nbsp;|&nbsp; 실 라우팅: <b>@Gateway.LiveRoutedCount.ToString("N0")</b> · 차단: <b>@Gateway.BlockedCount.ToString("N0")</b>
        </div>
        @* 🔐 운영자 서명 → 2단 원자 컷오버(사전무장 → <1ms flip). 순수 HTML. *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🔐 운영자 서명 → 2단 원자 컷오버 (① 사전무장: 이중키∧격리프로브∧3σ · ② 컷오버: &lt;1ms 원자 flip)</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_cutSig" @bind:event="oninput" placeholder="운영자 서명(예: CUTOVER-20260716-…)"
                       style="flex:1;min-width:240px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoPreArm"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#2e6da4;color:#fff;font-weight:600">🛡️ ① 사전무장</button>
                <button @onclick="DoCutover"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#c0392b;color:#fff;font-weight:600">🚀 ② 원자 컷오버</button>
                @if (Cutover.IsLive)
                {
                    <button @onclick="DoRollback"
                            style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#42a5f5;color:#fff;font-weight:600">↩️ 되감기</button>
                }
                @if (!string.IsNullOrEmpty(_cutMsg)) { <span class="kpi-sub">@_cutMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                실 브로커 소켓은 시세·예수금·인증만 수신하고, IsShadowMode(기본 ON)면 최하위 주문 송출을 100% 바이패스(실 소켓 0바이트) — 가로챈 주문은 전용 섀도우 청산 메쉬에 50ms 내 가상 체결로 공급(슬리피지 모델).
                ★이중 차단 인터락: 사전무장(이중키 ValveWired∧LiveArmingWired 동시∧격리 프로브∧3σ)이 성공해야만 원자 flip 가능하며, flip 후에도 매 발주가 이중키∧MasterIgnited 를 재평가 — 미충족 시 실주문 0바이트+fail-closed 동결(liveArmed:false).
                ★Think Beyond: 컷오버 직후 카나리 검역(RTT 단측 3σ) 실패 시 &lt;0.1ms 가역 되감기, 듀얼트랙(섀도우 예측 vs 실체결) 1raw 발산 시 경성 동결.
            </div>
        </div>
    </div>

    @* ══ v5.0.0 실전 총점화 (Live Total Ignition) 대시보드 ═══════════════════════ *@
    <div class="kpi-card @(KillSwitch.State == KillSwitchState.Tripped || Deadman.State == DeadmanState.Reverted ? "kpi-alert" : "")" style="margin-bottom:22px">
        <div class="kpi-label">🎯 실전 총점화 (Live Total Ignition) — 3단계 안전 골격</div>
        @if (KillSwitch.State == KillSwitchState.Tripped)
        {
            <div class="prod-live-banner">🔴 [REMOTE KILL SWITCH TRIPPED — 비상 정지·금고 재봉인·소켓 ABORT]</div>
        }
        <div style="display:flex;gap:20px;margin-top:10px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(Genesis.State == GenesisState.Synced ? "prod-auth" : Genesis.State == GenesisState.Refused ? "chaos-red" : "prod-idle")">@Genesis.State.ToString()</span></div><div class="kpi-sub">① Genesis 원장 동기화</div></div>
            <div><div class="kpi-value" style="font-size:18px">@((Genesis.SyncedDepositKrwRaw / (decimal)100_000_000L).ToString("N0")) <span style="font-size:12px">원</span></div><div class="kpi-sub">실 예수금(1raw 시딩)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@CanaryProbe.LastNetDriftRaw.ToString("N0") <span style="font-size:12px">raw</span></div><div class="kpi-sub">② Canary net 대조 드리프트</div></div>
            <div><div class="kpi-value" style="font-size:16px">@(BlastRadius.Active ? (BlastRadius.CeilingRaw / (decimal)100_000_000L).ToString("N0") + " 원" : "무제한")</div><div class="kpi-sub">블래스트 반경(위반 @BlastRadius.Breaches.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(KillSwitch.State == KillSwitchState.Tripped ? "chaos-red" : "prod-idle")">@KillSwitch.State.ToString()</span></div><div class="kpi-sub">③ 원격 킬스위치</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(Deadman.State == DeadmanState.Reverted ? "chaos-red" : Deadman.State == DeadmanState.Watching ? "prod-connecting" : "prod-idle")">@Deadman.State.ToString()</span></div><div class="kpi-sub">데드맨 역-컷오버</div></div>
        </div>
        @* 🔐 Red Team 운영자 컨트롤 — 킬스위치(서명 투하)·데드맨 감시/생존신호(순수 HTML). *@
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border,rgba(255,255,255,0.08))">
            <div class="kpi-sub" style="margin-bottom:6px">🔐 Red Team 컨트롤 — 원격 킬스위치(서명 비상정지) · 데드맨 생존신호</div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" @bind="_killSig" @bind:event="oninput" placeholder="비상정지 서명(예: KILL-20260717-…)"
                       style="flex:1;min-width:200px;padding:8px 10px;border-radius:6px;border:1px solid var(--border,rgba(255,255,255,0.12));background:var(--card-bg,rgba(255,255,255,0.04));color:inherit;font-family:var(--mono)" />
                <button @onclick="DoKillSwitch"
                        style="padding:8px 16px;border-radius:6px;border:0;cursor:pointer;background:#c0392b;color:#fff;font-weight:700">🛑 비상 정지</button>
                <button @onclick="DoDeadmanStart"
                        style="padding:8px 14px;border-radius:6px;border:0;cursor:pointer;background:#2e6da4;color:#fff;font-weight:600">👁️ 데드맨 감시 시작</button>
                <button @onclick="DoDeadmanBeat"
                        style="padding:8px 14px;border-radius:6px;border:0;cursor:pointer;background:#3a7d44;color:#fff;font-weight:600">💓 생존 신호</button>
                @if (!string.IsNullOrEmpty(_rtMsg)) { <span class="kpi-sub">@_rtMsg</span> }
            </div>
            <div class="kpi-sub" style="margin-top:6px">
                ★실 계좌 접속·자격증명 인가·1주 실 사출은 운영자(사람)가 이중키+서명으로 직접 수행 — 본 대시보드는 안전 골격의 상태 관측 + Red Team 훈련 컨트롤만 제공.
                킬스위치는 서명 검증 후 &lt;0.1ms 내 ForceFreeze+금고 재봉인+소켓 Abort 로 수렴(블랙박스 10만 패킷 자동 보존). 데드맨은 30초 생존신호 소실 시 자동 섀도우 역-컷오버.
            </div>
        </div>
    </div>

    @* ══ v5.1.0 자율 무정지 복구 & 실전 라이브 감시망 ═══════════════════════════ *@
    @{
        bool wdComa = Watchdog.Health == SessionHealth.Coma;
        bool foActive = Failover.Active == ActiveChannel.Standby;
        bool chDown = Failover.Active == ActiveChannel.None;
        bool bsFrozen = OrphanReaper.Freezes > 0;
        bool wdHealthy = !wdComa && Failover.Active == ActiveChannel.Primary && !bsFrozen;
        long bsHex = (OrphanReaper.Freezes << 24) | ((OrphanReaper.Orphans & 0xFFFF) << 8) | (Failover.Failovers & 0xFF);
    }
    @if (bsFrozen)
    {
        <div style="margin:0 28px 18px;background:rgba(150,10,10,0.30);border:2px solid #b40000;border-radius:10px;padding:18px 22px;animation:recpulse 0.7s ease-in-out infinite">
            <div style="font-size:16px;font-weight:700;color:#ff3030;margin-bottom:6px">🟥 [BLACK SWAN DEFENSE — 자본 묶임 강제 동결(고아주문 재수확 데드라인 초과)]</div>
            <div style="font-size:13px;color:#ffb0b0;font-family:var(--mono)">
                FORENSIC ERR CODE: <b>0x@(bsHex.ToString("X8"))</b> &nbsp;|&nbsp; 고아 탐지 @OrphanReaper.Orphans.ToString("N0") · 자본 회수 @OrphanReaper.Reclaimed.ToString("N0") · 강제 동결 @OrphanReaper.Freezes.ToString("N0")
            </div>
        </div>
    }
    else if (foActive || chDown)
    {
        <div style="margin:0 28px 18px;background:rgba(255,193,7,0.18);border:2px solid #ffc107;border-radius:10px;padding:16px 20px;animation:recpulse 1s ease-in-out infinite">
            <div style="font-size:15px;font-weight:700;color:#ffca28">🟡 @(chDown ? "[ALL CHANNELS DOWN — FAIL-CLOSED FREEZE]" : "[AUTONOMOUS FAILOVER IN PROGRESS - ROUTING TO STANDBY]")</div>
        </div>
    }
    <div class="kpi-card @(bsFrozen || chDown ? "kpi-alert" : (wdComa || foActive ? "kpi-amber" : ""))" style="margin-bottom:22px">
        <div class="kpi-label">🐕 Autonomous Live Watchdog & Healing Core — 자율 무정지 복구 감시망</div>
        @if (wdHealthy)
        {
            <div class="prod-safe-banner">🔵 [ALL SESSIONS HEALTHY — WATCHDOG & HEALING CORE NOMINAL]</div>
        }
        <div style="display:flex;gap:20px;margin-top:10px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(wdComa ? "chaos-red" : "prod-auth")">@Watchdog.Health.ToString()</span></div><div class="kpi-sub">① 세션 감시견 (Coma @Watchdog.ComaCount.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@((Watchdog.LastLatencyTicks / 10.0).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))<span style="font-size:12px">µs</span></div><div class="kpi-sub">세션 왕복 지연</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(chDown ? "chaos-red" : foActive ? "chaos-amber" : "prod-auth")">@Failover.Active.ToString()</span></div><div class="kpi-sub">② 활성 채널 (페일오버 @Failover.Failovers.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@((Starvation.AvailabilityScoreMilli / 10.0).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))<span style="font-size:12px">%</span></div><div class="kpi-sub">③ 쓰레드풀 가용성 (아사 @Starvation.Starvations.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@OrphanReaper.InFlightCount.ToString("N0")</div><div class="kpi-sub">④ 고아 감시 in-flight</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(bsFrozen ? "chaos-red" : OrphanReaper.Orphans > 0 ? "chaos-amber" : "prod-auth")">@(bsFrozen ? "FROZEN" : OrphanReaper.Orphans > 0 ? "ORPHANS" : "NOMINAL")</span></div><div class="kpi-sub">★블랙스완 방어선</div></div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            ① 20ms 핑퐁 RTT 연속 3회 100ms 초과→Coma 진단→IgnitionLock.Downgrade + 격리 소켓 리셋. ② 채널 물리 장애→대안 채널 자율 라우팅(exactly-once dedup @Failover.DedupBlocks.ToString("N0") 차단·복구 @Failover.Recoveries.ToString("N0")), 양채널 다운→fail-closed. ③ ThreadPool 아사+지터→SetMinThreads 프로비저닝(@Starvation.Provisions.ToString("N0")).
            ④ ★Think Beyond: 발주 후 종단 응답 무도착(자본 허공 묶임)을 실측 RTT 분포 적응형 데드라인으로 탐지→진상 조회 자본 회수(heal)→불확정+재수확 데드라인 초과 시 fail-closed 동결.
            ★liveArmed:false: 모든 자율 복구는 '더 안전한 방향(강등/동결/섀도우)'으로만 — 페일오버·세션 리셋이 백만 번 일어나도 이중키(ValveWired∧LiveArmingWired)∧MasterIgnited 없이는 실주문 0바이트.
        </div>
    </div>

    @* ══ v5.2.0 미시 유동성 슬라이서 & HFT 스로틀 코어 ═══════════════════════════ *@
    @{
        double imb = Slicer.LastImbalanceRaw / 100_000_000.0;         // [-1,+1]
        double bidPct = Math.Clamp(50.0 + imb * 50.0, 0.0, 100.0);    // 매수측 비중(%)
        double askPct = 100.0 - bidPct;
        bool toxFrozen = Toxic.Verdict == ToxicityVerdict.Toxic;
        bool toxCaution = Toxic.Verdict == ToxicityVerdict.Caution;
        long nowTs = System.Diagnostics.Stopwatch.GetTimestamp();   // UI 표시용 tick(트레이딩 판정 아님) — stale-aware rate 조회
        long rate1s = Throttle.Rate1s(nowTs);
        bool throttling = rate1s >= Throttle.Limit1s;
        long toxHex = ((long)Toxic.Verdict << 24) | ((Slicer.LastImbalanceRaw < 0 ? 1L : 0L) << 20) | (Toxic.ToxicTrips & 0xFFFF);
    }
    @if (toxFrozen)
    {
        <div style="margin:0 28px 18px;background:rgba(60,10,90,0.34);border:2px solid #7b1fa2;border-radius:10px;padding:18px 22px;animation:recpulse 0.7s ease-in-out infinite">
            <div style="font-size:16px;font-weight:700;color:#ce93d8;margin-bottom:6px">🟪 [TOXIC FLOW DETECTED — 독약 유동성 감지·슬라이서 홀드·점화 강등]</div>
            <div style="font-size:13px;color:#e1bee7;font-family:var(--mono)">
                FORENSIC ERR CODE: <b>0x@(toxHex.ToString("X8"))</b> &nbsp;|&nbsp; 비대칭 @(imb.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)) · 가속도 @Toxic.LastVelocityRaw.ToString("N0") · Toxic 트립 @Toxic.ToxicTrips.ToString("N0")
            </div>
        </div>
    }
    else if (throttling)
    {
        <div style="margin:0 28px 18px;background:rgba(255,193,7,0.18);border:2px solid #ffc107;border-radius:10px;padding:16px 20px;animation:recpulse 1s ease-in-out infinite">
            <div style="font-size:15px;font-weight:700;color:#ffca28">🟡 [ORDER THROTTLING ACTIVE - DELAYING HOT-PATH] — 초당 주문 한도 90% 도달·마이크로 스로틀</div>
        </div>
    }
    <div class="kpi-card @(toxFrozen ? "kpi-alert" : (toxCaution || throttling ? "kpi-amber" : ""))" style="margin-bottom:22px">
        <div class="kpi-label">🚦 미시 유동성 슬라이서 & HFT 스로틀 코어 (Micro-Liquidity Slicer &amp; HFT Throttle)</div>
        @* 5호가 양방향 비대칭 게이지(Pure CSS·매수 빨강/매도 파랑·한국 관례) *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">5호가 잔량 비대칭 — 매수 @(bidPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))% · 매도 @(askPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%</div>
            <div style="display:flex;height:18px;border-radius:6px;overflow:hidden;background:rgba(255,255,255,0.06)">
                <div style="width:@(bidPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:#e34d4d;transition:width .2s"></div>
                <div style="width:@(askPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:#5082c8;transition:width .2s"></div>
            </div>
        </div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@Slicer.SlicesEmitted.ToString("N0")</div><div class="kpi-sub">누적 슬라이스(주문 @Slicer.OrdersSliced.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Throttle.Throttled.ToString("N0")</div><div class="kpi-sub">스로틀 작동(1s rate @rate1s.ToString("N0")/@Throttle.Limit1s.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Slicer.CumSavedBps.ToString("N0")<span style="font-size:12px">bps</span></div><div class="kpi-sub">누적 슬리피지 절감(덤프 회피)</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(toxFrozen ? "chaos-red" : toxCaution ? "chaos-amber" : "prod-auth")">@Toxic.Verdict.ToString()</span></div><div class="kpi-sub">★독약 유동성 방어선</div></div>
            <div><div class="kpi-value" style="font-size:18px">@Slicer.HeldByToxic.ToString("N0") / @Slicer.HeldByThrottle.ToString("N0")</div><div class="kpi-sub">독성 홀드 / 스로틀 홀드</div></div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            대규모 주문을 5호가 즉시체결 가능 잔량분만 발라 미니 TWAP 분할→50ms 드레인 링 동기 사출(시장 충격 최소화). 초당 주문 한도 90% 도달 시 마이크로 스로틀(Hold).
            ★Think Beyond 독약 유동성: 비대칭 가속도 단측 3σ + 스프레드/RTT 유령 + 북워크 독성 베토 합성 3등급 — Caution 슬라이스 절반 축소·Toxic 전량 홀드+IgnitionLock.Downgrade.
            ★liveArmed:false: 슬라이서/스로틀/독성 방어는 전부 '주문 흐름을 줄이는' 방향만 — 슬라이스도 무장 게이트(이중키∧MasterIgnited) 하류라 미무장 시 실 송출 0바이트.
        </div>
    </div>

    @* ══ v5.3.0 무정지 전략 핫패치 게이트 & ALC 격리 그리드 ═══════════════════════ *@
    @{
        long hgGen        = ReloadGate.Generation;
        string hgVer      = ReloadGate.ActiveVersion;
        long hgBuild      = ReloadGate.ActiveBuildTicks;
        bool hgSwapping   = ReloadGate.Swapping;
        long hgReloads    = ReloadGate.Reloads;
        long hgRejects    = ReloadGate.Rejects;
        long hgUnloads    = ReloadGate.Unloads;
        long zbCount      = Zombie.ZombieCount;
        long zbCollected  = Zombie.CollectedCount;
        int  zbPending    = Zombie.PendingUnloads;
        long zbOrphan     = Zombie.OrphanEventsRejected;
        long scRttNs      = StateCarrier.LastHandoverRttNs;
        long scHandovers  = StateCarrier.Handovers;
        int  scInflight   = StateCarrier.InFlightCount;
        bool zbLeak       = zbCount > 0;
        bool alcCollected = hgUnloads > 0 && zbPending == 0 && !zbLeak;   // 언로드분 전부 GC 수거 완료
        // 포렌식 코드(64bit): [좀비16|세대16|대기16|고아16]
        long zHex = ((zbCount & 0xFFFF) << 48) | ((hgGen & 0xFFFF) << 32) | (((long)zbPending & 0xFFFF) << 16) | (zbOrphan & 0xFFFF);
    }
    @if (zbLeak)
    {
        <div style="margin:0 28px 18px;background:rgba(60,10,90,0.34);border:2px solid #7b1fa2;border-radius:10px;padding:18px 22px;animation:recpulse 0.7s ease-in-out infinite">
            <div style="font-size:16px;font-weight:700;color:#ce93d8;margin-bottom:6px">🟪 [ZOMBIE ASSEMBLY LEAK — 구 전략 ALC 수거 실패·참조 누출·점화 강등]</div>
            <div style="font-size:13px;color:#e1bee7;font-family:var(--mono)">
                FORENSIC ERR CODE: <b>0x@(zHex.ToString("X16"))</b> &nbsp;|&nbsp; 좀비 @zbCount.ToString("N0") · 세대 @hgGen.ToString("N0") · 언로드 대기 @zbPending.ToString("N0") · 고아 이벤트 거부 @zbOrphan.ToString("N0")
            </div>
        </div>
    }
    else if (hgSwapping)
    {
        <div style="margin:0 28px 18px;background:rgba(255,193,7,0.18);border:2px solid #ffc107;border-radius:10px;padding:16px 20px;animation:recpulse 0.8s ease-in-out infinite">
            <div style="font-size:15px;font-weight:700;color:#ffca28">🟡 [DYNAMIC RE-INITIALIZATION IN PROGRESS - LEAPING TO NEW MODEL] — 무정지 전략 핫스왑 진행 중·구버전 핫패스 원자 차단</div>
        </div>
    }
    <div class="kpi-card @(zbLeak ? "kpi-alert" : (hgSwapping ? "kpi-amber" : "kpi-hotswap-ok"))" style="margin-bottom:22px">
        <div class="kpi-label">🔌 무정지 전략 핫패치 게이트 & ALC 격리 그리드 (Hot-Strategy Reload Gate &amp; ALC Isolation)</div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@hgVer</div><div class="kpi-sub">활성 전략 버전 (세대 @hgGen.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:16px;font-family:var(--mono)">@hgBuild.ToString("N0")</div><div class="kpi-sub">빌드 타임스탬프(ticks)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@scRttNs.ToString("N0")<span style="font-size:12px">ns</span></div><div class="kpi-sub">상태 이월 RTT(In-Flight @scInflight · 이월 @scHandovers.ToString("N0")회)</div></div>
            <div>
                <div class="kpi-value" style="font-size:16px">
                    <span class="prod-badge @(zbLeak ? "chaos-red" : alcCollected ? "prod-auth" : "prod-idle")">@(zbLeak ? "누수" : alcCollected ? "GC 수거 완료" : "수거 대기")</span>
                </div>
                <div class="kpi-sub">구 ALC 수거(수거 @zbCollected.ToString("N0") · 대기 @zbPending.ToString("N0"))</div>
            </div>
            <div><div class="kpi-value" style="font-size:18px">@zbCount.ToString("N0") / @zbOrphan.ToString("N0")</div><div class="kpi-sub">★좀비 누수 / 고아 이벤트 거부</div></div>
            <div><div class="kpi-value" style="font-size:18px">@hgReloads.ToString("N0") / @hgRejects.ToString("N0") / @hgUnloads.ToString("N0")</div><div class="kpi-sub">리로드 / 거부 / 언로드</div></div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            메인 어셈블리·브로커 소켓·청산 메쉬가 살아있는 채로 알파 전략 바이너리만 수거 가능 ALC(isCollectible)에 격리 로드→CAS 래치로 구버전 핫패스 원자 차단→신버전 원자 바인딩(Interlocked.Exchange)→상태 이월→구 ALC Unload.
            ★Think Beyond 세대 펜스+WeakReference 어테스테이션: 핫스왑마다 세대 전진 — 구 ALC 누출 이벤트는 세대 불일치로 δ=0 거부(고아 방어), 구 ALC 는 grace(5s) 롤링 수거 확인 후 미수거 시 좀비 격리+IgnitionLock.Downgrade.
            ★liveArmed:false: 핫스왑은 무장 상태 무접촉 — 교체 전략의 신호도 무장 게이트(이중키∧MasterIgnited) 하류라 미무장 시 실 송출 0바이트. 서명 검증기 미배선이면 어떤 Reload 도 거부(fail-closed).
        </div>
    </div>

    @* ══ v5.4.0 다중 전략 인터리빙 메쉬 & 바스켓 네팅 코어 ═══════════════════════ *@
    @{
        int  msActive  = Mesh.ActiveLaneCount;
        int  msSealed  = Mesh.SealedLaneCount;
        int  msMuted   = Mesh.MutedLaneCount;
        int  msLanes   = Mesh.LaneCount;
        long msSatBps  = Mesh.CapitalSaturationBps;
        long netSaved  = Netter.SavedCostRawCum;
        long netEff    = Netter.NettingEfficiencyBps;
        long netEvents = Netter.NetEvents;
        long crossed   = Netter.CrossedQtyCum;
        long washRej   = WashGuard.Rejections;
        long washAdm   = WashGuard.Admits;
        long fwRes     = Firewall.ResonanceMetric;
        long fwSeals   = Firewall.SealCount;
        long fwCasc    = Firewall.Cascades;
        long fwEpochs  = Firewall.Epochs;
        bool cascade   = fwCasc > 0;
        bool muted     = !cascade && (msSealed + msMuted + fwSeals) > 0;
        // 포렌식 코드(64bit): [공진16|봉인16|캐스케이드16|자전거래거부16]
        long mHex = ((fwRes & 0xFFFF) << 48) | ((fwSeals & 0xFFFF) << 32) | ((fwCasc & 0xFFFF) << 16) | (washRej & 0xFFFF);
        decimal savedDec = netSaved / 100_000_000m;
    }
    @if (cascade)
    {
        <div style="margin:0 28px 18px;background:rgba(60,10,90,0.34);border:2px solid #7b1fa2;border-radius:10px;padding:18px 22px;animation:recpulse 0.7s ease-in-out infinite">
            <div style="font-size:16px;font-weight:700;color:#ce93d8;margin-bottom:6px">🟪 [CROSS-STRATEGY RISK CASCADE — 교차 전략 전염·자본 구획 봉인·전역 강등 수렴]</div>
            <div style="font-size:13px;color:#e1bee7;font-family:var(--mono)">
                FORENSIC ERR CODE: <b>0x@(mHex.ToString("X16"))</b> &nbsp;|&nbsp; 공진 @fwRes.ToString("N0") · 봉인 구획 @fwSeals.ToString("N0") · 캐스케이드 @fwCasc.ToString("N0") · 자전거래 거부 @washRej.ToString("N0")
            </div>
        </div>
    }
    else if (muted)
    {
        <div style="margin:0 28px 18px;background:rgba(255,193,7,0.18);border:2px solid #ffc107;border-radius:10px;padding:16px 20px;animation:recpulse 0.9s ease-in-out infinite">
            <div style="font-size:15px;font-weight:700;color:#ffca28">🟡 [STRATEGY LAUNCH BUFFER MUTED - RESEGMENTING CAPITALS] — 공진/자폭 전략 구획 봉인·생존 구획 자본 재분할</div>
        </div>
    }
    <div class="kpi-card @(cascade ? "kpi-alert" : (muted ? "kpi-amber" : "kpi-hotswap-ok"))" style="margin-bottom:22px">
        <div class="kpi-label">🔀 다중 전략 인터리빙 메쉬 & 바스켓 네팅 코어 (Multi-Strategy Interleaved Mesh &amp; Netting)</div>
        @* 전략별 자본 포화 다중 분할 가로 바(Pure CSS·레인마다 세로 포화 게이지·봉인=자색/진압=황색/포화高=적색) *@
        <div style="margin-top:10px">
            <div class="kpi-sub" style="margin-bottom:4px">전략 구획 자본 포화 — 활성 @msActive · 봉인/진압 @(msSealed + msMuted) · 총 @msLanes 레인</div>
            @if (msLanes > 0)
            {
                <div style="display:flex;height:20px;border-radius:6px;overflow:hidden;background:rgba(255,255,255,0.06);gap:1px">
                    @for (int i = 0; i < msLanes; i++)
                    {
                        var st = Mesh.LaneStateOf(i);
                        long satI = Mesh.LaneSaturationBps(i);
                        double fill = Math.Clamp(satI / 100.0, 0.0, 100.0);
                        string segColor = st == LaneState.Sealed ? "#7b1fa2" : st == LaneState.Muted ? "#ffb300" : (satI >= 9000 ? "#e34d4d" : satI >= 6000 ? "#ffb300" : "#4caf50");
                        <div style="flex:1;position:relative;background:rgba(255,255,255,0.05)" title="레인 @i 포화 @((satI/100.0).ToString("F1"))%">
                            <div style="position:absolute;bottom:0;left:0;right:0;height:@(fill.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:@segColor;transition:height .2s"></div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="height:20px;border-radius:6px;background:rgba(255,255,255,0.04);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted,#888)">대기 — 운영자 전략 레인 등록 전(시세 수신·레인 등록은 무장 무관)</div>
            }
        </div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@msActive<span style="font-size:12px"> / @msLanes</span></div><div class="kpi-sub">활성 공존 전략(총 레인)</div></div>
            <div><div class="kpi-value" style="font-size:18px">₩@savedDec.ToString("N0")</div><div class="kpi-sub">누적 네팅 절감(상쇄 @crossed.ToString("N0")·효율 @((netEff/100.0).ToString("F1"))%)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@netEvents.ToString("N0")</div><div class="kpi-sub">네팅 처리 틱</div></div>
            <div><div class="kpi-value" style="font-size:18px">@washRej.ToString("N0")</div><div class="kpi-sub">★자전거래 차단(통과 @washAdm.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:16px"><span class="prod-badge @(cascade ? "chaos-red" : fwSeals > 0 ? "chaos-amber" : "prod-auth")">@fwRes.ToString("N0")</span></div><div class="kpi-sub">★공진 메트릭(봉인 @fwSeals·캐스케이드 @fwCasc·에폭 @fwEpochs)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@((msSatBps/100.0).ToString("F1"))%</div><div class="kpi-sub">전체 자본 포화도</div></div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            복수 격리 알파 두뇌가 단일 시세 스트림을 δ=0 락프리 팬아웃 공유·소비. 전역 예수금을 정수 가중치 비율로 물리 분할(무할당 자본 가드: 1raw 초과 발주 차단·타 전략 예산 잠식 불가). 동일 틱 대향 주문은 내부 상쇄(왕복 수수료·세 절감), 잔여만 하류 사출.
            ★Think Beyond 교차 전략 전염 방화벽: 봉인 자본 재분배 금지(구획 격벽)+δ=0 공동낙폭 비트셋 공진(popcount)+손실속도 퓨즈 → 주도 전략 봉인, 다수 봉인 시 IgnitionLock 전역 백스톱. 자전거래 가드는 마이크로 윈도우 대향 주문 무효화(거래소 자전거래 셧다운 방어).
            ★liveArmed:false: 팬아웃/네팅/상쇄/잔여는 전부 무장 게이트(이중키∧MasterIgnited) 하류 — 미무장 시 실 송출 0바이트. 자전거래 거부도 드레인 전 차단이지 실주문 경로 신설 아님.
        </div>
    </div>

    @* ══ v5.5.0 영지식 초고속 로깅 패브릭 & 커널 지터 센티널 ═══════════════════════ *@
    @{
        long lgPushed  = Ms2Logger.PushedTotal;
        long lgDropped = Ms2Logger.DroppedTotal;
        long lgQueue   = Ms2Logger.QueueDepth;
        long lgFrames  = Ms2Logger.FramesWritten;
        long lgErrors  = Ms2Logger.DrainErrors;
        double lgCompPct = Ms2Logger.CompressionRatioBps / 100.0;   // 압축 후 비율(%)
        double lgMbSec = _frame.LogPersistMbPerSec;                 // 초당 영속(MB/s·Sample 산출)
        long kjMicros  = KernelJitter.LastJitterMicros;
        long kjSpikes  = KernelJitter.JitterSpikes;
        long kjGcSpk   = KernelJitter.GcPauseSpikes;
        long kjGcMic   = KernelJitter.LastGcPauseSpikeMicros;
        long kjNic     = KernelJitter.NicDropsEstimate;
        long kjEsc     = KernelJitter.Escalations;
        bool kjHold    = KernelJitter.SafeHoldActive;
        long ioStatus  = IoFirewall.StatusCode;
        long ioPageSpk = IoFirewall.PageFaultSpikes;
        long ioTouchUs = IoFirewall.LastTouchMicros;
        long ioStalls  = IoFirewall.DiskStalls;
        bool ioPageHold = IoFirewall.PageThrashHoldActive;
        bool ioFrozen  = IoFirewall.DiskStallFrozen;
        bool holding   = kjHold || ioPageHold;
        // 포렌식 코드(64bit): [지터µs16|GC스파이크16|페이지폴트16|드롭16]
        long kHex = ((kjMicros & 0xFFFF) << 48) | ((kjGcSpk & 0xFFFF) << 32) | ((ioPageSpk & 0xFFFF) << 16) | (lgDropped & 0xFFFF);
    }
    @if (ioFrozen)
    {
        <div style="margin:0 28px 18px;background:rgba(60,10,90,0.34);border:2px solid #7b1fa2;border-radius:10px;padding:18px 22px;animation:recpulse 0.7s ease-in-out infinite">
            <div style="font-size:16px;font-weight:700;color:#ce93d8;margin-bottom:6px">🟪 [DISK I/O STALL DETECTED — 디스크 쓰기 목졸림·전역 동결·수동 해제 요구]</div>
            <div style="font-size:13px;color:#e1bee7;font-family:var(--mono)">
                FORENSIC ERR CODE: <b>0x@(kHex.ToString("X16"))</b> &nbsp;|&nbsp; 디스크 stall @ioStalls.ToString("N0") · 로그 큐 @lgQueue.ToString("N0") · 드롭 @lgDropped.ToString("N0") · I/O 오류 @lgErrors.ToString("N0")
            </div>
        </div>
    }
    else if (holding)
    {
        <div style="margin:0 28px 18px;background:rgba(255,193,7,0.18);border:2px solid #ffc107;border-radius:10px;padding:16px 20px;animation:recpulse 0.8s ease-in-out infinite">
            <div style="font-size:15px;font-weight:700;color:#ffca28">🟡 [KERNEL JITTER SPIKE DETECTED - HOLDING HOT-PATH] — @(ioPageHold ? "페이지폴트 thrashing" : "커널/GC 지터 스파이크")·무장 안전 홀드(가역·자기회복)</div>
        </div>
    }
    <div class="kpi-card @(ioFrozen ? "kpi-alert" : (holding ? "kpi-amber" : "kpi-hotswap-ok"))" style="margin-bottom:22px">
        <div class="kpi-label">📦 영지식 초고속 로깅 패브릭 & 커널 지터 센티널 (Zero-Alloc Async Logger &amp; Kernel Sentinel)</div>
        <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
            <div><div class="kpi-value" style="font-size:18px">@lgMbSec.ToString("F2")<span style="font-size:12px">MB/s</span></div><div class="kpi-sub">이진 로그 영속 속도(프레임 @lgFrames.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@lgQueue.ToString("N0")</div><div class="kpi-sub">I/O 백그라운드 큐 포화(드롭 @lgDropped.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@lgCompPct.ToString("F1")%</div><div class="kpi-sub">압축 후 비율(Brotli·낮을수록 효율↑)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@kjMicros.ToString("N0")<span style="font-size:12px">µs</span></div><div class="kpi-sub">OS 커널 정밀 지터(3σ 스파이크 @kjSpikes.ToString("N0"))</div></div>
            <div><div class="kpi-value" style="font-size:18px">@kjGcMic.ToString("N0")<span style="font-size:12px">µs</span></div><div class="kpi-sub">GC Pause 스파이크(@kjGcSpk.ToString("N0")회)</div></div>
            <div><div class="kpi-value" style="font-size:18px">@kjNic.ToString("N0")</div><div class="kpi-sub">NIC 패킷 드롭 추정</div></div>
            <div>
                <div class="kpi-value" style="font-size:16px">
                    <span class="prod-badge @(ioFrozen ? "chaos-red" : holding ? "chaos-amber" : "prod-auth")">@(ioFrozen ? "디스크 동결" : holding ? "안전 홀드" : "정상")</span>
                </div>
                <div class="kpi-sub">★OS/HW 방어선(페이지 터치 @ioTouchUs.ToString("N0")µs·폴트 @ioPageSpk.ToString("N0")·강등 @kjEsc.ToString("N0"))</div>
            </div>
        </div>
        <div class="kpi-sub" style="margin-top:10px">
            핫패스는 고정 32B blittable 이벤트를 언매니지드 락프리 링에 δ=0 O(1) 푸시하고 즉시 복귀 — 백그라운드 전용 I/O 스레드가 Brotli 압축(내장·의존성 0)/XOR 난독/CRC32 프레임 무결 후 .ms2log 에 비동기 영속. 링 만원(디스크 stall)이면 드롭-오래된-것 무대기 덮어쓰기로 50ms 발주 드레인에 지터 무전파.
            ★Think Beyond I/O 역류 방화벽: 로거 큐/진행 워치독으로 디스크 쓰기 목졸림 감지 시 ForceFreeze(파국·fail-closed), 자가계측 페이지폴트 프로브(상주 페이지 QPC 터치 계측)로 스와핑 thrashing 감지 시 가역 안전 홀드. 커널 지터 센티널은 QPC 스케줄링 지터·GC pause·NIC drop 단측 3σ → 스파이크 시 무장 억제(가역), 지속 시 Downgrade.
            ★liveArmed:false: 로거/센티널/방화벽은 IBroker·소켓 참조 0 — 관측/영속 인프라. 안전 홀드는 무장 술어를 '더 안전한 방향(false)'으로만 억제(이중키∧MasterIgnited 우회 0). 커널/GC/NIC 지터는 인프라 관측이라 트레이딩 판정 입력 무유입(결정론).
        </div>
    </div>

    @* 데이터 없음 안내 *@
    @if (!_frame.HasActivity)
    {
        <div style="text-align:center;padding:40px;color:var(--muted,#888);font-size:14px">
            <div style="font-size:28px;margin-bottom:12px">📭</div>
            <div>링 활동 없음 — OrderDispatchRing 에 제안이 발행되지 않았거나 샘플러가 미시작입니다.</div>
            <div style="margin-top:8px;font-size:12px;font-family:var(--mono)">RingTelemetryPublisher.Sample() 주기 호출 여부를 확인하세요.</div>
        </div>
    }

    @* 세쿼록 채널 진단 *@
    <div style="margin-top:10px;padding:12px 16px;background:var(--card-bg,rgba(255,255,255,0.04));border-radius:8px;font-size:12px;color:var(--muted,#888);font-family:var(--mono)">
        채널 버전: @(Channel.Version)
        &nbsp;|&nbsp; 폴링 주기: 150ms (PeriodicTimer, 무할당)
        &nbsp;|&nbsp; seqlock 8회 재시도 후 직전 프레임 유지
        &nbsp;|&nbsp; 게이팅 모드: @(Attestation.Mode)
    </div>
</div>

<style>
    .kpi-card {
        background: var(--card-bg, rgba(255,255,255,0.05));
        border: 1px solid var(--border, rgba(255,255,255,0.08));
        border-radius: 10px;
        padding: 14px 16px;
        display: flex; flex-direction: column; gap: 4px;
    }
    .kpi-card.kpi-alert {
        border-color: rgba(220, 50, 50, 0.5);
        background: rgba(180, 20, 20, 0.10);
    }
    .kpi-card.kpi-amber {
        border-color: rgba(255, 152, 0, 0.6);
        background: rgba(255, 152, 0, 0.08);
    }
    /* v5.3.0 — 핫스왑 정상(healthy): 청색 안정(시스템 상태색 — 시세 방향 아님). 스왑 중 amber / 좀비 누수 적. */
    .kpi-card.kpi-hotswap-ok {
        border-color: rgba(66, 133, 244, 0.45);
        background: rgba(66, 133, 244, 0.07);
    }
    .kpi-label { font-size: 11px; color: var(--muted, #888); text-transform: uppercase; letter-spacing: 0.05em; }
    .kpi-value { font-size: 22px; font-weight: 600; font-family: var(--mono); }
    .kpi-sub   { font-size: 11px; color: var(--muted, #888); }
    /* v4.90.0 — 웜 스타트 복구 단계 배지: Stable 녹 / Draining·Escalating 황색 점멸 / Idle 회 / Frozen 적. */
    .rec-badge      { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 6px; font-family: var(--mono); }
    .rec-idle       { background: rgba(255,255,255,0.08); color: var(--muted, #888); }
    .rec-validating { background: rgba(255,152,0,0.18);   color: #ffb74d; }
    .rec-busy       { background: rgba(255,152,0,0.22);   color: #ffb74d; animation: recpulse 1s ease-in-out infinite; }
    .rec-stable     { background: rgba(76,175,80,0.20);   color: #66bb6a; }
    .rec-frozen     { background: rgba(220,50,50,0.22);   color: #ff6b6b; }
    @@keyframes recpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    /* ★v6.1.0 CausalWeave 크림슨 풀-스크린 퓨즈 경보(화면 전체 테두리 점멸 · pointer-events:none 로 UI 비차단) */
    .causal-crimson-frame { position: fixed; inset: 0; pointer-events: none; z-index: 99998;
        border: 10px solid #ff0000; box-sizing: border-box; animation: crimsonpulse 0.55s ease-in-out infinite; }
    .causal-crimson-banner { position: fixed; top: 0; left: 50%; transform: translateX(-50%); z-index: 99999;
        pointer-events: none; background: rgba(150,0,0,0.94); color: #fff; padding: 10px 30px;
        border: 2px solid #ff0000; border-top: none; border-radius: 0 0 14px 14px; text-align: center;
        box-shadow: 0 0 26px rgba(255,0,0,0.75); }
    /* 감사훼손+퓨즈 동시 트립 시 퓨즈 배너를 아래로 내려 두 경보가 겹치지 않고 세로 스택(둘 다 판독 가능) */
