            <div style="min-width:220px">
                <div class="kpi-value" style="font-size:14px">미시 알파 <b style="font-family:var(--mono);color:@(aAlpha > 0 ? "#ef5350" : (aAlpha < 0 ? "#42a5f5" : "#9e9e9e"))">@aAlpha.ToString("+0.000;-0.000;0.000")</b></div>
                <div class="kpi-sub">실측 조율 @_frame.AvxCalibrations.ToString("N0") · ZMM keep-alive @_frame.ZmmWarmKeepAlives.ToString("N0")</div>
