@code {
    private const string ChartId = "telemetryChart";   // 상수(캐시 — push 마다 문자열 재생성 없음)
    private const int    ChartCapacity = 60;            // 최근 60프레임(~9초 @150ms)

    // 직전 성공 프레임 — TryRead false(경합) 시 이 값 그대로 유지(StateHasChanged 불호출).
    private RingTelemetry _frame;
    private long _tornReads;                            // 읽기 경합(torn/미발행 재시도) UI측 계수 — δ=0 long 증가
    private bool _chartReady;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // v4.90.0 — 웜 스타트 서명 입력·상태 메시지.
    private string _sig = "";
    private string _recMsg = "";

    // v4.91.0 — 카오스 그리드 시드 재현 입력·상태 메시지.
    private string _seed = "42";
    private string _chaosMsg = "";

    // v4.97.0 — 원자 컷오버 서명 입력·상태 메시지.
    private string _cutSig = "";
    private string _cutMsg = "";

    // v5.0.0 — Red Team 킬스위치 서명·상태 메시지.
    private string _killSig = "";
    private string _rtMsg = "";

    // v4.93.0 — 🧠 패널 SVG 마이크로차트 데모 시계열 + 뉴스 닷(idx2 악재 파랑·idx5 호재 빨강). 실 운영은 종목별 시세/뉴스로 결속.
    private static readonly decimal[] _demoSeries = { 100m, 101m, 99m, 98m, 102m, 105m, 103m, 107m };
    private static readonly List<NewsRadarSvg.NewsDot> _demoDots = new() { new(2, false), new(5, true) };

    // v4.95.0 — 🗃️ 블랙박스 헥스덤프: 동결 시 최근 N 레코드를 1회 정적 투사(캐시). 사전할당 버퍼·per-poll 재생성 금지(GC 폭탄 방지).
    private const int HexRecordCount = 100;
    private readonly FlightRecordEvent[] _hexBuf = new FlightRecordEvent[HexRecordCount];
    private string? _hexCache;
    private string BuildHexDump()
    {
        int n = Blackbox.SnapshotRecent(_hexBuf);
        if (n == 0) return "(레코드 없음 — 링 비었거나 봉인 전 기록 0)";
        return FlightHexRenderer.Render(new ReadOnlySpan<FlightRecordEvent>(_hexBuf, 0, n));
    }

    // 시드 재현 트리거 — 결정론 카오스 시나리오를 가상 시간선에서 백그라운드 재현(순수 인메모리·외부 API 0바이트).
    private void DoReproduceChaos()
    {
        if (!int.TryParse((_seed ?? "").Trim(), out var seed)) { _chaosMsg = "정수 시드를 입력하세요."; return; }
        _chaosMsg = $"시드 {seed} 카오스 시나리오 가상 재현 — 백그라운드 실행(1000× 압축 시간선).";
        Chaos.ReproduceInBackground(seed, new ChaosGridConfig());
    }

    // v4.92.0 — 프로덕션 스왑 브로커 연결상태 배지 CSS(Authenticated 녹·Connecting 황·SessionStale 황 점멸·Disconnected 회).
    private static string LinkCss(BrokerLinkState s) => s switch
    {
        BrokerLinkState.Authenticated => "prod-auth",
        BrokerLinkState.Connecting    => "prod-connecting",
        BrokerLinkState.SessionStale  => "prod-stale",
        _                             => "prod-idle"
    };

    // 단계별 배지 CSS(타임라인). RingTelemetry.RecoveryStateCss 는 '현재 단계' 전용이라 각 단계 색은 이 헬퍼로.
    private static string RecoveryCss(RecoveryState s) => s switch
    {
        RecoveryState.Stable                                  => "rec-stable",
        RecoveryState.Draining or RecoveryState.Escalating    => "rec-busy",
        RecoveryState.Frozen                                  => "rec-frozen",
        RecoveryState.Validating                              => "rec-validating",
        _                                                     => "rec-idle"
    };

    // 서명 확인 → 수동 해제 + 웜 스타트(단일 백그라운드 스레드). 동결 아님/공백 서명은 착화 거부(fail-closed 안내).
    private void DoWarmRestart()
    {
        var sig = (_sig ?? "").Trim();
        if (string.IsNullOrWhiteSpace(sig)) { _recMsg = "운영자 서명을 입력하세요."; return; }
        if (Attestation.Mode != GatingMode.EmergencyFreeze) { _recMsg = "동결(EmergencyFreeze) 상태가 아닙니다 — 웜 스타트 불필요."; return; }
        _recMsg = "웜 스타트 시퀀스 착화 — 백그라운드 진행(단계 배지로 추적).";
        _sig = "";                 // 서명 즉시 화면에서 제거(잔류 방지)
        Recovery.Trigger(sig);     // mesh.Stop→ManualRelease→백로그 드레인(펜스)→점화 승격→Stable / 실패 시 재동결
    }

    // v4.97.0 — 2단 컷오버 핸들러(순수 UI 스레드). 서명 공백은 fail-closed 거부. 컷오버 성공/거부 사유를 그대로 표출.
    private void DoPreArm()
    {
        var sig = (_cutSig ?? "").Trim();
        if (string.IsNullOrWhiteSpace(sig)) { _cutMsg = "운영자 서명을 입력하세요."; return; }
        _cutMsg = Cutover.PreArm(sig).Reason;   // 이중키∧격리프로브∧3σ → MasterIgnited(섀도우 유지)
    }

    private void DoCutover()
    {
        var sig = (_cutSig ?? "").Trim();
        if (string.IsNullOrWhiteSpace(sig)) { _cutMsg = "운영자 서명을 입력하세요."; return; }
        var r = Cutover.Cutover(sig);           // 사전무장 확인·이중키 재검 → <1ms 원자 flip
        _cutSig = "";                            // 서명 즉시 화면에서 제거(잔류 방지)
        _cutMsg = r.Reason;
    }

    private void DoRollback()
    {
        Cutover.RollbackToShadow("운영자 수동 되감기 — 섀도우 플라이트 복귀");   // EnterShadow() 원자 flip(<0.1ms)
        _cutMsg = "되감기 완료 — 섀도우 플라이트로 복귀(자본 100% 안전).";
    }

    // 컷오버 상태 배지 CSS(SHADOW=중립·ARMED=연결중·CANARY=스테일 점멸·LIVE/FROZEN=적색).
    private static string CutoverBadgeCss(CutoverState s) => s switch
    {
        CutoverState.ArmedReady       => "prod-connecting",
        CutoverState.CanaryQuarantine => "prod-stale",
        CutoverState.Live             => "chaos-red",
        CutoverState.Frozen           => "chaos-red",
        _                             => "prod-idle",   // Shadow / RolledBack
    };

    // v5.0.0 — Red Team 컨트롤 핸들러(순수 UI 스레드).
    private void DoKillSwitch()
    {
        var sig = (_killSig ?? "").Trim();
        if (string.IsNullOrWhiteSpace(sig)) { _rtMsg = "비상정지 서명을 입력하세요."; return; }
        bool tripped = KillSwitch.Trip(sig);   // 서명 검증→ForceFreeze+금고 재봉인+소켓 Abort
        _killSig = "";
        _rtMsg = tripped ? "🛑 킬스위치 발동 — 비상 정지·금고 재봉인·소켓 Abort 수렴." : "서명 거부 — 킬스위치 미발동(위조 방지).";
    }

    private void DoDeadmanStart()
    {
        Deadman.StartWatching();
        _rtMsg = "👁️ 데드맨 감시 시작 — 30초 내 생존 신호 없으면 자동 섀도우 역-컷오버.";
    }

    private void DoDeadmanBeat()
    {
        Deadman.Beat();
        _rtMsg = "💓 생존 신호 갱신.";
    }

    protected override void OnInitialized()
    {
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(150));
        _ = PollLoopAsync(_cts.Token);
    }

    // 첫 렌더 후 JS 차트 초기화(canvas DOM 존재 시점). 고정크기 Float64Array ring 1회 할당.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("dashboard.telemetryChart.init", ChartId, ChartCapacity); _chartReady = true; }
            catch { /* JS 미로드 시 차트만 비활성(데이터 카드는 정상) */ }
        }
    }

    // ★ 백그라운드 폴링 루프 — 렌더링 스레드와 독립.
    //   차트는 매 틱 JS canvas 로 직접 push(δ=0: C# 문자열 미생성·Blazor 렌더 트리 미경유). KPI 텍스트는 새 프레임에만 렌더.
    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct).ConfigureAwait(false))
            {
                bool got = Channel.TryRead(out var latest);
                if (got) _frame = latest;
                else     _tornReads++;   // 읽기 경합(직전 프레임 유지) — UI측 torn 계수(코어 무손상)

                // UI 스레드 마샬링: ① JS 차트 push(스칼라 2개·문자열 0) ② 새 프레임이면 KPI 텍스트 렌더.
                //   push 는 매 틱(추세 시간축 진행), StateHasChanged 는 got 일 때만(불필요 렌더 억제).
                await InvokeAsync(async () =>
                {
                    // 차트 push 는 teardown 레이스(네비게이션 중 WebView 단절)에서 throw 가능 — 삼켜 fire-and-forget 무옵저브 차단.
                    if (_chartReady)
                        try { await JS.InvokeVoidAsync("dashboard.telemetryChart.push",
                            ChartId, _frame.ThroughputPerSec, (double)_frame.WriterCollisions).ConfigureAwait(false); }
                        catch (JSDisconnectedException) { }
                        catch (ObjectDisposedException) { }
                    if (got) StateHasChanged();
                }).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) { /* 컴포넌트 Dispose 시 정상 탈출 */ }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync().ConfigureAwait(false);
        _timer?.Dispose();
        _cts.Dispose();
    }
}
