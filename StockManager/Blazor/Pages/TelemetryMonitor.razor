@* ══ 계기판 ════════════════════════════════════════════════════════════════ *@
<div style="padding:0 28px 28px">

    @* 상단 KPI 카드 열 *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px">
        <div class="kpi-card @(_frame.HasAlert ? "kpi-alert" : "")">
            <div class="kpi-label">Published</div>
            <div class="kpi-value">@(_frame.Published < 0 ? "—" : _frame.Published.ToString("N0"))</div>
            <div class="kpi-sub">링 최고 발행 시퀀스</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Forwarded</div>
            <div class="kpi-value" style="color:var(--green,#4caf50)">@(_frame.Forwarded.ToString("N0"))</div>
            <div class="kpi-sub">무장 실송출 (성공)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">GatedOut</div>
            <div class="kpi-value" style="color:var(--yellow,#ffc107)">@(_frame.GatedOut.ToString("N0"))</div>
            <div class="kpi-sub">미무장 차단 (fail-closed)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Dropped</div>
            <div class="kpi-value" style="color:@(_frame.Dropped > 0 ? "var(--orange,#ff9800)" : "inherit")">@(_frame.Dropped.ToString("N0"))</div>
            <div class="kpi-sub">추월 유실 (소비 지연)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">WriterCollisions</div>
            <div class="kpi-value" style="color:@(_frame.WriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.WriterCollisions.ToString("N0"))</div>
            <div class="kpi-sub">동시 발행 위반 (CAS 낙방)</div>
        </div>
        <div class="kpi-card @(_frame.HasAlert ? "kpi-alert" : "")">
            <div class="kpi-label">SendErrors</div>
            <div class="kpi-value" style="color:@(_frame.SendErrors > 0 ? "#ff4444" : "inherit");font-weight:@(_frame.SendErrors > 0 ? "800" : "400")">@(_frame.SendErrors.ToString("N0"))</div>
            <div class="kpi-sub">downstream throw 누적</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Throughput</div>
            <div class="kpi-value">@(_frame.ThroughputPerSec.ToString("N1"))</div>
            <div class="kpi-sub">건/초 (직전 샘플 델타)</div>
        </div>
    </div>

    @* ══ δ=0 실시간 추세 차트 — Canvas(JS) 직접 드로잉. C# 은 매 틱 스칼라 2개만 push(SVG 문자열 KB 폭발 없음) ══ *@
    <div style="background:var(--card-bg,rgba(255,255,255,0.04));border:1px solid var(--border,rgba(255,255,255,0.08));border-radius:10px;padding:12px 14px;margin-bottom:22px">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:8px">
            <span class="kpi-label">최근 @(ChartCapacity)프레임 추세 (~@(ChartCapacity * 150 / 1000)초)</span>
            <span style="font-size:11px;color:var(--muted,#888)"><span style="display:inline-block;width:12px;height:2px;background:#4caf50;vertical-align:middle"></span> Throughput</span>
            <span style="font-size:11px;color:var(--muted,#888)"><span style="display:inline-block;width:12px;height:2px;background:#f44336;vertical-align:middle"></span> WriterCollisions</span>
        </div>
        @* width/height = 픽셀 백버퍼. 문자열·MarkupString 미사용 — 좌표는 전부 JS 측 Float64Array→canvas. *@
        <canvas id="@ChartId" width="900" height="120" style="width:100%;height:120px;display:block"></canvas>
    </div>

    @* ══ 다중 seqlock 교차 관제(주문 파이프라인 ↔ 시나리오 변이) ══════════════════ *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:22px">
        <div class="kpi-card">
            <div class="kpi-label">📡 주문 파이프라인 seqlock</div>
            <div style="display:flex;gap:20px;margin-top:6px">
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.WriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.WriterCollisions.ToString("N0"))</div><div class="kpi-sub">라이터 경합</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(_tornReads.ToString("N0"))</div><div class="kpi-sub">읽기 경합(torn 재시도·UI계수)</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(Channel.Version.ToString("N0"))</div><div class="kpi-sub">채널 버전</div></div>
            </div>
        </div>
        <div class="kpi-card @(_frame.ScenarioFrozen > 0 ? "kpi-alert" : "")">
            <div class="kpi-label">🌀 시나리오 변이 seqlock @(_frame.ScenarioActive ? "" : "(비활성)")</div>
            <div style="display:flex;gap:20px;margin-top:6px">
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.ScenarioWriterCollisions > 0 ? "var(--red,#f44336)" : "inherit")">@(_frame.ScenarioWriterCollisions.ToString("N0"))</div><div class="kpi-sub">라이터 경합(슬라이더)</div></div>
                <div><div class="kpi-value" style="font-size:18px;color:@(_frame.ScenarioFrozen > 0 ? "#ff4444" : "inherit")">@(_frame.ScenarioFrozen.ToString("N0"))</div><div class="kpi-sub">산출 동결</div></div>
                <div><div class="kpi-value" style="font-size:18px">@(_frame.ScenarioVersion.ToString("N0"))</div><div class="kpi-sub">발행 버전</div></div>
            </div>
            @if (!_frame.ScenarioActive)
            {
                <div class="kpi-sub" style="margin-top:6px">미래가치 시뮬(/future/sim) 열면 슬라이더 경합이 실시간 합류됩니다.</div>
            }
        </div>
    </div>

    @* ══ v7.0.0 Phase 7: RIO 하드웨어 사전점검 매트릭스 & 암호학적 감사 금고 (Pre-Flight & Audit Vault) ══ *@
    @{
        bool p7RioOk    = _frame.RioProbeOk;
        bool p7Fallback = _frame.RioProbeFallback;
        bool p7Intact   = _frame.AuditIntact;
        bool p7Corrupt  = _frame.AuditCorrupted;
        bool p7Sealed   = _frame.AuditSealed;
        long p7Head     = _frame.AuditLedgerHeadHash;
    }
    @* 감사 원장 무결성 훼손(CORRUPTED) → 비가역 크림슨 경보 오버레이(트립 봉인은 CausalWeave 퓨즈 오버레이가 담당) *@
    @if (p7Corrupt)
    {
        <div class="causal-crimson-frame"></div>
        <div class="causal-crimson-banner">
            <div style="font-size:16px;font-weight:800;letter-spacing:0.5px">🟥 [AUDIT LEDGER CORRUPTED - CRYPTOGRAPHIC CHAIN BROKEN]</div>
            <div style="font-size:12px;margin-top:3px">SHA-256 해시체인 변조 감지 · <b>비가역 포렌식 경보</b> — 원장 무결성 훼손</div>
            <div style="font-size:12px;margin-top:3px;font-family:var(--mono)">HEAD 0x@(p7Head.ToString("X16")) · 레코드 @_frame.AuditLedgerCount.ToString("N0")</div>
        </div>
    }
    <div class="kpi-card @(p7Corrupt ? "kpi-alert" : (p7Fallback ? "kpi-amber" : (p7RioOk ? "kpi-hotswap-ok" : "")))" style="margin-bottom:22px">
        <div class="kpi-label">🔍 RIO 하드웨어 사전 점검 매트릭스 &amp; 암호학적 감사 금고 (Pre-Flight &amp; Audit Vault)</div>
        <div style="display:flex;gap:28px;flex-wrap:wrap;margin-top:6px">
            <div style="min-width:280px">
                <div class="kpi-value" style="font-size:15px">
                    @if (p7RioOk)
                    {
                        <span class="prod-badge neon-teal">[RIO HW SUPPORTED - PRE-FLIGHT PASS]</span>
                    }
                    else if (p7Fallback)
                    {
                        <span class="prod-badge chaos-amber">[RIO UNSUPPORTED - SAFE FALLBACK 권고]</span>
                    }
                    else
                    {
                        <span class="prod-badge">[HW PROBE IDLE]</span>
                    }
                </div>
                <div class="kpi-sub">물리 어댑터 @_frame.RioProbeAdapterCount.ToString("N0") · 최대 수신버퍼 @_frame.RioProbeMaxRcvBufMB.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) MB</div>
            </div>
            <div style="min-width:300px">
                <div class="kpi-value" style="font-size:15px">
                    @if (p7Corrupt)
                    {
                        <span class="prod-badge chaos-red">[AUDIT LEDGER CORRUPTED]</span>
                    }
                    else if (p7Intact)
                    {
                        <span class="prod-badge neon-teal">[AUDIT LEDGER INTACT]</span>
                    }
                    else
                    {
                        <span class="prod-badge">[LEDGER UNVERIFIED]</span>
                    }
                    @if (p7Sealed)
                    {
                        <span class="prod-badge chaos-red" style="margin-left:6px">🔒 TRIP-SEALED (비가역)</span>
                    }
                </div>
                <div class="kpi-sub">SHA-256 Append-Only 해시체인 · 레코드 @_frame.AuditLedgerCount.ToString("N0") · HEAD <b style="font-family:var(--mono)">0x@(p7Head.ToString("X16"))</b></div>
            </div>
            <div style="min-width:200px">
                <div class="kpi-sub" style="margin-bottom:2px">안심 강등(Safe Fallback) 권고</div>
                <div class="kpi-value" style="font-size:15px;color:@(p7Fallback ? "#ffb74d" : "#26ffe6")">@(p7Fallback ? "RECOMMENDED" : "불필요")</div>
                <div class="kpi-sub">하드웨어 캡스 사전점검 기반</div>
            </div>
        </div>
        @if (!p7RioOk && !p7Fallback && !_frame.AuditVaultWired)
        {
            <div class="kpi-sub" style="margin-top:6px">하드웨어 프로브/감사 금고 미배선 — RingTelemetryPublisher 에 hwProbe/auditVault 주입 시 실시간 합류.</div>
        }
    </div>

    @* ══ v6.0.0 Path Gamma: 결정론 리플레이 & RIO 커널 바이패스 코어 (+ ★CausalWeave 인과 워터마크) ══ *@
    @{
        bool gRioOn   = _frame.RioActive;
        bool gRioFb   = _frame.RioFallback;
        bool gPbRun   = _frame.PlaybackRunning;
        bool gCwFuse  = _frame.CausalFuse;
        bool gCwEvict = _frame.CausalEvicting;
        string gPbWidth  = _frame.PlaybackProgressPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        string gSatWidth = Math.Min(100.0, _frame.CausalRingSaturationPct).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
        string gFps      = _frame.PlaybackFps.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
        // 포렌식(64bit): [RIO지연ns하위16 | 링포화‰16 | 증명회수하위16 | 재생진행%×10 16]
        long gHex = ((_frame.RioReceiveLatencyNanos & 0xFFFF) << 48) | ((_frame.CausalRingSaturationPermille & 0xFFFF) << 32)
                  | ((_frame.CausalRingEvictions & 0xFFFF) << 16) | ((long)(_frame.PlaybackProgressPct * 10.0) & 0xFFFF);
    }
    @* ★크림슨 풀-스크린 퓨즈 경보 — 화면 전체 테두리 점멸(#ff0000) + 하드웨어 오프셋 포렌식 브로드캐스트 *@
    @if (gCwFuse)
    {
        @if (!p7Corrupt) { <div class="causal-crimson-frame"></div> }  @* 감사훼손 동시 트립 시 전체화면 테두리 이중 렌더 방지 *@
        <div class="causal-crimson-banner@(p7Corrupt ? " causal-crimson-banner--stacked" : "")">
            <div style="font-size:17px;font-weight:800;letter-spacing:0.5px">🟥 [CRITICAL CAUSAL FUSE TRIPPED - SYSTEM FROZEN]</div>
