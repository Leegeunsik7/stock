@page "/risklab"
@page "/risklab/{Tab}"
@inject NavigationManager Nav

<HubTabs Items="_tabs" Active="@Cur" OnSelect="Sel" />
@switch (Cur)
{
    case "scenario": <ScenarioPage /> break;
    default: <MonteCarloPage /> break;
}

@code {
    [Parameter] public string? Tab { get; set; }
    private string Cur => string.IsNullOrWhiteSpace(Tab) ? "montecarlo" : Tab!.ToLowerInvariant();
    private readonly (string, string)[] _tabs = { ("montecarlo", "몬테카를로"), ("scenario", "시나리오 스튜디오") };
    private void Sel(string k) => Nav.NavigateTo(k == "montecarlo" ? "/risklab" : $"/risklab/{k}");
}
