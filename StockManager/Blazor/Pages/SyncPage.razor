@page "/sync"
@inject LocalDatabase Db

<div class="top">
    <div class="hello"><h1>🔄 다기기 동기화</h1><p>중앙 서버 없이 — 암호화 번들 파일을 기기 간에 옮겨 거래·보유를 안전하게 병합(E2EE · 백업 · 미리보기)</p></div>
    <button class="ghost" style="margin-right:16px" @onclick="OpenFolder">📂 동기화 폴더 열기</button>
</div>

<div style="padding:0 28px 40px;max-width:900px">
    <div class="sub" style="font-size:12px;margin-bottom:14px">
        이 기기 ID: <code>@_device</code> · 폴더: <code>@_dir</code>
    </div>

    <div style="background:color-mix(in srgb,var(--accent) 7%,transparent);border:1px solid var(--line);border-radius:12px;padding:11px 14px;font-size:12px;line-height:1.7;margin-bottom:18px">
        🔒 <b>안전 설계</b>: 라이브 네트워크 연결 없음(파일만 교환) · AES-256-GCM 종단간 암호화 · 머지는 <b>가산적</b>(거래=합집합·중복제거, 보유=신규만 추가) · 적용 전 DB 자동 백업 · <b>API키·비밀번호·계좌번호·LAN PIN 등 비밀/식별자는 번들에 포함되지 않음</b>(허용목록 기반).
        <br/>ℹ️ 단, 거래·보유의 <b>메모/태그</b> 자유 텍스트는 그대로 포함됩니다 — 메모에 비밀번호·토큰을 적지 마세요.
    </div>

    <!-- 내보내기 -->
    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:10px">① 내보내기 — 이 기기 → 암호화 번들</div>
        <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-bottom:10px">
            <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" @bind="_optTx" /> 거래 내역</label>
            <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" @bind="_optHold" /> 보유 종목</label>
            <label style="display:flex;align-items:center;gap:6px"><input type="checkbox" @bind="_optSet" /> 환경설정<span class="sub" style="font-size:11px">(비밀 제외)</span></label>
            <button class="ghost" @onclick="RefreshCounts">집계</button>
            @if (_counts is not null)
            {
                <span class="sub" style="font-size:12px">거래 @(_counts.Transactions) · 보유 @(_counts.Holdings) · 설정 @(_counts.Settings)</span>
            }
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <input type="password" placeholder="암호(6자 이상)" @bind="_pass" style="padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)" />
            <input type="password" placeholder="암호 확인" @bind="_pass2" style="padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)" />
            <button class="addbtn" @onclick="Export">🔐 암호화 번들 생성</button>
        </div>
        @if (!string.IsNullOrEmpty(_exportMsg))
        {
            <div class="sub" style="font-size:12px;margin-top:9px">@_exportMsg</div>
        }
        <div class="sub" style="font-size:11px;margin-top:8px">⚠️ 암호는 어디에도 저장되지 않습니다. 다른 기기에서 같은 암호를 입력해야 복호화됩니다 — 잊으면 복구 불가.</div>
    </div>

    <!-- 가져오기 -->
    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:10px">② 가져오기 — 다른 기기의 번들 → 이 기기</div>
        <div class="sub" style="font-size:11.5px;margin-bottom:9px">다른 기기에서 만든 <code>.ms2sync</code> 파일을 동기화 폴더에 복사한 뒤 아래에서 선택하세요.</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
            <select @bind="_sel" style="padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);min-width:280px">
                <option value="">— 번들 파일 선택 —</option>
                @foreach (var f in _files)
                {
                    <option value="@f">@System.IO.Path.GetFileName(f)</option>
                }
            </select>
            <button class="ghost" @onclick="RefreshFiles">🔄 목록</button>
            <input type="password" placeholder="암호" @bind="_impPass" style="padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)" />
            <button class="addbtn" @onclick="Preview">👁 미리보기</button>
        </div>
        @if (!string.IsNullOrEmpty(_impMsg))
        {
            <div class="sub" style="font-size:12px;margin-top:6px">@_impMsg</div>
        }

        @if (_plan is not null)
        {
            <div style="margin-top:12px;border:1px solid var(--line);border-radius:10px;overflow:hidden">
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                        <th style="text-align:left;padding:8px 12px">종류</th>
                        <th style="text-align:left;padding:8px 12px;width:90px">추가</th>
                        <th style="text-align:left;padding:8px 12px;width:90px">충돌</th>
                    </tr></thead>
                    <tbody>
                        <tr style="border-top:1px solid var(--line)"><td style="padding:7px 12px">거래</td><td style="padding:7px 12px;color:var(--up,#16a34a);font-weight:700">+@(_plan.InsertsOf(SyncKind.Transaction))</td><td style="padding:7px 12px">@(_plan.ConflictsOf(SyncKind.Transaction))</td></tr>
                        <tr style="border-top:1px solid var(--line)"><td style="padding:7px 12px">보유</td><td style="padding:7px 12px;color:var(--up,#16a34a);font-weight:700">+@(_plan.InsertsOf(SyncKind.Holding))</td><td style="padding:7px 12px">@(_plan.ConflictsOf(SyncKind.Holding))</td></tr>
                        <tr style="border-top:1px solid var(--line)"><td style="padding:7px 12px">설정</td><td style="padding:7px 12px;color:var(--up,#16a34a);font-weight:700">+@(_plan.InsertsOf(SyncKind.Setting))</td><td style="padding:7px 12px">@(_plan.ConflictsOf(SyncKind.Setting))</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="sub" style="font-size:11.5px;margin-top:8px">
                @_bundleInfo · <b>추가 @(_plan.Inserts)건</b>은 백업 후 안전 적용 · 동일 @(_plan.Identical)건 무시 · <b>충돌 @(_plan.Conflicts)건</b>은 기본 미적용(기존 보존).
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px">
                <label style="display:flex;align-items:center;gap:6px;font-size:12.5px"><input type="checkbox" @bind="_applyConflicts" /> 설정 충돌도 덮어쓰기(수신값 우선)</label>
                <button class="addbtn" disabled="@(_plan.Inserts == 0 && !(_applyConflicts && _plan.ConflictsOf(SyncKind.Setting) > 0))" @onclick="Apply">💾 백업 후 적용</button>
            </div>
        }
    </div>
</div>

@code {
    private string _device = "";
    private string _dir = SyncService.SyncDir;

    // 내보내기
    private bool _optTx = true, _optHold = true, _optSet = false;
    private string _pass = "", _pass2 = "", _exportMsg = "";
    private SyncCounts? _counts;

    // 가져오기
    private List<string> _files = new();
    private string _sel = "", _impPass = "", _impMsg = "", _bundleInfo = "";
    private MergePlan? _plan;
    private bool _applyConflicts;

    protected override void OnInitialized()
    {
        _device = SyncService.DeviceId(Db);
        RefreshFiles();
        RefreshCounts();
    }

    private SyncOptions CurrentOpt() => new SyncOptions(_optTx, _optHold, _optSet);

    private void RefreshCounts()
    {
        try { _counts = SyncService.CountLocal(Db, CurrentOpt()); }
        catch (Exception ex) { _exportMsg = "집계 실패: " + ex.Message; }
    }

    private void RefreshFiles() => _files = SyncService.ListBundles();

    private void Export()
    {
        _exportMsg = "";
        if (!_optTx && !_optHold && !_optSet) { _exportMsg = "⚠️ 내보낼 항목을 하나 이상 선택하세요."; return; }
        if (_pass.Length < 6) { _exportMsg = "⚠️ 암호는 6자 이상이어야 합니다."; return; }
        if (_pass != _pass2) { _exportMsg = "⚠️ 두 암호가 일치하지 않습니다."; return; }
        try
        {
            var path = SyncService.ExportToFile(Db, CurrentOpt(), _pass);
            _pass = _pass2 = "";
            RefreshFiles();
            _exportMsg = $"✅ 생성됨: {System.IO.Path.GetFileName(path)} — 이 파일을 다른 기기의 동기화 폴더로 복사하세요.";
        }
        catch (Exception ex) { _exportMsg = "내보내기 실패: " + ex.Message; }
    }

    private void Preview()
    {
        _plan = null; _impMsg = ""; _bundleInfo = "";
        if (string.IsNullOrEmpty(_sel)) { _impMsg = "⚠️ 번들 파일을 선택하세요."; return; }
        if (!SyncService.TryImportFile(_sel, _impPass, out var bundle, out var err) || bundle is null)
        { _impMsg = "❌ " + err; return; }
        try
        {
            _plan = SyncService.PlanAgainstLocal(Db, bundle, new SyncOptions(true, true, true));
            var when = DateTime.TryParse(bundle.ExportedAtIso, out var dt) ? dt.ToString("yyyy-MM-dd HH:mm") : bundle.ExportedAtIso;
            _bundleInfo = $"기기 {bundle.DeviceId} · {when} · 레코드 {bundle.Records.Count}건";
        }
        catch (Exception ex) { _impMsg = "미리보기 실패: " + ex.Message; }
    }

    private void Apply()
    {
        if (_plan is null) return;
        try
        {
            var res = SyncService.ApplyPlan(Db, _plan, _applyConflicts, backup: true);
            _impMsg = $"✅ 적용 완료 — 추가 {res.Inserted} · 충돌적용 {res.ConflictsApplied} · 스킵 {res.Skipped}" +
                      (string.IsNullOrEmpty(res.BackupPath) ? "" : $" · 백업: {System.IO.Path.GetFileName(res.BackupPath)}");
            Preview();  // 적용 후 재계획(이제 동일로 표시)
        }
        catch (Exception ex) { _impMsg = "적용 실패: " + ex.Message; }
    }

    private void OpenFolder()
    {
        try
        {
            System.IO.Directory.CreateDirectory(_dir);
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo { FileName = _dir, UseShellExecute = true });
        }
        catch (Exception ex) { _exportMsg = "폴더 열기 실패: " + ex.Message; }
    }
}
