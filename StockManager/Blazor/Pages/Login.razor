    .lg-pill{position:relative;display:flex;align-items:center;gap:11px;padding:12px 13px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:13px;overflow:hidden;transition:border-color .18s,transform .18s,background .18s}
    .lg-pill::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(180deg,#818cf5,transparent);opacity:.7}
    .lg-pill::after{content:'';position:absolute;top:6px;right:6px;width:6px;height:6px;border-top:1px solid rgba(124,138,255,.5);border-right:1px solid rgba(124,138,255,.5)}
    .lg-pill:hover{border-color:rgba(124,138,255,.44);background:rgba(124,138,255,.07);transform:translateY(-2px)}
    .lg-pill-ic{font-size:1.35rem;flex:0 0 auto}
    .lg-pill b{display:block;font-size:13px;color:#eef1fb}
    .lg-pill small{font-size:10.5px;color:#97a1bd}
    .lg-badges{margin-top:28px;display:flex;gap:9px;flex-wrap:wrap}
    .lg-badge{font-size:11.5px;font-weight:700;padding:6px 13px;border-radius:999px;background:rgba(124,138,255,.1);border:1px solid rgba(124,138,255,.3);color:#a9b2f0}
    .lg-badge.ok{background:rgba(52,211,153,.12);border-color:rgba(52,211,153,.4);color:#6ee7b7}

    .lg-panel{position:relative;align-self:center;justify-self:center;width:min(410px,86%);margin:5vh 6% 5vh 0;padding:30px 32px 34px;border-radius:20px;overflow:hidden;z-index:3;
        background:linear-gradient(180deg,rgba(16,22,42,.86),rgba(9,12,24,.92));backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
        border:1px solid rgba(124,138,255,.24);box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 40px rgba(60,72,180,.12),inset 0 1px 0 rgba(255,255,255,.05)}
    .lg-pc{position:absolute;width:18px;height:18px;border:2px solid rgba(129,140,245,.6);z-index:2}
    .lg-pc.tl{top:10px;left:10px;border-right:0;border-bottom:0}.lg-pc.tr{top:10px;right:10px;border-left:0;border-bottom:0}
    .lg-pc.bl{bottom:10px;left:10px;border-right:0;border-top:0}.lg-pc.br{bottom:10px;right:10px;border-left:0;border-top:0}
    .lg-pscan{position:absolute;left:0;right:0;height:70px;pointer-events:none;background:linear-gradient(180deg,transparent,rgba(124,138,255,.07),transparent);animation:lgSweepY 5.5s linear infinite}
    .lg-p-status{display:flex;align-items:center;gap:8px;font:700 9.5px/1 'Roboto Mono',Consolas,monospace;letter-spacing:.1em;color:#6b78a0;margin-bottom:16px}
    .lg-p-dot{width:7px;height:7px;border-radius:50%;background:#818cf5;box-shadow:0 0 8px #818cf5;animation:lgPulse 1.6s ease-in-out infinite}
    .lg-p-armed{margin-left:auto;color:#6ee7b7;letter-spacing:.08em}
    .lg-p-head{margin-bottom:18px}
    .lg-p-title{font-size:19px;font-weight:800;color:#eef1fb}
    .lg-p-sub{font-size:12.5px;color:#97a1bd;margin-top:5px}
    .lg-lbl{display:block;font-size:12px;font-weight:600;color:#9aa4cf;margin:14px 0 6px}
    .lg-inwrap{position:relative;display:flex;align-items:center;gap:9px;background:rgba(8,11,22,.6);border:1px solid rgba(124,138,255,.2);border-radius:11px;padding:0 13px;transition:border-color .15s,box-shadow .15s}
    .lg-inwrap:focus-within{border-color:#818cf5;box-shadow:0 0 0 3px rgba(124,138,255,.15),0 0 22px rgba(124,138,255,.12)}
    .lg-in-ic{font-size:14px;opacity:.82}
    .lg-in2{flex:1;min-width:0;box-sizing:border-box;background:transparent;border:none;outline:none;color:#eef1fb;font-size:14px;font-family:inherit;padding:12px 0;letter-spacing:.3px}
    .lg-in2::placeholder{color:#5f6a90}
    .lg-err{margin-top:12px;padding:9px 12px;border-radius:9px;background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.35);color:#fca5a5;font-size:12.5px}
    .lg-reg-ok{margin-bottom:14px;padding:10px 12px;border-radius:10px;font-size:12.5px;font-weight:700;color:#a9b2f0;background:rgba(124,138,255,.1);border:1px solid rgba(124,138,255,.3);line-height:1.5}
    .lg-reg-ok b{color:#eef1fb}
    .lg-btn{position:relative;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:20px;padding:14px;border-radius:12px;border:0;cursor:pointer;font-family:inherit;font-size:15px;font-weight:800;overflow:hidden;
        color:#fff;background:linear-gradient(135deg,#818cf5,#4f5bd5);box-shadow:0 10px 26px rgba(79,91,213,.36);transition:filter .15s,transform .1s}
    .lg-btn::after{content:'';position:absolute;top:0;left:-60%;width:45%;height:100%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);animation:lgShine 3.6s ease-in-out infinite}
    @@keyframes lgShine{0%{left:-60%}55%,100%{left:130%}}
    .lg-btn:hover{filter:brightness(1.08)}.lg-btn:active{transform:translateY(1px)}
    .lg-arrow{font-weight:900}
    .lg-alt{width:100%;margin-top:11px;padding:11px;border-radius:11px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;
        color:#a9b2f0;background:transparent;border:1px solid rgba(124,138,255,.3);transition:background .15s,border-color .15s}
    .lg-alt:hover{background:rgba(124,138,255,.08);border-color:rgba(124,138,255,.5)}
    .lg-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07)}
    .lg-trust span{font-size:10px;font-weight:700;color:#6b78a0}
    .lg-foot{margin-top:12px;text-align:center;font-size:11px;color:#5f6a90}

    @@media(max-width:860px){.lg-wrap{grid-template-columns:1fr}.lg-brand{padding:7vh 8vw 2vh}.lg-panel{margin:2vh auto 6vh}.lg-pillars{grid-template-columns:1fr}.lg-chart{display:none}.lg-brand-in{max-width:none}.lg-tele{max-width:none}}
    @@media(prefers-reduced-motion:reduce){.lg-ma,.lg-btn::after,.lg-scanlines::after,.lg-pscan{animation:none}}
</style>

@code {
    private string _id = "", _pw = "", _error = "";
    private bool _showRegister;
    private string _justRegistered = "";
    private static readonly System.Globalization.CultureInfo Ci = System.Globalization.CultureInfo.InvariantCulture;

    // ── 캔들스틱 차트(정적 · 상승 추세) ──
    private readonly record struct Candle(double X, double Wy1, double Wy2, double By, double Bh, bool Up);
    private static readonly (Candle[] Cs, string Ma) Chart = BuildChart();
    private static Candle[] Candles => Chart.Cs;
    private static string MaPoints => Chart.Ma;
    private static string F(double v) => v.ToString("0.#", Ci);

    private static (Candle[], string) BuildChart()
    {
        double[] p = { 100, 104, 101, 107, 111, 108, 114, 118, 116, 123, 128, 125, 132, 137, 134, 141, 146 };
        double min = p.Min() - 4, max = p.Max() + 4;
        double Y(double price) => 30 + (max - price) / (max - min) * 300;
        int n = p.Length - 1;
        var list = new List<Candle>(n);
        var ma = new System.Text.StringBuilder();
        for (int i = 1; i <= n; i++)
        {
            double open = p[i - 1], close = p[i];
            double wick = 1.6 + (i % 3) * 1.4;
            double hi = Math.Max(open, close) + wick, lo = Math.Min(open, close) - wick;
            double x = 34 + (i - 1) * (520.0 / (n - 1));
            double byTop = Y(Math.Max(open, close));
            double bh = Math.Abs(Y(open) - Y(close));
            list.Add(new Candle(x, Y(hi), Y(lo), byTop, bh, close >= open));
            double m = 0; int c = 0;
            for (int k = Math.Max(0, i - 3); k <= i; k++) { m += p[k]; c++; }
            ma.Append(x.ToString("0.#", Ci)).Append(',').Append(Y(m / c).ToString("0.#", Ci)).Append(' ');
        }
        return (list.ToArray(), ma.ToString().Trim());
    }

    // ── 실시간 지수 텔레메트리(서버 타이머) ──
    private sealed class Tick { public string Label = ""; public double Val; public double Chg; public string Fmt = "N2"; }
    private readonly List<Tick> _ticks = new()
    {
        new Tick { Label = "KOSPI", Val = 2648.70, Chg = 0.42, Fmt = "N2" },
        new Tick { Label = "KOSDAQ", Val = 858.30, Chg = -0.31, Fmt = "N2" },
        new Tick { Label = "NASDAQ", Val = 18327.4, Chg = 0.88, Fmt = "N2" },
        new Tick { Label = "USD/KRW", Val = 1362.5, Chg = -0.12, Fmt = "N1" },
        new Tick { Label = "BTC", Val = 94215, Chg = 1.34, Fmt = "N0" },
    };
    private readonly Random _rng = new();
    private System.Threading.Timer? _hudTimer;
    private volatile bool _disposed;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated) { Nav.NavigateTo("", forceLoad: false); return; }
        _hudTimer = new System.Threading.Timer(_ => HudTick(), null, 1300, 1300);
    }

    private void HudTick()
    {
        if (_disposed) return;
        try
        {
            foreach (var t in _ticks)
            {
                var drift = (_rng.NextDouble() - 0.5) * (t.Val * 0.0007);
                t.Val = Math.Max(0.01, t.Val + drift);
                t.Chg = Math.Clamp(t.Chg + (_rng.NextDouble() - 0.5) * 0.07, -3.8, 3.8);
            }
            InvokeAsync(StateHasChanged);
        }
        catch { /* 회로 종료 후 무시 */ }
    }

    private void DoLogin()
    {
        var id = _id.Trim();
        if (id.Length < 3 || _pw.Length < 4) { _error = "아이디 3자·비밀번호 4자 이상 입력하세요."; return; }
        var m = Members.Authenticate(id, _pw);
        if (!m.Ok) { _error = m.Message; _pw = ""; return; }
        Session.SignIn(id, m.Role, m.Message);
        _error = "";
        Nav.NavigateTo("", forceLoad: false);   // BlazorWebView 단일 컨텍스트 — SPA 네비게이션(게이트가 싱글턴 세션 판독)
    }

    private void OnRegistered(StockRegisterModal.RegisterResult res)
    {
        _showRegister = false;
        _id = res.UserId;
        _pw = "";
        _justRegistered = res.MemberId;
        _error = "";
    }

    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") DoLogin(); }

    public void Dispose() { _disposed = true; _hudTimer?.Dispose(); _hudTimer = null; }
}
