    .lg-scanlines{position:fixed;inset:0;z-index:4;pointer-events:none;opacity:.28;
        background:repeating-linear-gradient(0deg,rgba(124,138,255,.05) 0,rgba(124,138,255,.05) 1px,transparent 2px,transparent 4px)}
    .lg-scanlines::after{content:'';position:absolute;left:0;right:0;height:140px;
