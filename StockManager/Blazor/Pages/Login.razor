@page "/login"
@layout EmptyLayout
@implements IDisposable
@inject StockManager.Common.Account.MemberRegistryService Members
@inject StockManager.Common.Account.SessionState Session
@inject NavigationManager Nav

@* [MS2E StockSuite] 통합 트레이딩 콘솔 로그인 — 핀테크 트레이딩 터미널.
   좌: 브랜딩(로고·실시간 지수 HUD·4대 기능 필러) + 캔들차트 워터마크(우측 블리드·텍스트 뒤) / 우: 보안 접속 카드.
   자립형 SVG·CSS + 서버 타이머(외부 라이브러리 0). 회원 원장(MemberRegistry) 실인증 · BlazorWebView 단일 인터랙티브. *@

<div class="lg-wrap">
    <div class="lg-frame" aria-hidden="true"><span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span></div>
    <div class="lg-scanlines" aria-hidden="true"></div>

    <div class="lg-brand">
        @* ── 캔들스틱 차트 워터마크(우측 블리드 · 저투명 · 텍스트 뒤) ── *@
        <svg class="lg-chart" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <g stroke="rgba(124,138,255,.12)" stroke-width="1">
                <line x1="20" y1="70" x2="580" y2="70" /><line x1="20" y1="140" x2="580" y2="140" />
                <line x1="20" y1="210" x2="580" y2="210" /><line x1="20" y1="280" x2="580" y2="280" />
            </g>
            @foreach (var c in Candles)
            {
                <line x1="@F(c.X)" y1="@F(c.Wy1)" x2="@F(c.X)" y2="@F(c.Wy2)" stroke="@(c.Up ? "#34d399" : "#f87171")" stroke-width="1.4" opacity=".85" />
                <rect x="@F(c.X - 8)" y="@F(c.By)" width="16" height="@F(Math.Max(2, c.Bh))" rx="2"
                      fill="@(c.Up ? "rgba(52,211,153,.85)" : "rgba(248,113,113,.85)")" stroke="@(c.Up ? "#34d399" : "#f87171")" stroke-width="1" />
            }
            <polyline points="@MaPoints" fill="none" stroke="#f0a028" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity=".9" class="lg-ma" />
            <polyline points="30,300 570,70" fill="none" stroke="rgba(129,140,245,.55)" stroke-width="1.6" stroke-dasharray="3 8" />
        </svg>
        <div class="lg-scrim" aria-hidden="true"></div>

        <div class="lg-brand-in">
            @* 실시간 지수 텔레메트리 HUD *@
            <div class="lg-tele">
                <span class="lg-arm"><span class="lg-arm-dot"></span>MARKET LIVE</span>
                @foreach (var t in _ticks)
                {
                    <span class="lg-t-i">
                        <i>@t.Label</i>
                        <b>@t.Val.ToString(t.Fmt, Ci)</b>
                        <u class="@(t.Chg >= 0 ? "up" : "down")">@(t.Chg >= 0 ? "▲" : "▼")@Math.Abs(t.Chg).ToString("0.00", Ci)%</u>
                    </span>
                }
            </div>

            <div class="lg-brandrow">
                <div class="lg-logobox"><span style="font-size:20px;font-weight:800;letter-spacing:-.5px">ANG</span><span class="lg-lb-ring"></span></div>
                <div>
                    <div class="lg-logo"><span class="lg-logo-t">MS2E StockSuite</span></div>
                    <div class="lg-logo-sub">AI QUANT TRADING TERMINAL</div>
                </div>
            </div>
            <div class="lg-h1">AI 퀀트 <span class="lg-em">트레이딩 터미널</span></div>
            <div class="lg-sub">실시간 시세 · AI 분석 · 시그널 · 자동매매 통합 관제 센터 · Integrated Quant Trading Operations</div>
            <div class="lg-pillars">
                <div class="lg-pill"><span class="lg-pill-ic">📊</span><div><b>실시간 시세 감시</b><small>국내·해외·암호화폐 통합</small></div></div>
                <div class="lg-pill"><span class="lg-pill-ic">🤖</span><div><b>AI 분석 엔진</b><small>뉴스 레이더 · 시그널 스코어</small></div></div>
                <div class="lg-pill"><span class="lg-pill-ic">⚡</span><div><b>시그널 엔진</b><small>진입·청산 전략 자동 탐지</small></div></div>
                <div class="lg-pill"><span class="lg-pill-ic">💹</span><div><b>모의·자동매매</b><small>페이퍼 트레이딩 · 총자산</small></div></div>
            </div>
            <div class="lg-badges">
                <span class="lg-badge ok">📡 거래소 실시간 연동</span>
                <span class="lg-badge">🔒 로컬 암호화 보관</span>
                <span class="lg-badge">📋 폐쇄망 격리 운용</span>
            </div>
        </div>
    </div>

    <div class="lg-panel">
        <span class="lg-pc tl"></span><span class="lg-pc tr"></span><span class="lg-pc bl"></span><span class="lg-pc br"></span>
        <div class="lg-pscan" aria-hidden="true"></div>

        <div class="lg-p-status"><span class="lg-p-dot"></span>SECURE CHANNEL · AES-256 · DPAPI<span class="lg-p-armed">● ARMED</span></div>

        <div class="lg-p-head">
            <div class="lg-p-title">🔐 통합 트레이딩 콘솔 로그인</div>
            <div class="lg-p-sub">인가된 운영자만 접근할 수 있습니다.</div>
        </div>

        @if (_justRegistered is { Length: > 0 })
        {
            <div class="lg-reg-ok">🎉 가입 완료(<b>@_justRegistered</b>) · 아이디가 자동 입력되었습니다. 비밀번호를 입력해 로그인하세요.</div>
        }

        <label class="lg-lbl">아이디</label>
        <div class="lg-inwrap"><span class="lg-in-ic">👤</span><input class="lg-in2" placeholder="USER ID" @bind="_id" @bind:event="oninput" @onkeydown="OnKey" /></div>
        <label class="lg-lbl">비밀번호</label>
        <div class="lg-inwrap"><span class="lg-in-ic">🔒</span><input class="lg-in2" type="password" placeholder="••••••••" @bind="_pw" @bind:event="oninput" @onkeydown="OnKey" /></div>

        @if (_error is { Length: > 0 })
        {
            <div class="lg-err">⚠ @_error</div>
        }

        <button class="lg-btn" @onclick="DoLogin"><span>인증 · 로그인</span><span class="lg-arrow">➔</span></button>
        <button class="lg-alt" @onclick="() => _showRegister = true">📝 신규 회원가입</button>

        <div class="lg-trust"><span>🔒 오프라인 서명 검증</span><span>🛡️ DPAPI 로컬 보관</span><span>📋 에어갭 격리</span></div>
        <div class="lg-foot">© ANG Technology · MS2E StockSuite</div>
    </div>
</div>

<StockRegisterModal Visible="_showRegister" OnComplete="OnRegistered" OnClose="() => _showRegister = false" />

<style>
    .lg-wrap{position:fixed;inset:0;display:grid;grid-template-columns:1.15fr .85fr;gap:0;color:#cdd5e8;font-family:'Pretendard Variable','Pretendard','Segoe UI','Malgun Gothic',system-ui,sans-serif;
        background:radial-gradient(1200px 800px at 18% 16%,#131c34 0%,#0b1020 46%,#070a14 100%),linear-gradient(135deg,#070a14,#0d1326);overflow:auto}

    .lg-frame{position:fixed;inset:14px;z-index:5;pointer-events:none}
    .lg-frame .c{position:absolute;width:34px;height:34px;border:2px solid rgba(129,140,245,.5);filter:drop-shadow(0 0 6px rgba(124,138,255,.4));animation:lgFrame 3.2s ease-in-out infinite}
    .lg-frame .tl{top:0;left:0;border-right:0;border-bottom:0}.lg-frame .tr{top:0;right:0;border-left:0;border-bottom:0}
    .lg-frame .bl{bottom:0;left:0;border-right:0;border-top:0}.lg-frame .br{bottom:0;right:0;border-left:0;border-top:0}
