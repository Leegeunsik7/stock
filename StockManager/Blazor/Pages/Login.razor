    @@keyframes lgSweepY{0%{top:-140px}100%{top:100%}}

    .lg-brand{position:relative;display:flex;flex-direction:column;justify-content:center;padding:6vh 6vw;overflow:hidden}
    .lg-brand::before{content:'';position:absolute;inset:0;pointer-events:none;background:
        radial-gradient(600px 420px at 12% 30%,rgba(124,138,255,.1),transparent 60%),
        radial-gradient(520px 480px at 42% 92%,rgba(52,211,153,.07),transparent 62%)}
    .lg-chart{position:absolute;right:clamp(-140px,-4vw,-24px);top:50%;width:clamp(400px,50vw,720px);height:auto;z-index:1;opacity:.26;
        transform:translateY(-50%);filter:drop-shadow(0 18px 46px rgba(52,211,153,.12));
        -webkit-mask-image:radial-gradient(circle at 60% 50%,#000 42%,transparent 78%);mask-image:radial-gradient(circle at 60% 50%,#000 42%,transparent 78%)}
    .lg-ma{stroke-dasharray:1400;stroke-dashoffset:1400;animation:lgDraw 2.6s ease-out .3s forwards}
    @@keyframes lgDraw{to{stroke-dashoffset:0}}
    .lg-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;
        background:linear-gradient(100deg,rgba(7,10,20,.74) 0%,rgba(7,10,20,.42) 34%,rgba(7,10,20,0) 66%)}
    .lg-brand-in{position:relative;z-index:2;max-width:640px}

    .lg-tele{display:flex;align-items:center;gap:9px 16px;flex-wrap:wrap;margin-bottom:24px;padding:9px 14px;border-radius:12px;
        background:linear-gradient(180deg,rgba(13,19,38,.72),rgba(9,12,24,.5));border:1px solid rgba(124,138,255,.2);
        box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 6px 20px rgba(0,0,0,.3);backdrop-filter:blur(6px);max-width:40em}
    .lg-arm{display:inline-flex;align-items:center;gap:7px;font:800 10.5px/1 'Roboto Mono',Consolas,monospace;letter-spacing:.1em;color:#6ee7b7}
    .lg-arm-dot{width:8px;height:8px;border-radius:50%;background:#34d399;box-shadow:0 0 8px #34d399;animation:lgPulse 1.4s ease-in-out infinite}
    @@keyframes lgPulse{0%,100%{opacity:.35}50%{opacity:1}}
    .lg-t-i{display:inline-flex;align-items:baseline;gap:5px;font-family:'Roboto Mono',Consolas,monospace}
    .lg-t-i i{font-style:normal;font-size:9px;font-weight:700;letter-spacing:.06em;color:#6b78a0}
    .lg-t-i b{font-size:12px;font-weight:800;color:#dfe4f5;font-variant-numeric:tabular-nums}
    .lg-t-i u{text-decoration:none;font-size:10px;font-weight:800;font-variant-numeric:tabular-nums}
    .lg-t-i u.up{color:#34d399}.lg-t-i u.down{color:#f87171}

    .lg-brandrow{display:flex;align-items:center;gap:14px;margin-bottom:26px}
    .lg-logobox{position:relative;width:58px;height:58px;display:grid;place-items:center;font-size:26px;border-radius:16px;background:rgba(124,138,255,.12);border:1px solid rgba(124,138,255,.4);box-shadow:0 10px 30px rgba(60,72,180,.3),inset 0 1px 0 rgba(255,255,255,.08)}
    .lg-lb-ring{position:absolute;inset:-6px;border-radius:20px;border:1px solid rgba(124,138,255,.35);animation:lgRing 2.6s ease-out infinite}
    @@keyframes lgRing{0%{transform:scale(.9);opacity:.8}100%{transform:scale(1.18);opacity:0}}
    .lg-logo{font-size:24px;font-weight:900;letter-spacing:.3px;line-height:1;margin:0}
    .lg-logo-t{background:linear-gradient(90deg,#a5b0ff,#818cf5,#34d399);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 16px rgba(124,138,255,.35))}
    .lg-logo-sub{font:800 9.5px/1 'Roboto Mono',Consolas,monospace;letter-spacing:.22em;color:#7f8bc4;margin-top:6px;opacity:.95}
    .lg-h1{font-size:clamp(28px,4.2vw,50px);font-weight:800;line-height:1.08;letter-spacing:-1px;color:#eef1fb;text-shadow:0 2px 30px rgba(60,72,180,.35)}
    .lg-em{background:linear-gradient(90deg,#818cf5,#a5b0ff,#34d399);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 22px rgba(124,138,255,.32))}
