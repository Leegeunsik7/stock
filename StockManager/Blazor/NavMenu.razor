        <div class="logo">₩</div>
        <div class="meta"><div class="t">Stock Suite</div><div class="v">MS2-E · v3.4</div></div>
    </div>
    <div class="kbar" @onclick='() => JS.InvokeVoidAsync("dashboard.openPalette")'>
        🔍 검색하거나 이동… <kbd>Ctrl K</kbd>
    </div>
    <div class="sectlbl">WORKSPACE</div>
    <nav>
        @foreach (var item in _items)
        {
            <NavLink class="nav" href="@item.Href" Match="@item.Match">
                <span class="ic">@item.Icon</span><span class="navtxt">@item.Label</span>
            </NavLink>
        }
    </nav>
    <div class="side-foot">
        <div class="ava">이</div>
        <div class="usermeta"><div class="n">이근식</div><div class="e">gslee@@angtec.com</div></div>
    </div>
</aside>

