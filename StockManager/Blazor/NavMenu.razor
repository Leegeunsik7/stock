@implements IDisposable
@inject NavigationManager Nav
@inject LocalDatabase Db

<aside class="side">
    <div class="brand">
        <div class="logo">₩</div>
        <div class="meta"><div class="t">Stock Suite</div><div class="v">MS2-E · v4.0.0</div></div>
    </div>
    <div class="kbar" @onclick='() => JS.InvokeVoidAsync("dashboard.openPalette")'>
        🔍 검색하거나 이동… <kbd>Ctrl K</kbd>
    </div>

    <nav>
        <NavLink class="nav" href="/" Match="NavLinkMatch.All"><span class="ic">🏠</span><span class="navtxt">홈</span></NavLink>

        @foreach (var g in _groups)
        {
            <div class="grphead @(_open == g.Id ? "open" : "")" @onclick="() => OnHead(g)">
                <span class="ic">@g.Icon</span>
                <span class="navtxt">@g.Label</span>
                @if (BadgeFor(g.Id) is int n && n > 0)
                {
                    <span class="navbadge" title="미확인">@(n > 99 ? "99+" : n.ToString())</span>
                }
                <span class="cap">@g.Caption</span>
                <span class="chev">@(_open == g.Id ? "▾" : "▸")</span>
            </div>
            @if (_open == g.Id)
            {
                <div class="subwrap">
                    @foreach (var it in g.Items)
                    {
                        <NavLink class="nav sub" href="@it.Href" Match="@it.Match">
                            <span class="ic">@it.Icon</span><span class="navtxt">@it.Label</span>
                        </NavLink>
                    }
                </div>
            }
        }
    </nav>

    <div class="side-foot">
        <div class="ava">이</div>
        <div class="usermeta"><div class="n">이근식</div><div class="e">gslee@@angtec.com</div></div>
    </div>
</aside>

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = null!;

    private record Item(string Icon, string Label, string Href, NavLinkMatch Match);
    private record Group(string Id, string Icon, string Label, string Caption, string[] Roots, Item[] Items);

    private string? _open;

    private readonly Group[] _groups =
    {
        new("market", "📊", "마켓", "MARKET", new[] { "/live", "/news" }, new[]
        {
            new Item("📈", "실시간 시세", "/live", NavLinkMatch.Prefix),
            new Item("📰", "뉴스 레이더", "/news", NavLinkMatch.Prefix),
        }),
        new("folio", "💼", "포트폴리오", "PORTFOLIO", new[] { "/portfolio", "/health", "/mirror" }, new[]
        {
            new Item("📋", "보유·배분", "/portfolio", NavLinkMatch.All),
            new Item("🩺", "종합 건강검진", "/health", NavLinkMatch.Prefix),
            new Item("⚖️", "리밸런싱(MPT)", "/portfolio/rebalance", NavLinkMatch.All),
            new Item("🧯", "리스크 분해", "/portfolio/risk", NavLinkMatch.All),
            new Item("🧮", "총자산", "/portfolio/assets", NavLinkMatch.All),
            new Item("🪟", "결정 품질 미러", "/mirror", NavLinkMatch.All),
            new Item("🌌", "멀티버스 관측실", "/portfolio/multiverse", NavLinkMatch.All),
        }),
        new("lab", "🔬", "전략 연구소", "STRATEGY LAB", new[] { "/lab", "/forge", "/compiler", "/tournament" }, new[]
        {
            new Item("⚡", "시그널 엔진", "/lab", NavLinkMatch.All),
            new Item("🌙", "옵티마이저", "/lab/optimizer", NavLinkMatch.All),
            new Item("🔬", "이벤트 스터디", "/lab/eventstudy", NavLinkMatch.All),
            new Item("🧬", "가설 발굴", "/lab/miner", NavLinkMatch.All),
            new Item("🎚", "포지션 사이저", "/lab/sizer", NavLinkMatch.All),
            new Item("🛠", "전략 단조소", "/forge", NavLinkMatch.Prefix),
            new Item("🧱", "전략 컴파일러", "/compiler", NavLinkMatch.Prefix),
            new Item("🏆", "전략 토너먼트", "/tournament", NavLinkMatch.Prefix),
            new Item("📡", "신호 모니터", "/lab/signals", NavLinkMatch.Prefix),
            new Item("🧬", "유전자 진화소", "/lab/genome", NavLinkMatch.All),
            new Item("🔭", "알파 인과 추론", "/lab/alpha", NavLinkMatch.All),
        }),
        new("risklab", "🎲", "리스크 시뮬", "RISK & SIM", new[] { "/risklab", "/future", "/blackswan", "/tailbudget" }, new[]
        {
            new Item("🎲", "몬테카를로", "/risklab", NavLinkMatch.All),
            new Item("🌪", "시나리오 스튜디오", "/risklab/scenario", NavLinkMatch.All),
            new Item("🔮", "확률 미래", "/future", NavLinkMatch.Prefix),
            new Item("🦢", "블랙스완", "/blackswan", NavLinkMatch.Prefix),
            new Item("☠️", "테일 리스크 설계사", "/tailbudget", NavLinkMatch.All),
        }),
        new("intel", "🤖", "AI & 저널", "INTELLIGENCE", new[] { "/intel", "/research", "/coach", "/agent" }, new[]
        {
            new Item("🤖", "AI 비서(RAG)", "/intel", NavLinkMatch.All),
            new Item("🛠", "에이전트 워크벤치", "/agent", NavLinkMatch.Prefix),
            new Item("🧠", "종목 분석", "/intel/analyze", NavLinkMatch.All),
            new Item("🗣", "멀티 토론", "/intel/debate", NavLinkMatch.All),
            new Item("⚖️", "퀀트 위원회", "/intel/committee", NavLinkMatch.All),
            new Item("🧭", "인과 저널", "/intel/journal", NavLinkMatch.All),
            new Item("🌙", "야간 연구", "/research", NavLinkMatch.Prefix),
            new Item("🪞", "회고 코치", "/coach", NavLinkMatch.Prefix),
            new Item("🌉", "포터블 브릿지", "/intel/bridge", NavLinkMatch.All),
        }),
        new("validate", "🧪", "검증 센터", "VALIDATION", new[] { "/validate" }, new[]
        {
            new Item("🪞", "디지털 트윈", "/validate", NavLinkMatch.All),
            new Item("📐", "예측 스코어보드", "/validate/forecast", NavLinkMatch.All),
            new Item("🎯", "알림 신뢰도", "/validate/calibrator", NavLinkMatch.All),
            new Item("🔁", "결정 리플레이", "/validate/replay", NavLinkMatch.All),
            new Item("🕰", "타임머신", "/timemachine", NavLinkMatch.Prefix),
        }),
        new("alertcenter", "🔔", "알림", "ALERTS", new[] { "/alertcenter", "/fraud-alerts" }, new[]
        {
            new Item("🔔", "알림 센터", "/alertcenter", NavLinkMatch.All),
            new Item("🧠", "복합 알림", "/alertcenter/composite", NavLinkMatch.All),
            new Item("📜", "알림 이력", "/alertcenter/history", NavLinkMatch.All),
            new Item("🚨", "부정거래 경고", "/fraud-alerts", NavLinkMatch.All),
        }),
        new("tools", "🧰", "도구", "TOOLS", new[] { "/command", "/paper", "/copilot", "/diagnostics", "/plugins", "/cartridges", "/sync", "/settings", "/broker", "/trading" }, new[]
        {
            new Item("🗺️", "관제 탑", "/command", NavLinkMatch.Prefix),
            new Item("🧑‍✈️", "코파일럿", "/copilot", NavLinkMatch.Prefix),
            new Item("🩺", "진단", "/diagnostics", NavLinkMatch.Prefix),
            new Item("🧩", "플러그인", "/plugins", NavLinkMatch.Prefix),
            new Item("🧬", "전략 카트리지", "/cartridges", NavLinkMatch.Prefix),
            new Item("🔄", "다기기 동기화", "/sync", NavLinkMatch.Prefix),
            new Item("🧪", "모의투자", "/paper", NavLinkMatch.Prefix),
            new Item("🌑", "섀도우 샌드박스", "/broker/sandbox", NavLinkMatch.Prefix),
            new Item("🔐", "증적 감사 추적", "/broker/gating", NavLinkMatch.Prefix),
            new Item("🎯", "실거래 계기판", "/trading/live", NavLinkMatch.Prefix),
            new Item("📊", "실행 품질", "/trading/quality", NavLinkMatch.Prefix),
            new Item("⚙️", "거래 설정", "/settings", NavLinkMatch.Prefix),
        }),
    };

    private int _alertUnread;
    private int _fraudUnread;

    protected override void OnInitialized()
    {
        AutoOpen();
        RefreshBadges();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        AutoOpen();
        RefreshBadges();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshBadges()
    {
        try
        {
            var dt = Db.Query("SELECT COUNT(*) AS c FROM Alerts WHERE IsRead=0");
            _alertUnread = dt.Rows.Count > 0 ? Safe.Int(dt.Rows[0]["c"]) : 0;
        }
        catch { _alertUnread = 0; }
        try { _fraudUnread = Db.GetUnreviewedFraudCount(); }
        catch { _fraudUnread = 0; }
    }

    private int BadgeFor(string groupId) =>
        groupId == "alertcenter" ? _alertUnread + _fraudUnread : 0;

    private void AutoOpen()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        foreach (var g in _groups)
            if (g.Roots.Any(r => path == r || path.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase)))
            { _open = g.Id; return; }
        // 홈 등 미매칭 시 현재 펼침 유지(사용자가 접어둔 상태 존중)
    }

    private void OnHead(Group g)
    {
        if (_open == g.Id) { _open = null; }           // 이미 열린 그룹 → 접기
        else Nav.NavigateTo(g.Items[0].Href);          // 첫 항목으로 이동(LocationChanged가 펼침)
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

<style>
    .grphead{display:flex;align-items:center;gap:12px;padding:9px 22px;color:var(--side-ink);cursor:pointer;font-size:13.5px;user-select:none}
    .grphead:hover{background:#181f31}
    .grphead.open{color:#fff;font-weight:600}
    .grphead .ic{width:18px;text-align:center;opacity:.9}
    .grphead .cap{margin-left:auto;font-size:9px;letter-spacing:.1em;color:var(--side-sub);font-weight:700}
    .grphead .chev{font-size:10px;color:var(--side-sub);margin-left:8px}
    .navbadge{background:var(--down,#e34d4d);color:#fff;font-size:10px;font-weight:800;line-height:1;border-radius:9px;padding:3px 6px;margin-left:7px;min-width:16px;text-align:center}
    .side.collapsed .navbadge{position:absolute;margin:0;transform:translate(14px,-8px)}
    .side.collapsed .grphead .cap,.side.collapsed .grphead .chev{display:none}
    .subwrap{padding:2px 0 6px;background:rgba(0,0,0,.12)}
    .nav.sub{padding-left:34px;font-size:13px}
    .nav.sub .ic{opacity:.8}
</style>
