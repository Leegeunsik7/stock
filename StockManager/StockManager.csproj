<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockManager</RootNamespace>
    <AssemblyName>MS2E.StockSuite</AssemblyName>
    <ApplicationIcon></ApplicationIcon>

    <!--
      ⚠️ AnyCPU: 키움 OpenAPI+는 32비트 전용이므로,
      Kiwoom 실시간 필요 시 아래 주석을 해제해 x86으로 빌드:
      <PlatformTarget>x86</PlatformTarget>
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <Version>4.4.0</Version>
    <AssemblyVersion>4.4.0.0</AssemblyVersion>
    <FileVersion>4.4.0.0</FileVersion>
    <!-- v4.4.0 — S19 #5: 라이브 결속 + 3중 강철 안전 게이트 (AlgoExecutionGate·실시간마찰피드·LiveBindingTests 18개) -->
    <!-- v4.3.0 — S19 #4: 격리 배양 온실 + 관제탑 5번째 센서 (GreenhouseService·SystemStatus 확장·GreenhouseTests 16개) -->
    <!-- v4.2.0 — S19 #3: 원자 핫스왑 게이트웨이 (StrategySlot·PromotionGateway·HotSwapTests 23개) -->
    <!-- v4.1.0 — S19 #2: 섀도우 그린하우스 순수 코어 (MutationBoundsMatrix·FitnessEvaluator·MutationBoundsTests 39개) -->
    <!-- v4.0.0 — The Gold Master: 18개 시즌 결정론 퀀트 터미널 정식 프로덕션 릴리스 (빌드 가드레일 최대화) -->
    <Product>MS2-E Stock Suite</Product>
    <Company>Angtec</Company>
    <Authors>Angtec Engineering</Authors>

    <!-- v4.0.0 골드 마스터 빌드 가드레일: 단 하나의 경고도 빌드를 차단 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- v3.1: Blazor Hybrid 대시보드 (WebView2 런타임 필요) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="8.0.10" />
  </ItemGroup>

  <!-- 디자인 프로토타입/스캐폴드(.html/.txt/.md)는 컴파일 대상에서 제외 -->
  <ItemGroup>
    <Content Remove="_design_prototype\**" />
    <Content Remove="_blazor_hybrid_scaffold\**" />
    <Content Remove="_optional_webview2\**" />
    <None Include="_design_prototype\**" />
    <None Include="_blazor_hybrid_scaffold\**" />
    <None Include="_optional_webview2\**" />
  </ItemGroup>

</Project>
