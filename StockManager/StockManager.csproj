<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockManager</RootNamespace>
    <AssemblyName>MS2E.StockSuite</AssemblyName>
    <ApplicationIcon></ApplicationIcon>

    <!--
      ⚠️ AnyCPU: 키움 OpenAPI+는 32비트 전용이므로,
      Kiwoom 실시간 필요 시 아래 주석을 해제해 x86으로 빌드:
      <PlatformTarget>x86</PlatformTarget>
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <Version>4.45.0</Version>
    <AssemblyVersion>4.45.0.0</AssemblyVersion>
    <FileVersion>4.45.0.0</FileVersion>
    <!-- v4.45.0 — ★BTC 0.13→0 저장 근본 수정. 진단 배너 'DB저장값 0/real'이 결정타: 정수 강제변환이 아니라 입력
         0.13이 0으로 '잃힌' 것. 비교로 확정 — 단가(텍스트+InvariantCulture 파싱, v4.40.0)는 정상 저장됐고 수량만
         type=number @bind이라 0.13을 0으로 잃었다(Blazor 숫자입력 소수 바인딩이 이 환경에서 깨짐). 수량 입력(매수폼·
         직접등록)을 단가와 동일한 텍스트+ParseMoney 경로로 전환 → 0.13 정확 저장. 진단 배너는 유지(정상 시 '보유수량 X'). -->

    <!-- v4.44.0 — 보유목록 자산군 필터(전체/국내/해외/코인) + BTC 저장 정밀 진단 강화. 지휘관 요청·재신고.
         · 보유 종목 패널에 분류 칩(전체·🇰🇷국내·🇺🇸해외·₿코인) + 각 칩에 종목수. PortfolioBreakdown.Classify 재사용.
         · BTC 미저장 정밀 추적: 새 DB는 0.13을 REAL로 정상 저장 확인(테스트 AddTransaction_FractionalQty_StoredAsReal…
           typeof=real). 즉 코드는 정상, 지휘관 기존 DB의 Quantity 컬럼이 0.13→0 강제변환 의심. 저장 배너에 'DB저장값+
           typeof'를 노출해 다음 캡처로 컬럼 storage class를 확정(integer 강제변환 여부) → 확정 후 컬럼 마이그레이션 예정. -->

    <!-- v4.43.1 — ★실시간 폴링이 매수폼 입력을 손상시키던 치명 버그 수정. 거래 이력 실측 결과 'KRW-BTC Buy 수량 0'으로
         저장된 게 확인됨(폼엔 0.13로 보였으나). 원인: v4.42.0의 5초 자동 새로고침 StateHasChanged 재렌더가 폼이 열린
         채 발생해, 입력 중인 컨트롤드 입력(수량·단가·거래일시)을 backing 값으로 리셋 → 0.13이 0으로 저장. 수정: 폼 열림
         (_showTxForm/_showForm) 중에는 폴링 재렌더를 건너뛴다. 코어 저장/재계산은 정상이었음(단위 테스트 통과). -->

    <!-- v4.43.0 — 거래 이력 개별 삭제 + 평단 재계산 연쇄. 진단(v4.42.1) 결과 'BTC 거래 10건·보유수량 0'으로 확인된
         원인(누적 거래 순수량 0 → Quantity>0 필터 탈락)의 자가 정리 수단. 📝 거래 이력에 🗑 삭제 버튼 → DeleteTransaction(Id)
         + RecomputeAverage(종목) → 보유 목록·집계 즉시 갱신. 회귀 테스트: 매수0.13+매도0.13 순0 → 매도 삭제 → 0.13 복구.
         적대적 리뷰(ship) 후 minor 수정: 삭제 확인창(JS confirm) · LIMIT 200→1000 + 절단 안내 · Id를 Safe.Long으로 일관화. -->

    <!-- v4.42.1 — 진단: '비트코인 저장됐다는데 데이터 없음' 신고 추적. SaveTx가 저장 직후 DB 실제 상태(해당 코드의
         거래 건수·보유행 존재·보유수량)를 직접 조회해 배너에 노출. 정상이면 '✅ 저장됨 — 보유수량 X', 비정상이면
         '⚠️ 거래는 저장됐으나 보유 항목 미생성 — 코드/수량/DB거래/보유행' 진단 표시. 코어(AddTransaction+
         RecomputeAverage+GetAllHoldings)는 단위 테스트(TxFormBtcSave) 통과 — 라이브 DB 실측으로 간극 확정 목적. -->

    <!-- v4.42.0 — 포트폴리오 실시간 자동 새로고침(토스류). 지휘관 요청: 시세가 바로바로 들어와 현재 상황을 전체적으로.
         · 자동 새로고침 주기 선택(끄기/3/5/10/30초, 기본 5초) + 헤더 '● LIVE N초' 펄스. 기존 30초 고정 → 사용자 제어.
         · 주식 시세 '병렬' fetch(동시 6, Task.WhenAll) — provider에 배치 없어 18종목 순차 9~18초였던 것을 수초로. 코인은
           업비트 배치 1콜. 자동 폴링은 메모리만 갱신(DB 저장 분리) → 5초 폴링에도 SaveHolding 폭주 없음(저장은 초기·수동).
         · 현재가 틱 플래시(상승 초록/하락 빨강, @key 재생성). AsOf(과거시점)·보유탭 아님·끄기면 폴링 일시정지.
         · 적대적 리뷰 수정: (MAJOR) 폴링·수동 LoadAsync 인터리브로 한 사이클 총평가 오류 → SemaphoreSlim(1) 직렬화(큐잉).
           (MAJOR) AS-OF에서 LIVE KPI·자산군 카드·탭이 현재가 노출 → @if(IsLive) 가드 + AS-OF 진입 시 보유탭 고정.
         아키텍처는 사전 탐색(scout) 워크플로로 매핑 후 설계. ⚠️ 라이브 시세 CI 미검증·근사. liveArmed:false 불변 -->
    <!-- v4.41.0 — 비트코인 미저장 진짜 원인: 검색창에 이름만 타이핑하고 드롭다운을 '선택'하지 않아 종목코드가
         빈 채로 저장 시도(검증 거부)된 것(지휘관 스크린샷: 종목코드 placeholder=빈값). SymbolPicker UX 보강:
         (1) Enter로 첫(최상위 관련도) 결과 선택 — "비트코인"+Enter면 KRW-BTC 즉시 채움. IME 조합확정 Enter는 무시.
         (2) 드롭다운에 '클릭/Enter로 선택해야 코드가 채워진다' 안내 + 첫 행 강조. 코어·검색매칭은 이상 없음 확인. -->
    <!-- v4.40.0 — 입력 버퍼링(IME) 버그 수정 + 단가 천단위 콤마. 지휘관 피드백.
         (1) ★IME 버그: SymbolPicker 검색창이 value="@_q" 제어 입력이라, 입력 중 라이브검색 비동기 재렌더가 조합 중
             한글을 리셋해 '글자가 깨지고 원치 않은 글자가 자동 입력'됐다. → 비제어 입력 전환(value 바인딩 제거) +
             선택 후 비우기는 @key(_inputKey) 증가로 입력 요소 재생성. 타이핑 중엔 _inputKey 불변이라 리셋 없음.
         (2) 단가·평균단가 천단위 콤마: type=number는 콤마 불가 → 텍스트 입력 + MoneyText(#,##0)/ParseMoney(콤마·통화기호
             제거 후 파싱, 음수 0). blur 시 콤마 반영. 매수폼 단가 + 직접등록 평균단가 모두.
         (3) BTC 저장 회귀 테스트: 매수폼 경로(거래추가+CRYPTO 힌트 재계산)가 보유행 생성·3분류 코인 카운트까지
             끝단 검증(TxFormBtcSave). 코어는 정상 — 라이브 미등록은 입력 손상(IME) 기인으로 판단.
         ⚠️ 수수료/환율 추정·근사. liveArmed:false 불변 -->
    <!-- v4.39.0 — 자산군 3분류 집계(국내주식·해외주식·비트코인) + 비트코인 저장 버그 근본 수정. 지휘관 피드백.
         (1) 3분류 패널: PortfolioBreakdown(순수)가 보유를 국내(KRX)/해외(US)/코인(CRYPTO)로 묶어 KRW 환산 평가·손익·
             수익률·비중 카드 표시(KPI 아래). USD만 ×환율(LoadAsync 산식과 동일). 테스트 3(분류·환산집계·빈목록).
         (2) ★BTC 저장 버그 근본원인: 종목 수정 화면에서 SymbolPicker로 비트코인을 고르면 _editId가 편집 중이던
