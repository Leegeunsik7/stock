<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockManager</RootNamespace>
    <AssemblyName>MS2E.StockSuite</AssemblyName>
    <ApplicationIcon></ApplicationIcon>

    <!--
      ⚠️ AnyCPU: 키움 OpenAPI+는 32비트 전용이므로,
      Kiwoom 실시간 필요 시 아래 주석을 해제해 x86으로 빌드:
      <PlatformTarget>x86</PlatformTarget>
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <Version>4.20.0</Version>
    <AssemblyVersion>4.20.0.0</AssemblyVersion>
    <FileVersion>4.20.0.0</FileVersion>
    <!-- v4.20.0 — S23-b: 라이브 피드 결속 안전 코어 (3대 비대칭 규칙·전부 옵트인 기본 OFF). 규칙1 isDirty 숏서킷(GreenhouseService.SkipUnchanged)+LiveCandleFeed 단일 재사용 버퍼. 규칙2 staleness fail-closed(StalenessWindow)+피드 검증(단조·OHLC). 규칙3 As-Of 락아웃(PromotionGateway.AsOfTicks·Approve/Activate 원자 신선도 검문·승인→활성 레이스 방어). S23bLiveFeedTests 19. 라이브 provider 바인딩은 문서화 후속(미배선). liveArmed 불변 -->
    <!-- v4.19.0 — Season 23: 자율 배양 엔진 점등 (GreenhouseActivator·DefaultSeeds·BootstrapCandles[결정론 참조 시리즈]·호스트 부팅 시 Activate[Greenhouse.AutoStart 게이트, 기본 true]·관제탑 자율배양 LIVE 스트립·종료 시 Stop·GreenhouseActivatorTests 10). 안전: 제안 전용·dry-run+밸브·liveArmed:false → 실거래 0%. EmergencyFreeze fail-closed -->
    <!-- v4.18.0 — S22 PathA: LAN 포트 교차-호스트 결속 (LanStatusServer 원시 파싱→RuntimeConfig 검증 경로·BootConfigSpecs 에 Lan.Port 편입[SSOT 4스펙]·트레이 호스트에 cfg 주입·부팅 감사 자동 포함·테스트 +1). 인프라 설정 파이프라인 단일화. liveArmed 불변 -->
    <!-- v4.17.0 — S22 #3-b: 잔여 싱크 밀봉 (ScrubbingTextWriter·Console.SetOut/SetError 래핑→서드파티 stdout/stderr 차폐·ScrubbingTextWriterTests 9). 검증: LiveAuditService 무비밀·무영속(스크럽 불요), HTTP 아웃바운드 마스킹 불가(인증)·로깅은 Log/Console 경유(차폐). S22 보안 3부작 완결 -->
    <!-- v4.16.0 — S22 #3: 로그 비밀 차폐 전수 (LogRedactor·2겹 방어[등록 실비밀 정확일치+라벨패턴]·Log.Write 단일 초크포인트 마스킹·Program.cs 부팅 등록[KIS/Gemini/Upbit/Telegram/계좌번호]·LogRedactorTests 20). 예외 덤프 평문 누출 차단 -->
    <!-- v4.15.0 — S22 #2: 무위험 설정 라우팅 + 부팅 무결성 결속 (ConfigAuditor·BootConfigSpecs 3튜너블 검증경로 라우팅[스냅샷주기·신선도·온실사이클]·부팅 redacted 스냅샷 원장·Coerced 시 관제탑 [⚠️ 설정복구] 경보·ConfigAuditorTests 24). liveArmed 미노출 -->
    <!-- v4.14.0 — S22 #1: 설정 격리·런타임 보안 파사드 (RuntimeConfig·env→DB precedence·검증/바운드/fail-safe·비밀 Redact·LiveTradingConfigurable=false 안전 불변식·RuntimeConfigTests 38). liveArmed 미노출(코드 게이트 전용) -->
    <!-- v4.13.0 — v5.0.0-c(안전형)/S21 #3: 2중 게이트 핫-밸브 (정적 차단막 → liveArmed 마스터 + IgnitionLock 런타임 게이트). 호스트 liveArmed:false 박제 — 실거래 0. 5.0.0은 최종 flip 시 -->
    <!-- v4.12.0 — v5.0.0-b: 관제탑 점화 제어반 UI (조종석·단계표시·서명입력·후퇴·StageLabel/Css). 방아쇠(-c) 여전히 잠금 -->
    <!-- v4.11.0 — v5.0.0-a: 점화 제어반 두뇌 (IgnitionLock FSM·서명게이트·자동후퇴·IgnitionLockTests 20개). 방아쇠(-c 실위임) 잠금 — 5.0.0은 라이브 결속·점화 시 확정 -->
    <!-- v4.10.0 — S21 #2: 그림자 추적기 + 단방향 발주 밸브 (ShadowMetricsBridge·틱미러·실측마찰·ShadowMetricsBridgeTests 12개) -->
    <!-- v4.9.0 — S21 #1-b: 카오스 폭격 + 불변식 방어 (ChaosInjectionTests 20개·브로커예외 fail-closed 하드닝·테스트 1024) -->
    <!-- v4.8.0 — S20 #4: 드라이런 종단 조립체 (ShadowExecutionRouter·게이트+메시 결속·ClosedLoopAssemblyTests 11개·테스트 1000 돌파) -->
    <!-- v4.7.0 — S20 #3(Path B): 가상 멀티 계좌 할당 (MultiAccountMesh·최대잉여 무손실 분배·MultiAccountMeshTests 15개) -->
    <!-- v4.6.0 — S20 #2: 거시 매크로 레짐 융합 (MacroRegimeFusion·레짐별 게이트 수축·MacroRegimeTests 17개) -->
    <!-- v4.5.0 — S20 #1: 락-프리 SPMC 링버퍼 (RingBufferCore·seqlock·캐시라인패딩·RingBufferTests 15개) -->
    <!-- v4.4.0 — S19 #5: 라이브 결속 + 3중 강철 안전 게이트 (AlgoExecutionGate·실시간마찰피드·LiveBindingTests 18개) -->
    <!-- v4.3.0 — S19 #4: 격리 배양 온실 + 관제탑 5번째 센서 (GreenhouseService·SystemStatus 확장·GreenhouseTests 16개) -->
    <!-- v4.2.0 — S19 #3: 원자 핫스왑 게이트웨이 (StrategySlot·PromotionGateway·HotSwapTests 23개) -->
    <!-- v4.1.0 — S19 #2: 섀도우 그린하우스 순수 코어 (MutationBoundsMatrix·FitnessEvaluator·MutationBoundsTests 39개) -->
    <!-- v4.0.0 — The Gold Master: 18개 시즌 결정론 퀀트 터미널 정식 프로덕션 릴리스 (빌드 가드레일 최대화) -->
    <Product>MS2-E Stock Suite</Product>
    <Company>Angtec</Company>
    <Authors>Angtec Engineering</Authors>

    <!-- v4.0.0 골드 마스터 빌드 가드레일: 단 하나의 경고도 빌드를 차단 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- v3.1: Blazor Hybrid 대시보드 (WebView2 런타임 필요) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="8.0.10" />
  </ItemGroup>

  <!-- 디자인 프로토타입/스캐폴드(.html/.txt/.md)는 컴파일 대상에서 제외 -->
  <ItemGroup>
    <Content Remove="_design_prototype\**" />
    <Content Remove="_blazor_hybrid_scaffold\**" />
    <Content Remove="_optional_webview2\**" />
    <None Include="_design_prototype\**" />
    <None Include="_blazor_hybrid_scaffold\**" />
    <None Include="_optional_webview2\**" />
  </ItemGroup>

</Project>
