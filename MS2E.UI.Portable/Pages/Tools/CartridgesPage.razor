@* Phase 94-P: 순수 UI 이관 — @page 는 호스트 shim(CartridgesHostPage). ICartridgePort 만 소비(CartridgeService/Engine·Process.Start 무참조). *@
@inject ICartridgePort Cartridge

<div class="top">
    <div class="hello"><h1>🧩 전략 카트리지</h1><p>매크로·전략을 서명된 카트리지로 교환 — 중앙 서버 없이 <b>서명 + 결정론 백테스트 증명서</b>로 무신뢰 검증</p></div>
    <button class="ghost" style="margin-right:16px" @onclick="OpenFolder">📂 폴더 열기</button>
</div>

<div style="padding:0 28px 40px;max-width:980px">
    <div class="sub" style="font-size:12px;margin-bottom:12px">내 신원(공개키): <code>@Trunc(_pub)</code> · 제작자: <b>@_author</b></div>

    @if (!string.IsNullOrEmpty(_msg)) { <div style="background:color-mix(in srgb,var(--accent) 8%,transparent);border:1px solid var(--line);border-radius:10px;padding:9px 13px;font-size:12.5px;margin-bottom:14px">@_msg</div> }

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        @* ── 내보내기 ── *@
        <div class="panel">
            <div class="panel-h">📤 카트리지 만들기 <span class="tag">SIGN</span></div>
            <div class="panel-b">
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px">
                    <input class="srch" style="flex:1;min-width:140px" placeholder="이름" @bind="_name" />
                    <input class="srch" style="flex:2;min-width:160px" placeholder="설명(선택)" @bind="_desc" />
                </div>
                <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px">
                    <span class="sub" style="font-size:12px">전략 MA</span>
                    <input class="srch" style="width:62px" type="number" @bind="_short" /> /
                    <input class="srch" style="width:62px" type="number" @bind="_long" />
                    <span class="sub" style="font-size:12px">시드</span>
                    <input class="srch" style="width:74px" type="number" @bind="_seed" />
                    <button class="ghost" @onclick="AddStrategy">+ 전략(증명서 부착)</button>
                </div>
                @if (_drafts.Count > 0)
                {
                    <table class="ctbl dense" style="margin-bottom:8px">
                        <thead><tr><th>전략</th><th style="text-align:right">수익률</th><th style="text-align:right">MDD</th><th style="text-align:right">거래</th><th></th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < _drafts.Count; i++)
                            {
                                var idx = i; var s = _drafts[i];
                                <tr>
                                    <td>@s.Name <small class="sub">seed @s.Seed</small></td>
                                    <td class="num" style="text-align:right">@s.AttestTotalReturnPct.ToString("+0.0;-0.0")%</td>
                                    <td class="num" style="text-align:right">@s.AttestMaxDrawdownPct.ToString("0.0")%</td>
                                    <td class="num" style="text-align:right">@s.AttestTrades</td>
                                    <td style="text-align:center"><button class="pill r" style="border:0;cursor:pointer;padding:2px 7px;font-size:11px" @onclick="() => RemoveDraft(idx)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="sub" style="font-size:11px;margin-bottom:8px">매크로는 현재 등록된 커맨드라인 매크로(@(_macroCount)개)가 함께 포장됩니다.</div>
                <button class="addbtn" @onclick="Export">🔐 서명 + 내보내기</button>
                @if (!string.IsNullOrEmpty(_exportMsg)) { <div class="sub" style="font-size:12px;margin-top:8px">@_exportMsg</div> }
            </div>
        </div>

        @* ── 가져오기 ── *@
        <div class="panel">
            <div class="panel-h">📥 가져오기 · 검증 <span class="tag">VERIFY</span></div>
            <div class="panel-b">
                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">
                    <select class="srch" style="flex:1;min-width:200px" @bind="_sel" @bind:after="Select">
                        <option value="">— .ms2cart 선택 —</option>
                        @foreach (var f in _files) { <option value="@f">@System.IO.Path.GetFileName(f)</option> }
                    </select>
                    <button class="ghost" @onclick="RefreshFiles">🔄</button>
                </div>
                @if (!string.IsNullOrEmpty(_impMsg)) { <div class="sub" style="font-size:12px;margin-bottom:8px">@_impMsg</div> }
                @if (_cart is not null && _verdict is not null)
                {
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:6px">
                        <span class="pill @(_verdict.SignatureOk?"r":"b")" style="font-size:11px">@(_verdict.SignatureOk ? "✅ 서명 OK" : "❌ 서명 실패")</span>
                        <span class="pill @(_verdict.AttestationOk?"r":"b")" style="font-size:11px">@(_verdict.AttestationOk ? "✅ 증명서 OK" : "⚠️ 증명서 불일치")</span>
                        @if (_verdict.FullyTrusted) { <span style="color:var(--up);font-weight:800;font-size:12px">무결성·증명서 OK</span> }
                    </div>
                    @if (_verdict.SignatureOk)
                    {
                        <div style="color:var(--warn);font-size:11px;margin-bottom:6px">⚠️ 자가서명 — <b>서명 유효 ≠ 제작자 신뢰</b>. 아래 키 지문을 신뢰하는 제작자 것과 직접 대조하세요.</div>
                    }
                    <div class="sub" style="font-size:11.5px;margin-bottom:8px">@_cart.Name · @_cart.Author · @_cart.CreatedIso · 키 <code>@Trunc(_cart.AuthorPubKey)</code> · @_verdict.Note</div>
                    @if (_cart.Strategies.Count > 0)
                    {
                        <table class="ctbl dense" style="margin-bottom:8px">
                            <thead><tr><th>전략</th><th style="text-align:right">주장 수익률</th><th style="text-align:right">거래</th><th style="text-align:center">재현</th></tr></thead>
                            <tbody>
                                @foreach (var s in _cart.Strategies)
                                {
                                    var okv = s.Reproduced;
                                    <tr>
                                        <td>@s.Name</td>
                                        <td class="num" style="text-align:right">@s.AttestTotalReturnPct.ToString("+0.0;-0.0")%</td>
                                        <td class="num" style="text-align:right">@s.AttestTrades</td>
                                        <td style="text-align:center" class="@(okv?"up":"down")">@(okv ? "✓" : "✗")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (_cart.MacroCount > 0)
                    {
                        <div class="sub" style="font-size:11.5px;margin-bottom:6px">매크로 @(_cart.MacroCount)개: @string.Join(", ", _cart.MacroAliases)</div>
                        <button class="addbtn" disabled="@(!_verdict.SignatureOk)" @onclick="ApplyMacros">⬇ 매크로 적용</button>
                        @if (!_verdict.SignatureOk) { <span class="sub" style="font-size:11px;margin-left:8px">서명 검증 실패 — 적용 차단</span> }
                    }
                }
            </div>
        </div>
    </div>

    <div class="sub" style="font-size:11.5px;margin-top:14px">
        ℹ️ <b>무신뢰 검증</b>: 카트리지는 ECDsa 서명(제작자·무결성)과 결정론 백테스트 증명서를 담습니다. 받는 쪽이 시드 기준 시계열에서 전략을 <b>재실행해 주장 성과를 대조</b>하므로, 자기 키로 유효 서명한 카트리지라도 <b>거짓 성과는 즉시 적발</b>됩니다. 기준 시계열 성과는 합성 벤치마크이며 실거래 보장이 아닙니다.
    </div>
</div>

@code {
    private string _pub = "", _author = "me", _msg = "";
    // export draft
    private string _name = "", _desc = "", _exportMsg = "";
    private int _short = 5, _long = 20, _seed = 7;
    private IReadOnlyList<ICartStrategyView> _drafts = Array.Empty<ICartStrategyView>();
    private int _macroCount;
    // import
    private IReadOnlyList<string> _files = Array.Empty<string>();
    private string _sel = "", _impMsg = "";
    private ICartridgeInfoView? _cart;
    private ICartridgeVerdictView? _verdict;

    protected override void OnInitialized()
    {
        _pub = Cartridge.EnsureIdentity();
        _author = Cartridge.Author();
        _macroCount = Cartridge.MacroCount();
        _drafts = Cartridge.Drafts;
        RefreshFiles();
    }

    private void AddStrategy()
    {
        // 서명 증명서 부착(CartridgeEngine.Attest)은 어댑터가 내재화. 반환=오류 메시지("" 성공).
        _exportMsg = Cartridge.AddDraft(_short, _long, _seed);
        _drafts = Cartridge.Drafts;
    }

    private void RemoveDraft(int index) { Cartridge.RemoveDraft(index); _drafts = Cartridge.Drafts; }

    private void Export()
    {
        // 서명·내보내기(BuildSigned/ExportToFile)는 어댑터가 내재화.
        _exportMsg = Cartridge.Export(_name, _desc);
        _drafts = Cartridge.Drafts;
        RefreshFiles();
    }

    private void RefreshFiles() => _files = Cartridge.ListFiles();

    private void Select()
    {
        _cart = null; _verdict = null; _impMsg = "";
        if (string.IsNullOrEmpty(_sel)) return;
        var (cart, verdict, err) = Cartridge.Import(_sel);   // TryImport + Verify + 전략 재현 검증은 어댑터 내재화.
        if (cart is null) { _impMsg = err; return; }
        _cart = cart; _verdict = verdict;
    }

    private void ApplyMacros()
    {
        if (_cart is null || _verdict is null || !_verdict.SignatureOk) return;
        _msg = Cartridge.ApplyMacros();   // MacroMap/ApplyMacros 는 어댑터 내재화.
        _macroCount = Cartridge.MacroCount();
    }

    private void OpenFolder() => Cartridge.OpenFolder();   // CreateDirectory + Process.Start 는 어댑터 내재화.

    private static string Trunc(string s) => string.IsNullOrEmpty(s) ? "—" : (s.Length > 24 ? s[..24] + "…" : s);
}
