@* v12.6.0 Main Dashboard AI Recommendation Feed Widget — IDashboardAiFeedPort 만 주입(엔진 무참조).
   ★Advisory-Only: 이 컴포넌트는 발주 관련 타입을 전혀 모른다 — "주문 연동" 버튼은 IOrderPrefillPort 로
   종목코드/가격 숫자만 전달할 뿐, liveArmed·물리 키·발주 경로에 어떤 접근도 없다. 괴리(Divergent) 카드는
   버튼 자체가 비활성화되고 경고 배너가 사출된다(Think Beyond Idea B — AI-Microstructure Divergence). *@
@using System.Threading
@inject IDashboardAiFeedPort Feed
@implements IDisposable

<div class="ai-feed">
    @if (_loading)
    {
        <div class="sub" style="padding:10px 0">AI 팩터 분석 중…</div>
    }
    else if (_error is not null)
    {
        <div class="sub" style="color:var(--warn);padding:10px 0">⚠ AI 추천 조회 실패 — 잠시 후 다시 시도해 주세요. (@_error)</div>
    }
    else if (_cards.Count == 0)
    {
        <div class="sub" style="padding:10px 0">보유 종목이 없어 추천을 산출할 수 없습니다.</div>
    }
    else
    {
        @foreach (var c in _cards)
        {
            <div class="row ai-card" style="flex-direction:column;align-items:stretch;padding:8px 0;border-bottom:1px solid var(--line,#eee)">
                <div style="display:flex;align-items:center;justify-content:space-between">
                    <div class="nm" style="font-weight:700">@c.Symbol</div>
                    <span style="background:@GradeColor(c.Grade);color:#fff;font-size:11px;font-weight:700;border-radius:4px;padding:2px 8px">@GradeLabel(c.Grade)</span>
                </div>
                <div style="display:flex;gap:14px;font-size:12px;color:var(--sub);margin-top:4px">
                    <span>목표가 <b style="color:var(--txt,inherit)">@c.TargetPrice.ToString("N0")</b></span>
                    <span>손절가 <b style="color:var(--txt,inherit)">@c.StopLossPrice.ToString("N0")</b></span>
                    <span>신뢰도 @((c.Confidence * 100).ToString("0"))%</span>
                </div>
                <div title="XAI 팩터 기여도: 기술적/기본적/미시구조/수급" style="display:flex;height:6px;border-radius:3px;overflow:hidden;margin-top:6px">
                    <div style="width:@(c.TechnicalPct)%;background:#42A5F5" title="기술적 @(c.TechnicalPct)%"></div>
                    <div style="width:@(c.FundamentalPct)%;background:#66BB6A" title="기본적 @(c.FundamentalPct)%"></div>
                    <div style="width:@(c.MicrostructurePct)%;background:#FFA726" title="미시구조 @(c.MicrostructurePct)%"></div>
                    <div style="width:@(c.SupplyDemandPct)%;background:#AB47BC" title="수급 @(c.SupplyDemandPct)%"></div>
                </div>
                <div style="font-size:10px;color:var(--sub);margin-top:2px">
                    기술 @(c.TechnicalPct)% · 기본 @(c.FundamentalPct)% · 미시 @(c.MicrostructurePct)% · 수급 @(c.SupplyDemandPct)%
                </div>
                @if (c.Divergent)
                {
                    <div class="warn-banner" style="background:#FFF3E0;color:#E65100;font-size:11px;border-radius:4px;padding:4px 8px;margin-top:6px">
                        ⚠ AI 등급과 실시간 호가 불균형이 상충합니다 — 주문 연동이 자동 차단되었습니다.
                    </div>
                }
                <div style="margin-top:6px">
                    <button class="addbtn" disabled="@c.Divergent" @onclick="() => StagePrefill(c)">
                        @(c.Divergent ? "🚫 연동 차단됨" : "📋 주문 창으로 연동")
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<IAiRecommendationCardView> _cards = Array.Empty<IAiRecommendationCardView>();
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _cts;

    // v12.8.0 감사 — 이전엔 GetTopRecommendationsAsync 실패 시 예외가 그대로 전파되어(무방비) Blazor 렌더 트리
    // 상위로 번질 위험이 있었음(실측 확인). Divergence 서킷 브레이커 등 하류 로직 예외까지 포함해 방어하고,
    // 컴포넌트 폐기로 인한 취소(OperationCanceledException)는 정상 경로로 간주해 에러로 표시하지 않는다.
    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        try { _cards = await Feed.GetTopRecommendationsAsync(5, _cts.Token); }
        catch (OperationCanceledException) { /* 컴포넌트 폐기 중 취소 — 정상 경로 */ }
        catch (Exception ex) { _error = ex.GetType().Name; }
        finally { _loading = false; }
    }

    private void StagePrefill(IAiRecommendationCardView card) => Feed.TryStageOrderPrefill(card);

    private static string GradeColor(AiRecommendationGrade g) => g switch
    {
        AiRecommendationGrade.StrongBuy or AiRecommendationGrade.Buy => "#E53935",     // 한국 관례 상승/매수 적색
        AiRecommendationGrade.StrongSell or AiRecommendationGrade.Sell => "#1E88E5",   // 하강/매도 청색
        _ => "#9E9E9E",
    };

    private static string GradeLabel(AiRecommendationGrade g) => g switch
    {
        AiRecommendationGrade.StrongBuy => "적극매수", AiRecommendationGrade.Buy => "매수",
        AiRecommendationGrade.Hold => "관망",
        AiRecommendationGrade.Sell => "매도", AiRecommendationGrade.StrongSell => "적극매도",
        _ => "-",
    };

    public void Dispose() { try { _cts?.Cancel(); } catch { } _cts?.Dispose(); }
}
