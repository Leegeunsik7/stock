@* Phase 94-M: 순수 UI 이관 — @page 제거(호스트 DashboardHostPage 가 "/" 보존).
   엔진 구상(DashboardService·ToastService·GlobalIndexService·ModuleBridge·PaperSide) 무참조 —
   IDashboardWidgetPort(KPI/지수/테마/모듈) + IUserActivityPort(활동) + ILayoutPersistencePort(레이아웃) + IDashboardActionPort(모의주문). *@
@using MS2E.UI.Portable.Pages.Shell.Widgets
@using MS2E.UI.Portable.Infrastructure
@inject IDashboardWidgetPort Widget
@inject IUserActivityPort Activity
@inject ILayoutPersistencePort Layout
@inject IDashboardActionPort Action
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject StateAwareRenderGovernor RenderGov
@inject WidgetLifecycleMemoryGuard MemoryGuard
@implements IDisposable

<div class="top">
    <div class="hello">
        <h1>좋은 하루입니다, <b>이근식</b>님</h1>
        <p>@DateTime.Now.ToString("yyyy년 MM월 dd일 dddd") · 위젯을 드래그해서 원하는 대로 배치하세요</p>
    </div>
    <div class="search">🔎 <input placeholder="종목·코인 검색 (Ctrl+K)" /></div>
    <div class="badges">
        <span class="dot"><i></i>업비트</span>
        <span class="dot"><i></i>KIS</span>
        <span class="dot"><i style="background:var(--warn);box-shadow:0 0 0 3px color-mix(in srgb,var(--warn) 20%,transparent)"></i>모의</span>
    </div>
    <button class="addbtn" @onclick='() => Nav.NavigateTo("/dashboard")'
            style="margin-right:4px" title="통합 관제탑 열기">🚀 통합 관제탑</button>
    <button class="iconbtn" @onclick="ToggleTheme" title="테마 전환">@(_theme == "dark" ? "☀️" : "🌙")</button>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="k-lab">총자산</div>
        <div class="k-val">₩@Widget.Total.ToString("N0")</div>
        <div class="k-row">
            <span class="delta @(Widget.Ret >= 0 ? "pos" : "neg")">@Widget.Ret.ToString("+0.0;-0.0;0.0")%</span>
            <span class="sub" style="font-size:11px">실시간 합산</span>
        </div>
        @WeeklySpark()
    </div>
    <div class="kpi">
        <div class="k-lab">평가손익 · 주식</div>
        <div class="k-val @(Widget.Pnl >= 0 ? "up" : "down")">@Widget.Pnl.ToString("+#,##0;-#,##0;0")</div>
        <div class="k-row">
            <span class="delta @(Widget.Ret >= 0 ? "pos" : "neg")">@Widget.Ret.ToString("+0.0;-0.0;0.0")%</span>
            <span class="sub" style="font-size:11px">누적 수익률</span>
        </div>
    </div>
    <div class="kpi">
        <div class="k-lab">코인 평가</div>
        <div class="k-val">₩@Widget.CoinValue.ToString("N0")</div>
        <div class="k-row"><span class="sub" style="font-size:11px">업비트 실시간</span></div>
    </div>
    <div class="kpi">
        <div class="k-lab">모의 계좌</div>
        <div class="k-val">₩@((Widget.PaperCash + Widget.PaperPosVal).ToString("N0"))</div>
        <div class="k-row">
            <span class="delta @(Widget.PaperRet >= 0 ? "pos" : "neg")">@Widget.PaperRet.ToString("+0.0;-0.0;0.0")%</span>
            <span class="sub" style="font-size:11px">누적</span>
        </div>
    </div>
</div>

<div class="hint">⠿ 끌어서, 또는 ✕ 로 위젯을 정리할 수 있어요
    <button class="addbtn" @onclick="() => _gallery = true">+ 위젯 추가</button>
</div>

<div class="grid" id="widgetGrid">
    @foreach (var k in _layout)
    {
        <div class="w @(ColOf(k)) @(_dragOver == k && _drag != k ? "drag-over" : "")" data-k="@k" @key="k"
             @ondragover:preventDefault="true"
             @ondragenter="() => OnDragEnter(k)"
             @ondrop="() => OnDrop(k)">
            <div class="wh" draggable="true"
                 @ondragstart="() => OnDragStart(k)" @ondragend="OnDragEnd">
                <span class="grip" title="드래그해서 순서 변경">⠿</span>
                <span class="h">@TitleOf(k)</span>
                @if (LinkOf(k) is { } href)
                {
                    <button class="open" title="모듈 열기" @onclick="() => Nav.NavigateTo(href)">↗</button>
                }
                <button class="x" title="제거" @onclick="() => Remove(k)">✕</button>
            </div>
            <div class="wb">
                @* v12.8.0 감사 — 위젯 개별 격리: 한 위젯의 렌더링/초기화 예외가 대시보드 전체를 무너뜨리지 않도록
                   ErrorBoundary 로 카드 단위 격리(Safe Fallback UI). @key="k" 로 위젯 교체 시 경계도 함께 재생성. *@
                <ErrorBoundary @key="k">
                    <ChildContent>
                        @switch (k)
                        {
                    case "coins":
                        @foreach (var c in Widget.Coins)
                        {
                            <div class="row">
                                <div class="nm">@c.Name</div>
                                <div style="flex:1;margin:0 14px">@Spark(c.Spark, c.ChangeRate >= 0 ? "var(--up)" : "var(--down)")</div>
                                <div style="text-align:right">
                                    <div class="num">@c.Price.ToString("N0")</div>
                                    <div class="num @(c.ChangeRate >= 0 ? "up" : "down")" style="font-size:11px">@((c.ChangeRate*100).ToString("+0.00;-0.00"))%</div>
                                </div>
                            </div>
                        }
                        break;

                    case "pie":
                        <div class="donut" style="background:@DonutCss()">
                            <div class="in"><b class="num">@Eok(Widget.Total)</b><span>총자산</span></div>
                        </div>
                        <div class="legend">
                            <div class="li"><i style="background:var(--accent)"></i>주식(원화) · @Pct(Widget.AllocKrwStock)%</div>
                            <div class="li"><i style="background:var(--accent-2)"></i>주식(외화) · @Pct(Widget.AllocUsdStock)%</div>
                            <div class="li"><i style="background:var(--warn)"></i>코인 · @Pct(Widget.AllocCoin)%</div>
                        </div>
                        break;

                    case "weekly":
                        <div class="bars">
                            @foreach (var d in Widget.Weekly)
                            {
                                var hPct = (int)((double)d.Value / MaxW() * 100);
                                <div class="b"><div class="vv">@WeeklyVal(d.Value)</div><div class="bar" style="height:@(Math.Max(6, hPct))%"></div><div class="lab">@d.Label</div></div>
                            }
                        </div>
                        @if (Widget.WeeklySample)
                        {
                            <div class="sub" style="text-align:right;color:var(--sub);font-size:11px;margin-top:4px">샘플 — 매일 자동 기록되어 채워집니다</div>
                        }
                        break;

                    case "paper":
                        <div class="row"><div class="nm">현금</div><div class="num">@Widget.PaperCash.ToString("N0")</div></div>
                        <div class="row"><div class="nm">포지션 평가</div><div class="num">@Widget.PaperPosVal.ToString("N0")</div></div>
                        <div class="row"><div class="nm">총손익</div><div class="num @(Widget.PaperPnl >= 0 ? "up" : "down")">@Widget.PaperPnl.ToString("+#,##0;-#,##0;0") (@Widget.PaperRet.ToString("+0.0;-0.0;0.0")%)</div></div>
                        <div class="order">
                            <button class="buy" @onclick="() => Quick(_qaMarket, _qaAmt, true)">매수</button>
                            <button class="sell" @onclick="() => Quick(_qaMarket, _qaAmt, false)">매도</button>
                        </div>
                        <div class="qa">
                            <span @onclick='() => Quick("KRW-BTC", 1_000_000, true)'>BTC 100만 매수</span>
                            <span @onclick='() => Quick("KRW-ETH", 500_000, false)'>ETH 50만 매도</span>
                            <span @onclick="OpenPaperModule">모의투자 창 열기</span>
                        </div>
                        break;

                    case "imminent":
                        @if (Widget.Signals.Count == 0)
                        {
                            <div class="sub" style="color:var(--sub);padding:8px 0">현재 포착된 신호가 없습니다. (감시 코인 일봉 기준)</div>
                        }
                        @foreach (var o in Widget.Signals)
                        {
                            <div style="padding:9px 0;border-bottom:1px solid var(--line)">
                                <div style="display:flex;align-items:center;gap:8px">
                                    <span class="pill @(o.Side == "BUY" ? "r" : "b")">@o.Side</span>
                                    <b style="font-size:12.5px">@o.Name</b>
                                    <span style="margin-left:auto;color:var(--sub);font-size:11px">@o.Reason</span>
                                </div>
                                <div class="prog"><i style="width:@(o.Pct)%"></i></div>
                            </div>
                        }
                        break;

                    case "activity":
                        @if (Activity.Recent.Count == 0)
                        {
                            <div class="sub" style="color:var(--sub);padding:8px 0">최근 활동이 없습니다. 모의 주문을 실행해 보세요.</div>
                        }
                        @foreach (var a in Activity.Recent)
                        {
                            <div class="act"><i></i><div>@a.Text</div><div class="tm">@a.When</div></div>
                        }
                        break;

                    case "indices":
                        @if (Widget.Indices.Count == 0)
                        {
                            <div class="sub" style="color:var(--sub);padding:8px 0">지수 데이터 로딩 중… (네트워크 필요)</div>
                        }
                        else
                        {
                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 18px">
                                @foreach (var region in new[] { "아시아", "미국", "유럽" })
                                {
                                    <div>
                                        <div style="font-size:10px;font-weight:700;color:var(--sub);letter-spacing:.08em;padding:4px 0 3px">@region.ToUpperInvariant()</div>
                                        @foreach (var r in Widget.Indices.Where(x => x.Region == region))
                                        {
                                            <div class="row" style="padding:4px 0">
                                                <div class="nm" style="font-size:12.5px;min-width:0;flex:1">@r.Flag @r.Name</div>
                                                <div style="text-align:right;padding-left:6px">
                                                    <div class="num" style="font-size:12.5px">@FormatIdx(r)</div>
                                                    <div class="num @(r.Up ? "up" : "down")" style="font-size:11px">@(r.Up ? "▲" : "▼") @Math.Abs(r.ChgPct).ToString("0.00")%</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="sub" style="text-align:right;color:var(--sub);font-size:10.5px;margin-top:6px">Yahoo Finance · 60초 자동 갱신</div>
                        }
                        break;

                    case "ai":
                        <AiRecommendationWidget @ref="_aiWidgetRef" />
                        break;

                    case "risk":
                        <RiskInterlockStatusWidget />
                        break;

                    case "forensic":
                        <ForensicAuditStreamViewer />
                        break;
                        }
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="sub" style="color:var(--warn);padding:10px 0">
                            ⚠ '@TitleOf(k)' 위젯 렌더링 오류 — 다른 위젯은 정상 동작합니다. (@ex.GetType().Name)
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    }
</div>

@if (_gallery)
{
    <div class="mask on" @onclick="() => _gallery = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h3>위젯 추가</h3>
            <div class="gal">
                @foreach (var k in _all)
                {
                    var has = _layout.Contains(k);
                    <div class="gcard @(has ? "dis" : "")" @onclick="() => Add(k)">
                        <div class="gt">@TitleOf(k)</div>
                        <div class="gd">@(has ? "이미 추가됨" : "클릭하여 추가")</div>
                    </div>
                }
            </div>
            <div class="foot"><button @onclick="() => _gallery = false">닫기</button></div>
        </div>
    </div>
}

@code {
    private List<string> _layout = new();
    private readonly string[] _all = { "coins", "pie", "weekly", "paper", "imminent", "activity", "indices", "ai", "risk", "forensic" };
    private bool _gallery;
    private string _theme = "light";

    private string? _drag;
    private string? _dragOver;

    private const string _qaMarket = "KRW-BTC";
    private const decimal _qaAmt = 1_000_000m;

    protected override async Task OnInitializedAsync()
    {
        _theme = Widget.Theme;
        _layout = Layout.Load().ToList();
        // [시세 하드닝 §2] 선행+후행 스냅샷 거버너 — 창 안 마지막 갱신도 반드시 렌더(이전 ShouldRender 는 거부된 최종 상태를 유실).
        _idxGov = new SnapshotRenderGovernor(() => _ = InvokeAsync(StateHasChanged), loadGovernor: RenderGov);
        Widget.IndicesRefreshed += OnIdxRefreshed;
        await Widget.LoadAsync();
    }

    // v12.8.0 감사 — StateAwareRenderGovernor(v10.1.0, 등록·ForceFreeze 결속까지는 돼있었으나 어떤 컴포넌트도
    //   ShouldRender 를 호출하지 않아 실질적으로 미가동 상태였음(실측 확인)). 지수 60초 자동 갱신 이벤트를 이 게이트로
    //   통과시켜 — 동결/고부하 시 렌더 코얼레싱이 실제로 작동하도록 결속한다(정상 상태는 무제한 그대로 통과).
    //   [시세 하드닝 §2] ShouldRender(선행 에지 전용) → SnapshotRenderGovernor(선행+후행 · 버전 변경 감지 · 부하/동결 적응 창)로 교체.
    private SnapshotRenderGovernor? _idxGov;
    private long _idxVersion;
    private void OnIdxRefreshed() => _idxGov?.Signal(System.Threading.Interlocked.Increment(ref _idxVersion));

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) await JS.InvokeVoidAsync("dashboard.setTheme", _theme);
    }

    private void OnDragStart(string k) { _drag = k; _dragOver = null; }
    private void OnDragEnter(string k) { if (_drag != null && k != _drag) _dragOver = k; }
    private void OnDragEnd() { _drag = null; _dragOver = null; }

    private void OnDrop(string targetKey)
    {
        if (_drag is null || _drag == targetKey) { OnDragEnd(); return; }
        var from = _layout.IndexOf(_drag);
        var to = _layout.IndexOf(targetKey);
        if (from >= 0 && to >= 0)
        {
            _layout.RemoveAt(from);
            _layout.Insert(to, _drag);
            Layout.Save(_layout);
        }
        OnDragEnd();
    }

    private static string? LinkOf(string k) => k switch
    {
        "coins" => "/live/coin", "pie" => "/portfolio/assets", "weekly" => "/portfolio/assets",
        "paper" => "/paper", "imminent" => "/lab", "activity" => "/paper", _ => null
    };

    private static string FormatIdx(IIndexRowView r)
    {
        if (r.Last >= 1000) return r.Last.ToString("N2");
        return r.Last.ToString("0.00");
    }

    private AiRecommendationWidget? _aiWidgetRef;

    // v12.8.0 Think Beyond B — 위젯 핫스왑(제거) 시 폐기 예정 인스턴스를 약한 참조로 등록(WidgetLifecycleMemoryGuard).
    // 강한 참조를 보유하지 않으므로 이 등록 자체가 누수 원인이 되지 않는다. 실제 회수 검증은 진단 도구(테스트) 책임.
    private void Remove(string k)
    {
        if (k == "ai" && _aiWidgetRef is not null) { MemoryGuard.Track(_aiWidgetRef); _aiWidgetRef = null; }
        _layout.Remove(k);
        Layout.Save(_layout);
    }
    private void Add(string k) { if (!_layout.Contains(k)) { _layout.Add(k); Layout.Save(_layout); } _gallery = false; }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        Widget.Theme = _theme;
        await JS.InvokeVoidAsync("dashboard.setTheme", _theme);
    }

    private async Task Quick(string market, decimal amt, bool isBuy)
    {
        await Action.QuickPaperAsync(market, amt, isBuy);   // 어댑터가 모의주문+토스트-네비 수행
        StateHasChanged();
    }

    private void OpenPaperModule() => Widget.OpenModule("Paper");

    private string TitleOf(string k) => k switch
    {
        "coins" => "🪙 코인 실시간", "pie" => "🧮 자산 구성", "weekly" => "📊 주간 수익률",
        "paper" => "🧪 모의투자 계좌", "imminent" => "⏳ 임박 신호", "activity" => "📡 최근 활동",
        "indices" => "🌍 글로벌 지수", "ai" => "🤖 AI 추천 코파일럿", "risk" => "🛡️ 리스크 서킷 브레이커",
        "forensic" => "🗃️ 포렌식 감사 스트림", _ => k
    };
    private string ColOf(string k) => k switch { "weekly" => "col8", "indices" => "col8", "ai" => "col8", "forensic" => "col8", _ => "col4" };

    private MarkupString Spark(double[] d, string color)
    {
        if (d == null || d.Length < 2) return (MarkupString)"";
        double w = 240, h = 26, mn = d.Min(), mx = d.Max(); var r = (mx - mn) == 0 ? 1 : (mx - mn);
        var pts = string.Join(" ", d.Select((v, i) => $"{(i / (double)(d.Length - 1) * w):F1},{(h - (v - mn) / r * h):F1}"));
        return (MarkupString)$"<svg class='spark' viewBox='0 0 {w} {h}' preserveAspectRatio='none' style='width:100%'><polyline points='{pts}' fill='none' stroke='{color}' stroke-width='2'/></svg>";
    }

    private MarkupString WeeklySpark()
    {
        if (Widget.Weekly == null || Widget.Weekly.Count < 2) return (MarkupString)"";
        var d = Widget.Weekly.Select(x => (double)x.Value).ToArray();
        double w = 88, h = 24, mn = d.Min(), mx = d.Max(); var r = (mx - mn) == 0 ? 1 : (mx - mn);
        var pts = string.Join(" ", d.Select((v, i) => $"{(i / (double)(d.Length - 1) * w):F1},{(h - (v - mn) / r * h):F1}"));
        var color = d[^1] >= d[0] ? "var(--up)" : "var(--down)";
        return (MarkupString)$"<svg class='k-spark' viewBox='0 0 {w} {h}' preserveAspectRatio='none'><polyline points='{pts}' fill='none' stroke='{color}' stroke-width='1.6'/></svg>";
    }

    private decimal Tot => Widget.AllocKrwStock + Widget.AllocUsdStock + Widget.AllocCoin;
    private string Pct(decimal v) => Tot > 0 ? (v / Tot * 100m).ToString("0.0") : "0.0";
    private string Eok(decimal v) => v >= 100_000_000m ? $"{v / 100_000_000m:0.0}억" : $"{v / 10_000m:N0}만";
    private string WeeklyVal(decimal v) => Widget.WeeklySample ? ((int)v).ToString() : Eok(v);
    private double MaxW() { var w = Widget.Weekly.Count > 0 ? (double)Widget.Weekly.Max(x => x.Value) : 1; return w <= 0 ? 1 : w; }
    private string DonutCss()
    {
        var t = Tot <= 0 ? 1m : Tot;
        var a = (double)(Widget.AllocKrwStock / t * 100);
        var b = a + (double)(Widget.AllocUsdStock / t * 100);
        return $"conic-gradient(var(--accent) 0 {a:F1}%, var(--accent-2) {a:F1}% {b:F1}%, var(--warn) {b:F1}% 100%)";
    }

    public void Dispose() { Widget.IndicesRefreshed -= OnIdxRefreshed; _idxGov?.Dispose(); }
}
