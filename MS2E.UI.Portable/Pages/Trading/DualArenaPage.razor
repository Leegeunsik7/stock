    public static readonly decimal[] CopyRatios = { 0.5m, 1.0m };

    private ArenaCopyTradingView CopyOf(int mode) => mode == ModeCrypto ? CryptoPort.CopyTrading : mode == ModeUs ? UsPort.CopyTrading : Port.CopyTrading;

    // [v12.18.71-DEV] 1-클릭 복제(근거 순번 → 활성 모드 포트 FollowAiTrade · 비례 수량 × 배율) → 결과 토스트(성공 = 접수 · 거부 = 사유).
    private void Follow(int mode, long seq)
    {
        var r = mode == ModeCrypto ? CryptoPort.FollowAiTrade(seq, _copyRatio) : mode == ModeUs ? UsPort.FollowAiTrade(seq, _copyRatio) : Port.FollowAiTrade(seq, _copyRatio);
        string act = r.Side > 0 ? "따라사기" : "따라팔기";
        string qty = mode == ModeCrypto ? CoinQty(r.Qty) + " 코인" : r.Qty.ToString("N0") + "주";
        (_copyCss, _copyMsg) = r.Accepted
            ? ("ok", "✅ " + act + " 접수 #" + seq + " — " + qty + " (배율 " + RatioText(_copyRatio) + ") → 다음 정산 회차 휴먼 가상 원장 체결 · 슬리피지 20bp 초과 시 자동 취소")
            : ("bad", "⛔ " + act + " 거부 #" + seq + " — " + r.Label);
        System.Threading.Volatile.Write(ref _drawn, -1);
    }

    // [v12.18.71-DEV] 자동 미러링 토글 · 배율(활성 모드 포트만 · 미지원 = 거부 토스트 · 가짜 상태 0).
    private async Task SetAutoCopy(int mode, bool enabled, decimal ratio)
    {
        bool ok = mode == ModeCrypto ? CryptoPort.SetAutoCopyEnabled(enabled, ratio) : mode == ModeUs ? UsPort.SetAutoCopyEnabled(enabled, ratio) : Port.SetAutoCopyEnabled(enabled, ratio);
        if (ok) _copyRatio = ratio;
        (_copyCss, _copyMsg) = !ok ? ("bad", "⛔ 자동 미러링 설정 거부 — 이 아레나는 카피 트레이딩 미지원")
            : enabled ? ("ok", "⚡ 플루토 자동 미러링 ON (" + RatioText(ratio) + ") — AI 체결 즉시 휴먼 가상 원장 비례 복제 · AI 청산 시 복제분 동반 청산 · 예수금 부족 = 거부")
            : ("idle", "플루토 자동 미러링 OFF — 휴먼 원장은 수동 주문 · 1-클릭 따라하기만 반영됩니다");
        System.Threading.Volatile.Write(ref _drawn, -1);
        if (ok) await PersistCopy(mode, enabled, ratio);
    }

    // [v12.18.72-DEV] 자동 미러링 선호 저장(스레드 풀 · 아레나별 최종값 수렴 · 늦게 끝난 이전 저장의 결과 표시는 무시). 모드 상수 = ArenaPreferenceArena 값.
    private readonly int[] _copyPersistSeq = new int[3];
    private readonly string[] _copyPersistCss = { "idle", "idle", "idle" }, _copyPersistText = { "", "", "" };
    private async Task PersistCopy(int mode, bool enabled, decimal ratio)
    {
        if (!Prefs.IsWired) return;
        int seq = ++_copyPersistSeq[mode];
        _copyPersistCss[mode] = "saving"; _copyPersistText[mode] = "💾 저장 중…";
        bool ok;
        try { ok = await Prefs.SaveAutoCopyAsync(mode, enabled, ratio); }
        catch (Exception) { ok = false; }
        if (seq != _copyPersistSeq[mode]) return;
        (_copyPersistCss[mode], _copyPersistText[mode]) = ok
            ? ("ok", "💾 저장됨 — 재기동 후에도 " + (enabled ? "ON" : "OFF") + " · " + RatioText(ratio) + " 유지")
            : ("bad", "저장 실패 — 재기동 시 이전 저장값으로 복귀");
        System.Threading.Volatile.Write(ref _drawn, -1);
    }

    private void InitCopyPersistBadges()
    {
        for (int mode = ModeKrx; mode <= ModeCrypto; mode++)
        {
            if (!Prefs.IsWired) { _copyPersistCss[mode] = "none"; _copyPersistText[mode] = "저장소 미결선 — 재기동 시 OFF · 1.0x 로 복귀"; continue; }
            var stored = Prefs.StoredAutoCopy(mode);
            _copyPersistCss[mode] = "ok";
            _copyPersistText[mode] = stored is { } p ? "💾 저장값 " + (p.Enabled ? "ON" : "OFF") + " · " + RatioText(p.Ratio) + " — 재기동 후에도 유지" : "💾 저장값 없음 — 기본 OFF · 1.0x";
        }
    }

    // [v12.18.72-DEV] 배율 버튼 = 활성 모드 엔진 배율(기동 복원값 포함) 과 동기화. 미지원 · 배율 0 = 현재 값 유지.
    private void SyncCopyRatio()
    {
        var c = CopyOf(_mode);
        if (c.Supported && c.RatioBp > 0) _copyRatio = c.RatioBp / 10_000m;
    }

    private static string RatioText(decimal r) => r.ToString("0.0#", System.Globalization.CultureInfo.InvariantCulture) + "x";

    // [v12.18.71-DEV] 휴먼 티켓 상단 자동 미러링 바(토글 · 배율 · 복제 계수 · 최근 자동 결과).
    private RenderFragment CopyBar(int mode, ArenaCopyTradingView c) => @<text>
        <div class="da-copy-bar" data-mode="@mode">
            <button class="da-copy-toggle @(c.AutoEnabled ? "on" : "off")" role="switch" aria-checked="@(c.AutoEnabled ? "true" : "false")" disabled="@(!c.Supported)"
                    @onclick="() => SetAutoCopy(mode, !c.AutoEnabled, _copyRatio)">⚡ 플루토 자동 미러링 <b>(@(c.AutoEnabled ? "ON" : "OFF"))</b></button>
            @foreach (var ratio in CopyRatios)
            {
                <button class="da-copy-ratio @(_copyRatio == ratio ? "on" : "")" data-ratio="@RatioText(ratio)" @onclick="() => SetAutoCopy(mode, c.AutoEnabled, ratio)">@RatioText(ratio)</button>
            }
            @if (!c.Supported)
            {
                <span class="ar-sub">카피 트레이딩 미결선</span>
            }
            else
            {
                <span class="da-badge da-copy-persist @_copyPersistCss[mode]" data-copy-persist="@_copyPersistCss[mode]">@_copyPersistText[mode]</span>
                <span class="ar-sub da-copy-stats">미러링 @c.Mirrored · 따라하기 @c.Followed · 동반 청산 @c.CompanionCloses · 슬리피지 취소 @c.SlippageCancels · 예수금 거부 @c.CashRejects</span>
                @if (c.LastEvent > 0)
                {
                    <span class="da-badge da-copy-last @(c.LastCode == ArenaCopyCode.None ? "ok" : "bad")" data-copy-last="@c.LastCode">@c.LastKindLabel @(c.LastSide > 0 ? "매수" : "매도") @(c.LastSymbol is { } ls ? Sym(ls) : "") · @(c.LastCode == ArenaCopyCode.None ? "체결" : ArenaCopyCode.Label(c.LastCode))</span>
                }
            }
        </div>
    </text>;

    // [v12.18.71-DEV] 근거 카드 · 청산 저널 행 1-클릭 복제 버튼(매수 근거 = 따라사기 · 매도 근거 = 따라팔기).
    private RenderFragment FollowButton(int mode, long seq, int side) => @<text>
        <button class="da-follow @(side > 0 ? "buy" : "sell")" data-follow="@seq" title="AI 체결 #@seq 를 휴먼 가상 원장으로 복제(배율 @RatioText(_copyRatio) · 슬리피지 20bp 보호)" @onclick="() => Follow(mode, seq)">👤 @(side > 0 ? "따라사기" : "따라팔기")</button>
    </text>;

    // [v12.18.71-DEV] 시초가 개장 게이트 배지(동시호가 접수 · 단일가 체결 · 갭 거부권 · 종목 개장 갭).
    private static RenderFragment OpenBadges(ArenaOpeningAuctionView a, IReadOnlyList<ArenaOpenGapView> gaps) => @<text>@if (a.Supported)
    {
        @if (a.PreOpen)
        {
            <span class="da-badge da-auction pre" data-auction="pre">🔔 동시호가 접수 중 · 장부 @(a.Parked)건 → 개장 단일가 체결</span>
        }
        @if (a.AuctionFills + a.AuctionRejects + a.GapVetoes + a.GapFillEntries > 0)
        {
            <span class="da-badge da-auction">시초가 단일가 체결 @a.AuctionFills · 거부 @a.AuctionRejects · 갭 거부권 @a.GapVetoes · 갭 메우기 진입 @a.GapFillEntries</span>
        }
        @foreach (var g in gaps)
        {
            <span class="da-gap @ArenaOpenGapKind.Css(g.Kind) @(g.InWindow ? "live" : "")" data-gap="@g.Code" title="@g.KindLabel">@Sym(g.Code) 시초 갭 <b class="@Css(g.GapBp)">@Bp(g.GapBp)</b>@(g.InWindow ? " · " + g.KindLabel : "")</span>
        }
    }</text>;

    // [v12.18.70-DEV] 청산 근거 카드 헤더 실현손익 칩(저널 매칭 = 수익률 병기 · 미매칭 = 금액만).
    private static RenderFragment PnlChip(string pnlText, long pnl, ArenaClosedTradeView? t) => @<text>
        <span class="da-pnl-chip @Css(pnl)">[실현손익: @pnlText@(t is { HasReturn: true } ? " (" + Bp(t.ReturnBp) + ")" : "")]</span>
    </text>;

    private static ArenaClosedTradeView? ClosedOf(IReadOnlyList<ArenaClosedTradeView> list, long seq)
    {
        foreach (var t in list) if (t.Seq == seq) return t;
        return null;
    }

    /// <summary>[v12.18.70-DEV] 미국 티커 · 업비트 마켓 표시("엔비디아 NVDA" · 미등록 = 코드).</summary>
    private static string Sym(string code) => StockDisplayNameResolver.Display(code);
    private static string Shares(long q) => q.ToString("N0");
    private static string SignedWon(long w) => Signed(w) + "원";
    private static string Won(long w) => w.ToString("N0") + "원";
    private static string Signed(long w) => (w > 0 ? "+" : "") + w.ToString("N0");
    private static string Bp(long bp) => (bp > 0 ? "+" : "") + (bp / 100.0).ToString("F2") + "%";
    private static string Ret(KrxArenaBookView b) => Bp(b.ReturnBp);
    private static string WinRate(KrxArenaBookView b) => WinRate(b.Wins, b.Losses, b.WinRateBp);
    private static string WinRate(int wins, int losses, long winRateBp) => wins + losses == 0 ? "-" : (winRateBp / 100.0).ToString("F1") + "% (" + wins + "승 " + losses + "패)";

    protected override void OnInitialized()
    {
        InitPersistBadge();
        InitCopyPersistBadges();
        SyncCopyRatio();
        _timer = new System.Threading.Timer(_ => RenderPump(), null, RenderPumpMs, RenderPumpMs);
    }

    // 레벨 트리거 렌더 펌프(타이머 스레드): 활성 모드 포트의 그려진 버전 ≠ 현재 버전 ∧ 진행 중 렌더 없음 → InvokeAsync 1건.
    private void RenderPump()
    {
        int mode = System.Threading.Volatile.Read(ref _mode);
        long current = mode == ModeCrypto ? CryptoPort.Version : mode == ModeUs ? UsPort.Version : Port.Version;
        if (current == System.Threading.Volatile.Read(ref _drawn)) return;
        if (System.Threading.Interlocked.CompareExchange(ref _renderInFlight, 1, 0) != 0) return;
        try { _ = InvokeAsync(StateHasChanged); }
        catch (Exception) { System.Threading.Volatile.Write(ref _renderInFlight, 0); }
    }

    protected override void OnAfterRender(bool firstRender) => System.Threading.Volatile.Write(ref _renderInFlight, 0);

    public void Dispose() => _timer?.Dispose();
}

