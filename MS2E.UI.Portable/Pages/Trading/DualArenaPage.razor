@code {
    public const int RenderPumpMs = 100, MaxCards = 30, MaxClosed = 50;
    public const int ModeKrx = 0, ModeUs = 1, ModeCrypto = 2;

    private int _mode = ModeKrx;
    private string? _govMsg;
    private string _persistCss = "idle", _persistText = "";
    private long _symbol;
    private long _qty = 10;
    private string? _msg;
    // 미국 모드 전용 상태(국내 티켓 · 메시지와 분리 — 모드 전환 시 교차 오염 0)
    private string? _ticker;
    private long _usQty = 10;
    private string? _usMsg;
    // 크립토 모드 전용 상태(국내 · 미국 티켓 · 메시지와 분리)
    private string? _market;
    private decimal _coinQty = 0.001m;
    private string? _cryptoMsg;
    // [v12.18.78-DEV] 추천 패널 상태(탭 −1 = 활성 모드 추종 · 메시지 = 마지막 1-Click 담기 결과)
    private int _recoTab = -1;
    // [v12.18.87-DEV] 추천 매트릭스 탭(−1 = 전체 통합 순위)
    private int _mxTab = PlutoCockpitMatrix.All;
    private string? _recoMsg;
    // [v12.18.85-DEV] 인지 브리핑 패널 열림(닫힘 = 합성 0)
    private bool _briefOpen;
    // [v12.18.71-DEV] 카피 트레이딩 상태(배율 = 따라하기 · 자동 미러링 공용 · 토스트 = 마지막 1-클릭 결과)
    private decimal _copyRatio = 1.0m;
    private string? _copyMsg;
    private string _copyCss = "ok";
    private long _drawn = -1;
    private int _renderInFlight;
    private System.Threading.Timer? _timer;

    private void Select(int source)
    {
        if (Port.Feed.Requested == source) return;
        _msg = Port.SelectSource(source) ? KrxArenaFeed.Label(source) + " 선택 — 다음 정산에서 양 진영 원장 초기화 후 적용" : "출처 선택 불가(주입기 미결선)";
    }

    private void Submit(int side)
    {
        long sym = _symbol;
        if (sym <= 0) { var q = Port.Quotes(); sym = q.Count > 0 ? q[0].Symbol : 0; }
        int r = Port.SubmitHuman(sym, side, _qty);
        _msg = r == KrxArenaReject.None
            ? (side > 0 ? "매수" : "매도") + " 접수 → 다음 정산 회차 가상 체결"
            : "접수 거부: " + KrxArenaReject.Label(r);
    }

    // [v12.18.78-DEV] 1-Click 아레나 담기 = 해당 모드 전환 + 휴먼 티켓 종목 · 추천 수량 바인딩만(접수 0 — 사용자가 매수 버튼으로 확정).
    // [v12.18.79-DEV] 코인 = 크립토 모드 전환 + 마켓 코드 · 코인 수량(raw 10^8 → 코인) 바인딩.
    private void LoadReco(PlutoRecommendationCard c)
    {
        if (c.RecommendedQty <= 0) { _recoMsg = "담기 불가: 추천 수량 0주(자본 대비 1주 가격 초과)"; return; }
        if (c.Market == PlutoRecoMarket.Crypto)
        {
            SetMode(ModeCrypto);
            _market = c.Code;
            _coinQty = c.RecommendedQty / (decimal)CryptoArenaUnits.Scale;
            _cryptoMsg = "🌟 플루토 추천 담기: " + c.Code + " " + c.QtyText + " — 매수 버튼으로 접수";
        }
        else if (c.Market == PlutoRecoMarket.Us)
        {
            SetMode(ModeUs);
            _ticker = c.Code;
            _usQty = c.RecommendedQty;
            _usMsg = "🌟 플루토 추천 담기: " + c.Code + " " + c.RecommendedQty.ToString("N0") + "주 — 매수 버튼으로 접수";
        }
        else
        {
            SetMode(ModeKrx);
            _symbol = c.Symbol;
            _qty = c.RecommendedQty;
            _msg = "🌟 플루토 추천 담기: " + c.Name + " " + c.RecommendedQty.ToString("N0") + "주 — 매수 버튼으로 접수";
        }
        _recoTab = c.Market;
        _recoMsg = "🌟 " + c.Name + "(" + c.Code + ") " + c.QtyText + " → " + PlutoRecoMarket.Label(c.Market) + " 휴먼 티켓에 담았습니다";
    }

    // 모드 전환 = 표시 대상 포트만 바꾼다(각 원장은 자기 엔진에 그대로 · 그려진 버전 무효화 → 새 모드 첫 폴링에서 다시 그린다).
    private void SetMode(int mode)
    {
        if (mode == _mode || (mode != ModeKrx && mode != ModeUs && mode != ModeCrypto)) return;
        System.Threading.Volatile.Write(ref _mode, mode);
        SyncCopyRatio();
        System.Threading.Volatile.Write(ref _drawn, -1);
    }

    private void SelectUs(int source)
    {
        if (UsPort.Feed.Requested == source) return;
        _usMsg = UsPort.SelectSource(source) ? UsArenaFeed.Label(source) + " 선택 — 다음 정산에서 양 진영 원장 초기화 후 적용" : "출처 선택 불가(주입기 미결선)";
    }

    private void SubmitUs(int side)
    {
        string? tkr = _ticker;
        if (string.IsNullOrEmpty(tkr)) { var q = UsPort.Quotes(); tkr = q.Count > 0 ? q[0].Ticker : null; }
        int r = UsPort.SubmitHuman(tkr ?? "", side, _usQty);
        _usMsg = r == UsArenaReject.None
            ? (side > 0 ? "매수" : "매도") + " 접수 → 다음 정산 회차 가상 체결(USD)"
            : "접수 거부: " + UsArenaReject.Label(r);
    }

    private void SelectCrypto(int source)
    {
        if (CryptoPort.Feed.Requested == source) return;
        _cryptoMsg = CryptoPort.SelectSource(source) ? CryptoArenaFeed.Label(source) + " 선택 — 다음 정산에서 양 진영 원장 초기화 후 적용" : "출처 선택 불가(주입기 미결선)";
    }

    private void SubmitCrypto(int side)
    {
        string? mkt = _market;
        if (string.IsNullOrEmpty(mkt)) { var q = CryptoPort.Quotes(); mkt = q.Count > 0 ? q[0].Market : null; }
        long qtyRaw = _coinQty <= 0 || _coinQty > 1_000_000_000m ? 0 : (long)decimal.Truncate(_coinQty * CryptoArenaUnits.Scale);
        int r = CryptoPort.SubmitHuman(mkt ?? "", side, qtyRaw);
        _cryptoMsg = r == CryptoArenaReject.None
            ? (side > 0 ? "매수" : "매도") + " 접수 → 다음 정산 회차 가상 체결(KRW)"
            : "접수 거부: " + CryptoArenaReject.Label(r);
    }

