    // [v12.18.70-DEV] AI 실현손익 체결 내역(청산 저널 · 최신순) — 단위 표기는 아레나별 포맷터 주입(원 · USD · 코인 raw).
    private RenderFragment ClosedTable(IReadOnlyList<ArenaClosedTradeView> list, Func<long, string> price, Func<long, string> signedPnl,
