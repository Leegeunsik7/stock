    private int _persistSeq;
    private async Task Persist(bool target)
    {
        if (!Prefs.IsWired) return;
        int seq = ++_persistSeq;
        _persistCss = "saving"; _persistText = "💾 저장 중…";
        bool ok;
        try { ok = await Prefs.SaveGovernanceEnabledAsync(target); }
        catch (Exception) { ok = false; }
        if (seq != _persistSeq) return;
        (_persistCss, _persistText) = ok
            ? ("ok", "💾 저장됨 — 재기동 후에도 " + (target ? "ON" : "OFF") + " 유지")
            : ("bad", "저장 실패 — 재기동 시 이전 저장값으로 복귀");
    }

