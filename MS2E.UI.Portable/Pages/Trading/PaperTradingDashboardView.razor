    .pd-reg.trend { background: #2e7d32; } .pd-reg.revert { background: #f9a825; color: #111; } .pd-reg.chop { background: #E53935; }
    .pd-churn-hot { outline: 1px solid #E53935; }
    .pd-gate { padding: 2px 8px; border-radius: 6px; font-weight: 600; background: #3a3f4b; color: #ccc; }
    .pd-audit { padding: 2px 8px; border-radius: 6px; font-weight: 600; background: #3a3f4b; color: #ccc; display: inline-flex; gap: 4px; align-items: center; }
    .pd-audit.ok { background: #2e7d32; color: #fff; } .pd-audit.sat { background: #f9a825; color: #111; } .pd-audit.frozen { background: #6a1b9a; color: #fff; }
    .pd-audit em { font-style: normal; opacity: .85; } .pd-audit code { font-size: 11px; opacity: .9; }
    .pd-jit { padding: 2px 8px; border-radius: 6px; font-weight: 600; background: #3a3f4b; color: #ccc; display: inline-flex; gap: 4px; align-items: center; }
    .pd-jit.ok { background: #2e7d32; color: #fff; } .pd-jit.spike { background: #f9a825; color: #111; } .pd-jit.gc { background: #E53935; color: #fff; }
    .pd-jit em { font-style: normal; font-weight: 400; opacity: .85; }
    .pd-ses { padding: 1px 6px; border-radius: 6px; font-weight: 600; background: #3a3f4b; color: #ccc; }
    .pd-ses.ok { background: #2e7d32; color: #fff; } .pd-ses.wait { background: #f9a825; color: #111; } .pd-ses.bad { background: #E53935; color: #fff; }
    .pd-ses-n { font-style: normal; opacity: .8; margin-left: 4px; }
    .pd-sw { display: inline-block; width: 8px; height: 12px; border-radius: 2px; }
    .pd-gate.enforce { background: #1565c0; color: #fff; } .pd-gate.observe { background: #4e342e; color: #ffcc80; }
    .pd-lat-grade.ok { background: #2e7d32; color: #fff; } .pd-lat-grade.spike { background: #f9a825; color: #111; }
    .pd-lat-grade.lag { background: #E53935; color: #fff; } .pd-lat-grade.off { background: #3a3f4b; color: #ccc; }
    .pd-lat-b { background: #1d2230; border-radius: 6px; padding: 2px 8px; font-family: Consolas, monospace; }
    .pd-lat-b em { font-style: normal; color: var(--sub); margin-right: 4px; } .pd-lat-main { outline: 1px solid #4dd0e1; }
    .pd-lat-off { color: var(--sub); } .pd-lat-throttle { color: #f9a825; }
    .pd-lat-spark { flex: 1 1 100%; }
    .pd-dec { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 1px 0; }
    .pd-badge { font-size: 10.5px; padding: 1px 6px; border-radius: 6px; font-family: inherit; }
    .pd-badge.up { background: #E53935; color: #fff; } .pd-badge.down { background: #1E88E5; color: #fff; }
    .pd-badge.hold { background: #3a3f4b; color: #ccc; } .pd-badge.warn { background: #f9a825; color: #111; }
    .pd-conf { position: relative; display: inline-block; width: 70px; height: 6px; background: #2a3040; border-radius: 3px; }
    .pd-conf i { position: absolute; left: 0; top: 0; height: 100%; border-radius: 3px; background: #757575; }
    .pd-conf i.up { background: #E53935; } .pd-conf i.down { background: #1E88E5; } .pd-conf i.warn { background: #f9a825; }
    .pd-conf em { position: absolute; left: 85%; top: -2px; width: 1px; height: 10px; background: #f9a825; }
    .pd-flash { animation: pd-blink 0.8s steps(2, start) infinite; }
    .pd-led.pd-flash { outline: 1px solid #E53935; }
    @@keyframes pd-blink { to { background-color: rgba(229, 57, 53, 0.35); } }
</style>

@code {
    private SnapshotRenderGovernor? _gov;
    private Action<long>? _onFrame;
    // [방향 B] 렌더 지연 열화 · [방향 A] 스파크라인 버퍼(프레임 버전당 1회 문자열)
    private readonly DashboardDegradationGovernor _degrade = new();
    private long _renderBuilt, _observedBuilt;
    private const int SparkW = 300, SparkH = 40;
    private readonly long[] _sparkVals = new long[PaperDashboardFrame.MaxDecisions];
    private readonly char[] _sparkBuf = new char[PaperDashboardFrame.MaxDecisions * 12];
    private long _sparkVersion = -1;
    private string _sparkPoints = "";

    private string FlashClass(bool on) => on && !_degrade.Degraded ? "pd-flash" : "";

    private string SparkPoints(PaperDashboardFrame f)
    {
        if (f.Version == _sparkVersion) return _sparkPoints;
        int n = f.DecisionCount;
        for (int i = 0; i < n; i++) _sparkVals[i] = f.Decisions[n - 1 - i].ScaleBp;   // 과거 → 최신
        int len = SparklineWriter.Write(_sparkVals.AsSpan(0, n), _sparkBuf, SparkW, SparkH);
        _sparkPoints = len > 0 ? new string(_sparkBuf, 0, len) : "";
        _sparkVersion = f.Version;
        return _sparkPoints;
    }

    // [v12.17.5-DEV] 지연 스파크라인(로그 버킷 축) — 고정 버퍼 작성 · 프레임 버전당 문자열 1회
    private readonly long[] _latScratch = new long[PaperDashboardFrame.MaxLatencyTrend];
    private readonly char[] _latBuf = new char[PaperDashboardFrame.MaxLatencyTrend * 12];
    private long _latVersion = -1;
    private string _latPoints = "";

    private string LatencyPoints(PaperDashboardFrame f)
    {
        if (f.Version == _latVersion) return _latPoints;
        int len = SparklineWriter.WriteLatency(f.LatencyTrendSpan, _latScratch, _latBuf, SparkW, SparkH);
        _latPoints = len > 0 ? new string(_latBuf, 0, len) : "";
        _latVersion = f.Version;
        return _latPoints;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // [방향 B] 허브 조립 시각 → 렌더 완료 지연(같은 UTC 틱 시계). 모드 전환 시 1회 재렌더.
        long built = _renderBuilt;
        if (built <= 0 || built == _observedBuilt) return;                // 같은 프레임 재렌더 = 표본 아님
        _observedBuilt = built;
        if (_degrade.Observe((DateTime.UtcNow.Ticks - built) / 10_000.0)) { try { _ = InvokeAsync(StateHasChanged); } catch (Exception) { } }
    }

    protected override void OnInitialized()
    {
        // 렌더 콜백 예외(회로 종료 후 InvokeAsync 등)는 여기서 흡수 — 허브 펌프로 전파 0
        _gov = new SnapshotRenderGovernor(() => { try { _ = InvokeAsync(StateHasChanged); } catch (Exception) { } }, TimeSpan.FromMilliseconds(50), RenderGov);
        var gov = _gov;
        _onFrame = v => gov.Signal(v);
        Dash.FrameReady += _onFrame;
    }

    public void Dispose()
    {
        if (_onFrame is not null) Dash.FrameReady -= _onFrame;
        _gov?.Dispose();
    }

    private static string Tone(long v) => v > 0 ? "#E53935" : v < 0 ? "#1E88E5" : "inherit";
    private static string Won(long v) => (v > 0 ? "+" : "") + v.ToString("N0") + "원";
    private static string Bp(long bp) => (bp / 100.0).ToString("0.00") + "%";
    private static string Time(long ticks) => ticks <= 0 ? "--:--:--" : new DateTime(ticks, DateTimeKind.Utc).ToLocalTime().ToString("HH:mm:ss.fff");
    private static string BrokerName(int b) => b switch { 0 => "키움", 1 => "KIS", 2 => "모의", _ => "B" + b };
    private static long Pct(long a, long b) => b <= 0 ? 0 : Math.Clamp(a * 100 / b, 0, 100);

    private static string LedTitle(PaperDashboardFrame f, int bit)
        => bit + " " + f.BitName(bit) + (f.IsRequired(bit) ? " · 필수" : "") + (f.IsBound(bit) ? " · 결속" : " · 미결속");

    private static string LedClass(PaperDashboardFrame f, int bit)
        => f.IsRaised(bit) ? "raised" : (f.IsRequired(bit) && !f.IsBound(bit)) ? "unbound" : "ok";

    private static string Bits(PaperDashboardFrame f, long bits)
    {
        // 단일 비트(대부분) = 정적 한글 라벨 그대로(할당 0) · 복수 비트만 결합
        if (bits != 0 && (bits & (bits - 1)) == 0) return SignalLabelMapper.Interlock(System.Numerics.BitOperations.TrailingZeroCount((ulong)bits));
        var sb = new System.Text.StringBuilder();
        for (int b = 0; b < 64; b++)
            if ((bits & (1L << b)) != 0) { if (sb.Length > 0) sb.Append(", "); sb.Append(SignalLabelMapper.Interlock(b)); }
        return sb.ToString();
    }

    private static (long Min, long Max) Range(PaperDashboardFrame f)
    {
        long min = 0, max = 0;
        for (int i = 0; i < f.EquityCount; i++) { long v = f.Equity[i].EquityWon; if (v < min) min = v; if (v > max) max = v; }
        if (max == min) max = min + 1;
        return (min, max);
    }

    private static string ZeroY(PaperDashboardFrame f)
    {
        var (min, max) = Range(f);
        return (150 - (0 - min) * 140.0 / (max - min)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string CurvePoints(PaperDashboardFrame f)
    {
        var (min, max) = Range(f);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder(f.EquityCount * 12);
        double step = 600.0 / Math.Max(1, f.EquityCount - 1);
        for (int i = 0; i < f.EquityCount; i++)
        {
            double x = i * step, y = 150 - (f.Equity[i].EquityWon - min) * 140.0 / (max - min);
            sb.Append(x.ToString("0.0", inv)).Append(',').Append(y.ToString("0.0", inv)).Append(' ');
        }
        return sb.ToString();
    }
}
