    .pd-bar { height: 4px; background: #2a3040; border-radius: 2px; margin: 4px 0; } .pd-bar i { display: block; height: 100%; background: #43a047; border-radius: 2px; }
    .pd-stream { font-size: 11.5px; max-height: 220px; overflow: auto; background: #0f1219; padding: 8px; border-radius: 8px; margin: 0; font-family: Consolas, monospace; }
