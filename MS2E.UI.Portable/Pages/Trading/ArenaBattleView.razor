        }
    };

    private RenderFragment Debrief(int side, string title) => __builder =>
    {
        if (!Arena.TryReadDebrief(side, out var b)) return;
        <div>
            <h4>@title <small>@(b.Trips)회 · @(b.Wins)승 @(b.Losses)패@(b.OpenTrips > 0 ? " · 미청산 " + b.OpenTrips : "")</small></h4>
            <table class="ar-tbl">
                <tr><td>MAE 최악/평균</td><td class="ar-down">@(b.MaeWorstWon.ToString("N0")) / @(b.MaeAvgWon.ToString("N0"))</td><td>MFE 최고/평균</td><td class="ar-up">@(b.MfeBestWon.ToString("N0")) / @(b.MfeAvgWon.ToString("N0"))</td></tr>
                <tr><td>보유 평균/최장</td><td>@HoldText(b.AvgHoldMs) / @HoldText(b.MaxHoldMs)</td><td>MFE 포착률</td><td>@((b.CaptureBp / 100.0).ToString("0.0"))%</td></tr>
                <tr><td>실현 합계</td><td class="@Tone(b.RealizedWon)">@(b.RealizedWon.ToString("N0"))</td><td>최대 연패</td><td>@(b.MaxLossStreak)</td></tr>
                <tr><td>슬리피지 드래그</td><td>@(b.SlippageDragWon.ToString("N0"))</td><td>왕복 내 슬리피지</td><td>@(b.TripSlippageWon.ToString("N0"))</td></tr>
                <tr><td>틸트 경보</td><td class="@(b.TiltAlerts > 0 ? "ar-msg" : "")">@(b.TiltAlerts)건</td><td>마지막 사유</td><td>@ArenaTilt.Label(b.LastTiltReason)</td></tr>
            </table>
        </div>
