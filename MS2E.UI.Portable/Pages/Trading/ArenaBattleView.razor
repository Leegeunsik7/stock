    private static string Pct(long bp) => (bp / 100.0).ToString("0.00") + "%";
    private static string Pf(long bp) => bp < 0 ? "∞(손실 0)" : bp == 0 ? "-" : (bp / 10_000.0).ToString("0.00");
    private static string LastTrade(in ArenaDebrief d)
        => d.LastSide == 0 ? "-" : (d.LastSide > 0 ? "LONG " : "SHORT ") + d.LastEntryPx.ToString("N0") + "→" + d.LastExitPx.ToString("N0")
           + " · MAE " + d.LastMaePx.ToString("N0") + " · MFE " + d.LastMfePx.ToString("N0") + " · Net " + d.LastNetWon.ToString("N0") + " · " + HoldText(d.LastHoldMs);
    private static string Verdict(in ArenaDebrief a, in ArenaDebrief h)
        => h.NetPnlWon == a.NetPnlWon ? "Net 동률"
           : (h.NetPnlWon > a.NetPnlWon ? "휴먼" : "AI") + " Net 우위 " + Math.Abs(h.NetPnlWon - a.NetPnlWon).ToString("N0") + "원"
             + (h.GrossPnlWon > a.GrossPnlWon != h.NetPnlWon > a.NetPnlWon ? " — Gross 기준으론 반대(마찰비용이 승부를 뒤집음)" : "");

    private static string HoldText(long ms) => ms >= 60_000 ? (ms / 60_000) + "분 " + (ms / 1_000 % 60) + "초" : (ms / 1_000.0).ToString("0.0") + "초";

    private long _limitPx, _peakQty = 10;
    private bool _iceberg;
    private string _tapePath = "";
    private IReadOnlyList<ArenaTapeInfo> _tapes = Array.Empty<ArenaTapeInfo>();

    private void RefreshTapes() => _tapes = Tapes.ListTapes();

    private void LoadTape()
        => _msg = Replay.LoadTape(_tapePath.Length == 0 ? null : _tapePath) ? null : "테이프 열기 실패(손상 · 형식 불일치)";

    private void StartRecording() => _msg = Tapes.StartRecording() ? null : "녹화 시작 실패(디렉터리 · 디스크 확인)";

    private void StopRecording()
    {
        Tapes.StopRecording();
        _msg = "녹화 저장 " + Tapes.RecordedCount.ToString("N0") + "건";
    }

    private void SubmitLimit(int dir)
    {
        if (!long.TryParse(_symbol, out long sym) || sym <= 0) { _msg = "종목코드를 숫자 6자리로 입력하세요"; return; }
        int r = _iceberg ? Arena.SubmitHumanIceberg(sym, dir, _qty, _limitPx, _peakQty) : Arena.SubmitHumanLimit(sym, dir, _qty, _limitPx);
        _msg = r == ArenaReject.None ? (_iceberg ? "🧊 빙산 " : "") + (dir > 0 ? "지정가 매수" : "지정가 매도") + " 접수 → 지연 후 대기열 배치" : "접수 거부: " + ArenaReject.Label(r);
    }

    private void CancelAll()
    {
        int r = Arena.CancelHuman();
        _msg = r == ArenaReject.None ? "전량 취소 접수 → 지연 후 반영(그 사이 체결 가능)" : "취소 거부: " + ArenaReject.Label(r);
    }

    private RenderFragment Board(int side, string title, ArenaSideStats st, long capital) => __builder =>
    {
        long pnl = st.PnlWon(capital);
        long retBp = capital > 0 ? pnl * 10_000 / capital : 0;
        <div class="ar-card">
            <h3>@title <small>@(st.OpenPositions)종목 보유@(st.ShortPositions > 0 ? " (롱 " + st.LongPositions + " · 숏 " + st.ShortPositions + " · 숏 담보 " + st.ShortLockedWon.ToString("N0") + "원)" : "")@(st.QueueCancelDepletedQty > 0 ? " · 취소 이탈 순번 전진 " + st.QueueCancelDepletedQty.ToString("N0") + "주" : "")</small></h3>
            <div class="ar-pnl @Tone(pnl)">@(pnl >= 0 ? "+" : "")@(pnl.ToString("N0"))원 <small>(@(retBp >= 0 ? "+" : "")@((retBp / 100.0).ToString("0.00"))%)</small></div>
            <svg viewBox="0 0 @(SparkW) @(SparkH)" preserveAspectRatio="none" class="ar-spark" aria-label="자산곡선">
                <polyline fill="none" stroke="@(pnl >= 0 ? "#E53935" : "#1E88E5")" stroke-width="1.6" points="@SparkPoints(side)" />
            </svg>
            <table class="ar-tbl">
                <tr><td>평가자산</td><td>@(st.EquityWon.ToString("N0"))원</td><td>현금</td><td>@(st.CashWon.ToString("N0"))원</td></tr>
                <tr><td>실현손익</td><td class="@Tone(st.RealizedWon)">@(st.RealizedWon.ToString("N0"))원</td><td>평가손익</td><td class="@Tone(st.UnrealizedWon)">@(st.UnrealizedWon.ToString("N0"))원</td></tr>
                <tr><td>MDD</td><td>@(st.MddWon.ToString("N0"))원 (@((st.MddBp / 100.0).ToString("0.00"))%)</td><td>승률</td><td>@((st.WinRate * 100).ToString("0.0"))% (@(st.Wins)승 @(st.Losses)패)</td></tr>
                <tr><td>수수료</td><td>@(st.FeesWon.ToString("N0"))원</td><td>거래세</td><td>@(st.TaxWon.ToString("N0"))원</td></tr>
                <tr><td>슬리피지</td><td>@(st.SlippageWon.ToString("N0"))원</td><td>체결/거부</td><td>@(st.Fills.ToString("N0")) / @(st.Rejects.ToString("N0"))</td></tr>
                <tr><td>지연/작동</td><td>@(st.PendingOrders) / @(st.WorkingOrders)건</td><td>내 앞 잔량</td><td>@(st.QueueAheadQty < 0 ? "-" : st.QueueAheadQty.ToString("N0") + "주")</td></tr>
                <tr><td>예약 현금</td><td>@(st.ReservedCashWon.ToString("N0"))원</td><td>취소</td><td>@(st.Cancels.ToString("N0"))</td></tr>
                <tr><td>유동성 진공</td><td class="@(st.VacuumEvents > 0 ? "ar-msg" : "")">@(st.VacuumEvents.ToString("N0"))회 · 페널티 @(st.VacuumPenaltyWon.ToString("N0"))원</td><td>빙산 리필</td><td>@(st.IcebergRefills.ToString("N0"))회</td></tr>
            </table>
        </div>
    };

    private static string Tone(long v) => v > 0 ? "ar-up" : v < 0 ? "ar-down" : "";

    // ── [v12.18.16-DEV] KIS 시세 지연 뱃지 ──
    private RenderFragment KisBadge() => __builder =>
    {
        var k = KisFeed.Status;
        <span class="ar-kis @DashKisFeed.Css(k.State)" title="KIS 전문 시각(초 해상도) 대비 지연 구간 · 위반 @(k.Violations.ToString("N0"))건@(k.Trips > 0 ? " · 사유 " + KisSkewReason.Label(k.LastTripReason) : "")">
            @DashKisFeed.Label(k.State)@(k.State is DashKisFeed.Ok or DashKisFeed.Latched ? " · " + k.RangeText : "")
        </span>
    };

    // ── [v12.18.15-DEV] AI 페르소나 · 설명 가능 HUD ──
    private void SelectPersona(int persona)
        => _msg = Arena.SetPersona(persona) ? ArenaPersona.Label(persona) + " 선택 → 다음 정산 회차 반영(진행 중이면 AI 포지션 전량 청산 후 교체)" : "페르소나 값 오류";

    private static string Gauge(long bp, long span)
        => (Math.Clamp((bp + span) * 50.0 / span, 0, 100)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string BpText(long bp) => (bp >= 0 ? "+" : "") + (bp / 100.0).ToString("0.00") + "%";

    private RenderFragment PersonaCard(ArenaAiHud h, int aiSide) => __builder =>
    {
        <div class="ar-card ar-persona">
            <div class="ar-mode" role="tablist">
                @for (int i = ArenaPersona.Signal; i < ArenaPersona.Count; i++)
                {
                    int p = i;
                    <button class="ar-tab @(h.Persona == p ? "on" : "")" role="tab" title="@ArenaPersona.Thesis(p)" @onclick="() => SelectPersona(p)">@ArenaPersona.Label(p)</button>
                }
            </div>
            <p class="ar-sub">🤖 @ArenaPersona.Label(h.Persona) — @ArenaPersona.Thesis(h.Persona)@(h.Switches > 0 ? " · 이번 매치 교체 " + h.Switches + "회" : "")</p>
            @if (h.Persona != ArenaPersona.Signal)
            {
                <div class="ar-hud">
                    <div>
                        <span class="ar-sub">대상 @(h.TargetSymbol > 0 ? h.TargetSymbol.ToString("D6") : "-") · 판단</span>
                        <span class="ar-pos @ArenaPositionSide.Css(aiSide)" title="AI 대상 종목 포지션 방향">[@ArenaPositionSide.Label(aiSide)]</span>
                        <b class="ar-act a@(h.Action)">@ArenaAiAction.Label(h.Action)</b>
                        <span>@ArenaAiReason.Label(h.Reason)</span>
                    </div>
                    <div class="ar-gauge" title="VWAP 이격률(±3% 눈금 · 중앙 = VWAP · ±1.5% 밴드 표시)">
                        <span class="ar-sub">VWAP 이격</span>
                        <div class="bar dev"><em style="left:25%"></em><em style="left:75%"></em><i style="left:@Gauge(h.VwapDevBp, 300)%"></i></div>
                        <b class="@Tone(h.VwapDevBp)">@(h.VwapWon > 0 ? BpText(h.VwapDevBp) : "-")</b>
                    </div>
                    <div class="ar-gauge" title="10호가 매수 총잔량 비율(중앙 = 50% · 65% / 35% 임계 표시)">
                        <span class="ar-sub">매수 잔량</span>
                        <div class="bar imb"><em style="left:35%"></em><em style="left:65%"></em><i style="left:@((h.ImbalanceBp / 100.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                        <b class="@Tone(h.ImbalanceBp - 5000)">@((h.ImbalanceBp / 100.0).ToString("0.0"))%</b>
                    </div>
                    <table class="ar-tbl">
                        <tr><td>VWAP</td><td>@(h.VwapWon > 0 ? h.VwapWon.ToString("N0") + "원" : "체결 대기")</td><td>σ(VWAP 기준)</td><td>@(h.SigmaWon.ToString("N0"))원 · @(h.VwapTrades.ToString("N0"))체결</td></tr>
                        <tr><td>목표가</td><td class="ar-up">@(h.TargetPx > 0 ? h.TargetPx.ToString("N0") + "원" : "-")</td><td>손절/스탑</td><td class="ar-down">@(h.StopPx > 0 ? h.StopPx.ToString("N0") + "원" : "-")</td></tr>
                        <tr><td>스프레드</td><td>@(h.SpreadWon.ToString("N0"))원</td><td>페르소나 발주</td><td>@(h.Decisions.ToString("N0"))건(가상 원장 전용)</td></tr>
                    </table>
                    @if (h.Persona == ArenaPersona.Predator)
                    {
                        <div class="ar-gauge ar-predator" title="공격성 = 기본 25% + 휴먼 연패 × 20% + 최근 틸트 20% + MAE 가중(상한 15%) · 50% 미만 = TWAP 은밀 분할 진입">
                            <span class="ar-sub">🦈 공격성</span>
                            <div class="bar aggr"><em style="left:50%"></em><i style="left:@((h.AggressionBp / 100.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                            <b class="@(h.AggressionBp >= 5_000 ? "ar-up" : "")">@((h.AggressionBp / 100.0).ToString("0"))%</b>
                        </div>
                        <table class="ar-tbl">
                            <tr><td>휴먼 연패(역추적)</td><td class="@(h.PreyLossStreak >= 2 ? "ar-msg" : "")">@(h.PreyLossStreak)연패 · 틸트 @(h.PreyTiltAlerts)건</td><td>휴먼 미청산 MAE</td><td class="ar-down">@(h.PreyMaeWon.ToString("N0"))원</td></tr>
                            <tr><td>래더 허수 잔량(가상)</td><td colspan="3">@(h.PhantomBidQty > 0 || h.PhantomAskQty > 0 ? "매수 1호가 +" + h.PhantomBidQty.ToString("N0") + " · 매도 1호가 +" + h.PhantomAskQty.ToString("N0") + "주 — 체결 불가 · 추격 매수 유도" : "주입 없음(휴먼 2연패 이상에서 발동)")</td></tr>
                        </table>
                    }
                </div>
            }
        </div>
    };

    private string SparkPoints(int side)
    {
        long ver = Arena.Version;
        if (ver == _sparkVersion[side]) return _sparkPoints[side];
        int n = Arena.CopyEquity(side, _curve[side]);
        int len = SparklineWriter.Write(_curve[side].AsSpan(0, n), _sparkBuf[side], SparkW, SparkH);
        _sparkPoints[side] = len > 0 ? new string(_sparkBuf[side], 0, len) : "";
        _sparkVersion[side] = ver;
        return _sparkPoints[side];
    }

    private void StartMatch()
        => _msg = Arena.Start(_capital) ? null : "자본금 범위 밖(100만 ~ 100억 원)";

    private void StopMatch()
    {
        Arena.Stop();
        _msg = null;
    }

    private void Submit(int dir)
    {
        if (!long.TryParse(_symbol, out long sym) || sym <= 0) { _msg = "종목코드를 숫자 6자리로 입력하세요"; return; }
        int r = Arena.SubmitHuman(sym, dir, _qty);
        string when = _replay && Replay.Status.State == ArenaReplayState.Paused ? " 접수 → 일시정지 중 대기(재개 첫 틱 체결)" : " 접수 → 다음 정산 회차 가상 체결";
        _msg = r == ArenaReject.None ? (dir > 0 ? "매수" : "매도") + when : "접수 거부: " + ArenaReject.Label(r);
    }

    protected override void OnInitialized()
    {
        SyncFocus();
        _timer = new System.Threading.Timer(_ => RenderPump(), null, RenderPumpMs, RenderPumpMs);
    }

    // [v12.18.24-DEV] 레벨 트리거 렌더 펌프(타이머 스레드): 그려진 버전 ≠ 현재 버전 ∧ 진행 중 렌더 없음 → InvokeAsync 1건.
    private void RenderPump()
    {
        long v = Arena.Version, rv = _replay ? Replay.Status.Version : 0;
        if (v == System.Threading.Volatile.Read(ref _drawn) && rv == System.Threading.Volatile.Read(ref _drawnReplay)) return;
        if (System.Threading.Interlocked.CompareExchange(ref _renderInFlight, 1, 0) != 0) { System.Threading.Interlocked.Increment(ref _pumpSkippedInFlight); return; }
        System.Threading.Interlocked.Increment(ref _pumpRenders);
        try { _ = InvokeAsync(StateHasChanged); }
        catch (Exception) { System.Threading.Volatile.Write(ref _renderInFlight, 0); }   // 회로 종료 등 — 다음 폴링 재시도
    }

    protected override void OnAfterRender(bool firstRender) => System.Threading.Volatile.Write(ref _renderInFlight, 0);

    public void Dispose() => _timer?.Dispose();
}

