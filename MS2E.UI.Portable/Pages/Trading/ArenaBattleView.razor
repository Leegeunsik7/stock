    // ── [v12.18.25-DEV] 포렌식 성과 분석 모달(경기 종료 · 닫기 = 이 매치 동안 숨김 · 다음 매치 개시 시 다시 표시) ──
    private long _forensicClosedAt = -1;

    private RenderFragment ForensicModal(ArenaSnapshot s) => __builder =>
    {
        bool ha = Arena.TryReadDebrief(ArenaSide.Ai, out var a), hh = Arena.TryReadDebrief(ArenaSide.Human, out var h);
