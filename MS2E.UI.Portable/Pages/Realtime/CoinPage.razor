@* Phase 94-O: 순수 UI 이관 — @page 는 호스트 shim(CoinHostPage)이 소유. ICryptoStreamPort 만 소비(엔진/거래소 provider 무참조). *@
@inject ICryptoStreamPort Crypto
@implements IDisposable
@using System.Threading

<div class="top">
    <div class="hello"><h1>🪙 코인 실시간</h1><p>업비트 · 빗썸 · 바이낸스 김프 · 환율 @_usdKrw.ToString("N0") · @_ts</p></div>
    <div class="badges">
        <span class="dot"><i></i>업비트 @(_upbitCount)종</span>
        <span class="dot" style="@(_bithumbCount==0?"opacity:.4":"")"><i style="background:var(--warn)"></i>빗썸 @(_bithumbCount)종</span>
        <span class="dot" style="@(_bnCount==0?"opacity:.4":"")"><i style="background:var(--accent-2)"></i>바낸 @(_bnCount)종</span>
    </div>
    <button class="addbtn" @onclick="RefreshSafeAsync" style="margin:0 16px">🔄 새로고침</button>
</div>

<div style="display:flex;gap:8px;padding:0 28px 14px;flex-wrap:wrap;align-items:center">
    @foreach (var t in _tabs)
    {
        <button class="pill @(t==_tab?"r":"b")" style="padding:6px 14px;cursor:pointer;border:0;font-size:12.5px" @onclick="()=>_tab=t">@t</button>
    }
    <input class="srch" placeholder="🔍 코인 검색 (BTC, 비트코인)" @bind="_q" @bind:event="oninput" />
    <select class="srch" @bind="_sort">
        <option value="val">거래대금순</option>
        <option value="change">변동률순</option>
        <option value="name">이름순</option>
    </select>
    <span class="sub" style="font-size:12px">표시 @(Rows.Count())종 / 전체 @(_allSymbols)종</span>
</div>

<div style="overflow:auto;padding:0 28px 40px">
    <table class="ctbl">
        <thead><tr>
            <th>코인</th><th style="text-align:right">업비트</th>
            <th style="text-align:right">빗썸</th>
            <th style="text-align:right">거래소 차이</th>
            <th style="text-align:right">바낸($)</th>
            <th style="text-align:right">김프%</th>
            <th style="text-align:right">24h 변화</th>
            <th style="text-align:right">거래대금(24h)</th>
            <th>보유</th><th>모의 주문</th>
        </tr></thead>
        <tbody>
            @foreach (var r in Rows)
            {
                <tr>
                    <td><b>@r.Name</b><br/><small class="sub">@r.Symbol</small></td>
                    <td class="num" style="text-align:right">@(r.UpbitPx>0 ? r.UpbitPx.ToString("N0") : "-")</td>
                    <td class="num" style="text-align:right;@(r.BithumbPx==0?"color:var(--sub)":"")">@(r.BithumbPx>0 ? r.BithumbPx.ToString("N0") : "-")</td>
                    <td class="num" style="text-align:right;@DiffColor(r.Diff)">@(r.UpbitPx>0 && r.BithumbPx>0 ? (r.Diff>=0?"+":"")+r.Diff.ToString("0.00")+"%" : "-")</td>
                    <td class="num" style="text-align:right;color:var(--sub)">@(r.BnUsdt>0 ? "$"+FmtUsd(r.BnUsdt) : "-")</td>
                    <td class="num" style="text-align:right;@KimchiColor(r)">@(r.HasKimchi ? (r.Kimchi>=0?"+":"")+r.Kimchi.ToString("0.00")+"%" : "-")</td>
                    <td style="text-align:right"><span class="@(r.Change>=0?"up":"down") num">@r.Change.ToString("+0.00;-0.00")%</span></td>
                    <td class="num sub" style="text-align:right;font-size:12px">@Fmt(r.TradeVal)</td>
                    <td style="font-size:12px">@(r.Held>0 ? r.Held.ToString("0.####") : "-")</td>
                    <td>
                        @if (r.UpbitPx > 0)
                        {
                            <button class="pill r" style="border:0;cursor:pointer;padding:3px 8px;font-size:11.5px" @onclick="()=>QuickBuy(r.Symbol)">매수</button>
                            <button class="pill b" style="border:0;cursor:pointer;padding:3px 8px;font-size:11.5px;margin-left:3px" @onclick="()=>QuickSell(r.Symbol)">매도</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Rows.Any()) { <div style="padding:40px;text-align:center;color:var(--sub)">데이터를 불러오는 중이거나 검색 결과가 없습니다.</div> }
</div>

@if (!string.IsNullOrEmpty(_toast))
{
    <div style="position:fixed;bottom:24px;right:28px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 20px;box-shadow:0 10px 30px rgba(0,0,0,.2);z-index:90;max-width:360px">
        @_toast
        <button style="border:0;background:transparent;cursor:pointer;margin-left:10px" @onclick="()=>_toast=string.Empty">✕</button>
    </div>
}

@code {
    private readonly string[] _tabs = { "전체", "업비트", "빗썸", "보유중" };
    private IReadOnlyList<ICoinQuoteView> _quotes = Array.Empty<ICoinQuoteView>();
    private IReadOnlyDictionary<string, decimal> _held = new Dictionary<string, decimal>();
    private decimal _usdKrw = 1380m;   // 환율 실패 시 직전 캐시값 유지 (원본 룰)
    private int _upbitCount, _bithumbCount, _bnCount, _allSymbols;
    private string _tab = "전체", _q = "", _sort = "val";
    private string _toast = "", _ts = "";
    private CancellationTokenSource? _cts;

    // 표시용 행(포터블 스냅샷 기반 파생 — 차익/김프는 원시값 계산).
    private record CoinRow(string Symbol, string Name, decimal UpbitPx, decimal BithumbPx,
        decimal Diff, decimal Change, decimal TradeVal, decimal Held,
        decimal BnUsdt, decimal Kimchi, bool HasKimchi);

    private IEnumerable<CoinRow> Rows
    {
        get
        {
            IEnumerable<ICoinQuoteView> src = _tab switch
            {
                "업비트" => _quotes.Where(q => q.UpbitPx > 0),
                "빗썸" => _quotes.Where(q => q.BithumbPx > 0),
                "보유중" => _quotes.Where(q => _held.TryGetValue("KRW-" + q.Symbol, out var h) && h > 0),
                _ => _quotes
            };

            var rows = src.Select(q =>
            {
                decimal up = q.UpbitPx, bp = q.BithumbPx;
                decimal diff = up > 0 && bp > 0 ? (up - bp) / bp * 100m : 0m;
                _held.TryGetValue("KRW-" + q.Symbol, out var held);
                // 김치 프리미엄 — 원본 룰: (업비트가 − 바낸가×환율)/공정가×100, 세 값 모두 >0일 때만.
                decimal fair = q.BnUsdt > 0 && _usdKrw > 0 ? q.BnUsdt * _usdKrw : 0m;
                bool hasK = up > 0 && fair > 0;
                decimal kimchi = hasK ? (up - fair) / fair * 100m : 0m;
                return new CoinRow(q.Symbol, q.Name, up, bp, diff, q.Change, q.TradeVal, held, q.BnUsdt, kimchi, hasK);
            });

            if (!string.IsNullOrWhiteSpace(_q))
                rows = rows.Where(r => r.Symbol.Contains(_q, StringComparison.OrdinalIgnoreCase)
                                    || r.Name.Contains(_q, StringComparison.OrdinalIgnoreCase));

            return (_sort switch
            {
                "change" => rows.OrderByDescending(r => Math.Abs(r.Change)),
                "name" => rows.OrderBy(r => r.Name),
                _ => rows.OrderByDescending(r => r.TradeVal)
            }).Take(120);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshSafeAsync();
        _cts = new CancellationTokenSource();
        _ = LoopAsync(_cts.Token);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try { await Task.Delay(15_000, ct); } catch { return; }
            await RefreshSafeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ★어댑터 병합 로직(개별 거래소 호출 밖)이 던질 수 있는 예외로부터 회로/폴링 루프를 보호(fail-closed: 직전 데이터 유지).
    private async Task RefreshSafeAsync()
    {
        try { await RefreshAsync(); }
        catch { _toast = "⚠️ 코인 시세 갱신 실패 · 직전 데이터 유지"; }
    }

    private async Task RefreshAsync()
    {
        var board = await Crypto.LoadBoardAsync(_cts?.Token ?? default);
        _quotes = board.Quotes;
        _held = board.Held;
        _usdKrw = board.UsdKrw;
        _upbitCount = board.UpbitCount;
        _bithumbCount = board.BithumbCount;
        _bnCount = board.BinanceCount;
        _allSymbols = board.AllSymbols;
        _ts = DateTime.Now.ToString("HH:mm:ss");
    }

    private void QuickBuy(string sym) { var (_, msg) = Crypto.QuickPaper("KRW-" + sym, 100_000m, isBuy: true); _toast = msg; }
    private void QuickSell(string sym) { var (_, msg) = Crypto.QuickPaper("KRW-" + sym, 100_000m, isBuy: false); _toast = msg; }

    private static string DiffColor(decimal d) => d > 0 ? "color:var(--up)" : d < 0 ? "color:var(--down)" : "color:var(--sub)";

    // 김프 색: 양수=상승색/음수=하락색/0 또는 미계산=보조색 (원본 룰)
    private static string KimchiColor(CoinRow r) =>
        !r.HasKimchi ? "color:var(--sub)" : r.Kimchi > 0 ? "color:var(--up)" : r.Kimchi < 0 ? "color:var(--down)" : "color:var(--sub)";

    // 원본 Fmt 룰: 100 이상 → 천단위 정수, 미만 → 소수 4자리
    private static string FmtUsd(decimal p) => p >= 100 ? p.ToString("N0") : p.ToString("0.####");

    private static string Fmt(decimal v) =>
        v >= 1_000_000_000_000m ? $"{v/1_000_000_000_000m:0.0}조" :
        v >= 100_000_000m ? $"{v/100_000_000m:0.0}억" : v.ToString("N0");

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
