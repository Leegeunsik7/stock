@code {
    private enum FormMode { Buy, Sell, Correct }
    private bool _showForm, _formEditing;
    private FormMode _mode = FormMode.Buy;
    private int _editId;
    private string _formMsg = "", _txMsg = "", _flash = "";
    private IHoldingView? _lastDeleted;
    private bool _showDeleted;
    private int _pollSec = 5;
    private CancellationTokenSource? _cts;

    // 로컬 통화 포맷(엔진 Formatter.Money 미러).
    private static string Money(decimal v, PfCurrency c) => c == PfCurrency.KRW ? $"{v:N0}원" : $"${v:N2}";
    private static string FmtQty(decimal q) => q == decimal.Truncate(q) ? q.ToString("N0") : q.ToString("0.########");

    // ----- 필터/정렬 -----
    private string _holdFilter = "all";
    private readonly (string k, string lbl)[] _holdFilters =
        { ("all", "전체"), ("dom", "🇰🇷 국내주식"), ("for", "🇺🇸 해외주식"), ("crypto", "₿ 코인") };
    private string _sortKey = "val";
    private bool _sortDesc = true;
    private void OnSortChanged() => _sortDesc = _sortKey != "name";
    private int ViewCount => Board.ViewHoldings(_holdFilter, _sortKey, _sortDesc).Count;

    private static string SessLabel(string s) => s switch { "AFTER" => "시간외", "PRE" => "프리", "POST" => "애프터", _ => "" };

    private string TickClass(IHoldingView h) =>
        Board.TryGetPrevPrice(h.Symbol, out var prev) && prev > 0
            ? (h.CurrentPrice > prev ? "tick-up" : h.CurrentPrice < prev ? "tick-down" : "")
            : "";

    private void MoveCustom(IHoldingView h, int dir)
    {
        var view = Board.ViewHoldings(_holdFilter, _sortKey, _sortDesc).Select(x => x.Symbol).ToList();
        Board.MoveCustom(h.Symbol, dir, view);
    }

    private static string CatIcon(PfAssetClass c) => c switch
    { PfAssetClass.DomesticStock => "🇰🇷", PfAssetClass.ForeignStock => "🇺🇸", PfAssetClass.Crypto => "₿", _ => "•" };
    private static string CatClass(PfAssetClass c) => c switch
    { PfAssetClass.DomesticStock => "c-dom", PfAssetClass.ForeignStock => "c-for", PfAssetClass.Crypto => "c-cry", _ => "" };
    private string WeightWidth(ICategoryView c)
    {
        var w = Math.Max(0m, Math.Min(100m, c.WeightPct(Board.TotalValue)));
        return w.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private string _tab = "hold";
    private readonly (string key, string label)[] _tabDefs = {
        ("hold","📊 보유 종목"), ("tx","📝 거래 이력"), ("tax","💰 세금 시뮬"),
        ("div","💸 배당 캘린더"), ("corr","🔗 상관관계") };

    // ----- 폼 드래프트 -----
    private HoldingDraft _f = new();
    private TxDraft _tf = new();
    private PfTxType _txType = PfTxType.Buy;
    private decimal TxTotal => _tf.Qty * _tf.Price + _tf.Commission + _tf.Tax;

    private void ApplyPickToForm(ISymbolEntryView e)
    {
        _editId = 0;
        _f.Symbol = e.Code; _f.Name = e.Name; _f.Market = e.Market; _f.Currency = e.Currency; _f.Picked = true;
        _fLastBroker = (_f.Broker ?? "").Trim();
        _formMsg = $"'{e.Name}' 선택됨 — 신규 등록으로 전환. 수량·평균단가를 입력하세요.";
    }
    private void OnFormSymbolEdited() => _f.Picked = false;
    private void ApplyPickToTx(ISymbolEntryView e)
    {
        _tf.Symbol = e.Code; _tf.Name = e.Name; _tf.Market = e.Market; _tf.Currency = e.Currency; _tf.Picked = true;
        AutoFillFees();
    }
    private void OnSymbolEdited()
    {
        if (_tf.Picked) _tf.Name = "";
        _tf.Picked = false;
        AutoFillFees();
    }

    private string ExecAtText =>
        (_tf.ExecutedAt == default ? DateTime.Now : _tf.ExecutedAt).ToString("yyyy-MM-ddTHH:mm");
    private void OnExecAtChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) _tf.ExecutedAt = dt;
    }

    private static decimal ParseMoney(object? v)
    {
        var raw = v?.ToString() ?? "";
        var sb = new System.Text.StringBuilder(raw.Length);
        foreach (var ch in raw) if (char.IsDigit(ch) || ch == '.' || ch == '-') sb.Append(ch);
        return decimal.TryParse(sb.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var d) && d >= 0 ? d : 0m;
    }
    private static string MoneyText(decimal v) =>
        v == 0 ? "" : v.ToString("#,##0.########", System.Globalization.CultureInfo.InvariantCulture);
    private static string QtyText(decimal q) =>
        q == 0 ? "" : q.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture);

    private string TxPriceText => MoneyText(_tf.Price);
    private void OnTxPriceChanged(ChangeEventArgs e) { _tf.Price = ParseMoney(e.Value); AutoFillFees(); }
    private string FormAvgText => MoneyText(_f.AvgPrice);
    private void OnFormAvgChanged(ChangeEventArgs e) { _f.AvgPrice = ParseMoney(e.Value); }
    private string TxQtyText => QtyText(_tf.Qty);
    private void OnTxQtyChanged(ChangeEventArgs e) { _tf.Qty = ParseMoney(e.Value); AutoFillFees(); }
    private string FormQtyText => QtyText(_f.Quantity);
    private void OnFormQtyChanged(ChangeEventArgs e) { _f.Quantity = ParseMoney(e.Value); }

    private bool _feesDirty;
    private string _lastBroker = "";
    private void MarkFeesDirty() => _feesDirty = true;
    private void OnBrokerChanged()
    {
        var b = (_tf.Broker ?? "").Trim();
        if (b == _lastBroker) return;
        _lastBroker = b; _feesDirty = false; AutoFillFees();
    }
    private void AutoFillFees()
    {
        if (string.IsNullOrWhiteSpace(_tf.Broker) || _feesDirty) return;
        var mkt = _tf.Picked ? _tf.Market : InferMarket(_tf.Symbol);
        var (c, t) = Board.EstimateFees(_tf.Broker, mkt, _txType, _tf.Qty, _tf.Price);
        _tf.Commission = c; _tf.Tax = t;
    }
    private static PfMarket InferMarket(string symbol) =>
        symbol.StartsWith("KRW-", StringComparison.OrdinalIgnoreCase) ? PfMarket.CRYPTO
        : (symbol.Length == 6 && char.IsDigit(symbol[0])) ? PfMarket.KRX_KOSPI : PfMarket.US_NASDAQ;

    // ----- 거래 이력 -----
    private List<ITxRowView> _txs = new();

    private async Task DeleteTx(ITxRowView t)
    {
        bool ok = await Dialog.ConfirmAsync($"이 거래를 삭제할까요?\n{t.Sym} · {t.Type} · {FmtQty(t.Qty)} @ {t.Price:N0}\n→ 해당 종목 평단·수량이 재계산됩니다.");
        if (!ok) return;
        try
        {
            Tx.Delete(t.Id, t.Sym);
            _flash = $"🗑 거래 삭제됨 — '{t.Sym}' {t.Type} {FmtQty(t.Qty)} @ {t.Price:N0}. 평단·수량 재계산 완료.";
        }
        catch (Exception ex) { _flash = "거래 삭제 실패: " + ex.Message; }
        await LoadAllAsync();
    }

    // ----- 상관관계 -----
    private decimal[,]? _corr;
    private List<string> _corrSyms = new();
    private bool _corrBusy;
    private string _corrMsg = "";

    // ----- AS-OF -----
    private List<IAsOfHoldingView> _asof = new();
    private void LoadAsOf() => _asof = AsOf.Reconstruct().ToList();
    private void OnAsOf() { if (!AsOf.IsLive) _tab = "hold"; LoadAsOf(); InvokeAsync(StateHasChanged); }

    protected override async Task OnInitializedAsync()
    {
        Board.LoadCustomOrder();
        await LoadAllAsync();
        LoadAsOf();
        AsOf.OnChange += OnAsOf;
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }

    private void RestartPoll()
    {
        _cts?.Cancel(); _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }
    private async Task OnPollChanged()
    {
        RestartPoll();
        if (_pollSec > 0 && AsOf.IsLive && _tab == "hold") { await RefreshBoardSafeAsync(); StateHasChanged(); }
    }

    private async Task Loop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            int sec = _pollSec > 0 ? _pollSec : 15;
            try { await Task.Delay(sec * 1000, ct); } catch { return; }
            if (ct.IsCancellationRequested) return;
            if (_pollSec <= 0 || !AsOf.IsLive || _tab != "hold" || (_showForm && _formEditing)) continue;
            await RefreshBoardSafeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    // v12.9.0 감사 — Board.LoadAsync() 예외가 무방비였음(실측 확인): 시세 단절/브로커 지연 시 폴링 루프(fire-and-forget
    // Task)가 관측되지 않은 예외로 영구 정지 + 사용자 피드백 0. Fail-closed(직전 보유 데이터 유지) + 토스트로 수정.
    private async Task RefreshBoardSafeAsync()
    {
        try { await Board.LoadAsync(persist: false); }
        catch (Exception ex) { Toast.ShowWarning("포트폴리오 갱신 실패", "직전 데이터 유지 — " + ex.Message); }
    }

    private void SwitchTab(string key)
    {
        _tab = key; _flash = "";
        if (key == "tx") LoadTransactions();
        else if (key == "div") _ = LoadDividends();
    }

    private async Task LoadAllAsync()
    {
        await Board.LoadAsync();
        LoadTransactions();
        _ = Board.LoadSparksAsync(() => InvokeAsync(StateHasChanged));
    }

    private MarkupString SparkSvg(string sym)
    {
        var d = Board.Spark(sym);
        if (d.Length < 2) return (MarkupString)"";
        double w = 100, h = 26, mn = d.Min(), mx = d.Max(); var r = (mx - mn) == 0 ? 1 : (mx - mn);
        var pts = string.Join(" ", d.Select((v, i) => $"{(i / (double)(d.Length - 1) * w):F1},{(h - (v - mn) / r * h):F1}"));
        var color = d[^1] >= d[0] ? "var(--up)" : "var(--down)";
        return (MarkupString)$"<svg class='spark' viewBox='0 0 {w} {h}' preserveAspectRatio='none' style='width:100px;height:26px;vertical-align:middle'><polyline points='{pts}' fill='none' stroke='{color}' stroke-width='1.6'/></svg>";
    }

    private void LoadTransactions() => _txs = Tx.Recent(1000).ToList();
    private async Task LoadDividends() { await Board.LoadDividendsAsync(); StateHasChanged(); }

    private async Task CalcCorrAsync()
    {
        _corrBusy = true; _corrMsg = ""; StateHasChanged();
        var res = await Board.CalcCorrelationAsync();
        _corrSyms = res.Symbols.ToList(); _corr = res.Matrix; _corrMsg = res.Message;
        _corrBusy = false;
    }

    private static string CorrColor(decimal v) =>
        v >= 0.7m ? "#dc3232" : v >= 0.3m ? "#c88250" : v >= -0.3m ? "#646464" : v >= -0.7m ? "#5082c8" : "#325adc";

    // ===== 폼 열기/전환 =====
    private void Open(FormMode m)
    {
        if (m == FormMode.Correct && _showForm && _mode == FormMode.Correct) { CloseForm(); return; }
        _showForm = true; _mode = m; _flash = "";
        if (m == FormMode.Correct) { ResetForm(); }
        else
        {
            _txType = m == FormMode.Buy ? PfTxType.Buy : PfTxType.Sell;
            _editId = 0; _tf = new() { Type = _txType }; _feesDirty = false; _lastBroker = ""; _txMsg = "";
        }
    }
    private void CloseForm() { _showForm = false; _editId = 0; _flash = ""; }

    private void SwitchMode(FormMode m)
    {
        if (m == _mode) return;
        string sym, name, broker; PfMarket mk; PfCurrency cur; bool picked;
        if (_mode == FormMode.Correct)
        { sym = _f.Symbol; name = _f.Name; mk = _f.Market; cur = _f.Currency; broker = _f.Broker; picked = _f.Picked; }
        else
        { sym = _tf.Symbol; name = _tf.Name; mk = _tf.Market; cur = _tf.Currency; broker = _tf.Broker; picked = _tf.Picked; }

        _mode = m; _flash = "";
        if (m == FormMode.Correct)
        {
            _editId = 0;
            _f = new() { Symbol = sym, Name = name, Market = mk, Currency = cur, Broker = broker };
            _fLastBroker = (broker ?? "").Trim();
            _formMsg = "직접보정 — 보유 합계(수량·평단)를 직접 입력/덮어씁니다.";
        }
        else
        {
            _txType = m == FormMode.Buy ? PfTxType.Buy : PfTxType.Sell;
            _editId = 0;
            _tf = new() { Symbol = sym, Name = name, Market = mk, Currency = cur, Broker = broker, Picked = picked, ExecutedAt = DateTime.Now, Type = _txType };
            _feesDirty = false; _lastBroker = (broker ?? "").Trim(); _txMsg = "";
        }
    }

    private void ApplyPick(ISymbolEntryView e)
    {
        if (_mode == FormMode.Correct) ApplyPickToForm(e);
        else ApplyPickToTx(e);
    }

    private async Task SaveTx()
    {
        if (string.IsNullOrWhiteSpace(_tf.Symbol)) { _txMsg = "종목코드를 입력하세요."; return; }
        if (_tf.Qty == 0 || _tf.Price == 0) { _txMsg = "수량과 단가를 입력하세요."; return; }
        _tf.Type = _txType;
        try { Tx.Add(_tf); }
        catch (Exception ex) { _txMsg = "저장 실패: " + ex.Message; return; }

        string nm = string.IsNullOrWhiteSpace(_tf.Name) ? _tf.Symbol : _tf.Name;
        var (hExists, hQty, txCnt, storedQ) = Tx.Diagnose(_tf.Symbol.Trim());
        if (!hExists || hQty <= 0)
            _flash = $"⚠️ '{nm}' 거래 저장됐으나 보유 미생성 — 코드 [{_tf.Symbol.Trim()}] · 입력 {_tf.Qty} · DB저장값 {storedQ} · 거래 {txCnt}건 · 보유행 {(hExists ? $"있음(수량 {hQty})" : "없음")}. 이 문구를 캡처해 주세요.";
        else
            _flash = $"✅ '{nm}' {(_txType == PfTxType.Buy ? "매수" : "매도")} 저장됨 — 보유수량 {hQty} ({_tf.Symbol.Trim()}).";
        _showForm = false; _tf = new(); _feesDirty = false; _lastBroker = ""; _txMsg = "";
        try { await Board.LoadAsync(); LoadTransactions(); } catch { }
    }

    private void ResetForm() { _f = new(); _editId = 0; _formMsg = ""; _fLastBroker = ""; }

    private void Edit(IHoldingView h)
    {
        _editId = h.Id; _mode = FormMode.Correct;
        _f = Board.ToDraft(h);
        _fLastBroker = (h.BrokerAccount ?? "").Trim();
        _showForm = true; _formMsg = ""; _flash = ""; _tab = "hold";
    }

    private string _fLastBroker = "";
    private void OnFormBrokerChanged()
    {
        var b = (_f.Broker ?? "").Trim();
        if (b == _fLastBroker) return;
        _fLastBroker = b;
        if (string.IsNullOrWhiteSpace(b)) return;
        var (c, _) = Board.EstimateFees(b, _f.Market, PfTxType.Buy, _f.Quantity, _f.AvgPrice);
        _f.Commission = c;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_f.Symbol) || _f.Quantity <= 0) { _formMsg = "종목코드와 수량을 입력하세요."; return; }
        bool edited = _editId > 0;
        _f.Id = _editId;
        try { await Board.SaveHoldingAsync(_f, edited); }
        catch (Exception ex) { _formMsg = "저장 실패: " + ex.Message; return; }
        _flash = $"✅ '{(string.IsNullOrWhiteSpace(_f.Name) ? _f.Symbol : _f.Name)}' {(edited ? "수정" : "등록")}되었습니다.";
        ResetForm(); _showForm = false;
    }

    private async Task Delete(IHoldingView h)
    {
        _flash = "";
        try { await Board.DeleteHoldingAsync(h.Symbol, h.BrokerAccount); _lastDeleted = h; }
        catch (Exception ex) { _flash = "삭제 실패: " + ex.Message; }
    }
    private async Task Restore(IHoldingView h)
    {
        _flash = "";
        try
        {
            await Board.RestoreHoldingAsync(h.Symbol, h.BrokerAccount);
            if (_lastDeleted is { } ld && ld.Symbol == h.Symbol && ld.BrokerAccount == h.BrokerAccount) _lastDeleted = null;
            _flash = $"↩️ '{h.Name}' 복원되었습니다.";
        }
        catch (Exception ex) { _flash = "복원 실패: " + ex.Message; }
    }
    private async Task HardDelete(IHoldingView h)
    {
        bool ok = await Dialog.ConfirmAsync($"'{h.Name}'({h.Symbol})을(를) 영구 삭제할까요?\n이 작업은 되돌릴 수 없습니다.");
        if (!ok) return;
        try
        {
            await Board.HardDeleteHoldingAsync(h.Symbol, h.BrokerAccount);
            if (_lastDeleted is { } ld && ld.Symbol == h.Symbol && ld.BrokerAccount == h.BrokerAccount) _lastDeleted = null;
            _flash = $"🗑 '{h.Name}' 영구 삭제되었습니다.";
        }
        catch (Exception ex) { _flash = "영구 삭제 실패: " + ex.Message; }
    }

    private void AddBuy(IHoldingView h)
    {
        _showForm = true; _mode = FormMode.Buy; _txType = PfTxType.Buy; _editId = 0; _flash = ""; _tab = "hold";
        _tf = new() { Symbol = h.Symbol, Name = h.Name, Market = h.Market, Currency = h.Currency,
                      Broker = h.BrokerAccount, Picked = true, ExecutedAt = DateTime.Now, Type = PfTxType.Buy };
        _feesDirty = false; _lastBroker = (h.BrokerAccount ?? "").Trim(); _txMsg = "";
    }

    private IHoldingView? FindHolding(string? symbol)
    {
        var s = (symbol ?? "").Trim();
        return s.Length == 0 ? null : Board.Holdings.FirstOrDefault(x => string.Equals(x.Symbol, s, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose() { AsOf.OnChange -= OnAsOf; _cts?.Cancel(); _cts?.Dispose(); }
}
