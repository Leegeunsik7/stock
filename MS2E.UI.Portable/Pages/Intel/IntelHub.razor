@* Phase 94-O: 순수 UI 이관 — @page 는 호스트 shim(IntelHostPage)이 소유. NavigationManager(포터블)만 사용, 자식 4종은 RCL. *@
@inject NavigationManager Nav

<HubTabs Items="_tabs" Active="@Cur" OnSelect="Sel" />
@switch (Cur)
{
    case "analyze": <AIPage /> break;
    case "journal": <JournalPage /> break;
    case "debate": <DebatePage /> break;
    default: <AdvisorPage /> break;
}

@code {
    [Parameter] public string? Tab { get; set; }
    private string Cur => string.IsNullOrWhiteSpace(Tab) ? "advisor" : Tab!.ToLowerInvariant();
    private readonly (string, string)[] _tabs = { ("advisor", "AI 비서(RAG)"), ("analyze", "종목 분석"), ("debate", "토론"), ("journal", "인과 저널") };
    private void Sel(string k) => Nav.NavigateTo(k == "advisor" ? "/intel" : $"/intel/{k}");
}
