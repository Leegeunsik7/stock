@* ============================================================================
   ForgePage — Phase 94-E: 전략 단조소 (★0 Concrete Ref · Host→RCL 물리 이주)
     레거시 IQuoteProvider/SymbolContext/LocalDatabase/StrategyForge/CartridgeService 직결을 전면 제거하고
     IStrategyHubInfraPort(심볼 컨텍스트) + IStrategyForgePort(발굴·서명 카트리지 내보내기)만 소비.
     라우팅 /forge 는 호스트 얇은 셸(ForgeHostPage)로 보존. ★liveArmed:false(순수 발굴·서명 — 발주 무접촉).
     한국 관례색: OOS/수익 상승=빨강(up)·하락=파랑(down).
   =========================================================================== *@
@implements IDisposable
@inject IStrategyHubInfraPort Infra
@inject IStrategyForgePort Forge

<div class="top">
    <div class="hello"><h1>🛠 전략 단조소 (Forge)</h1><p>MA 격자를 워크포워드 OOS로 평가해 <b>강건한 전략을 자가 발굴</b> → 서명된 카트리지로 포장 — 정보 제공이며 투자 권유 아님</p></div>
</div>

<div style="display:flex;gap:8px;padding:0 28px 12px;flex-wrap:wrap;align-items:center">
    <input class="srch" style="width:150px" placeholder="종목코드 (005930/AAPL)" @bind="_sym" @onkeydown="OnKey" />
    <span class="sub" style="font-size:12px">폴드</span>
    <select class="srch" style="width:72px" @bind="_folds" @bind:after="RunAsync">
        @foreach (var f in new[] { 3, 4, 5, 6 }) { <option value="@f">@f</option> }
    </select>
    <button class="addbtn" disabled="@_busy" @onclick="RunAsync">@(_busy ? "발굴 중…" : "🛠 발굴")</button>
</div>

@if (!string.IsNullOrEmpty(_msg)) { <div style="padding:0 28px 20px;color:var(--sub)">@_msg</div> }
else if (_res is { IsValid: true })
{
    <div class="kpis" style="grid-template-columns:repeat(4,1fr)">
        <div class="kpi"><div class="k-lab">평가 조합</div><div class="k-val">@_res.Tested</div></div>
        <div class="kpi"><div class="k-lab">OOS 폴드</div><div class="k-val">@_res.Folds</div></div>
        <div class="kpi g"><div class="k-lab">최고 강건 점수</div><div class="k-val @(_res.Ranked[0].Score>=0?"up":"down")">@_res.Ranked[0].Score.ToString("+0.0;-0.0")</div></div>
        <div class="kpi"><div class="k-lab">선택</div><div class="k-val">@(_picked.Count)</div></div>
    </div>

    <div style="padding:0 28px 40px">
        <div class="panel">
            <div class="panel-h">🛠 @_sym 강건 전략 순위 <span class="tag">WALK-FORWARD OOS</span></div>
            <div style="overflow:auto;max-height:calc(100vh - 420px)">
            <table class="ctbl dense">
                <thead><tr>
                    <th style="width:42px"></th><th>전략</th>
                    <th style="text-align:right">OOS 평균</th><th style="text-align:right">OOS 표준편차</th>
                    <th style="text-align:right">강건 점수</th><th style="text-align:right">거래</th><th style="text-align:right">전체구간</th>
                </tr></thead>
                <tbody>
                    @foreach (var c in _res.Ranked)
                    {
                        var key = (c.Short, c.Long);
                        <tr>
                            <td style="text-align:center"><input type="checkbox" checked="@_picked.Contains(key)" @onchange="@(e => Toggle(key, e.Value is true))" /></td>
                            <td><b>MA @c.Short/@c.Long</b></td>
                            <td class="num @(c.OosMeanPct>=0?"up":"down")" style="text-align:right">@c.OosMeanPct.ToString("+0.0;-0.0")%</td>
                            <td class="num sub" style="text-align:right">@c.OosStdPct.ToString("0.0")</td>
                            <td class="num" style="text-align:right;font-weight:700">@c.Score.ToString("+0.0;-0.0")</td>
                            <td class="num sub" style="text-align:right">@c.Trades</td>
                            <td class="num @(c.FullReturnPct>=0?"up":"down")" style="text-align:right">@c.FullReturnPct.ToString("+0.0;-0.0")%</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div class="panel-b" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;border-top:1px solid var(--hairline)">
                <input class="srch" style="width:180px" placeholder="카트리지 이름" @bind="_cartName" />
                <button class="addbtn" disabled="@(_picked.Count == 0)" @onclick="ExportCartridge">🧬 선택 @(_picked.Count)개 → 카트리지 서명·내보내기</button>
                @if (!string.IsNullOrEmpty(_exportMsg)) { <span class="sub" style="font-size:12px">@_exportMsg</span> }
            </div>
        </div>
        <div class="sub" style="font-size:11.5px;margin-top:10px">
            ℹ️ <b>강건 점수 = OOS 폴드 평균수익 − 0.5·표준편차</b>(일관성 패널티). 거래가 빈약한 조합은 제외됩니다. 발굴된 전략은 <a href="/cartridges" style="color:var(--accent)">카트리지</a>로 서명·증명서 포장되어 교환 가능합니다. 과거 기반 정보 제공이며 미래 보장 아님.
        </div>
    </div>
}

@code {
    private string _sym = "", _msg = "", _cartName = "", _exportMsg = "";
    private int _folds = 4;
    private bool _busy;
    private IForgeReport? _res;
    private readonly HashSet<(int s, int l)> _picked = new();

    protected override async Task OnInitializedAsync()
    {
        if (Infra.HasSymbol) _sym = Infra.CurrentSymbol;
        Infra.SymbolChanged += OnSym;
        if (!string.IsNullOrWhiteSpace(_sym)) await RunAsync();
    }

    private void OnSym() { _sym = Infra.CurrentSymbol; InvokeAsync(RunAsync); }
    private void OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = RunAsync(); }
    private void Toggle((int s, int l) key, bool on) { if (on) _picked.Add(key); else _picked.Remove(key); }

    private async Task RunAsync()
    {
        _msg = ""; _res = null; _exportMsg = ""; _picked.Clear();
        var sym = (_sym ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(sym)) { _msg = "종목코드를 입력하세요."; return; }
        _sym = sym;
        _busy = true; StateHasChanged();
        try
        {
            _res = await Forge.ForgeAsync(sym, _folds);   // 어댑터가 시세 조회 + StrategyForge 실행(오프로드)
            if (!_res.IsValid) _msg = $"{sym}: {_res.Note}";
            if (string.IsNullOrWhiteSpace(_cartName)) _cartName = $"{sym} 강건 전략";
        }
        catch (Exception ex) { _msg = "발굴 실패: " + ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task ExportCartridge()
    {
        if (_res is null || _picked.Count == 0) return;
        try
        {
            var picks = _picked.Select(k => new ForgePick(k.s, k.l)).ToList();
            var file = await Forge.ExportCartridgeAsync(_cartName, $"Forge 발굴 · {_sym} · {_res.Folds}폴드 OOS", picks);
            _exportMsg = string.IsNullOrEmpty(file)
                ? "내보내기 실패(선택 없음 또는 서명 오류)."
                : $"✅ 서명·내보내기: {file} (카트리지 화면에서 확인/교환)";
            Infra.Notify("카트리지 내보내기", _exportMsg, StrategyNotifyLevel.Success);
        }
        catch (Exception ex) { _exportMsg = "내보내기 실패: " + ex.Message; }
    }

    public void Dispose() => Infra.SymbolChanged -= OnSym;
}
