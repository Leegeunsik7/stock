@* ============================================================================
   OptimizerPage — Phase 94-F: 오버나잇 전략 옵티마이저 (★0 Concrete Ref · Host→RCL 물리 이주)
     레거시 IQuoteProvider/LocalDatabase/SymbolContext/ToastService/StrategyOptimizer/WalkForward/CompositeAlertEngine
     직결을 전면 제거하고 IStrategyHubInfraPort(설정·심볼·알림) + IOptimizerExecutionPort(최적화·워크포워드·스윕) +
     ICompositeAlertPort(추세필터 주입·도메인 은닉) + IStrategyLabPort(격자수)만 소비. 라우팅 /optimizer 는 호스트 셸로 보존.
     ★한국 관례색: 수익률 상승=빨강(up)·하락=파랑(down). liveArmed:false(순수 발굴/검증 — 발주·DCA 무접촉).
   =========================================================================== *@
@implements IDisposable
@inject IStrategyHubInfraPort Infra
@inject IOptimizerExecutionPort Opt
@inject ICompositeAlertPort Alerts
@inject IStrategyLabPort Lab
@inject NavigationManager Nav

<div class="top">
    <div class="hello"><h1>🌙 오버나잇 전략 옵티마이저</h1><p>종목별 MA 골든/데드크로스 기간을 격자 전수 백테스트해 "그 종목에 맞았던" 값 발굴 (정보 제공용)</p></div>
    <input class="srch" style="width:150px" placeholder="종목코드 (예 005930)" @bind="_symbol" @bind:event="oninput" />
    <select class="srch" style="width:130px;margin:0 8px" @bind="_marketCode">
        @foreach (var m in _markets) { <option value="@m.Code">@m.Label</option> }
    </select>
    <button class="addbtn" style="margin-right:16px" disabled="@_busy" @onclick="RunOneAsync">@(_busy?"분석 중…":"▶ 이 종목 분석")</button>
</div>

<div style="padding:0 28px 40px;max-width:1000px">
    <div style="background:color-mix(in srgb,var(--accent) 9%,transparent);border:1px solid var(--accent);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--sub);margin-bottom:16px">
        ℹ️ 격자 = 단기 {5·8·10·12} × 장기 {20·26·30·60} (단기&lt;장기 @(_grid)조합). 점수=총수익률, 동점 시 MDD 작은 쪽.
        <b>과거 성과가 미래를 보장하지 않습니다(투자 권유 아님).</b> 무거래 조합은 후보에서 제외합니다.
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:18px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <label style="display:flex;align-items:center;gap:8px;font-weight:700;cursor:pointer">
                <input type="checkbox" checked="@_enabled" @onchange="ToggleEnabled" /> 밤사이 자동 분석 (보유 종목)
            </label>
            <span style="color:var(--sub);font-size:12px">간격</span>
            <select class="srch" style="width:90px" @bind="_intervalHours" @bind:after="SaveInterval">
                <option value="12">12시간</option><option value="24">24시간</option><option value="48">48시간</option>
            </select>
            <button class="ghost" disabled="@_busy" @onclick="RunAllNowAsync">@(_busy?"실행 중…":"지금 전체 실행")</button>
            <span style="color:var(--sub);font-size:12px;margin-left:auto">@_lastRunLabel</span>
        </div>
        <div style="color:var(--sub);font-size:11.5px;margin-top:8px">
            보유 주식(최대 25종목)을 18개월 일봉으로 분석합니다. 읽기전용 백테스트만 수행하며 <b>주문·DCA를 절대 건드리지 않습니다.</b>
        </div>
    </div>

    @if (_oneMsg.Length > 0) { <div style="color:var(--down);padding:6px 2px 14px">@_oneMsg</div> }

    @if (_one is { IsValid: true } one && one.Best is not null)
    {
        <div style="font-weight:700;margin:6px 0 10px">🎯 @one.Name (@one.Symbol) — 우승 @one.Best.Label</div>
        <div class="kpis" style="margin:0 0 14px;grid-template-columns:repeat(4,1fr)">
            <div class="kpi @(one.Best.TotalReturn>=0?"u":"d")"><div class="k-lab">총 수익률</div><div class="k-val">@one.Best.TotalReturn.ToString("+0.0;-0.0")%</div></div>
            <div class="kpi d"><div class="k-lab">최대 낙폭 (MDD)</div><div class="k-val">@one.Best.MaxDrawdown.ToString("0.0")%</div></div>
            <div class="kpi k"><div class="k-lab">승률 · 거래</div><div class="k-val">@one.Best.WinRate.ToString("0")% · @one.Best.TradeCount</div></div>
            <div class="kpi k"><div class="k-lab">Sharpe</div><div class="k-val">@one.Best.Sharpe.ToString("0.00")</div></div>
        </div>
        <div style="margin:2px 0 14px">
            <button class="addbtn" @onclick="() => InjectComposite(one)">🔔 복합 알림으로 추가</button>
            <span style="color:var(--sub);font-size:11.5px;margin-left:10px">우승 장기선(MA@(one.Best.LongP)) 복귀 시 알림 — 표준화된 추세 필터(정확한 교차 아님).</span>
        </div>

        <div class="panel"><div class="panel-h">최적 조합 격자 <span class="tag">OPTIMIZER</span></div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:8px">
            <table class="ctbl" style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                    <th style="text-align:left;padding:8px 12px">조합</th><th style="text-align:right;padding:8px 12px">수익률</th>
                    <th style="text-align:right;padding:8px 12px">MDD</th><th style="text-align:right;padding:8px 12px">승률</th>
                    <th style="text-align:right;padding:8px 12px">거래</th><th style="text-align:right;padding:8px 12px">Sharpe</th>
                </tr></thead>
                <tbody>
                @foreach (var c in one.Candidates.OrderByDescending(x => x.TotalReturn))
                {
                    bool win = c.ShortP == one.Best.ShortP && c.LongP == one.Best.LongP;
                    <tr style="border-top:1px solid var(--line);@(win?"background:color-mix(in srgb,var(--up) 10%,transparent);font-weight:700":"")">
                        <td style="padding:7px 12px">@(win?"🏆 ":"")@c.Label</td>
                        <td style="text-align:right;padding:7px 12px" class="@(c.TotalReturn>=0?"up":"down")">@c.TotalReturn.ToString("+0.0;-0.0")%</td>
                        <td style="text-align:right;padding:7px 12px">@c.MaxDrawdown.ToString("0.0")%</td>
                        <td style="text-align:right;padding:7px 12px">@c.WinRate.ToString("0")%</td>
                        <td style="text-align:right;padding:7px 12px">@c.TradeCount</td>
                        <td style="text-align:right;padding:7px 12px">@c.Sharpe.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        </div>
        <div class="sub" style="font-size:11.5px;margin-bottom:18px">@one.Note · 캔들 @(one.CandlesUsed)개</div>

        <div style="display:flex;align-items:center;gap:12px;margin:6px 0 12px">
            <div style="font-weight:700">🧪 강건성 검증 (Walk-Forward)</div>
            <button class="ghost" disabled="@_wfBusy" @onclick="RunWalkForwardAsync">@(_wfBusy?"검증 중…":"▶ 검증 실행")</button>
            <span style="color:var(--sub);font-size:11.5px">학습창에서 뽑은 값이 <b>다음 구간(OOS)</b>에서도 통하는지 — 과최적화를 거른다.</span>
        </div>
        @if (_wfMsg.Length > 0) { <div style="color:var(--down);padding:2px 0 16px">@_wfMsg</div> }
        @if (_wf is { IsValid: true } wf)
        {
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                <span style="background:color-mix(in srgb,@WfColor() 16%,transparent);border:1px solid @WfColor();color:@WfColor();font-weight:800;border-radius:8px;padding:3px 12px">@wf.Verdict</span>
                <span style="color:var(--sub);font-size:12px">추천 @wf.RecLabel · @(wf.FoldCount)개 OOS 창</span>
            </div>
            <div class="kpis" style="margin:0 0 14px;grid-template-columns:repeat(4,1fr)">
                <div class="kpi @(wf.AvgInSample>=0?"u":"d")"><div class="k-lab">평균 IS 수익(학습)</div><div class="k-val">@wf.AvgInSample.ToString("+0.0;-0.0")%</div></div>
                <div class="kpi @(wf.AvgOutSample>=0?"u":"d")"><div class="k-lab">평균 OOS 수익(검증)</div><div class="k-val">@wf.AvgOutSample.ToString("+0.0;-0.0")%</div></div>
                <div class="kpi k"><div class="k-lab">OOS 승률</div><div class="k-val">@wf.OosWinRate.ToString("0")%</div></div>
                <div class="kpi k"><div class="k-lab">효율 (OOS/IS)</div><div class="k-val">@wf.Efficiency.ToString("0")%</div></div>
            </div>
            <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:8px">
                <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                    <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                        <th style="text-align:left;padding:8px 12px">창</th><th style="text-align:left;padding:8px 12px">학습 우승</th>
                        <th style="text-align:right;padding:8px 12px">IS 수익</th><th style="text-align:right;padding:8px 12px">OOS 수익</th>
                        <th style="text-align:right;padding:8px 12px">OOS 거래</th><th style="text-align:center;padding:8px 12px">판정</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var f in wf.Folds)
                    {
                        <tr style="border-top:1px solid var(--line)">
                            <td style="padding:7px 12px">#@(f.Index + 1)</td>
                            <td style="padding:7px 12px">@f.Label</td>
                            <td style="text-align:right;padding:7px 12px" class="@(f.InSampleReturn>=0?"up":"down")">@f.InSampleReturn.ToString("+0.0;-0.0")%</td>
                            <td style="text-align:right;padding:7px 12px" class="@(f.OutSampleReturn>=0?"up":"down")">@f.OutSampleReturn.ToString("+0.0;-0.0")%</td>
                            <td style="text-align:right;padding:7px 12px">@f.OosTradeCount</td>
                            <td style="text-align:center;padding:7px 12px">@(f.OosWin ? "✅" : "❌")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="sub" style="font-size:11.5px;margin-bottom:24px">
                과최적화 갭(IS−OOS) @wf.Degradation.ToString("+0.0;-0.0")%p · 갭이 크고 OOS가 음(−)이면 그 우승값은 과거에만 맞은 것입니다.
            </div>
        }
    }

    <div style="font-weight:700;margin:8px 0 10px">📋 보유 종목 자동 분석 결과</div>
    @if (_snap is { Rows.Count: > 0 } snap)
    {
        <div class="sub" style="font-size:12px;margin-bottom:8px">생성 @FmtTime(snap.GeneratedAt) · @snap.Rows.Count(r => r.IsValid)/@snap.Rows.Count 종목 유효</div>
        <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden">
            <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                    <th style="text-align:left;padding:8px 12px">종목</th><th style="text-align:left;padding:8px 12px">최적 전략</th>
                    <th style="text-align:right;padding:8px 12px">수익률</th><th style="text-align:right;padding:8px 12px">MDD</th>
                    <th style="text-align:right;padding:8px 12px">승률</th><th style="text-align:right;padding:8px 12px">거래</th><th style="padding:8px 12px"></th>
                </tr></thead>
                <tbody>
                @foreach (var r in snap.Rows.OrderByDescending(x => x.IsValid).ThenByDescending(x => x.TotalReturn))
                {
                    <tr style="border-top:1px solid var(--line)">
                        <td style="padding:7px 12px"><b>@r.Name</b> <span style="color:var(--sub)">@r.Symbol</span></td>
                        <td style="padding:7px 12px">@r.Label</td>
                        @if (r.IsValid)
                        {
                            <td style="text-align:right;padding:7px 12px" class="@(r.TotalReturn>=0?"up":"down")">@r.TotalReturn.ToString("+0.0;-0.0")%</td>
                            <td style="text-align:right;padding:7px 12px">@r.MaxDrawdown.ToString("0.0")%</td>
                            <td style="text-align:right;padding:7px 12px">@r.WinRate.ToString("0")%</td>
                            <td style="text-align:right;padding:7px 12px">@r.TradeCount</td>
                        }
                        else { <td colspan="4" style="padding:7px 12px;color:var(--sub)">@r.Note</td> }
                        <td style="text-align:right;padding:7px 12px"><button class="ghost" style="padding:3px 9px;font-size:11.5px" @onclick="() => Probe(r.Symbol)">분석</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else { <div style="color:var(--sub);padding:10px 2px">아직 자동 분석 결과가 없습니다. 위에서 「지금 전체 실행」을 누르거나 자동 분석을 켜 두세요.</div> }
</div>

@code {
    private string _symbol = "";
    private int _marketCode;
    private bool _busy, _enabled, _wfBusy;
    private int _intervalHours = 24, _grid;
    private string _oneMsg = "", _lastRunLabel = "", _wfMsg = "";
    private IOptimizationReport? _one;
    private IBacktestResultSnapshot? _snap;
    private IWalkForwardReport? _wf;
    private IReadOnlyList<MarketOption> _markets = Array.Empty<MarketOption>();

    protected override void OnInitialized()
    {
        _markets = Lab.GetMarkets();
        if (_markets.Count > 0) _marketCode = _markets[0].Code;
        _grid = Lab.GetCartridges().FirstOrDefault()?.GridSize ?? 13;

        if (Infra.HasSymbol) { _symbol = Infra.CurrentSymbol; _marketCode = Infra.CurrentMarketCode; }
        Infra.SymbolChanged += OnSym;

        _enabled = Infra.GetSetting("Optimizer.Enabled") == "true";
        if (int.TryParse(Infra.GetSetting("Optimizer.IntervalHours"), out var h) && h > 0) _intervalHours = h;
        _snap = Opt.LoadLastSnapshot();
        UpdateLastRun();
    }

    private void UpdateLastRun()
        => _lastRunLabel = DateTime.TryParse(Infra.GetSetting("Optimizer.LastRun"), out var t) ? $"마지막 실행 {t:MM-dd HH:mm}" : "아직 실행 안 됨";

    private void ToggleEnabled(ChangeEventArgs e)
    {
        _enabled = e.Value is true;
        Infra.SetSetting("Optimizer.Enabled", _enabled ? "true" : "false");
        Infra.Notify(_enabled ? "밤사이 자동 분석 켜짐" : "자동 분석 꺼짐",
            _enabled ? $"{_intervalHours}시간마다 보유 종목을 분석합니다." : "", StrategyNotifyLevel.Info);
    }

    private void SaveInterval() => Infra.SetSetting("Optimizer.IntervalHours", _intervalHours.ToString());

    private void Probe(string sym) { _symbol = sym; _ = RunOneAsync(); }

    private void OnSym() { _symbol = Infra.CurrentSymbol; _marketCode = Infra.CurrentMarketCode; InvokeAsync(RunOneAsync); }
    public void Dispose() => Infra.SymbolChanged -= OnSym;

    private async Task RunOneAsync()
    {
        var sym = (_symbol ?? "").Trim().Split(' ')[0];
        if (string.IsNullOrWhiteSpace(sym)) { _oneMsg = "종목코드를 입력하세요."; return; }
        Infra.SetSymbol(sym, _marketCode);
        _busy = true; _oneMsg = ""; _one = null; _wf = null; _wfMsg = ""; StateHasChanged();
        try
        {
            _one = await Opt.OptimizeAsync(sym, sym, _marketCode, 18);
            if (!_one.IsValid) { _oneMsg = $"분석 불가: {_one.Note}"; _one = null; }
        }
        catch (Exception ex) { _oneMsg = "오류: " + ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task RunWalkForwardAsync()
    {
        if (_one is null) return;
        _wfBusy = true; _wfMsg = ""; _wf = null; StateHasChanged();
        try
        {
            // 18개월 일봉(~370봉) 기준 train 120 / test 40 → 약 6 OOS 창. 어댑터가 시세 재조회·오프로드.
            _wf = await Opt.WalkForwardAsync(_one.Symbol, _one.Name, _marketCode, 18, 120, 40);
            if (!_wf.IsValid) { _wfMsg = $"검증 불가: {_wf.Note}"; _wf = null; }
        }
        catch (Exception ex) { _wfMsg = "오류: " + ex.Message; }
        finally { _wfBusy = false; StateHasChanged(); }
    }

    private async Task RunAllNowAsync()
    {
        _busy = true; StateHasChanged();
        try
        {
            var progress = new Progress<IBacktestResultRow>(_ => InvokeAsync(StateHasChanged));
            _snap = await Opt.RunPortfolioSweepAsync(18, 25, progress);   // 어댑터가 내부 영속
            UpdateLastRun();
            int valid = _snap.Rows.Count(r => r.IsValid);
            Infra.Notify(valid > 0 ? "전체 분석 완료" : "분석 결과 없음", $"{valid}/{_snap.Rows.Count}종목 유효", valid > 0 ? StrategyNotifyLevel.Success : StrategyNotifyLevel.Warning);
        }
        catch (Exception ex) { Infra.Notify("실행 실패", ex.Message, StrategyNotifyLevel.Error); }
        finally { _busy = false; StateHasChanged(); }
    }

    // 우승 장기선(MA long) 복귀 알림을 복합알림 규칙으로 추가 — 도메인 구상 타입은 어댑터가 조립(RCL 무유입).
    private void InjectComposite(IOptimizationReport r)
    {
        if (r.Best is null) return;
        Alerts.InjectTrendAlert(r.Symbol, r.Name, r.Best.LongP);
        Infra.Notify("복합 알림 추가됨", $"{r.Name} MA{r.Best.LongP} 추세 필터 — 즉시 활성화", StrategyNotifyLevel.Success);
        Nav.NavigateTo("/composite");
    }

    private string WfColor() => _wf?.Verdict switch
    {
        "강건" => "var(--up)",
        "취약(과최적화)" => "var(--down)",
        "보통" => "var(--warn)",
        _ => "var(--sub)"
    };

    private static string FmtTime(string iso) => DateTime.TryParse(iso, out var t) ? t.ToString("MM-dd HH:mm") : iso;
}
