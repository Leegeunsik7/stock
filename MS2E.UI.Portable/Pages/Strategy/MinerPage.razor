@* Phase 94-O: 순수 UI 이관 — @page 는 호스트 shim(MinerHostPage). 발굴 compute + 심볼 인프라 + 토스트 포트만 소비(엔진/복합규칙 무참조). *@
@inject IHypothesisMinerPort Miner
@inject IStrategyHubInfraPort Infra
@inject IToastPort Toasts
@implements IDisposable

<CrossLinks Current="miner" />
<div class="top">
    <div class="hello"><h1>🧬 자동 가설 발굴 (유전자 풀)</h1><p>조건 조합을 자동 생성해 train/OOS로 검증 — 보류표본에서도 살아남는 패턴만 발굴 (정보 제공용)</p></div>
    <input class="srch" style="width:140px" placeholder="종목코드 (005930)" @bind="_symbol" @bind:event="oninput" />
    <select class="srch" style="width:120px;margin:0 8px" @bind="_market">
        <option value="@PfMarket.KRX_KOSPI">코스피</option><option value="@PfMarket.KRX_KOSDAQ">코스닥</option>
        <option value="@PfMarket.US_NASDAQ">나스닥</option><option value="@PfMarket.US_NYSE">뉴욕</option><option value="@PfMarket.US_AMEX">아멕스</option>
    </select>
    <select class="srch" style="width:80px" @bind="_months"><option value="36">3년</option><option value="60">5년</option></select>
    <select class="srch" style="width:90px;margin-left:8px" @bind="_horizon"><option value="5">+5일</option><option value="10">+10일</option><option value="20">+20일</option></select>
    <button class="addbtn" style="margin:0 16px 0 8px" disabled="@_busy" @onclick="RunAsync">@(_busy?"발굴 중…":"⛏ 발굴")</button>
</div>

<div style="padding:0 28px 40px;max-width:920px">
    <div style="background:color-mix(in srgb,var(--warn) 10%,transparent);border:1px solid var(--warn);border-radius:10px;padding:10px 14px;font-size:12px;color:var(--sub);margin-bottom:16px">
        ⚠️ 수많은 조합을 돌리면 우연히 좋아 보이는 게 반드시 나옵니다. 이 엔진은 <b>OOS(보류표본) 엣지 양수 필수 + 다중검정 보정(효과크기 바)</b>으로
        그 함정을 막습니다. 생존했다 해도 <b>과거 패턴이며 미래를 보장하지 않습니다(투자 권유 아님).</b>
    </div>

    @if (_busy) { <div style="color:var(--sub);padding:20px">시세 수집 + 후보 검정 중…</div> }
    else if (_msg.Length > 0) { <div style="color:var(--sub);padding:20px">@_msg</div> }
    else if (_res is { IsValid: true })
    {
        <div class="kpis" style="margin:0 0 14px;grid-template-columns:repeat(3,1fr)">
            <div class="kpi k"><div class="k-lab">검정한 가설</div><div class="k-val">@_res.Tested</div></div>
            <div class="kpi @(_res.Survivors>0?"u":"d")"><div class="k-lab">OOS 생존</div><div class="k-val">@_res.Survivors</div></div>
            <div class="kpi k"><div class="k-lab">효과크기 바</div><div class="k-val">@_res.SignificanceBar.ToString("0.0")%p</div></div>
        </div>

        @if (_res.Survivors == 0)
        {
            <div style="color:var(--sub);padding:8px 2px">@_res.Note</div>
        }
        else
        {
            <div class="panel"><div class="panel-h">생존 가설 <span class="tag">HYPOTHESIS</span></div>
            <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden">
                <table class="ctbl" style="width:100%;border-collapse:collapse;font-size:12.5px">
                    <thead><tr style="background:color-mix(in srgb,var(--accent) 6%,transparent);color:var(--sub)">
                        <th style="text-align:left;padding:8px 12px">가설 패턴</th>
                        <th style="text-align:right;padding:8px 12px">Train 엣지</th>
                        <th style="text-align:right;padding:8px 12px">OOS 엣지</th>
                        <th style="text-align:right;padding:8px 12px">OOS 승률</th>
                        <th style="text-align:right;padding:8px 12px">OOS 표본</th>
                        <th style="padding:8px 12px"></th>
                    </tr></thead>
                    <tbody>
                    @foreach (var h in _res.Pool)
                    {
                        <tr style="border-top:1px solid var(--line)">
                            <td style="padding:7px 12px;font-weight:600">@h.Label</td>
                            <td style="text-align:right;padding:7px 12px" class="@(h.TrainEdgePct>=0?"up":"down")">@h.TrainEdgePct.ToString("+0.0;-0.0")%p</td>
                            <td style="text-align:right;padding:7px 12px;font-weight:700" class="@(h.OosEdgePct>=0?"up":"down")">@h.OosEdgePct.ToString("+0.0;-0.0")%p</td>
                            <td style="text-align:right;padding:7px 12px">@h.OosWinRatePct.ToString("0")%</td>
                            <td style="text-align:right;padding:7px 12px">@h.OosN</td>
                            <td style="text-align:right;padding:7px 12px"><button class="ghost" style="padding:3px 9px;font-size:11.5px" @onclick="() => Adopt(h)">＋알림</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            </div>
            <div class="sub" style="font-size:11.5px;margin-top:8px">@_res.Note · 엣지 = 패턴 발생 후 평균수익 − 무조건 평균. 「＋알림」으로 복합 알림에 채택하면 /eventstudy·/composite에서도 보입니다.</div>
        }
    }
</div>

@code {
    private string _symbol = "", _msg = "";
    private PfMarket _market = PfMarket.KRX_KOSPI;
    private int _months = 36, _horizon = 10;
    private bool _busy;
    private IMiningResultView? _res;

    protected override void OnInitialized()
    {
        if (Infra.HasSymbol) { _symbol = Infra.CurrentSymbol; _market = (PfMarket)Infra.CurrentMarketCode; }
        Infra.SymbolChanged += OnSym;
    }

    private void OnSym() { _symbol = Infra.CurrentSymbol; _market = (PfMarket)Infra.CurrentMarketCode; InvokeAsync(RunAsync); }
    public void Dispose() => Infra.SymbolChanged -= OnSym;

    private async Task RunAsync()
    {
        var sym = (_symbol ?? "").Trim().Split(' ')[0];
        if (string.IsNullOrWhiteSpace(sym)) { _msg = "종목코드를 입력하세요."; _res = null; return; }
        Infra.SetSymbol(sym, (int)_market);
        _busy = true; _msg = ""; _res = null; StateHasChanged();
        try
        {
            // 시세 fetch + HypothesisMiner.Mine 은 어댑터가 내재화(발굴 풀은 채택용으로 어댑터가 캐시).
            var res = await Miner.MineAsync(sym, _market, _months, _horizon);
            if (res.IsValid) _res = res;
            else { _msg = res.Note; _res = null; }
        }
        catch (Exception ex) { _msg = "오류: " + ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private void Adopt(IHypothesisView h)
    {
        // 채택(가설 index → 복합규칙 저장)은 어댑터가 내재화. 반환 메시지를 토스트로 표시.
        var sym = (_symbol ?? "").Trim().Split(' ')[0];
        var (title, message) = Miner.Adopt(int.Parse(h.Id), sym);
        Toasts.ShowSuccess(title, message);
    }
}
