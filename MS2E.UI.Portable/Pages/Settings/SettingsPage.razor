@* Phase 94-H: 순수 UI 이관 — @page 제거(호스트 SettingsHostPage.razor 가 /settings 라우트 보존).
   엔진 구상(LocalDatabase·BrokerHub·ApiKeyVault·LanStatusServer·AiService) 무참조 — IAdminSettingWidgetPort + NavigationManager(포터블)만 사용.
   ★API 키는 Port 가 마스킹해 전달(원본 키 RCL 무유입) · 비밀번호는 SetSecret(DPAPI). *@
@inject IAdminSettingWidgetPort Settings
@inject NavigationManager Nav

<div class="top"><div class="hello"><h1>⚙️ 설정</h1><p>거래 모드 · API 키 · 테마</p></div></div>

<div style="padding:0 28px;max-width:560px">
    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:14px">거래 모드</div>
        <div style="display:flex;gap:14px;margin-bottom:12px">
            <span class="pill @(!_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick='()=>SetMode(false)'>🧪 모의투자</span>
            <span class="pill @(_live?"r":"b")" style="padding:8px 16px;cursor:pointer;border:0;font-size:13px" @onclick='()=>SetMode(true)'>💸 실거래</span>
        </div>
        <div style="color:var(--sub);font-size:12.5px">@(_live ? "실거래 모드 — 무장(LiveArmed) 설정 후 주문이 실제 집행됩니다." : "모의투자 모드 — 실제 자금이 이동하지 않습니다.")</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:14px">API 키 관리 (DPAPI 암호화 저장)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">키는 로컬에서 암호화 보관됩니다. 자세한 설정은 '거래 설정 창'을 이용하세요.</div>
        <div style="margin-bottom:8px">업비트: <span class="num" style="color:var(--sub)">@Settings.UpbitAccessKeyMasked</span></div>
        <div style="margin-bottom:14px">KIS: <span class="num" style="color:var(--sub)">@Settings.KisAccessKeyMasked</span></div>
        <button class="addbtn" @onclick="OpenBrokerSettings">⚙️ 거래 설정 열기</button>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">📱 LAN 상태 서버 (읽기전용)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">같은 와이파이의 폰 브라우저에서 포트폴리오 현황만 조회. 주문·설정 변경은 불가(이 PC에서만).</div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:10px">
            <input type="checkbox" @bind="_lanEnabled" /> 서버 사용
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <div><label class="flbl">포트</label><input class="fin" style="width:90px" type="number" @bind="_lanPort" /></div>
            <div><label class="flbl">접속 PIN</label><input class="fin" style="width:130px" @bind="_lanPin" /></div>
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="GenPin">🎲 PIN 생성</button>
            <button class="addbtn" @onclick="ApplyLan">적용</button>
        </div>
        <div style="margin-top:12px;font-size:12px;color:var(--sub);line-height:1.7">
            <b>원격 접속(외부망):</b> 앱 개발 없이 두 가지 중 택1 —<br/>
            ① <b>Tailscale</b>(권장): 설치 후 <code>tailscale up</code> → 폰에서 <code>http://(이PC의 Tailscale IP):@_lanPort</code> (사설 메시·암호화)<br/>
            ② <b>Cloudflare Tunnel</b>: <code>cloudflared tunnel --url http://localhost:@_lanPort</code> → 발급 URL 접속(공개, Access로 보호 권장)<br/>
            <b>헤드리스 상주:</b> <code>MS2E.StockSuite.exe --headless</code> (UI 없이 엔진+서버만, 트레이로 종료). PIN 10회 오류 시 60초 잠금.
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">
            상태: @(Settings.LanRunning ? $"🟢 실행 중 (포트 {Settings.LanPort})" : "⚪ 중지")
            @if (!string.IsNullOrEmpty(Settings.LanLastError)) { <div style="color:var(--warn)">@Settings.LanLastError</div> }
            @if (_lanMsg.Length > 0) { <div>@_lanMsg</div> }
        </div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">🧠 LLM 백엔드 (프라이버시)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">
            <b>로컬(Ollama)</b>를 켜면 AI 비서·토론·브리핑이 <b>오프라인·무제한·완전 프라이빗</b>으로 동작합니다(데이터가 기기를 떠나지 않음, API 한도 없음).
            먼저 <code>ollama serve</code> 실행 + <code>ollama pull @_ollamaModel</code> 필요.
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-bottom:8px">
            <div><label class="flbl">제공자</label>
                <select class="fin" style="width:130px" @bind="_llmProvider">
                    <option value="auto">auto (키 있으면 Gemini)</option>
                    <option value="gemini">Gemini (클라우드)</option>
                    <option value="ollama">로컬 (Ollama)</option>
                </select>
            </div>
            <label class="ck" style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
                <input type="checkbox" @bind="_ollamaEnabled" /> 로컬 LLM 사용
            </label>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <div><label class="flbl">Ollama URL</label><input class="fin" style="width:180px" @bind="_ollamaUrl" /></div>
            <div><label class="flbl">모델</label><input class="fin" style="width:120px" @bind="_ollamaModel" /></div>
            <div><label class="flbl">타임아웃(초)</label><input class="fin" style="width:80px" type="number" min="10" max="1200" @bind="_ollamaTimeout" /></div>
            <button class="addbtn" @onclick="ApplyLlm">적용</button>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">현재 활성: <b>@_llmActive</b> @if (_llmMsg.Length > 0) { <span>· @_llmMsg</span> }</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">🛰 레짐 변화 감시 (이상탐지)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">
            고정 임계값을 넘어, 보유 종목이 <b>평소 성격에서 벗어나는 순간</b>(수익률 이상치·변동성 급등·추세 레짐 이동)과
            포트폴리오 <b>상관 급등(분산효과 붕괴)</b>을 백그라운드에서 통계로 감지해 알림. 읽기전용 — 주문은 건드리지 않음.
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:10px">
            <input type="checkbox" @bind="_regimeEnabled" /> 감시 사용 (앱·헤드리스 상주 시 동작)
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <div><label class="flbl">점검 간격(시간)</label><input class="fin" style="width:90px" type="number" min="1" max="168" @bind="_regimeHours" /></div>
            <button class="addbtn" @onclick="ApplyRegime">적용</button>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">보유 주식(최대 25)을 4개월 일봉으로 점검 · 종목당 20시간 쿨다운. @if (_regimeMsg.Length > 0) { <span>@_regimeMsg</span> }</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">⚖️ 리밸런싱 드리프트 알림</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">
            포트폴리오 허브 → 리밸런싱 탭에서 <b>「🎯 타겟으로 저장」</b> 한 비중 대비, 현재 비중이 밴드(%p)를 벗어나면
            백그라운드에서 <b>"리밸런싱 시점"</b> 알림. 읽기전용 — 주문은 하지 않습니다.
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:10px">
            <input type="checkbox" @bind="_driftEnabled" /> 드리프트 감시 사용
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <div><label class="flbl">이탈 밴드(%p)</label><input class="fin" style="width:80px" type="number" min="1" max="50" @bind="_driftBand" /></div>
            <div><label class="flbl">점검 간격(시간)</label><input class="fin" style="width:90px" type="number" min="1" max="168" @bind="_driftHours" /></div>
            <button class="addbtn" @onclick="ApplyDrift">적용</button>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">@if (_driftMsg.Length > 0) { <span>@_driftMsg</span> } else { <span>저장된 타겟이 없으면 알림은 발생하지 않습니다. 종목당 20시간 쿨다운.</span> }</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">🌙 야간 자동 퍼블리싱</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">
            앱(또는 <code>--headless</code> 상주)이 켜져 있으면 매일 설정 시각 이후 손익·옵티마이저·예측보정·토론 승률을 종합해
            <b>텔레그램</b>(본문)·<b>메일</b>(PDF 첨부)로 1회 발송합니다.
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:10px">
            <input type="checkbox" @bind="_nightlyEnabled" /> 야간 리포트 사용
        </label>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-bottom:8px">
            <div><label class="flbl">발송 시각(시)</label><input class="fin" style="width:80px" type="number" min="0" max="23" @bind="_nightlyHour" /></div>
            <button class="addbtn" @onclick="ApplyNightly">적용</button>
        </div>
        <div style="font-weight:600;font-size:12.5px;margin:6px 0 4px">메일(SMTP, 선택)</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end">
            <div><label class="flbl">SMTP</label><input class="fin" style="width:150px" placeholder="smtp.gmail.com" @bind="_smtp" /></div>
            <div><label class="flbl">포트</label><input class="fin" style="width:64px" type="number" @bind="_smtpPort" /></div>
            <div><label class="flbl">받는 메일</label><input class="fin" style="width:170px" @bind="_emailTo" /></div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin-top:6px">
            <div><label class="flbl">계정</label><input class="fin" style="width:170px" @bind="_emailUser" /></div>
            <div><label class="flbl">앱 비밀번호</label><input class="fin" style="width:150px" type="password" @bind="_emailPass" /></div>
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="ApplyEmail">메일 저장</button>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">@if (_nightlyMsg.Length > 0) { <span>@_nightlyMsg</span> } else { <span>텔레그램 키(거래 설정)·SMTP 중 설정된 채널로만 발송. 비밀번호는 DPAPI 암호화 저장.</span> }</div>
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px">
        <div style="font-weight:700;margin-bottom:6px">🛡️ 시그널 게이트 안전 강화(강화 전용)</div>
        <div style="color:var(--sub);font-size:12.5px;margin-bottom:12px">
            더 엄격해지는 방향으로만 바꿀 수 있습니다 — 게이트 끄기 · 임계 낮추기 · 승인 한도 늘리기는 화면에서 거부됩니다(운영자 환경변수/관리 DB 로만).
            게이트 · 확신 임계 · 횡보 최대 임계는 1초 안에 반영, 적응 임계 사용 · 승인 한도는 다음 기동부터 반영됩니다.
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <button class="addbtn" @onclick="TightenGate" disabled="@(_gateOn)">@(_gateOn ? "게이트 강제 켜짐" : "시그널 게이트 강제 켜기")</button>
            <div><label class="flbl">확신 임계(bp · 현재 @_confBp)</label><input class="fin" style="width:90px" type="number" min="@_confBp" max="10000" @bind="_confInput" /></div>
            <div><label class="flbl">횡보 최대 임계(bp · 현재 @_maxBp)</label><input class="fin" style="width:90px" type="number" min="@_maxBp" max="10000" @bind="_maxInput" /></div>
            <button class="addbtn" @onclick="TightenThresholds">상향 적용</button>
        </div>
        <div style="margin-top:10px;font-size:12px;color:var(--sub)">@if (_tightenMsg.Length > 0) { <span>@_tightenMsg</span> } else { <span>완화 시도는 기존 값을 그대로 두고 폐기됩니다.</span> }</div>
        <div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px">
            <span style="padding:2px 8px;border-radius:6px;font-weight:600;background:@AuditBadgeColor;color:@AuditBadgeInk">📜 @SignalLabelMapper.AuditStateLabel(_audit.State, _audit.FreezeCause)</span>
            @if (_auditBound)
            {
                <span>기록 @(_audit.Count) / @(_audit.Capacity) (@SignalLabelMapper.AuditUsedText(_audit.UsedPercent))</span>
                <span style="display:inline-flex;gap:2px">
                    @for (int i = 0; i < SignalLabelMapper.HeadSwatchCount; i++)
                    {
                        <i style="display:inline-block;width:9px;height:13px;border-radius:2px;background:@SignalLabelMapper.HeadSwatch(_audit.HeadPrefix, i)"></i>
                    }
                </span>
                <code title="머리 해시 상위 8바이트 — 기억해 둔 지문과 다르면 원장이 바뀐 것">@SignalLabelMapper.HeadHex(_audit.HeadPrefix)</code>
                <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line);padding:2px 10px" @onclick="LoadAudit">새로고침</button>
            }
        </div>
        @if (_audit.State == DashAuditLedger.Frozen)
        {
            <div style="margin-top:6px;font-size:12px;color:#ce93d8">원장이 동결되어 이 화면의 모든 강화 기입이 거부됩니다(비트 27). 원장 파일을 보관한 뒤 재기동하세요.</div>
        }
        else if (_audit.State == DashAuditLedger.Saturating)
        {
            <div style="margin-top:6px;font-size:12px;color:#ffb300">원장 사용률이 90% 를 넘었습니다 — 가득 차면 설정 변경이 동결됩니다. 원장 파일 보관 후 재기동을 준비하세요.</div>
        }
    </div>

    <div style="background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px">
        <div style="font-weight:700;margin-bottom:14px">빠른 설정</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="OpenSetup">🔧 설정 마법사</button>
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="OpenBrokerSettings">💳 거래 설정</button>
            <button class="addbtn" style="background:var(--card-2);color:var(--ink);border:1px solid var(--line)" @onclick="OpenTradingSettings">💹 거래 수수료 설정</button>
        </div>
    </div>
</div>

@code {
    private bool _live;
    private bool _lanEnabled;
    private int _lanPort = 8787;
    private string _lanPin = "", _lanMsg = "";
    private bool _regimeEnabled;
    private int _regimeHours = 12;
    private string _regimeMsg = "";
    private bool _driftEnabled;
    private int _driftBand = 5, _driftHours = 24;
    private string _driftMsg = "";
    private string _llmProvider = "auto", _ollamaUrl = "http://localhost:11434", _ollamaModel = "llama3.1", _llmMsg = "", _llmActive = "";
    private bool _ollamaEnabled;
    private int _ollamaTimeout = 180;
    private bool _nightlyEnabled;
    private int _nightlyHour = 6, _smtpPort = 587;
    private string _smtp = "", _emailTo = "", _emailUser = "", _emailPass = "", _nightlyMsg = "";
    private bool _gateOn;
    private long _confBp, _maxBp;
    private int _confInput, _maxInput;
    private string _tightenMsg = "";
    private bool _auditBound;
    private AuditLedgerBadge _audit;
    private string AuditBadgeColor => _audit.State switch { DashAuditLedger.Normal => "#2e7d32", DashAuditLedger.Saturating => "#f9a825", DashAuditLedger.Frozen => "#6a1b9a", _ => "#3a3f4b" };
    private string AuditBadgeInk => _audit.State == DashAuditLedger.Saturating ? "#111" : "#fff";

    private void LoadAudit()
    {
        _auditBound = Settings.TryGetAuditLedger(out _audit);
        if (!_auditBound) _audit = default;                                            // 미결선 = State 0
    }

    protected override void OnInitialized()
    {
        _live = Settings.IsLive;
        _lanEnabled = Settings.GetSetting("Lan.Enabled") == "true";
        if (int.TryParse(Settings.GetSetting("Lan.Port"), out var p)) _lanPort = p;
        _lanPin = Settings.GetSetting("Lan.Pin") ?? "";
        _regimeEnabled = Settings.GetSetting("Regime.Enabled") == "true";
        if (int.TryParse(Settings.GetSetting("Regime.IntervalHours"), out var rh) && rh > 0) _regimeHours = rh;
        _driftEnabled = Settings.GetSetting("Drift.Enabled") == "true";
        if (double.TryParse(Settings.GetSetting("Drift.BandPct"), out var bb) && bb > 0) _driftBand = (int)bb;
        if (int.TryParse(Settings.GetSetting("Drift.IntervalHours"), out var dh) && dh > 0) _driftHours = dh;
        var lp = Settings.GetSetting("Llm.Provider"); if (!string.IsNullOrWhiteSpace(lp)) _llmProvider = lp;
        _ollamaEnabled = Settings.GetSetting("Ollama.Enabled") == "true";
        var ou = Settings.GetSetting("Ollama.Url"); if (!string.IsNullOrWhiteSpace(ou)) _ollamaUrl = ou;
        var om = Settings.GetSetting("Ollama.Model"); if (!string.IsNullOrWhiteSpace(om)) _ollamaModel = om;
        if (int.TryParse(Settings.GetSetting("Ollama.TimeoutSec"), out var ot) && ot > 0) _ollamaTimeout = ot;
        _llmActive = Settings.ActiveLlm;
        _nightlyEnabled = Settings.GetSetting("Nightly.Enabled") == "true";
        if (int.TryParse(Settings.GetSetting("Nightly.Hour"), out var nh)) _nightlyHour = Math.Clamp(nh, 0, 23);
        _smtp = Settings.GetSetting("Email.Smtp") ?? ""; _emailTo = Settings.GetSetting("Email.To") ?? "";
        _emailUser = Settings.GetSetting("Email.User") ?? "";
        if (int.TryParse(Settings.GetSetting("Email.Port"), out var ep) && ep > 0) _smtpPort = ep;
        LoadTightenable();
    }

    private void LoadTightenable()
    {
        _gateOn = Settings.TryGetTightenable("Strategy.SignalGateEnabled", out var g) && g == 1;
        if (Settings.TryGetTightenable("Strategy.ConfidenceThresholdBp", out var c)) _confBp = c;
        if (Settings.TryGetTightenable("Strategy.AdaptiveMaxBp", out var m)) _maxBp = m;
        _confInput = (int)_confBp; _maxInput = (int)_maxBp;
        LoadAudit();
    }

    private void TightenGate()
    {
        _tightenMsg = "게이트: " + TightenVerdictCode.Label(Settings.TightenSetting("Strategy.SignalGateEnabled", "true"));
        LoadTightenable();
    }

    private void TightenThresholds()
    {
        string c = TightenVerdictCode.Label(Settings.TightenSetting("Strategy.ConfidenceThresholdBp", _confInput.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        string m = TightenVerdictCode.Label(Settings.TightenSetting("Strategy.AdaptiveMaxBp", _maxInput.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        _tightenMsg = "확신 임계: " + c + " · 횡보 최대 임계: " + m;
        LoadTightenable();
    }

    private void ApplyNightly()
    {
        Settings.SetSetting("Nightly.Enabled", _nightlyEnabled ? "true" : "false");
        Settings.SetSetting("Nightly.Hour", Math.Clamp(_nightlyHour, 0, 23).ToString());
        _nightlyMsg = _nightlyEnabled ? $"✅ 매일 {_nightlyHour}시 이후 1회 발송" : "야간 리포트를 껐습니다.";
    }

    private void ApplyEmail()
    {
        Settings.SetSetting("Email.Smtp", _smtp.Trim());
        Settings.SetSetting("Email.Port", Math.Clamp(_smtpPort, 1, 65535).ToString());
        Settings.SetSetting("Email.To", _emailTo.Trim());
        Settings.SetSetting("Email.User", _emailUser.Trim());
        if (!string.IsNullOrWhiteSpace(_emailPass)) { Settings.SetSecret("Email.Pass", _emailPass.Trim()); _emailPass = ""; }
        _nightlyMsg = "✅ 메일 설정 저장(비밀번호 DPAPI 암호화)";
    }

    private void ApplyLlm()
    {
        Settings.SetSetting("Llm.Provider", _llmProvider);
        Settings.SetSetting("Ollama.Enabled", _ollamaEnabled ? "true" : "false");
        Settings.SetSetting("Ollama.Url", _ollamaUrl.Trim());
        Settings.SetSetting("Ollama.Model", _ollamaModel.Trim());
        Settings.SetSetting("Ollama.TimeoutSec", Math.Clamp(_ollamaTimeout, 10, 1200).ToString());
        _llmActive = Settings.ActiveLlm;
        _llmMsg = "적용됨 — AI 비서/브리핑/토론에 반영";
    }

    private void ApplyDrift()
    {
        Settings.SetSetting("Drift.Enabled", _driftEnabled ? "true" : "false");
        Settings.SetSetting("Drift.BandPct", Math.Clamp(_driftBand, 1, 50).ToString());
        Settings.SetSetting("Drift.IntervalHours", Math.Clamp(_driftHours, 1, 168).ToString());
        var hasTarget = !string.IsNullOrWhiteSpace(Settings.GetSetting("Rebalance.Target"));
        _driftMsg = _driftEnabled
            ? (hasTarget ? "✅ 감시 켜짐 — 다음 점검부터 적용" : "⚠️ 켜졌지만 저장된 타겟이 없습니다(리밸런싱 탭에서 저장).")
            : "감시를 껐습니다.";
    }

    private void ApplyRegime()
    {
        Settings.SetSetting("Regime.Enabled", _regimeEnabled ? "true" : "false");
        Settings.SetSetting("Regime.IntervalHours", Math.Clamp(_regimeHours, 1, 168).ToString());
        _regimeMsg = _regimeEnabled ? "✅ 감시 켜짐 — 다음 점검부터 적용" : "감시를 껐습니다.";
    }

    private void GenPin()
    {
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(4);
        _lanPin = (BitConverter.ToUInt32(bytes, 0) % 1_000_000).ToString("D6");   // 무작위 6자리
    }

    private void ApplyLan()
    {
        if (_lanEnabled && string.IsNullOrWhiteSpace(_lanPin)) { _lanMsg = "보안을 위해 PIN을 설정하세요."; return; }
        Settings.SetSetting("Lan.Enabled", _lanEnabled ? "true" : "false");
        Settings.SetSetting("Lan.Port", Math.Clamp(_lanPort, 1, 65535).ToString());
        Settings.SetSetting("Lan.Pin", _lanPin.Trim());
        Settings.RestartLan();
        _lanMsg = _lanEnabled ? "적용됨. 폰 브라우저에서 http://(이PC IP):" + _lanPort + " 접속." : "서버를 중지했습니다.";
    }

    private void SetMode(bool live) { Settings.SetLive(live); _live = live; }
    private void OpenBrokerSettings() => Nav.NavigateTo("/broker");
    private void OpenTradingSettings() => Nav.NavigateTo("/settings/trading");
    private void OpenSetup() => Nav.NavigateTo("/setup");
}
