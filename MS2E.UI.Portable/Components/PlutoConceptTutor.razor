@* PlutoConceptTutor — v12.18.93-DEV: 📚 퀀트 지표 원포인트 과외(CVD · 켈리 비중 · 볼린저 밴드 · 거시 레짐) — 칩 클릭 = 대화형 카드 토글.
   순수 표시 — PlutoConceptGuide 정적 교육 문구만(주입 0 · 엔진 참조 0 · 실시간 수치 인용 0). *@

<div class="pct" data-pct="@(_open ?? "none")">
    <span class="pct-label">📚 플루토 개념 과외</span>
    @foreach (var c in PlutoConceptGuide.All)
    {
        <button class="pct-chip @(c.Key == _open ? "on" : "")" data-pct-key="@c.Key" aria-expanded="@(c.Key == _open ? "true" : "false")" @onclick="() => Toggle(c.Key)">@c.Icon @ShortTitle(c)</button>
    }
    @if (PlutoConceptGuide.Get(_open) is { } k)
    {
        <div class="pct-card" role="dialog" aria-label="@k.Title" data-pct-card="@k.Key">
            <div class="pct-title"><span>@k.Icon @k.Title</span><button class="pct-x" @onclick="() => _open = null" aria-label="닫기">✕</button></div>
            <div class="pct-formula">@k.Formula</div>
            <div class="pct-bubble pluto"><b>🤖 플루토가 이 지표를 보는 이유</b><p>@k.WhyPluto</p></div>
            <div class="pct-bubble human"><b>🧑 인간 투자자가 배울 점</b><p>@k.HumanLesson</p></div>
            <div class="pct-pit">⚠️ 함정: @k.Pitfall</div>
        </div>
    }
</div>

@code {
    /// <summary>처음 펼칠 개념 키(null = 접힘).</summary>
    [Parameter] public string? Initial { get; set; }

    private string? _open;

    protected override void OnInitialized() => _open = PlutoConceptGuide.Get(Initial)?.Key;

    private void Toggle(string key) => _open = _open == key ? null : key;

    private static string ShortTitle(PlutoConcept c)
    {
        int i = c.Title.IndexOf(" · ", StringComparison.Ordinal);
        return i > 0 ? c.Title[..i] : c.Title;
    }
}

<style>
    .pct { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0; }
    .pct-label { font-size: 12px; font-weight: 700; color: #A5B4FC; }
    .pct-chip { font-size: 11.5px; padding: 3px 10px; border-radius: 12px; border: 1px solid #374151; background: #1F2937; color: #E5E7EB; cursor: pointer; }
    .pct-chip.on { border-color: #6366F1; background: #1e1b4b; color: #fff; }
    .pct-card { flex-basis: 100%; border: 1px solid #312E81; background: #0F1024; border-radius: 10px; padding: 10px 12px; font-size: 12px; color: #D1D5DB; line-height: 1.6; }
    .pct-title { font-size: 13px; font-weight: 700; color: #F9FAFB; display: flex; justify-content: space-between; }
    .pct-x { background: transparent; border: 0; color: #9CA3AF; cursor: pointer; }
    .pct-formula { margin: 6px 0; padding: 6px 8px; background: #111827; border-radius: 6px; color: #C7D2FE; font-family: ui-monospace, Consolas, monospace; font-size: 11.5px; }
    .pct-bubble { border-radius: 8px; padding: 6px 10px; margin: 6px 0; } .pct-bubble p { margin: 2px 0 0; }
    .pct-bubble.pluto { background: #1e1b4b; } .pct-bubble.human { background: #172033; }
    .pct-pit { color: #FCD34D; font-size: 11.5px; }
</style>
