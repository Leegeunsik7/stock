@* ============================================================================
   MarketTicker - 전역 시장 티커 바 (블룸버그/트레이딩뷰 톤, v3.47.0)
    상단에 주요 종목 시세를 고정폭 마퀴로 흘려보낸다. 20초 폴링·실패 무시(직전 유지).
    데이터 없으면 바 자체를 렌더하지 않음(레이아웃 안정).
   ============================================================================ *@
@* Phase 94-K: 순수 UI 이관 — IDashboardWidgetPort 만 소비(IQuoteProvider·watchlist·Formatter 어댑터 격리). *@
@inject IDashboardWidgetPort Widget
@implements IDisposable
@using System.Threading

@if (_items.Count > 0)
{
    <div class="ticker" title="주요 종목 시세 (20초 갱신)">
        <div class="ticker-track">
            @foreach (var it in _loop)
            {
                <span class="tk">
                    <span class="tk-sym">@it.Name</span>
                    <span class="tk-px num">@it.Px</span>
                    <span class="tk-dl num @(it.Up ? "up" : "down")">@(it.Up ? "▲" : "▼") @it.Rate</span>
                </span>
            }
        </div>
    </div>
}

@code {
    private List<ITickerRowView> _items = new();
    private List<ITickerRowView> _loop = new();     // 끊김 없는 마퀴를 위해 2회 이어붙임
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _ = Loop(_cts.Token);
    }

    private async Task Loop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            await RefreshAsync(ct);
            await InvokeAsync(StateHasChanged);
            try { await Task.Delay(20_000, ct); } catch { return; }
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        var rows = await Widget.GetTickerRowsAsync(ct);   // 시세 fetch·투영은 어댑터가 수행
        if (rows.Count > 0)
        {
            _items = rows.ToList();
            _loop = _items.Concat(_items).ToList();
        }
    }

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
