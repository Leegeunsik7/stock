@* AsOfBar - 전역 시점(As-Of) 스크러버 바. Phase 94-K: 순수 UI 이관 — ITimeTravelAsOfPort 만 소비(AsOfContext 무참조). *@
@implements IDisposable
@inject ITimeTravelAsOfPort AsOf

<div class="asofbar @(AsOf.IsLive ? "" : "active")">
    <span class="ao-lbl">🕰 시점</span>
    <input type="date" class="ao-in" @bind="_date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <button class="ao-btn" @onclick="Apply">적용</button>
    <span class="ao-presets">
        <a @onclick="() => Quick(1)">1M</a>
        <a @onclick="() => Quick(3)">3M</a>
        <a @onclick="() => Quick(6)">6M</a>
        <a @onclick="() => Quick(12)">1Y</a>
    </span>
    @if (AsOf.IsLive)
    {
        <span class="ao-live">🟢 LIVE · 현재 시점</span>
    }
    else
    {
        <span class="ao-asof">⏳ AS-OF @AsOf.AsOf!.Value.ToString("yyyy-MM-dd") · 터미널이 과거 시점을 표시 중</span>
        <button class="ao-livebtn" @onclick="() => AsOf.ReturnLive()">🔴 LIVE 복귀</button>
    }
</div>

@code {
    private DateTime _date = DateTime.Today.AddMonths(-3);

    protected override void OnInitialized()
    {
        if (!AsOf.IsLive) _date = AsOf.AsOf!.Value;
        AsOf.OnChange += OnCtx;
    }

    private void OnCtx() => InvokeAsync(StateHasChanged);

    private void Apply()
    {
        if (_date.Date >= DateTime.Today) { AsOf.ReturnLive(); return; }   // 오늘/미래 = LIVE
        AsOf.EnterAsOf(_date);
    }

    private void Quick(int months)
    {
        _date = DateTime.Today.AddMonths(-months);
        AsOf.EnterAsOf(_date);
    }

    public void Dispose() => AsOf.OnChange -= OnCtx;
}

<style>
    .asofbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:6px 28px;border-bottom:1px solid var(--hairline);
             background:color-mix(in srgb,var(--accent) 4%,var(--bg));font-size:12px}
    .asofbar .ao-lbl{color:var(--sub);font-weight:700}
    .asofbar .ao-in{background:var(--card);border:1px solid var(--line);border-radius:7px;padding:4px 8px;font-size:12px;color:var(--ink);font-family:var(--mono)}
    .asofbar .ao-btn{background:var(--accent);color:#fff;border:0;border-radius:7px;padding:4px 11px;font-size:12px;cursor:pointer;font-weight:600}
    .asofbar .ao-presets a{color:var(--accent);cursor:pointer;margin:0 4px;text-decoration:none;font-weight:700;font-family:var(--mono)}
    .asofbar .ao-presets a:hover{text-decoration:underline}
    .asofbar .ao-live{color:var(--ok);font-weight:700;margin-left:4px}
    /* 활성(과거 시점) — 앰버 강조: 전 화면에서 '시간여행 모드'임을 명확히 */
    .asofbar.active{background:color-mix(in srgb,var(--warn) 16%,var(--bg));border-bottom:2px solid var(--warn)}
    .asofbar.active .ao-asof{color:var(--warn);font-weight:800;letter-spacing:.01em}
    .asofbar .ao-livebtn{background:var(--warn);color:#1a1a1f;border:0;border-radius:7px;padding:4px 11px;font-size:12px;cursor:pointer;font-weight:800;margin-left:auto}
</style>
